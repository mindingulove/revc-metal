+// ---- read back
+MGL void mgl_glReadPixels(GLint x, GLint y, GLsizei w, GLsizei h, GLenum format, GLenum type, void *out)
+{
+	id<MTLTexture> src = readTarget(fboOf(G->readFbo));
+	if(!src) return;
+	submit(true);
+	size_t bpp = src.pixelFormat == MTLPixelFormatRGBA32Float ? 16 : src.pixelFormat == MTLPixelFormatRGBA16Float ? 8 : src.pixelFormat == MTLPixelFormatR8Unorm ? 1 : src.pixelFormat == MTLPixelFormatR32Float ? 4 : 4;
+	std::vector<uint8_t> raw((size_t)w*h*bpp);
+	[src getBytes:raw.data() bytesPerRow:(size_t)w*bpp fromRegion:MTLRegionMake2D(x, y, w, h) mipmapLevel:0];
+	int comps = format == GL_RGBA || format == GL_BGRA ? 4 : format == GL_RGB || format == GL_BGR ? 3 : 1;
+ if(type==GL_FLOAT){
+  size_t row=((size_t)w*comps*sizeof(float)+G->packAlign-1)/G->packAlign*G->packAlign;
+  for(int yy=0;yy<h;yy++)for(int xx=0;xx<w;xx++){
+   const uint8_t *p=raw.data()+((size_t)yy*w+xx)*bpp;float rgba[4]={0,0,0,1};
+   if(src.pixelFormat==MTLPixelFormatRGBA32Float)memcpy(rgba,p,16);
+   else if(src.pixelFormat==MTLPixelFormatRGBA16Float){const __fp16 *v=(const __fp16*)p;for(int c=0;c<4;c++)rgba[c]=v[c];}
+   else if(src.pixelFormat==MTLPixelFormatR32Float)memcpy(rgba,p,4);
+   else {for(size_t c=0;c<std::min(bpp,(size_t)4);c++)rgba[c]=p[c]/255.f;if(src.pixelFormat==MTLPixelFormatBGRA8Unorm)std::swap(rgba[0],rgba[2]);}
+   if(format==GL_BGRA || format==GL_BGR)std::swap(rgba[0],rgba[2]);
+   memcpy((uint8_t*)out+yy*row+(size_t)xx*comps*sizeof(float),rgba,comps*sizeof(float));
+  }
+  return;
+ }
+	bool bgraSrc = src.pixelFormat == MTLPixelFormatBGRA8Unorm;
+	size_t dstRow = ((size_t)w*comps + G->packAlign - 1)/G->packAlign*G->packAlign;
+	uint8_t *o = (uint8_t*)out;
+	if(src.pixelFormat == MTLPixelFormatRGBA8Unorm || bgraSrc){
+		for(int yy = 0; yy < h; yy++) for(int xx = 0; xx < w; xx++){
+			const uint8_t *p = &raw[((size_t)yy*w + xx)*4];
+			uint8_t r = bgraSrc ? p[2] : p[0], g = p[1], b = bgraSrc ? p[0] : p[2], a = p[3];
+			uint8_t *d = o + yy*dstRow + (size_t)xx*comps;
+			if(format == GL_BGRA){ d[0] = b; d[1] = g; d[2] = r; d[3] = a; }
+			else if(format == GL_BGR){ d[0] = b; d[1] = g; d[2] = r; }
+			else if(comps == 4){ d[0] = r; d[1] = g; d[2] = b; d[3] = a; }
+			else if(comps == 3){ d[0] = r; d[1] = g; d[2] = b; }
+			else d[0] = r;
+		}
+	}else{
+		for(int yy = 0; yy < h; yy++) memcpy(o + yy*dstRow, &raw[(size_t)yy*w*bpp], (size_t)w*bpp < dstRow ? (size_t)w*bpp : dstRow);
+	}
+}
+MGL void mgl_glGetTexImage(GLenum target, GLint level, GLenum format, GLenum type, void *out)
+{
+	Tex *t = boundTex(target);
+	if(!t || !out || !ensureTex(t) || level<0 || level>=t->created) return;
+	submit(true);
+	int w = t->w >> level, h = t->h >> level; if(w < 1) w = 1; if(h < 1) h = 1;
+	size_t rb; size_t total = levelBytes(t->fmt, w, h, &rb);
+	std::vector<uint8_t> raw(total);
+	MTLPixelFormat srcFmt = t->fmt;
+	if(srcFmt != MTLPixelFormatRGBA8Unorm && srcFmt != MTLPixelFormatBGRA8Unorm && type == GL_UNSIGNED_BYTE && !t->depth){
+		// compressed (or other) formats: let the GPU decode the level into RGBA8, like OpenGL does for glGetTexImage
+		id<MTLTexture> view = [t->mtl newTextureViewWithPixelFormat:t->fmt textureType:MTLTextureType2D levels:NSMakeRange(level, 1) slices:NSMakeRange(0, 1)];
+		MTLTextureDescriptor *d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm width:w height:h mipmapped:NO];
+		d.usage = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead; d.storageMode = MTLStorageModeShared;
+		id<MTLTexture> dst = [G->dev newTextureWithDescriptor:d];
+		MTLRenderPassDescriptor *pd = [MTLRenderPassDescriptor renderPassDescriptor];
+		pd.colorAttachments[0].texture = dst; pd.colorAttachments[0].loadAction = MTLLoadActionClear; pd.colorAttachments[0].storeAction = MTLStoreActionStore;
+		id<MTLCommandBuffer> cb = [G->queue commandBuffer];
+		id<MTLRenderCommandEncoder> enc = [cb renderCommandEncoderWithDescriptor:pd];
+		MTLPixelFormat cf[4] = { MTLPixelFormatRGBA8Unorm, MTLPixelFormatInvalid, MTLPixelFormatInvalid, MTLPixelFormatInvalid };
+		MTLColorWriteMask mk[4] = { MTLColorWriteMaskAll, MTLColorWriteMaskNone, MTLColorWriteMaskNone, MTLColorWriteMaskNone };
+		[enc setRenderPipelineState:utilPso(true, cf, MTLPixelFormatInvalid, mk)];
+		float params[8] = { 0, 0, 1, 1, 1, 0, 0, 0 };
+		[enc setVertexBytes:params length:sizeof(params) atIndex:0];
+		Tex dummy; dummy.minF = dummy.magF = GL_NEAREST; dummy.wrapS = dummy.wrapT = GL_CLAMP_TO_EDGE; dummy.created = 1;
+		[enc setFragmentSamplerState:samplerFor(&dummy) atIndex:0];
+		[enc setFragmentTexture:view atIndex:0];
+		[enc drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+		[enc endEncoding];
+		[cb commit]; [cb waitUntilCompleted];
+		rb = (size_t)w*4;
+		raw.assign(rb*h, 0);
+		[dst getBytes:raw.data() bytesPerRow:rb fromRegion:MTLRegionMake2D(0, 0, w, h) mipmapLevel:0];
+		srcFmt = MTLPixelFormatRGBA8Unorm;
+	}else
+		[t->mtl getBytes:raw.data() bytesPerRow:rb fromRegion:MTLRegionMake2D(0, 0, w, h) mipmapLevel:level];
+	int comps = format == GL_RGBA || format == GL_BGRA ? 4 : format == GL_RGB ? 3 : 1;
+	uint8_t *o = (uint8_t*)out;
+	size_t dstRow = ((size_t)w*comps + G->packAlign - 1)/G->packAlign*G->packAlign;
+	if(srcFmt == MTLPixelFormatRGBA8Unorm || srcFmt == MTLPixelFormatBGRA8Unorm){
+		bool bgraSrc = srcFmt == MTLPixelFormatBGRA8Unorm;
+		for(int yy = 0; yy < h; yy++) for(int xx = 0; xx < w; xx++){
+			const uint8_t *p = &raw[yy*rb + (size_t)xx*4];
+			uint8_t r = bgraSrc ? p[2] : p[0], g = p[1], b = bgraSrc ? p[0] : p[2], a = p[3];
+			uint8_t *d = o + yy*dstRow + (size_t)xx*comps;
+			if(format == GL_BGRA){ d[0] = b; d[1] = g; d[2] = r; d[3] = a; }
+			else if(comps == 4){ d[0] = r; d[1] = g; d[2] = b; d[3] = a; }
+			else if(comps == 3){ d[0] = r; d[1] = g; d[2] = b; }
+			else d[0] = r;
+		}
+	}else
+		memcpy(out, raw.data(), total);
+}
+MGL void mgl_glGetCompressedTexImage(GLenum target, GLint level, void *out)
+{
+	Tex *t = boundTex(target);
+	if(!t || !out || !ensureTex(t) || level<0 || level>=t->created) return;
+	submit(true);
+	int w = t->w >> level, h = t->h >> level; if(w < 1) w = 1; if(h < 1) h = 1;
+	size_t rb; levelBytes(t->fmt, w, h, &rb);
+	[t->mtl getBytes:out bytesPerRow:rb fromRegion:MTLRegionMake2D(0, 0, w, h) mipmapLevel:level];
+}
