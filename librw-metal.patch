+static std::string
+concat(const char **src)
+{
+	std::string s;
+	for(; src && *src; src++) s += *src;
+	return s;
+}
+
+static void
+initGlslang(void)
+{
+	static std::once_flag once;
+	std::call_once(once, []{ glslang::InitializeProcess(); });
+}
