diff --git a/src/matrixinvert.h b/src/matrixinvert.h
new file mode 100644
index 0000000..f0631b1
--- /dev/null
+++ b/src/matrixinvert.h
@@ -0,0 +1,35 @@
+#ifndef RW_MATRIXINVERT_H
+#define RW_MATRIXINVERT_H
+
+namespace rw { namespace matrixutil {
+// Large world translations make float cofactors lose enough precision to move history
+// by whole pixels. Compute the inverse in double, converting only the final matrix.
+inline bool invert4(float *out, const float *source)
+{
+	double m[16], inv[16];
+	for(int i=0;i<16;i++) m[i] = source[i];
+	inv[0] = m[5]*m[10]*m[15] - m[5]*m[11]*m[14] - m[9]*m[6]*m[15] + m[9]*m[7]*m[14] + m[13]*m[6]*m[11] - m[13]*m[7]*m[10];
+	inv[4] = -m[4]*m[10]*m[15] + m[4]*m[11]*m[14] + m[8]*m[6]*m[15] - m[8]*m[7]*m[14] - m[12]*m[6]*m[11] + m[12]*m[7]*m[10];
+	inv[8] = m[4]*m[9]*m[15] - m[4]*m[11]*m[13] - m[8]*m[5]*m[15] + m[8]*m[7]*m[13] + m[12]*m[5]*m[11] - m[12]*m[7]*m[9];
+	inv[12] = -m[4]*m[9]*m[14] + m[4]*m[10]*m[13] + m[8]*m[5]*m[14] - m[8]*m[6]*m[13] - m[12]*m[5]*m[10] + m[12]*m[6]*m[9];
+	inv[1] = -m[1]*m[10]*m[15] + m[1]*m[11]*m[14] + m[9]*m[2]*m[15] - m[9]*m[3]*m[14] - m[13]*m[2]*m[11] + m[13]*m[3]*m[10];
+	inv[5] = m[0]*m[10]*m[15] - m[0]*m[11]*m[14] - m[8]*m[2]*m[15] + m[8]*m[3]*m[14] + m[12]*m[2]*m[11] - m[12]*m[3]*m[10];
+	inv[9] = -m[0]*m[9]*m[15] + m[0]*m[11]*m[13] + m[8]*m[1]*m[15] - m[8]*m[3]*m[13] - m[12]*m[1]*m[11] + m[12]*m[3]*m[9];
+	inv[13] = m[0]*m[9]*m[14] - m[0]*m[10]*m[13] - m[8]*m[1]*m[14] + m[8]*m[2]*m[13] + m[12]*m[1]*m[10] - m[12]*m[2]*m[9];
+	inv[2] = m[1]*m[6]*m[15] - m[1]*m[7]*m[14] - m[5]*m[2]*m[15] + m[5]*m[3]*m[14] + m[13]*m[2]*m[7] - m[13]*m[3]*m[6];
+	inv[6] = -m[0]*m[6]*m[15] + m[0]*m[7]*m[14] + m[4]*m[2]*m[15] - m[4]*m[3]*m[14] - m[12]*m[2]*m[7] + m[12]*m[3]*m[6];
+	inv[10] = m[0]*m[5]*m[15] - m[0]*m[7]*m[13] - m[4]*m[1]*m[15] + m[4]*m[3]*m[13] + m[12]*m[1]*m[7] - m[12]*m[3]*m[5];
+	inv[14] = -m[0]*m[5]*m[14] + m[0]*m[6]*m[13] + m[4]*m[1]*m[14] - m[4]*m[2]*m[13] - m[12]*m[1]*m[6] + m[12]*m[2]*m[5];
+	inv[3] = -m[1]*m[6]*m[11] + m[1]*m[7]*m[10] + m[5]*m[2]*m[11] - m[5]*m[3]*m[10] - m[9]*m[2]*m[7] + m[9]*m[3]*m[6];
+	inv[7] = m[0]*m[6]*m[11] - m[0]*m[7]*m[10] - m[4]*m[2]*m[11] + m[4]*m[3]*m[10] + m[8]*m[2]*m[7] - m[8]*m[3]*m[6];
+	inv[11] = -m[0]*m[5]*m[11] + m[0]*m[7]*m[9] + m[4]*m[1]*m[11] - m[4]*m[3]*m[9] - m[8]*m[1]*m[7] + m[8]*m[3]*m[5];
+	inv[15] = m[0]*m[5]*m[10] - m[0]*m[6]*m[9] - m[4]*m[1]*m[10] + m[4]*m[2]*m[9] + m[8]*m[1]*m[6] - m[8]*m[2]*m[5];
+	double det = m[0]*inv[0] + m[1]*inv[4] + m[2]*inv[8] + m[3]*inv[12];
+	if(det == 0.0f) return false;
+	det = 1.0f/det;
+	for(int i = 0; i < 16; i++) out[i] = static_cast<float>(inv[i]*det);
+	return true;
+}
+
+} }
+#endif
diff --git a/src/mtl/mtlgl.h b/src/mtl/mtlgl.h
new file mode 100644
index 0000000..c91170c
--- /dev/null
+++ b/src/mtl/mtlgl.h
@@ -0,0 +1,40 @@
+#pragma once
+// OpenGL 3.3 core subset on top of Metal, for the engine's OpenGL backend (see mtlgl.mm).
+// The backend's own glad loader is fed the entry points from mtlglGetProcAddress, so the rest of the engine
+// keeps calling gl* functions unchanged while the work is done by Metal.
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Creates the Metal device and the layer of the given NSWindow (GLFW window created with GLFW_NO_API).
+// widthPx/heightPx: the framebuffer size in pixels. Returns 0 on failure.
+int mtlglInit(void *nsWindow, int widthPx, int heightPx);
+void mtlglShutdown(void);
+void *mtlglGetProcAddress(const char *name);
+
+// Finishes the frame: draws the default framebuffer to the window and presents it.
+void mtlglPresent(void);
+void mtlglSetVsync(int interval);
+// The size of the default framebuffer changed (window resized / moved to another screen).
+void mtlglResize(int widthPx, int heightPx);
+
+// Native scene MSAA. Resolve colour coverage and select a single nearest-depth surface for motion/reflection tags.
+int mtlglBeginSceneMSAA(unsigned int framebuffer, int samples);
+int mtlglResolveSceneMSAA(unsigned int framebuffer);
+int mtlglSceneMSAASamples(unsigned int framebuffer);
+
+// Interop for the Metal compute passes (ray tracing, MetalFX): the Metal objects behind GL object names.
+void *mtlglDevice(void);
+void *mtlglCommandQueue(void);
+void *mtlglTexture(unsigned int glName);	// id<MTLTexture> (bridged, not retained); creates it when needed
+unsigned int mtlglWrapTexture(void *mtlTexture);	// GL name for an existing id<MTLTexture>
+void mtlglFlush(void);
+float mtlglGpuMs(void);	// GPU time per frame (all command buffers, smoothed)	// ends the current pass and submits the work recorded so far
+
+#ifdef __cplusplus
+}
+#endif
+
+// Query hardware sample counts; never advertise emulated samples as native MSAA.
+extern "C" int mtlglSupportsSamples(int samples);
diff --git a/src/mtl/mtlgl_impl.cpp b/src/mtl/mtlgl_impl.cpp
new file mode 100644
index 0000000..2082623
--- /dev/null
+++ b/src/mtl/mtlgl_impl.cpp
@@ -0,0 +1,2420 @@
+// OpenGL 3.3 core subset implemented on Metal. See mtlgl.h.
+//
+// Conventions (so that the engine's GL code, shaders and render-to-texture passes keep working unchanged):
+//  * every vertex shader gets its clip space y flipped, so a texture's row 0 is GL's bottom row (GL convention) for all targets;
+//    the default framebuffer is an offscreen texture that is flipped once when it is presented
+//  * clip space depth is converted from -1..1 to 0..1 by the translator
+//  * uniform values live in per-program shadow blocks that are uploaded when a draw needs them
+#import <Metal/Metal.h>
+#import <QuartzCore/CAMetalLayer.h>
+#import <Cocoa/Cocoa.h>
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+#include <atomic>
+#include <mutex>
+#include <string>
+#include <vector>
+#include <unordered_map>
+#include <map>
+#include <algorithm>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "../gl/glad/glad.h"
+#include "mtlgl.h"
+#include "mtlshadertrans.h"
+
+#ifndef GL_TEXTURE_RECTANGLE
+#define GL_TEXTURE_RECTANGLE 0x84F5
+#endif
+
+namespace {
+
+using rw::mtl::TransProgram;
+
+static void logf_(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+static void logf_(const char *fmt, ...)
+{
+	va_list ap;
+	va_start(ap, fmt);
+	FILE *f = fopen("metalgl.log", "a");
+	if(f){ vfprintf(f, fmt, ap); fputc('\n', f); fclose(f); }
+	va_end(ap);
+}
+
+static bool dbgOn(void){ static int on = getenv("REGTA_MTLGL_LOG") ? 1 : 0; return on != 0; }
+// per frame statistics (REGTA_MTLGL_LOG): render passes, blits, draws, command buffers, new pipeline states
+struct Stats { int passes, blits, draws, cbs, psos, uploads; } gStats = {}, gStatsSum = {};
+static int gStatFrames = 0, gFrameNo = 0;
+static bool traceFrame(void){ return dbgOn() && gFrameNo == 600; }
+// GPU time per render pass on timed frames (REGTA_MTLGL_LOG, every 240th frame): timestamps at the stage boundaries
+struct PassTime { std::string label; int draws; int first; };
+static std::vector<PassTime> gPassTimes;
+static id<MTLCounterSampleBuffer> gTsBuf = nil;
+static int gTsNext = 0;
+static bool gTimeThisFrame = false;
+static int gCurPassTime = -1;
+
+// ---------------------------------------------------------------------------------------------------------
+// objects
+
+struct Page { id<MTLBuffer> buf; size_t used; size_t size; uint64_t serial; };
+
+struct Buf {
+	id<MTLBuffer> buf = nil;	// current storage (own, or a page of the ring)
+	size_t off = 0;		// offset of the data inside buf
+	size_t size = 0;	// size given by glBufferData
+	size_t valid = 0;	// bytes that hold defined data
+	bool ring = false;	// storage is a slice of the ring (frame lifetime)
+	GLenum usage = GL_STATIC_DRAW;
+};
+
+struct Level { int w = 0, h = 0; std::vector<uint8_t> data; bool has = false; };
+
+struct Tex {
+	GLenum target = GL_TEXTURE_2D;
+	id<MTLTexture> mtl = nil;
+	MTLPixelFormat fmt = MTLPixelFormatInvalid;
+	int w = 0, h = 0;
+	GLenum ifmt = 0;
+	bool compressed = false, depth = false;
+	int maxLevel = 1000;
+	bool genMips = false;
+	std::vector<Level> lv;
+	GLenum minF = GL_NEAREST_MIPMAP_LINEAR, magF = GL_LINEAR, wrapS = GL_REPEAT, wrapT = GL_REPEAT;
+	float aniso = 1.0f;
+	uint64_t lastUse = 0;
+	int created = 0;	// levels of mtl
+	uint32_t sampKey = ~0u; id<MTLSamplerState> samp = nil;	// last sampler state of this texture
+	bool uploaded = false;	// some pixel data reached the Metal texture (or it is a render target)
+	bool warned = false;
+	GLuint name = 0;
+};
+
+struct Rb { id<MTLTexture> mtl = nil; int w = 0, h = 0; GLenum fmt = 0; };
+
+struct Attach { Tex *tex = nullptr; Rb *rb = nullptr; int level = 0; };
+
+struct Fbo {
+	id<MTLTexture> msColor[3] = {}, msDepth = nil;
+	int msSamples = 1;
