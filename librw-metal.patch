+static id<MTLTexture>
+attachTexture(Attach &a)
+{
+	if(a.tex){
+		if(!ensureTex(a.tex)) return nil;
+		a.tex->lastUse = G->serial;
+		a.tex->uploaded = true;
+		return a.tex->mtl;
