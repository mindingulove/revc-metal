+	ENTRY(glEnable), ENTRY(glDisable), ENTRY(glIsEnabled), ENTRY(glEnablei), ENTRY(glDisablei),
+	ENTRY(glBlendFunc), ENTRY(glBlendFuncSeparate), ENTRY(glDepthFunc), ENTRY(glDepthMask), ENTRY(glColorMask), ENTRY(glCullFace),
