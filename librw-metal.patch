+// ---------------------------------------------------------------------------------------------------------
+// command buffer / encoder
+
+static id<MTLCommandBuffer>
+cmd(void)
+{
+	if(!G->cb){
+		G->cb = [G->queue commandBuffer];
+		uint64_t s = G->serial;
+		[G->cb addCompletedHandler:^(id<MTLCommandBuffer> b){
+			// GPU busy time: command buffers can overlap, so only count time not already covered
+			double st = b.GPUStartTime, en = b.GPUEndTime;
+			if(en > st && en - st < 1.0){
+				static std::mutex &m = *new std::mutex;	// never destroyed: completion handlers may still run during exit
+				static double lastEnd = 0.0;
+				std::lock_guard<std::mutex> lk(m);
+				double from = st > lastEnd ? st : lastEnd;
+				if(en > from) G->gpuNs.fetch_add((uint64_t)((en - from)*1e9));
+				if(en > lastEnd) lastEnd = en;
+			}
+			uint64_t cur = G->completed.load();
+			while(cur < s && !G->completed.compare_exchange_weak(cur, s)) {}
+		}];
+	}
+	return G->cb;
+}
+
+static void endEncoder(void);
+static id<MTLBlitCommandEncoder>
+newBlit(void)
+{
+	gStats.blits++;
+	if(traceFrame()) logf_("  blit");
+	return [cmd() blitCommandEncoder];
+}
+
+static void
+endEncoder(void)
+{
+	if(G->enc){
+		if(traceFrame()) logf_("  end pass");
+		[G->enc endEncoding];
+		G->enc = nil;
+	}
+	G->es = Ctx::EncState();
+}
+
+static void
+submit(bool wait)
+{
+	endEncoder();
+	if(G->cb){
+		id<MTLCommandBuffer> cb = G->cb;
+		G->cb = nil;
+		[cb commit];
+		gStats.cbs++;
+		G->serial++;
+		if(wait) [cb waitUntilCompleted];
+	}
+}
