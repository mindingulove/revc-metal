+extern "C" void
+mtlglPresent(void)
+{
+	if(!G) return;
+	@autoreleasepool {
+		flushPending(G->defFbo);
+		endEncoder();
+		captureFrames();
+		id<CAMetalDrawable> dr = [G->layer nextDrawable];
+		if(dr){
+			MTLRenderPassDescriptor *pd = [MTLRenderPassDescriptor renderPassDescriptor];
+			pd.colorAttachments[0].texture = dr.texture;
+			pd.colorAttachments[0].loadAction = MTLLoadActionDontCare;
+			pd.colorAttachments[0].storeAction = MTLStoreActionStore;
+			id<MTLRenderCommandEncoder> enc = [cmd() renderCommandEncoderWithDescriptor:pd];
+			MTLPixelFormat cf[4] = { dr.texture.pixelFormat, MTLPixelFormatInvalid, MTLPixelFormatInvalid, MTLPixelFormatInvalid };
+			MTLColorWriteMask mk[4] = { MTLColorWriteMaskAll, MTLColorWriteMaskNone, MTLColorWriteMaskNone, MTLColorWriteMaskNone };
+			id<MTLRenderPipelineState> pso = utilPso(true, cf, MTLPixelFormatInvalid, mk);
+			if(pso){
+				[enc setRenderPipelineState:pso];
+				[enc setCullMode:MTLCullModeNone];
+				float params[8] = { 0, 0, 1, 1, 0, 0, 0, 0 };
+				[enc setVertexBytes:params length:sizeof(params) atIndex:0];
+				Tex dummy; dummy.minF = dummy.magF = GL_LINEAR; dummy.wrapS = dummy.wrapT = GL_CLAMP_TO_EDGE; dummy.created = 1;
+				[enc setFragmentSamplerState:samplerFor(&dummy) atIndex:0];
+				[enc setFragmentTexture:G->defColor->mtl atIndex:0];
+				[enc drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+			}
+			[enc endEncoding];
+			[cmd() presentDrawable:dr];
+		}
+		if(gTimeThisFrame){
+			submit(true);
+			gTimeThisFrame = false;
+			NSData *d = [gTsBuf resolveCounterRange:NSMakeRange(0, gTsNext)];
+			const MTLCounterResultTimestamp *ts = d ? (const MTLCounterResultTimestamp*)d.bytes : nullptr;
+			if(ts){
+				// GPU timestamp ticks -> ns, from two CPU/GPU timestamp pairs
+				static MTLTimestamp c0 = 0, g0 = 0;
+				MTLTimestamp c1, g1;
+				[G->dev sampleTimestamps:&c1 gpuTimestamp:&g1];
+				double nsPerTick = (g0 && g1 > g0) ? (double)(c1 - c0)/(double)(g1 - g0) : 1.0;
+				c0 = c1; g0 = g1;
+				std::vector<std::pair<double, int>> order;
+				double total = 0;
+				for(size_t i = 0; i < gPassTimes.size(); i++){
+					const MTLCounterResultTimestamp *t = ts + gPassTimes[i].first;
+					uint64_t a = t[0].timestamp, e = t[3].timestamp;
+					if(a == MTLCounterErrorValue || e == MTLCounterErrorValue || e < a){ order.push_back({ -1.0, (int)i }); continue; }
+					double ms = (e - a)*nsPerTick/1e6;
+					total += ms;
+					order.push_back({ ms, (int)i });
+				}
+				std::sort(order.begin(), order.end(), [](const std::pair<double,int> &x, const std::pair<double,int> &y){ return x.first > y.first; });
+				logf_("GPU passes (%zu, sum %.1f ms, ns/tick %.3f):", gPassTimes.size(), total, nsPerTick);
+				for(size_t k = 0; k < order.size() && k < 14; k++)
+					logf_("  %6.2f ms  #%d  %s  draws %d", order[k].first, order[k].second, gPassTimes[order[k].second].label.c_str(), gPassTimes[order[k].second].draws);
+			}
+		}else
+			submit(false);
+		if(dbgOn()){
+			if(!gTsBuf){
+				for(id<MTLCounterSet> cs in G->dev.counterSets) if([cs.name isEqualToString:MTLCommonCounterSetTimestamp]){
+					MTLCounterSampleBufferDescriptor *sd = [MTLCounterSampleBufferDescriptor new];
+					sd.counterSet = cs; sd.storageMode = MTLStorageModeShared; sd.sampleCount = 4096;
+					NSError *e = nil;
+					gTsBuf = [G->dev newCounterSampleBufferWithDescriptor:sd error:&e];
+					if(!gTsBuf) logf_("no timestamp sample buffer: %s", e.localizedDescription.UTF8String);
+				}
+				if(![G->dev supportsCounterSampling:MTLCounterSamplingPointAtStageBoundary]){ logf_("GPU has no stage boundary timestamps"); gTsBuf = nil; }
+			}
+			if(gTsBuf && (gFrameNo % 240) == 239){ gTimeThisFrame = true; gTsNext = 0; gPassTimes.clear(); }
+			if(traceFrame()) logf_("---- end of traced frame %d", gFrameNo);
+			gFrameNo++;
+			if(gFrameNo == 600) logf_("---- trace of frame 600");
+			gStatsSum.passes += gStats.passes; gStatsSum.blits += gStats.blits; gStatsSum.draws += gStats.draws;
+			gStatsSum.cbs += gStats.cbs; gStatsSum.psos += gStats.psos; gStatsSum.uploads += gStats.uploads;
+			gStats = Stats();
+			if(++gStatFrames == 120){
+				logf_("per frame: %.1f passes, %.1f blits, %.0f draws, %.1f command buffers, %.2f new pipelines, %.1f texture creations, GPU %.1f ms",
+				      gStatsSum.passes/120.0, gStatsSum.blits/120.0, gStatsSum.draws/120.0, gStatsSum.cbs/120.0, gStatsSum.psos/120.0, gStatsSum.uploads/120.0, G->gpuMs);
+				gStatsSum = Stats(); gStatFrames = 0;
+			}
+		}
+		{
+			uint64_t now = G->gpuNs.load();
+			float ms = (float)((now - G->gpuNsAtPresent)/1.0e6);
+			G->gpuNsAtPresent = now;
+			G->gpuMs += (ms - G->gpuMs)*0.05f;
+		}
+		// follow the window: a changed backing size means a new default framebuffer
+		NSView *v = G->window.contentView;
+		NSRect b = v.bounds;
+		int nw = (int)(b.size.width*G->pxPerPoint + 0.5), nh = (int)(b.size.height*G->pxPerPoint + 0.5);
+		if(nw > 0 && nh > 0 && (nw != G->fbW || nh != G->fbH)) mtlglResize(nw, nh);
+	}
+}
