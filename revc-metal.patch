+#include "../vendor/librw/src/skinpositions.h"
+#include <vector>
+#include <cassert>
+#include <cstring>
+#include <chrono>
+#include <cstdio>
+int main(){
+ const int n=32768;std::vector<float> in(n*3),weights(n*4,.25f),a(n*3),b(n*3),bones(64*16,0);
+ std::vector<uint8_t> indices(n*4);
+ for(int k=0;k<64;k++){bones[k*16]=bones[k*16+5]=bones[k*16+10]=bones[k*16+15]=1;bones[k*16+12]=k*.01f;}
+ for(int i=0;i<n*3;i++)in[i]=(i%171)*.03f;
+ for(int i=0;i<n*4;i++)indices[i]=i%64;
+ for(int count:{1,8192,16383,16384,n}){
+  assert(rw::skinutil::positions(a.data(),in.data(),count,weights.data(),indices.data(),bones.data(),64));
+  assert(rw::skinutil::positionsParallel(b.data(),in.data(),count,weights.data(),indices.data(),bones.data(),64));
+  assert(memcmp(a.data(),b.data(),count*3*sizeof(float))==0);
+ }
+ auto time=[&](bool parallel,int count){auto t=std::chrono::steady_clock::now();for(int i=0;i<200;i++){
+  if(parallel)rw::skinutil::positionsParallel(b.data(),in.data(),count,weights.data(),indices.data(),bones.data(),64);
+  else rw::skinutil::positions(a.data(),in.data(),count,weights.data(),indices.data(),bones.data(),64);
+ }return std::chrono::duration<double,std::milli>(std::chrono::steady_clock::now()-t).count()/200;};
+ for(int count:{16384,n})for(int pass=0;pass<3;pass++)printf("%d vertices: serial %.3f ms, four jobs %.3f ms\n",count,time(false,count),time(true,count));
+ indices[(n/2)*4]=64;assert(!rw::skinutil::positionsParallel(b.data(),in.data(),n,weights.data(),indices.data(),bones.data(),64));
+ puts("PASS bit-identical serial/parallel skinning, threshold cases and invalid joints.");
+}
