+// -- directories --
+
+OP(opFindFirst)
+{
+	Arg pattern = ReadArg(s);
+	std::string pat = Str(pattern);
+	std::string dir = ".", mask = pat;
+	size_t slash = pat.find_last_of("/\\");
+	if(slash != std::string::npos){ dir = pat.substr(0, slash); mask = pat.substr(slash + 1); }
+	for(char &c : dir) if(c == '\\') c = '/';
+	DIR *d = opendir(dir.c_str());
+	int32_t handle = 0;
+	bool found = false;
+	char name[256] = "";
+	if(d){
+		gFinds.push_back(d);
+		gFindPatterns.push_back(mask);
+		handle = (int32_t)(VA_FIND + (gFinds.size() - 1) * 4);
+		while(struct dirent *e = readdir(d)){
+			if(fnmatch(mask.c_str(), e->d_name, 0) == 0){ strncpy(name, e->d_name, 255); found = true; break; }
+		}
+	}
+	Store(s, found ? handle : -1);
+	Arg out = ReadArg(s);
+	char *b = Buf(out, 1);
+	if(found && b) strcpy(b, name);
+	Flag(s, found);
+	return CONTINUE;
+}
+
+OP(opFindNext)
+{
+	Arg h = ReadArg(s);
+	Arg out = ReadArg(s);
+	uint32_t i = ((uint32_t)h.i - VA_FIND) / 4;
+	bool found = false;
+	if((uint32_t)h.i >= VA_FIND && i < gFinds.size() && gFinds[i]){
+		while(struct dirent *e = readdir(gFinds[i])){
+			if(fnmatch(gFindPatterns[i].c_str(), e->d_name, 0) == 0){
+				char *b = Buf(out, 1);
+				if(b) strcpy(b, e->d_name);
+				found = true;
+				break;
+			}
+		}
+	}
+	Flag(s, found);
+	return CONTINUE;
+}
+
+OP(opFindClose)
+{
+	Arg h = ReadArg(s);
+	uint32_t i = ((uint32_t)h.i - VA_FIND) / 4;
+	if((uint32_t)h.i >= VA_FIND && i < gFinds.size() && gFinds[i]){ closedir(gFinds[i]); gFinds[i] = nullptr; }
+	return CONTINUE;
+}
