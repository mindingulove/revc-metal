+		for (int j = 0; j < NUM_GANGS; ++j) {
+			info.gangThreshold[j] = info.copThreshold;
+			info.gangPedThreshold[j] = 10;
+		}
+		info.pedDensity = 25;
+		info.copPedThreshold = 10;
+		info.pedGroup = 0;
+
+	}
