+#include "StructuralBody.hpp"
+#include <cassert>
+#include <cstdio>
+using namespace structural;
+int main(){
+ Structure s;auto node=[&](Vec rest,Region r){Node n{};n.rest=rest;n.region=r;s.nodes.push_back(n);s.pos.push_back(rest);s.lift.push_back(0);};
+ node({-.8f,0,.3f},CABIN);node({.8f,0,.3f},CABIN);node({0,0,1.2f},ROOF);node({0,0,-.3f},FLOOR);node({0,2,.3f},FRONT);
+ Vec left={-.35f,0,.3f},right={.35f,0,.3f};assert(seatIntrusion(s,left)==0);
+ s.pos[0].x+=.35f;assert(seatIntrusion(s,left)>.34f);assert(seatIntrusion(s,right)<.1f); // side panel consumes seat space
+ s.pos[0]=s.nodes[0].rest;s.pos[0].x-=.35f;assert(seatIntrusion(s,left)==0); // outward dent is not intrusion
+ for(size_t i=0;i<s.pos.size();i++)s.pos[i]=s.nodes[i].rest+Vec{.2f,.3f,-.1f};assert(seatIntrusion(s,left)<1e-6f); // rigid movement
+ for(size_t i=0;i<s.pos.size();i++)s.pos[i]=s.nodes[i].rest;s.pos[2].z-=.4f;assert(seatIntrusion(s,left)>.36f); // crushed roof
+ s.pos[2]=s.nodes[2].rest;s.pos[4].y-=.7f;assert(seatIntrusion(s,left)==0); // bumper crumple does not imply cabin collapse
+ printf("PASS cabin intrusion: side crush, roof collapse, outward dents, rigid movement and front crumple isolation.\n");
+}
diff --git a/tools/test_collision_alt_hook.py b/tools/test_collision_alt_hook.py
new file mode 100644
index 00000000..62a31a01
--- /dev/null
+++ b/tools/test_collision_alt_hook.py
@@ -0,0 +1,89 @@
+"""Compile the actual fixed-world solver and capture wrapper against tiny engine fixtures."""
+from pathlib import Path
+import subprocess
+import tempfile
+root = Path(__file__).resolve().parents[1]
+src = (root / 'src/entities/Physical.cpp').read_text()
+alt = src[src.index('bool\nCPhysical::ApplyCollisionAlt('):src.index('bool\nCPhysical::ApplyFriction(CPhysical *B')]
+speed = src[src.index('CVector\nCPhysical::GetSpeed(const'):src.index('void\nCPhysical::ApplyMoveSpeed(')]
+contact_speed = src[src.index('static CVector\nDentContactSpeed('):src.index('bool\nCPhysical::ApplyCollision(')]
+force = src[src.index('void\nCPhysical::ApplyMoveForce(float'):src.index('void\nCPhysical::ApplyTurnForce(float')]
+fixture = r'''
+#include <cassert>
+#include <cmath>
+#include <cstdio>
+#define GTA_VERSION 0
+#define GTA3_PC_11 1
+#define GRAVITY .008f
+struct CVector {
+ float x{},y{},z{}; CVector()=default; CVector(float a,float b,float c):x(a),y(b),z(c){}
+ CVector operator+(CVector b)const{return {x+b.x,y+b.y,z+b.z};}
+ CVector operator-(CVector b)const{return {x-b.x,y-b.y,z-b.z};}
+ CVector operator*(float b)const{return {x*b,y*b,z*b};}
+ CVector& operator+=(CVector b){x+=b.x;y+=b.y;z+=b.z;return *this;}
+ float MagnitudeSqr()const{return x*x+y*y+z*z;}
+};
+float DotProduct(CVector a,CVector b){return a.x*b.x+a.y*b.y+a.z*b.z;}
+CVector CrossProduct(CVector a,CVector b){return {a.y*b.z-a.z*b.y,a.z*b.x-a.x*b.z,a.x*b.y-a.y*b.x};}
+float Abs(float x){return std::fabs(x);} struct CMatrix{};
+CVector Multiply3x3(CMatrix,CVector p){return p;}
+struct CColPoint{CVector point,normal;};
+struct CEntity{ bool building=true; bool IsBuilding(){return building;} };
+struct CTimer{static float GetTimeStep(){return 1;}};
+struct CPhysical:CEntity {
+ CVector m_vecMoveSpeed,m_vecTurnSpeed,m_vecMoveFriction,m_vecTurnFriction,m_vecCentreOfMass,position;
+ float m_fMass=1500,m_fTurnMass=1500,m_fElasticity=.05f;
+ bool bPedPhysics=false,bHasHitWall=false,bHasContacted=false,bInfiniteMass=false,bIsStuck=false,vehicle=true,isStatic=false;
+ CVector GetPosition(){return position;} CVector GetUp(){return {0,0,1};} CMatrix GetMatrix(){return {};}
+ bool GetIsStatic(){return isStatic;} bool IsObject(){return !vehicle;} bool IsVehicle(){return vehicle;}
+ CVector GetSpeed(const CVector&); void ApplyMoveForce(float,float,float);
+ void ApplyMoveForce(CVector p){ApplyMoveForce(p.x,p.y,p.z);}
+ float GetMass(CVector p,CVector n){return 1/(CrossProduct(p,n).MagnitudeSqr()/m_fTurnMass+1/m_fMass);}
+ bool ApplyCollisionAlt(CEntity*,CColPoint&,float&,CVector&,CVector&);
+ bool ApplyCollisionAlt_Impl(CEntity*,CColPoint&,float&,CVector&,CVector&);
+};
+namespace LocalDent{
+ bool enabled=true; int calls=0; float pre,post,raw;
+ void OnCollisionAlt(CPhysical*,const CColPoint&,float j,float before,float after){++calls;raw=j;pre=before;post=after;}
+}
+'''
+tests = r'''
+bool near(float a,float b){return std::fabs(a-b)<.00001f*(1+std::fabs(b));}
+int main(){
+ CPhysical body; CEntity wall; CColPoint p{{0,0,0},{1,0,0}};
+ CVector move{7,8,9},turn{1,2,3}; float j=0;
+ body.m_vecMoveSpeed={-1,0,0};
+ assert(body.ApplyCollisionAlt(&wall,p,j,move,turn));
+ assert(LocalDent::calls==1&&near(LocalDent::pre,-1)&&near(LocalDent::post,.26f));
+ assert(near(move.x,8.26f)&&near(body.m_vecMoveSpeed.x,-1));
+ // Prior pending responses must not enter this contact's post speed.
+ move={100,200,300};turn={20,30,40}; body.bHasHitWall=true;
+ assert(body.ApplyCollisionAlt(&wall,p,j,move,turn));
+ assert(near(LocalDent::post,.05f)); assert(near(move.x,101.05f));
+ // Off-centre torque contributes to the actual contact normal velocity.
+ move={};turn={};body.bHasHitWall=false;p.point={0,1,0};
+ assert(body.ApplyCollisionAlt(&wall,p,j,move,turn));
+ assert(near(j,787.5f)&&near(turn.z,-.525f)&&near(LocalDent::post,.155f));
+ // A temporarily stuck car still has a live velocity and pending response.
+ body.bIsStuck=true; move={};turn={};p.point={};
+ assert(near(DentContactSpeed(&body,p.point).x,-1));
+ body.isStatic=true;assert(near(DentContactSpeed(&body,p.point).x,0));body.isStatic=false;
+ body.bInfiniteMass=true;assert(near(DentContactSpeed(&body,p.point).x,0));body.bInfiniteMass=false;
+ assert(body.ApplyCollisionAlt(&wall,p,j,move,turn));assert(near(LocalDent::pre,-1));
+ // Ped path changes actual body speed rather than pending output vectors.
+ body.bPedPhysics=true;move={4,5,6};turn={7,8,9};
+ assert(body.ApplyCollisionAlt(&wall,p,j,move,turn));
+ assert(near(LocalDent::pre,-1)&&near(LocalDent::post,0)&&near(body.m_vecMoveSpeed.x,0));
+ assert(near(move.x,4)&&near(turn.z,9));
+ int calls=LocalDent::calls; body.m_vecMoveSpeed={1,0,0};
+ assert(!body.ApplyCollisionAlt(&wall,p,j,move,turn));assert(LocalDent::calls==calls);
+ LocalDent::enabled=false;body.m_vecMoveSpeed={-1,0,0};
+ assert(body.ApplyCollisionAlt(&wall,p,j,move,turn));assert(LocalDent::calls==calls);
+ puts("PASS: actual Alt solver/wrapper pending deltas, vehicle/wall force flags, contact torque, live stuck body, direct-force path, rejection and disabled hook");
+}
+'''
+with tempfile.TemporaryDirectory(prefix='regta-alt-hook-') as d:
+    source=Path(d)/'test.cpp'; binary=Path(d)/'test'
+    source.write_text(fixture+speed+force+contact_speed+alt+tests)
+    subprocess.run(['clang++','-std=c++17','-Wall','-Wextra','-Wno-logical-op-parentheses','-fsanitize=undefined,address',str(source),'-o',str(binary)],check=True)
+    subprocess.run([str(binary)],check=True)
diff --git a/tools/test_collision_energy.cpp b/tools/test_collision_energy.cpp
new file mode 100644
index 00000000..15bde528
--- /dev/null
+++ b/tools/test_collision_energy.cpp
@@ -0,0 +1,68 @@
+#include "CollisionEnergy.hpp"
+#include "DentMath.hpp"
+#include <cassert>
+#include <cstdio>
+#include <limits>
+using namespace dent;
+static bool near(float a,float b) { return std::fabs(a-b)<.001f*std::max(1.f,std::fabs(b)); }
+static CollisionBody car(float mass) { return {mass,1.f/mass,1.f}; }
+static CollisionBody wall() { return {1,0,0}; }
+static void bounds(const CollisionEnergy& r, float ma,float mb,float ja,float jb) {
+    assert(std::isfinite(r.available)&&std::isfinite(r.speedA)&&std::isfinite(r.speedB));
+    assert(r.absorbedA>=0&&r.absorbedB>=0);
+    assert(r.absorbedA+r.absorbedB<=r.available+.01f);
+    assert(r.speedA<=ja/ma+.00001f&&r.speedB<=jb/mb+.00001f);
+}
+int main() {
+    // Independent one-dimensional impulse solver: conserve momentum, then
+    // compare the actual kinetic energy loss to the reduced-mass calculation.
+    for(float ma:{750.f,1500.f,3000.f}) for(float mb:{750.f,1500.f,3000.f})
+    for(float e:{0.f,.05f,.5f,1.f}) {
+        float va=-.8f,vb=.2f,before=va-vb;
+        float j=-(1+e)*before/(1/ma+1/mb);
+        float va2=va+j/ma,vb2=vb-j/mb;
+        assert(near(ma*va+mb*vb,ma*va2+mb*vb2));
+        float actual=.5f*(ma*va*va+mb*vb*vb-ma*va2*va2-mb*vb2*vb2);
+        auto r=collisionEnergy(car(ma),car(mb),before,va2-vb2,j,j);
+        assert(near(r.available,std::max(0.f,actual)));
+        bounds(r,ma,mb,j,j);
+    }
+    auto equal=collisionEnergy(car(1500),car(1500),-1,0,750,750);
+    assert(near(equal.speedA,.5f)&&near(equal.speedB,.5f));
+    assert(near(equal.absorbedA+equal.absorbedB,equal.available));
+    auto unequal=collisionEnergy(car(750),car(3000),-1,0,600,600);
+    assert(unequal.speedA>unequal.speedB); bounds(unequal,750,3000,600,600);
+    // Swap both cars and reverse the normal: severity follows the body.
+    auto swapped=collisionEnergy(car(3000),car(750),-1,0,600,600);
+    assert(near(unequal.speedA,swapped.speedB)&&near(unequal.speedB,swapped.speedA));
+    auto lightWall=collisionEnergy(car(750),wall(),-1,0,750,0);
+    auto heavyWall=collisionEnergy(car(3000),wall(),-1,0,3000,0);
+    assert(near(lightWall.speedA,1)&&near(heavyWall.speedA,1));
+    assert(near(heavyWall.available,4*lightWall.available));
+    assert(lightWall.speedB==0&&near(lightWall.absorbedA,lightWall.available));
+    auto elastic=collisionEnergy(car(1500),wall(),-1,1,3000,0); assert(elastic.available==0);
+    auto fasterAfter=collisionEnergy(car(1500),wall(),-1,1.4f,3000,0); assert(fasterAfter.available==0);
+    // A pure sideswipe has no normal energy regardless of tangential speed.
+    Vec normal{1,0,0}, side{0,20,0};
+    assert(collisionEnergy(car(1500),wall(),dot(side,normal),0,1500,0).available==0);
+    auto glance=collisionEnergy(car(1500),wall(),dot(Vec{-.2f,20,0},normal),0,300,0);
+    assert(near(glance.speedA,.2f)&&glance.available<lightWall.available);
+    // Same-direction traffic uses closing speed, never absolute road speed.
+    auto rear=collisionEnergy(car(1500),car(1500),-.8f-(-.6f),0,150,150);
+    auto slow=collisionEnergy(car(1500),car(1500),-.2f,0,150,150);
+    assert(near(rear.available,slow.available));
+    assert(collisionEnergy(car(1500),car(1500),.2f,0,150,150).available==0);
+    // Off-centre rotation lowers effective mass and available crush work.
+    auto rotation=car(1500); rotation.inverseEffectiveMass*=2;
+    auto offcentre=collisionEnergy(rotation,wall(),-1,0,1500,0);
+    assert(near(offcentre.available,.5f*heavyWall.available/2));
+    assert(offcentre.speedA<1);
+    assert(collisionEnergy(wall(),wall(),-1,0,100,100).available==0);
+    assert(collisionEnergy({0,1,1},wall(),-1,0,100,0).available==0);
+    assert(collisionEnergy(car(1500),wall(),std::numeric_limits<float>::quiet_NaN(),0,100,0).available==0);
+    assert(collisionEnergy(car(1500),wall(),-std::numeric_limits<float>::infinity(),0,100,0).available==0);
+    assert(collisionEnergy(car(1500),wall(),-1.e30f,0,100,0).available==0);
+    auto invalidImpulse=collisionEnergy(car(1500),wall(),-1,0,std::numeric_limits<float>::quiet_NaN(),0);
+    assert(invalidImpulse.speedA==0);
+    puts("PASS: momentum/energy, equal/unequal masses, wall, rotation, glancing, rear-end, elastic, impulse bounds, invalid/static inputs");
+}
diff --git a/tools/test_damage_calibration.cpp b/tools/test_damage_calibration.cpp
new file mode 100644
index 00000000..14440322
--- /dev/null
+++ b/tools/test_damage_calibration.cpp
@@ -0,0 +1,26 @@
+#define main previous_structural_test_main
+#include "test_structural_crumple.cpp"
+#undef main
+float frontal(float deltaKmh)
+{
+ dent::ImpactConfig surface;surface.minImpact=.03f;surface.referenceImpact=.75f;surface.exponent=2.6f;
+ auto frame=surface;frame.referenceImpact=.65f;frame.exponent=2.f;
+ float speed=deltaKmh/3.6f/50.f;
+ auto panel=dent::response(speed*1500,1500,surface),rails=dent::response(speed*1500,1500,frame);
+ structural::Structure s;structural::Params prm;prm.crumpleTravelScale=1.8f;
+ assert(structural::build(s,body(),1500,nullptr,prm));
+ for(unsigned t=0;t<4000;t+=16){
+  if(t<240&&panel.depth>0)structural::drive(s,{0,2.6f,0},{0,-1,0},panel.depth*.6f,panel.radius,.65f,1,t,rails.depth*.6f,rails.radius);
+  structural::step(s,.016f,t);
+ }
+ return -structural::displacement(s,structural::skinFor(s,{0,2.5f,0})).y;
+}
+int main()
+{
+ float low=frontal(10),city=frontal(20),medium=frontal(40),hard=frontal(80);
