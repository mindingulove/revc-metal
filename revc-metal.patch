+static RpAtomic *
+CollectReflectionVehicleAtomic(RpAtomic *atomic, void *data)
+{
+	if(!(RpAtomicGetFlags(atomic) & rpATOMICRENDER)) return atomic;
+	RpAtomicCallBackRender render = RpAtomicGetRenderCallBack(atomic);
+	if(render == CVisibilityPlugins::RenderVehicleReallyLowDetailCB ||
+	   render == CVisibilityPlugins::RenderVehicleReallyLowDetailCB_BigVehicle ||
+	   render == CVisibilityPlugins::RenderVehicleLowDetailCB_BigVehicle ||
+	   render == CVisibilityPlugins::RenderVehicleLowDetailAlphaCB_BigVehicle) return atomic;
