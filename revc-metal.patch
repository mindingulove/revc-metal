+++ b/src/extras/metalfx/MetalRT.cpp
@@ -0,0 +1,1428 @@
+// Objective-C++ (compiled with -x objective-c++, see src/CMakeLists.txt)
+#define GL_SILENCE_DEPRECATION
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#import <IOSurface/IOSurface.h>
+#import <OpenGL/OpenGL.h>
+#import <OpenGL/CGLIOSurface.h>
+#import <OpenGL/gl3.h>
+#include <stdio.h>
+#include <atomic>
+#include <cstdint>
+#include <string.h>
+#include <stdlib.h>
+#include <vector>
+#include <unordered_map>
+#include <unordered_set>
+#include "MetalRT.h"
+#include "src/matrixinvert.h"
+#ifdef RW_METALGL
+#include "src/mtl/mtlgl.h"
+#endif
+
+
+namespace {
+static std::atomic<uint64_t> &lastGpuNs=*new std::atomic<uint64_t>(0);
+
+const char *kernelSource = R"MSL(
+#include <metal_stdlib>
+#include <metal_raytracing>
+using namespace metal;
+using namespace raytracing;
+
+struct Uniforms {
+	float4x4 invVP;
+	packed_float3 skyTop;      float pad0;
+	packed_float3 skyHorizon;  float pad1;
+	packed_float3 ambient;     float pad2;
+	packed_float3 sunDir;      float pad3;
+	packed_float3 sunColor;    float maxDistance;
+	float fogDistance;
+	uint width, height, hasDynamic;
+	packed_float3 toSun; float sunVisibility;
+	float shadowDistance; uint frame; uint pad4, pad5;
+	float4x4 prevVP;	// view-projection of the previous traced frame (history reprojection)
+	uint histValid, pad6, pad7, pad8;
+ packed_float3 camera; uint shaftQuality;
+};
+
+struct RaySurface {
+	device const float2 *uv [[id(0)]];
+	texture2d<float> albedo [[id(1)]];
+	float4 tint [[id(2)]];
+	uint flags [[id(3)]]; // bit 0 texture, remaining bits: primary/secondary vehicle paint
+};
+
+kernel void traceReflections(
+	texture2d<float, access::read> depthTex [[texture(0)]],
+	texture2d<float, access::read> dirTex [[texture(1)]],
+	texture2d<float, access::write> outTex [[texture(2)]],
+	texture2d<float, access::read> sceneColour [[texture(3)]],
+	texture2d<float, access::read> sceneDepth [[texture(4)]],
+	texture2d<float, access::read> sceneVelocity [[texture(5)]],
+	instance_acceleration_structure staticScene [[buffer(0)]],
+	instance_acceleration_structure dynamicScene [[buffer(1)]],
+	constant Uniforms &u [[buffer(2)]],
+	constant float4 *colours [[buffer(3)]],
+	constant uint *firstColour [[buffer(4)]],
+	constant uint4 *staticGeom [[buffer(5)]],
+	constant uint4 *dynamicGeom [[buffer(6)]],
+	constant RaySurface *surfaces [[buffer(8)]],
+	uint2 gid [[thread_position_in_grid]])
+{
+	if(gid.x >= u.width || gid.y >= u.height) return;
+	float4 rd = dirTex.read(gid);
+	if(u.pad0 > 1.5f){ outTex.write(float4(0.25f, 0.5f, 0.75f, 1.0f), gid); return; }
+	if(u.pad0 > 0.5f){ outTex.write(float4(depthTex.read(gid).r, rd.z, rd.w, 1.0f), gid); return; }
+	if(rd.w <= 0.001f || dot(rd.xyz, rd.xyz) < 0.01f){
+		outTex.write(float4(0.0f), gid);
+		return;
+	}
+	float depth = depthTex.read(gid).r;
+	float2 uv = depthTex.read(gid).gb;
+	if(u.pad6 != 0){
+		uint2 receiverPixel = min(uint2(uv*float2(sceneVelocity.get_width(), sceneVelocity.get_height())),
+		                         uint2(sceneVelocity.get_width()-1, sceneVelocity.get_height()-1));
+		float paneDepth = sceneVelocity.read(receiverPixel).a;
+		if(paneDepth < 0.0f && paneDepth >= -1.0f) depth = -paneDepth;
+	}
+	float4 w = u.invVP*float4(uv*2.0f - 1.0f, depth*2.0f - 1.0f, 1.0f);
+	float3 pos = w.xyz/w.w;
+	float3 dir = normalize(rd.xyz);
+
+	ray r;
+	r.origin = pos + dir*0.12f;
+	r.direction = dir;
+	r.min_distance = 0.02f;
+	r.max_distance = u.maxDistance;
+
+	intersector<triangle_data, instancing> inter;
+	inter.assume_geometry_type(geometry_type::triangle);
+	auto hs = inter.intersect(r, staticScene, 0x01);
+	float best = u.maxDistance;
+	bool hit = false;
+	float hitKind = 0.0f;
+	uint material=0,primitive=0;float2 bary=float2(0.0f);uint2 paint=uint2(0);
+	float3 albedo = float3(0.0f);
+	float3 prelit = float3(0.4f);
+	if(hs.type == intersection_type::triangle){
+		hit = true;
+		hitKind = 1.0f;
+		best = hs.distance;
+		uint g = staticGeom[hs.instance_id].x;
+		material=firstColour[g]+hs.geometry_id;primitive=hs.primitive_id;bary=hs.triangle_barycentric_coord;
+		albedo = colours[(firstColour[g] + hs.geometry_id)*2].rgb;
+		prelit = colours[(firstColour[g] + hs.geometry_id)*2 + 1].rgb;
+	}
+	if(u.hasDynamic != 0){
+		uint receiver = uint(round(depthTex.read(gid).a));
+		auto hd = inter.intersect(r, dynamicScene, 0x01);
+		// Smooth panel normals can send rays through the shell. Ignore every part of the
+		// receiving vehicle, including seats and opposite panels, without hiding other cars.
+		while(hd.type == intersection_type::triangle && receiver != 0 && dynamicGeom[hd.instance_id].y == receiver){
+			float next = hd.distance + max(0.0001f, hd.distance*0.000001f);
+			if(next >= best){ hd.type = intersection_type::none; break; }
+			r.min_distance = next;
+			hd = inter.intersect(r, dynamicScene, 0x01);
+		}
+		if(hd.type == intersection_type::triangle && hd.distance < best){
+			hit = true;
+			hitKind = dynamicGeom[hd.instance_id].y != 0 ? 2.0f : 3.0f;
+			best = hd.distance;
+			uint g = dynamicGeom[hd.instance_id].x;
+			material=firstColour[g]+hd.geometry_id;primitive=hd.primitive_id;bary=hd.triangle_barycentric_coord;paint=dynamicGeom[hd.instance_id].zw;
+			albedo = colours[(firstColour[g] + hd.geometry_id)*2].rgb;
+			prelit = colours[(firstColour[g] + hd.geometry_id)*2 + 1].rgb;
+		}
+	}
+
+	bool textured=false;
+	if(hit && u.pad7!=0){
+		constant RaySurface &surface=surfaces[material];
+		uint channel=surface.flags>>1;
+		if((surface.flags&1u)!=0){
+			float2 uv=surface.uv[primitive*3]*(1.0f-bary.x-bary.y)+surface.uv[primitive*3+1]*bary.x+surface.uv[primitive*3+2]*bary.y;
+			constexpr sampler linearRepeat(coord::normalized,address::repeat,filter::linear,mip_filter::linear);
+			float lod=max(0.0f,log2(max(best,1.0f)*0.02f));
+			albedo=surface.albedo.sample(linearRepeat,float2(uv.x,1.0f-uv.y),level(lod)).rgb*surface.tint.rgb;
+			textured=true;
+		}
+		uint packed=channel==1 ? paint.x : channel==2 ? paint.y : 0u;
+		if(packed!=0u){
+			float3 tint=float3(packed&255u,(packed>>8)&255u,(packed>>16)&255u)/255.0f;
+			albedo=(textured ? albedo : float3(1.0f))*tint;
+			textured=true;
+		}
+	}
+
+	float3 col;
+	float t = saturate(dir.z*1.6f);
+	float3 sky = max(mix(u.skyHorizon, u.skyTop, t), float3(0.14f));
+	if(hit){
+		// the game lights a surface as texture x (prelit vertex colour + ambient + sun): mimic that
+		// dark windows and black textures must not give black holes in a reflection: lift the albedo
+		if(!textured) albedo = max(albedo, float3(0.16f));
+		float3 lit = albedo*clamp(prelit + u.ambient*0.6f + u.sunColor*0.15f, 0.3f, 1.0f);
+		float f = saturate(best/u.fogDistance);
+		col = mix(lit, u.skyHorizon, f*f);
+	}else{
+		col = sky;
+	}
+	// Shade visible ray hits from the current frame's textured surface. Geometry still
+	// chooses the hit; the depth check rejects foreground occluders and offscreen hits
+	// retain their material fallback. No previous-frame lookup or history trails.
+	if(hit && !textured && u.pad8 != 0){
+		float3 hitPoint=r.origin+r.direction*best;
+		float4 hp=u.prevVP*float4(hitPoint,1.0f); // current VP for this kernel; shadows receive their own previous VP
+		if(hp.w>0.0f){
+			float2 uv=hp.xy/hp.w*0.5f+0.5f;
+			if(all(uv>=float2(0.0f)) && all(uv<=float2(1.0f))){
+				uint2 size=uint2(sceneDepth.get_width(),sceneDepth.get_height());
+				float2 pixel=uv*float2(size)-0.5f;
+				int2 base=int2(floor(pixel));float2 fraction=fract(pixel);
+				float3 surface=float3(0.0f);float weight=0.0f;
+				for(int y=0;y<2;y++) for(int x=0;x<2;x++){
+					int2 q=clamp(base+int2(x,y),int2(0),int2(size)-1);
+					float z=sceneDepth.read(uint2(q)).r;
+					float2 sampleUV=(float2(q)+0.5f)/float2(size);
+					float4 world=u.invVP*float4(sampleUV*2.0f-1.0f,z*2.0f-1.0f,1.0f);
+					float tolerance=0.10f+0.002f*length(hitPoint-pos);
+					if(z<0.99999f && distance(world.xyz/world.w,hitPoint)<tolerance){
+						float w=(x?fraction.x:1.0f-fraction.x)*(y?fraction.y:1.0f-fraction.y);
+						surface+=sceneColour.read(uint2(q)).rgb*w;weight+=w;
+					}
+				}
+				if(weight>0.01f) col=surface/weight;
+			}
+		}
+	}
+	if(!textured) col = max(col, float3(0.09f));
+	outTex.write(float4(col, u.pad3 > 0.5f ? hitKind : 1.0f), gid);
+}
+
+float3 worldPos(constant Uniforms &u, texture2d<float, access::read> depthTex, int2 p, float depth)
+{
+	// Depth belongs to the selected full-resolution sample, not the centre of its reduced block.
+	float2 uv = depthTex.read(uint2(p)).gb;
+	float4 w = u.invVP*float4(uv*2.0f - 1.0f, depth*2.0f - 1.0f, 1.0f);
+	return w.xyz/w.w;
+}
+
+float hashNoise(uint2 p, uint frame)
+{
+	// PCG style integer hash: no visible structure (the old gradient noise drew parallel lines into occlusion and shadows)
+	uint v = p.x*1973u + p.y*9277u + frame*26699u;
+	v = v*747796405u + 2891336453u;
+	v = ((v >> ((v >> 28u) + 4u)) ^ v)*277803737u;
+	v = (v >> 22u) ^ v;
+	return float(v)*(1.0f/4294967296.0f);
+}
+
+
+// Single scattering in a bounded homogeneous haze. Direction convention: viewDir points
+// away from the camera, toSun points toward the light (forward scattering peaks when equal).
+// HG phase and Beer transmittance: pbr-book.org/4ed/Volume_Scattering.
+kernel void traceSunShafts(
+ texture2d<float, access::read> depthTex [[texture(0)]],
+ texture2d<float, access::write> volumeTex [[texture(1)]],
+ instance_acceleration_structure staticScene [[buffer(0)]],
+ instance_acceleration_structure dynamicScene [[buffer(1)]],
+ constant Uniforms &u [[buffer(2)]], uint2 gid [[thread_position_in_grid]])
+{
+ if(gid.x >= volumeTex.get_width() || gid.y >= volumeTex.get_height()) return;
+ if(u.shaftQuality == 0 || u.sunVisibility <= 0.01f || u.toSun.z <= 0.0f){
+  volumeTex.write(float4(0),gid); return;
+ }
+ uint2 p=min(gid*4u+2u,uint2(u.width-1,u.height-1));
+ float depth=depthTex.read(p).r;
+ float3 end=worldPos(u,depthTex,int2(p),min(depth,0.9999f));
+ float3 delta=end-float3(u.camera);
+ float distance=length(delta);
+ if(!isfinite(distance) || distance < 0.001f){volumeTex.write(float4(0),gid);return;}
+ float3 viewDir=delta/distance;
+ float limit=depth >= 0.99999f ? 140.0f : min(distance,140.0f);
+ uint steps=u.shaftQuality == 1 ? 8u : (u.shaftQuality == 2 ? 16u : 32u);
+ float ds=limit/float(steps), sigma=0.0009f;
+ float g=0.55f, mu=clamp(dot(viewDir,normalize(float3(u.toSun))),-1.0f,1.0f);
+ float denom=1.0f+g*g-2.0f*g*mu;
+ float phase=(1.0f-g*g)/(12.5663706f*denom*sqrt(denom));
+ intersector<triangle_data, instancing> inter;
+ inter.assume_geometry_type(geometry_type::triangle); inter.accept_any_intersection(true);
+ float scattering=0.0f, transmission=1.0f;
+ float stepTransmission=exp(-sigma*ds), stepScattering=1.0f-stepTransmission;
+ for(uint k=0;k<steps;k++){
+  ray r;
+  r.origin=float3(u.camera)+viewDir*((float(k)+0.5f)*ds);
+  r.direction=normalize(float3(u.toSun)); r.min_distance=0.03f; r.max_distance=250.0f;
+  bool blocked=inter.intersect(r,staticScene,0x04).type == intersection_type::triangle;
+  if(!blocked && u.hasDynamic) blocked=inter.intersect(r,dynamicScene,0x04).type == intersection_type::triangle;
+  if(!blocked) scattering += transmission*stepScattering;
+  transmission *= stepTransmission;
+ }
+ float opacity=1.0f-exp(-sigma*limit);
+ float3 light=max(float3(u.sunColor),0.0f)*clamp(u.sunVisibility,0.0f,1.0f)*phase*scattering;
+ volumeTex.write(float4(light,opacity),gid);
+}
+
+kernel void traceShadows(
+	texture2d<float, access::read> depthTex [[texture(0)]],
+	texture2d<float, access::write> shadowTex [[texture(1)]],
+	texture2d<float, access::write> lightTex [[texture(2)]],
+	instance_acceleration_structure staticScene [[buffer(0)]],
+	instance_acceleration_structure dynamicScene [[buffer(1)]],
+	constant Uniforms &u [[buffer(2)]],
+	constant float4 *colours [[buffer(3)]],
+	constant uint *firstColour [[buffer(4)]],
+	constant uint4 *staticGeom [[buffer(5)]],
+	constant uint4 *dynamicGeom [[buffer(6)]],
+	constant float4 *lights [[buffer(7)]],
+	texture2d<float, access::read> histIn [[texture(3)]],
+	texture2d<float, access::write> histOut [[texture(4)]],
+	texture2d<float, access::read> posIn [[texture(5)]],
+	texture2d<float, access::write> posOut [[texture(6)]],
+	uint2 gid [[thread_position_in_grid]])
+{
+	if(gid.x >= u.width || gid.y >= u.height) return;
+	float depth = depthTex.read(gid).r;
+	if(depth >= 0.99999f){
+		shadowTex.write(float4(0.0f), gid);lightTex.write(float4(0.0f), gid);
+		histOut.write(float4(0.0f), gid);posOut.write(float4(0.0f), gid);return;
+	}
+	int2 p = int2(gid);
+	int2 px = int2(min(p.x + 1, int(u.width) - 1), p.y);
+	int2 py = int2(p.x, min(p.y + 1, int(u.height) - 1));
+	int2 mx = int2(max(p.x - 1, 0), p.y);
+	int2 my = int2(p.x, max(p.y - 1, 0));
+	float3 P = worldPos(u, depthTex, p, depth);
+	// screen space normal from the neighbour with the smaller depth step on each axis (avoids creases at edges)
+	float dX1 = depthTex.read(uint2(px)).r, dX0 = depthTex.read(uint2(mx)).r;
+	float dY1 = depthTex.read(uint2(py)).r, dY0 = depthTex.read(uint2(my)).r;
+	float3 ex = abs(dX1 - depth) < abs(dX0 - depth) ? worldPos(u, depthTex, px, dX1) - P : P - worldPos(u, depthTex, mx, dX0);
+	float3 ey = abs(dY1 - depth) < abs(dY0 - depth) ? worldPos(u, depthTex, py, dY1) - P : P - worldPos(u, depthTex, my, dY0);
+	float3 N = cross(ex, ey);
+	float nl = length(N);
+	if(nl < 1e-9f){
+		shadowTex.write(float4(0.0f), gid);lightTex.write(float4(0.0f), gid);
+		histOut.write(float4(0.0f), gid);posOut.write(float4(0.0f), gid);return;
+	}
+	N /= nl;
+	float4 c4 = u.invVP*float4(0.0f, 0.0f, -1.0f, 1.0f);
+	float3 cam = c4.xyz/c4.w;
+	float3 toCam = cam - P;
+	float dist = length(toCam);
+	if(dot(N, toCam) < 0.0f) N = -N;
+	intersector<triangle_data, instancing> inter;
+	inter.assume_geometry_type(geometry_type::triangle);
+	inter.accept_any_intersection(true);
+	// b: ground under a roof (tunnels, bridges, porches) gets no rain. Three rays straight up, a metre apart: all must hit,
+	// so a power line or a thin sign over the road does not count as a roof.
+	float cover = 0.0f;
+	if((u.pad4 & 2u) != 0 && N.z > 0.5f && dist < 160.0f){
+		cover = 1.0f;
+		const float2 offs[3] = { float2(0.0f, 0.7f), float2(0.61f, -0.35f), float2(-0.61f, -0.35f) };
+		for(int k = 0; k < 3 && cover > 0.0f; k++){
+			ray ur;
+			ur.origin = P + N*(0.08f + 0.002f*dist) + float3(offs[k], 0.0f);
+			ur.direction = float3(0.0f, 0.0f, 1.0f);
+			ur.min_distance = 0.05f;
+			ur.max_distance = 60.0f;
+			if(inter.intersect(ur, staticScene, 0x02).type != intersection_type::triangle) cover = 0.0f;
+		}
+	}
+	// a: ambient occlusion for the whole world. Two short rays into the hemisphere around the normal (cosine weighted, new
+	// directions every frame); the composite pass blurs them and the temporal upscaler averages the rest.
+	float ao = 0.0f;
+	if((u.pad4 & 4u) != 0 && dist < 80.0f){
+		float3 t1 = normalize(cross(N, abs(N.z) < 0.9f ? float3(0, 0, 1) : float3(1, 0, 0)));
+		float3 t2 = cross(N, t1);
+		float len = 1.0f + 0.008f*dist;
+		for(int k = 0; k < 1; k++){	// one ray: the blur and the temporal upscaler average the noise
+			// cosine weighted, but at least ~25 degrees off the surface: the normal rebuilt from depth is a few degrees off,
+			// and grazing rays hit the very wall they start on (dark dots crawling over flat walls)
+			// per pixel random start, then a golden ratio walk over the frames: the accumulated average converges much faster
+			// than with fresh random numbers each frame (less shimmer)
+			// interleaved sampling: the 16 pixels of each 4x4 tile take 16 different directions of a stratified set (rotated a
+			// little every frame), and the depth aware blur of the composite averages a tile: smooth instead of per-pixel grain
+			uint cell = ((gid.x & 3u) + ((gid.y & 3u) << 2u) + u.frame*7u) & 15u;
+			float jr = fract(float(u.frame)*0.6180340f), jp = fract(float(u.frame)*0.7548777f);
+			float r1 = ((float(cell & 3u) + jr)*0.25f)*0.82f;
+			float r2 = (float(cell >> 2u) + jp)*0.25f;
+			float rr = sqrt(r1), ph = 6.2831853f*r2;
+			float3 d = normalize(t1*(rr*cos(ph)) + t2*(rr*sin(ph)) + N*sqrt(max(1.0f - r1, 0.0f)));
+			ray ar;
+			ar.origin = P + (toCam/dist)*(0.08f + 0.006f*dist) + N*(0.10f + 0.004f*dist);
+			ar.direction = d;
+			ar.min_distance = 0.08f;
+			ar.max_distance = len;
+			// the map only: cars move, so occlusion from them never settles and showed as a noisy dark bubble around them
+			// (they keep their traced sun shadow)
+			bool hit = inter.intersect(ar, staticScene, 0x02).type == intersection_type::triangle;
+			if(hit) ao += 1.0f;
+		}
+		ao *= 1.0f - smoothstep(50.0f, 80.0f, dist);
+	}
+	// LIGHT: extra light that the game does not have
+	float3 extra = float3(0.0f);
+	float3 gi = float3(0.0f);
+	bool giTraced = false;
+	// one bounce of indirect light (sunlit walls light the street, colours bleed): one ray per pixel on alternate pixels
+	// (checkerboard that swaps every frame), the hit surface is lit like the reflections light it, and its sunlight is traced
+	if((u.pad4 & 8u) != 0 && dist < 100.0f && ((gid.x & 1u) + (gid.y & 1u)*2u) == (u.frame & 3u)){	// one pixel of each 2x2 per frame
+		giTraced = true;
+		float3 t1 = normalize(cross(N, abs(N.z) < 0.9f ? float3(0, 0, 1) : float3(1, 0, 0)));
+		float3 t2 = cross(N, t1);
+		uint walk = u.frame >> 2;	// this pixel traces every fourth frame
+		float r1 = fract(hashNoise(gid + uint2(11u, 59u), 0u) + float(walk)*0.6180340f)*0.82f;
+		float r2 = fract(hashNoise(gid + uint2(73u, 7u), 0u) + float(walk)*0.7548777f);
+		float rr = sqrt(r1), ph = 6.2831853f*r2;
+		float3 d = normalize(t1*(rr*cos(ph)) + t2*(rr*sin(ph)) + N*sqrt(max(1.0f - r1, 0.0f)));
+		ray gr;
+		gr.origin = P + (toCam/dist)*(0.08f + 0.006f*dist) + N*(0.10f + 0.004f*dist);
+		gr.direction = d;
+		gr.min_distance = 0.08f;
+		gr.max_distance = 10.0f;
+		intersector<triangle_data, instancing> near;
+		near.assume_geometry_type(geometry_type::triangle);
+		auto hs = near.intersect(gr, staticScene, 0x01);
+		bool hit = false; float best = gr.max_distance; float3 albedo = float3(0.0f), prelit = float3(0.0f);
+		if(hs.type == intersection_type::triangle){
+			hit = true; best = hs.distance;
+			uint g = staticGeom[hs.instance_id].x;
+			albedo = colours[(firstColour[g] + hs.geometry_id)*2].rgb;
+			prelit = colours[(firstColour[g] + hs.geometry_id)*2 + 1].rgb;
+		}
+		if(hit){
+			float sunlit = 0.0f;
+			if(u.sunVisibility > 0.05f){
+				ray sr2;
+				sr2.origin = gr.origin + d*(best - 0.08f);
+				sr2.direction = float3(u.toSun);
+				sr2.min_distance = 0.05f;
+				sr2.max_distance = 60.0f;
+				sunlit = inter.intersect(sr2, staticScene, 0x02).type == intersection_type::triangle ? 0.0f : u.sunVisibility;
+			}
+			float3 radiance = albedo*(prelit*0.35f + float3(u.ambient)*0.25f + float3(u.sunColor)*sunlit*0.7f);
+			gi = radiance*(1.0f - smoothstep(5.0f, 10.0f, best));
+		}
+	}
+	// Occlusion and indirect light are noisy (one ray, a quarter of the pixels): accumulate them over frames. The map does not
+	// move, so last frame's value is found by projecting this point with last frame's camera; where that pixel showed a
+	// different surface (disocclusion, moving things) start again.
+	float histSun = 0.0f, histSunWeight = 0.0f;
+	bool histOK = false;
+	{
+		float4 hist = float4(0.0f);
+		bool valid = false;
+		if(u.histValid != 0){
+			float4 hp = u.prevVP*float4(P, 1.0f);
+			if(hp.w > 0.0f){
+				float2 puv = (hp.xy/hp.w)*0.5f + 0.5f;
+				int2 q0 = int2(puv*float2(u.width, u.height));
+				// the camera jitters every frame (temporal anti-aliasing): at the edge of an object a pixel shows the object one
+				// frame and the wall behind it the next. Take the history texel around the projected spot that saw this same
+				// point, not just the nearest one, or the edges never settle.
+				// Ground seen at a grazing angle: one pixel spans a metre or more of floor, so the texel next door is far away
+				// in metres although it is the same flat surface. Judge the distance off the plane strictly and the distance
+				// along it by the size of a pixel on that plane (it failed there before and the floor never accumulated).
+				float tolN = 0.06f + 0.004f*dist;
+				float facing = max(abs(dot(N, toCam/dist)), 0.06f);
+				float tolT = (0.12f + 0.012f*dist)/facing;
+				float bestD = 2.0f;
+				for(int oy = -1; oy <= 1; oy++)
+				for(int ox = -1; ox <= 1; ox++){
+					int2 q = q0 + int2(ox, oy);
+					if(q.x < 0 || q.y < 0 || q.x >= int(u.width) || q.y >= int(u.height)) continue;
+					float4 hpos = posIn.read(uint2(q));
+					if(hpos.w < 0.5f) continue;
+					float3 dv = hpos.xyz - P;
+					float dn = abs(dot(dv, N));
+					float dt = length(dv - N*dot(dv, N));
+					float dd = dn/tolN + dt/tolT;
+					if(dn < tolN && dt < tolT){
+						if(dd < bestD){ bestD = dd; hist = histIn.read(uint2(q)); valid = true; }
+						// Sun shadows must interpolate history. Choosing a single nearest surface
+						// sample snaps between lit/shadowed texels as the camera jitter changes.
+						// Project its actual position: reduced depth samples need not be at texel centres.
+						float4 sp = u.prevVP*float4(hpos.xyz, 1.0f);
+						if(sp.w > 0.0f){
+							float2 suv = (sp.xy/sp.w)*0.5f + 0.5f;
+							float2 d = abs((suv - puv)*float2(u.width, u.height));
+							float2 tent = max(1.0f - d, 0.0f);
+							float weight = tent.x*tent.y;
+							histSun += (hpos.w - 1.0f)*weight;
+							histSunWeight += weight;
+						}
+					}
+				}
+			}
+		}
+		histOK = histSunWeight > 1e-4f;
+		if(histOK) histSun /= histSunWeight;
+		float aoAcc = valid ? mix(hist.a, ao, 0.06f) : ao;
+		float3 giAcc = valid ? (giTraced ? mix(hist.rgb, gi, 0.15f) : hist.rgb) : gi;
+		histOut.write(float4(giAcc, aoAcc), gid);
+		ao = aoAcc;
+		extra += giAcc*u.pad1;
+	}
+	// street, vehicle and fire lights, each with a traced shadow (the first two that reach this point)
+	if((u.pad4 & 16u) != 0){
+		int rays = 0;
+		for(uint i = 0; i < u.pad5; i++){
+			float4 a = lights[i*2], b = lights[i*2 + 1];
+			float3 dl = a.xyz - P;
+			// Reject lights outside their influence before square root/normalization.
+			float dd2 = dot(dl, dl);
+			if(a.w <= 0.0f || dd2 >= a.w*a.w || dd2 < 0.0025f || dot(N, dl) <= 0.0f) continue;
+			float dd = sqrt(dd2);
+			float3 l = dl/dd;
+			float nl2 = dot(N, l);
+			float att = 1.0f - dd/a.w; att *= att;
+			float c = att*nl2*b.w;
+			if(c < 0.01f) continue;
+			bool vis = true;
+			if(rays < 2){
+				rays++;
+				ray lr;
+				lr.origin = P + N*(0.10f + 0.004f*dist) + (toCam/dist)*(0.08f + 0.006f*dist);
+				lr.direction = l;
+				lr.min_distance = 0.05f;
+				lr.max_distance = max(dd - 0.5f, 0.06f);	// stop short of the lamp model itself
+				vis = inter.intersect(lr, staticScene, 0x02).type != intersection_type::triangle;
+				if(vis && u.hasDynamic != 0) vis = inter.intersect(lr, dynamicScene, 0x02).type != intersection_type::triangle;
+			}
+			if(vis) extra += b.rgb*c*u.pad2;
+		}
+	}
+	lightTex.write(float4(extra, 1.0f), gid);
+
+	float3 L = float3(u.toSun);
+	float ndl = dot(N, L);
+	// grazing surfaces: the normal rebuilt from depth is too noisy there and they are barely lit anyway
+	// pos.w = 1 + accumulated static sun shadow, reprojected with surface-checked interpolation
+	if((u.pad4 & 1u) == 0 || ndl < 0.18f || dist > u.shadowDistance){
+		float sAcc = histOK ? mix(histSun, 0.0f, 0.2f) : 0.0f;
+		posOut.write(float4(P, 1.0f + sAcc), gid);
+		shadowTex.write(float4(sAcc, 0.0f, cover, ao), gid);
+		return;
+	}
+
+	// small cone around the sun (soft edge): per pixel random start, then a golden ratio walk over the frames like the
+	// occlusion rays (fresh random numbers every frame kept the accumulated edge crawling)
+	float a = fract(hashNoise(gid + uint2(3u, 29u), 0u) + float(u.frame)*0.7548777f)*6.2831853f;
+	// no random cone: shadows of props (poles, pipes, signs are movable objects, so they are not averaged over frames) had
+	// edges that flickered every frame. One ray straight at the sun is stable; the composite blur softens the edge.
+	float r = 0.0f*sqrt(fract(hashNoise(gid + uint2(7u, 13u), 0u) + float(u.frame)*0.5698403f));
+	float3 t1 = normalize(cross(L, abs(L.z) < 0.9f ? float3(0, 0, 1) : float3(1, 0, 0)));
+	float3 t2 = cross(L, t1);
+	float3 dir = normalize(L + (t1*cos(a) + t2*sin(a))*r);
+
+	ray sr;
+	// start in front of the visible surface (towards the camera): depth reconstruction is only accurate to a few centimetres
+	sr.origin = P + (toCam/dist)*(0.14f + 0.008f*dist) + N*(0.06f + 0.003f*dist) + L*0.04f;
+	sr.direction = dir;
+	sr.min_distance = 0.02f + 0.002f*dist;
+	sr.max_distance = u.shadowDistance;
+	// two channels: r = blocked by the static map (does not move: the ground can take this one from last frame), g = blocked by
+	// cars, props and other dynamic things (must be current, or the shadow trails behind its car)
+	bool hitStatic = inter.intersect(sr, staticScene, 0x02).type == intersection_type::triangle;
+	bool hitDynamic = false;
+	if(u.hasDynamic != 0){
+		// Wheel contact shadows need millimetre/centimetre offsets. The map's large camera bias
+		// moves rays past the tire contact and leaves a bright unshadowed outline.
+		ray contactRay=sr;
+		contactRay.origin=P+(toCam/dist)*(0.005f+0.0005f*dist)+N*(0.01f+0.0003f*dist)+L*0.005f;
+		contactRay.min_distance=0.003f;
+		hitDynamic = inter.intersect(contactRay, dynamicScene, 0x02).type == intersection_type::triangle;
+	}
+	float f = smoothstep(0.18f, 0.45f, ndl);
+	float sNow = hitStatic ? f : 0.0f;
+	float sAcc = histOK ? mix(histSun, sNow, 0.1f) : sNow;
+	posOut.write(float4(P, 1.0f + sAcc), gid);
+	shadowTex.write(float4(sAcc, hitDynamic ? f : 0.0f, cover, ao), gid);
+}
+)MSL";
+
+struct StaticInst { int geom; float m[16]; uint32_t lastSeen; };
+struct DynInst { int geom; float m[16]; uint32_t owner = 0, primary = 0, secondary = 0; };
+struct RaySurfaceCPU { id<MTLBuffer> uv=nil; id<MTLTexture> albedo=nil; float tint[4]={1,1,1,1}; uint32_t flags=0; };
+
+struct AnimatedGeom {
+	uintptr_t key = 0;
+	int id = -1;
+	uint32_t frame = 0;
+	uint64_t topology = 0;
+	MTLPrimitiveAccelerationStructureDescriptor *descriptor = nil;
+};
+
+struct State {
+	id<MTLDevice> device;
+	id<MTLCommandQueue> queue;
+	id<MTLComputePipelineState> pipeline, shadowPipeline, shaftPipeline;
+	IOSurfaceRef surface[MRT_NUM_TEXTURES];
+	id<MTLTexture> tex[MRT_NUM_TEXTURES];
+	GLuint gl[MRT_NUM_TEXTURES];
+	std::vector<float> lights;	// 8 floats per light, set every frame
+	id<MTLTexture> sceneColour, sceneDepth, sceneVelocity;
+	id<MTLArgumentEncoder> surfaceEncoder;
+	id<MTLBuffer> surfaceBuffer;
+	std::vector<RaySurfaceCPU> surfaces;
+	std::vector<id<MTLResource>> surfaceResources; // Same immutable residency set as surfaceBuffer.
+	std::vector<uint32_t> dirtySurfaces;
+	std::unordered_map<int,uintptr_t> surfaceRevision;
+	size_t surfaceBytes=0;
+	id<MTLTexture> hist[2], pos[2];	// accumulated occlusion/indirect light and the world position it belongs to (ping-pong)
+	float prevVP[16];
+	bool histValid;
+	int width, height;
+
+	std::vector<id<MTLAccelerationStructure>> blas;
+	std::vector<AnimatedGeom> animated;
+	std::vector<uint32_t> firstColour;
+	struct GeometryAS { int first, second, volume; GeometryAS(int a=-1,int b=-1,int c=-1):first(a),second(b),volume(c){} };
+	std::vector<GeometryAS> geoms;	// geometry id -> main acceleration structure, shadow-only structure (-1 if none)
+	std::vector<int> dynamicOrder;
+ uint32_t lastDynamicBuild=0; uint64_t dynamicBuilds=0,dynamicRefits=0;
+ std::vector<int> staticUsed, dynamicUsed;	// bottom-level structures the scenes reference (the only ones that must be resident)
+	bool replaceColourBuffer; // changing a recycled actor must not overwrite colours still read by an in-flight frame
+	size_t uploadedColours, uploadedFirst;	// how much of the colour tables the GPU buffers already hold
+	std::vector<uint8_t> geomMask;	// instance mask per geometry: bit 0 = seen by reflection rays, bit 1 = casts shadows
+	std::vector<float> colours;	// rgba
+	id<MTLBuffer> colourBuf, firstColourBuf;
+	size_t gpuBytes;
+
+	id<MTLCommandBuffer> buildCB;
+	id<MTLAccelerationStructureCommandEncoder> buildEnc;
+	NSMutableArray *tempBuffers;
+	int buildsThisFrame;
+
+	std::unordered_map<uintptr_t, StaticInst> statics;
+	std::vector<DynInst> dynamics;
+	std::unordered_map<uintptr_t, size_t> dynamicKeys;
+	uint32_t frame;
+	uint32_t lastStaticBuild;
+	bool staticDirty;
+	id<MTLAccelerationStructure> staticTLAS, dynamicTLAS;
+	id<MTLBuffer> staticGeomBuf, dynamicGeomBuf;
+	uint32_t staticCount;
+	bool ready;
+};
+State &S = *new State();	// never destroyed: the MetalFX objects must not be torn down during exit()
+
+const size_t kMaxColours = 400000, kMaxGeometries = 60000;
+const size_t kMaxGpuBytes = 2048ull*1024*1024;
+const int kMaxBuildsPerFrame = 40;
+const size_t kMaxAnimatedGeometries = 128;
+const int kMaxAnimatedMeshes = 32;
+const uint32_t kEvictFrames = 3600;
+const uint32_t kStaticRebuildEvery = 15;
+
+void
+logLine(const char *msg)
+{
+	fprintf(stderr, "MetalRT: %s\n", msg);
+	if(FILE *f = fopen("metalfx.log", "a")){
+		fprintf(f, "%s\n", msg);
+		fclose(f);
+	}
+}
+
+// 4x4 inverse (column-major, as the matrices are passed); false when singular
+static bool
+invert4(float *out, const float *m)
+{
+	return rw::matrixutil::invert4(out,m);
+}
+
+bool
+makeShared(int idx, int w, int h, int bpe, uint32_t pixelFormat, MTLPixelFormat mtlFormat, MTLTextureUsage usage,
+           GLenum glInternal, GLenum glFormat, GLenum glType)
+{
+#ifdef RW_METALGL
+	{
+		MTLTextureDescriptor *d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:mtlFormat width:w height:h mipmapped:NO];
+		d.usage = usage | MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead;
+		d.storageMode = MTLStorageModePrivate;
+		S.tex[idx] = [S.device newTextureWithDescriptor:d];
+		if(!S.tex[idx]){ logLine("texture creation failed"); return false; }
+		S.gl[idx] = mtlglWrapTexture((__bridge void*)S.tex[idx]);
+		return true;
+	}
+#endif
+	NSDictionary *props = @{
+		(id)kIOSurfaceWidth: @(w), (id)kIOSurfaceHeight: @(h),
+		(id)kIOSurfaceBytesPerElement: @(bpe), (id)kIOSurfacePixelFormat: @(pixelFormat),
+	};
+	S.surface[idx] = IOSurfaceCreate((__bridge CFDictionaryRef)props);
+	if(!S.surface[idx]){ logLine("IOSurfaceCreate failed"); return false; }
+	MTLTextureDescriptor *d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:mtlFormat width:w height:h mipmapped:NO];
+	d.usage = usage;
+	S.tex[idx] = [S.device newTextureWithDescriptor:d iosurface:S.surface[idx] plane:0];
+	if(!S.tex[idx]){ logLine("newTextureWithDescriptor(iosurface) failed"); return false; }
+	glGenTextures(1, &S.gl[idx]);
+	glBindTexture(GL_TEXTURE_RECTANGLE, S.gl[idx]);
+	CGLError err = CGLTexImageIOSurface2D(CGLGetCurrentContext(), GL_TEXTURE_RECTANGLE, glInternal, w, h, glFormat, glType, S.surface[idx], 0);
+	if(err != kCGLNoError){
+		char b[128];
+		snprintf(b, sizeof(b), "CGLTexImageIOSurface2D failed for texture %d: %s", idx, CGLErrorString(err));
+		logLine(b);
+		return false;
+	}
+	glTexParameteri(GL_TEXTURE_RECTANGLE, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+	glTexParameteri(GL_TEXTURE_RECTANGLE, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+	glTexParameteri(GL_TEXTURE_RECTANGLE, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+	glTexParameteri(GL_TEXTURE_RECTANGLE, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+	return true;
+}
+
+void
+openBuild(void)
+{
+	if(S.buildCB) return;
+	S.buildCB = [S.queue commandBuffer];
+	S.buildEnc = [S.buildCB accelerationStructureCommandEncoder];
+	if(!S.tempBuffers) S.tempBuffers = [NSMutableArray array];
+}
+
+void
+closeBuild(bool wait)
+{
+	if(!S.buildCB) return;
+	[S.buildEnc endEncoding];
+	[S.buildCB commit];
+	if(wait) [S.buildCB waitUntilCompleted];
+	S.buildEnc = nil;
+	S.buildCB = nil;
+}
+
+id<MTLAccelerationStructure>
+buildStructure(MTLAccelerationStructureDescriptor *desc)
+{
+	MTLAccelerationStructureSizes sz = [S.device accelerationStructureSizesWithDescriptor:desc];
+	if(S.gpuBytes + sz.accelerationStructureSize > kMaxGpuBytes) return nil;
+	id<MTLAccelerationStructure> as = [S.device newAccelerationStructureWithSize:sz.accelerationStructureSize];
+	id<MTLBuffer> scratch = [S.device newBufferWithLength:MAX(sz.buildScratchBufferSize, (NSUInteger)16) options:MTLResourceStorageModePrivate];
+	if(!as || !scratch) return nil;
+	openBuild();
+	[S.buildEnc buildAccelerationStructure:as descriptor:desc scratchBuffer:scratch scratchBufferOffset:0];
+	[S.tempBuffers addObject:scratch];
+	S.gpuBytes += sz.accelerationStructureSize;
+	return as;
+}
+
+void
+packInstance(MTLAccelerationStructureInstanceDescriptor &d, int blasIndex, const float *m, uint8_t mask)
+{
+	for(int c = 0; c < 4; c++){
+		d.transformationMatrix.columns[c].x = m[c*4 + 0];
+		d.transformationMatrix.columns[c].y = m[c*4 + 1];
+		d.transformationMatrix.columns[c].z = m[c*4 + 2];
+	}
+	d.options = MTLAccelerationStructureInstanceOptionOpaque | MTLAccelerationStructureInstanceOptionDisableTriangleCulling;
+	d.mask = mask;
+	d.intersectionFunctionTableOffset = 0;
+	d.accelerationStructureIndex = (uint32_t)blasIndex;
+}
+
+// builds an instance acceleration structure over the given instances; geomOut receives the per-instance geometry ids
+id<MTLAccelerationStructure>
+buildScene(const std::vector<std::pair<int, const float*>> &inst, id<MTLBuffer> __strong *geomBuf, std::vector<int> &used, const std::vector<uint32_t> *owners = nullptr, const std::vector<std::array<uint32_t,2>> *paints = nullptr, id<MTLAccelerationStructure> previous = nil, bool dynamic = false)
+{
+	used.clear();
+	if(inst.empty()) return nil;
+	id<MTLBuffer> descBuf = [S.device newBufferWithLength:sizeof(MTLAccelerationStructureInstanceDescriptor)*inst.size() options:MTLResourceStorageModeShared];
+	*geomBuf = [S.device newBufferWithLength:sizeof(uint32_t)*4*inst.size() options:MTLResourceStorageModeShared];
+	auto *dp = (MTLAccelerationStructureInstanceDescriptor*)descBuf.contents;
+	auto *gp = (uint32_t*)(*geomBuf).contents;
+	// only the structures this scene uses go into its list (a few thousand, not every one ever built)
+	std::unordered_map<int, uint32_t> local;
+	NSMutableArray *list = [NSMutableArray array];
+	for(size_t i = 0; i < inst.size(); i++){
+		int blas = inst[i].first;
+		auto it = local.find(blas);
+		uint32_t li;
+		if(it == local.end()){
+			li = (uint32_t)list.count;
+			local[blas] = li;
+			[list addObject:S.blas[blas]];
+			used.push_back(blas);
+		}else
+			li = it->second;
+		packInstance(dp[i], (int)li, inst[i].second, S.geomMask[blas]);
+		gp[i*4] = (uint32_t)blas;
+		gp[i*4+1] = owners ? (*owners)[i] : 0;
+		gp[i*4+2] = paints ? (*paints)[i][0] : 0;
+		gp[i*4+3] = paints ? (*paints)[i][1] : 0;
+	}
+	MTLInstanceAccelerationStructureDescriptor *d = [MTLInstanceAccelerationStructureDescriptor descriptor];
+	d.instanceCount = inst.size();
+	d.instanceDescriptorBuffer = descBuf;
+	d.instancedAccelerationStructures = list;
+	d.instanceDescriptorType = MTLAccelerationStructureInstanceDescriptorTypeDefault;
+	[S.tempBuffers addObject:descBuf];
+ if(dynamic) d.usage=MTLAccelerationStructureUsageRefit;
+ id<MTLAccelerationStructure> as=nil;
+ if(dynamic && previous){
+  auto sizes=[S.device accelerationStructureSizesWithDescriptor:d];
+  NSUInteger bytes=MAX(sizes.accelerationStructureSize,previous.size);
+  if(S.gpuBytes+bytes<=kMaxGpuBytes){
+   as=[S.device newAccelerationStructureWithSize:bytes];
+   auto scratch=[S.device newBufferWithLength:MAX(sizes.refitScratchBufferSize,(NSUInteger)16) options:MTLResourceStorageModePrivate];
+   if(as && scratch){openBuild();[S.buildEnc refitAccelerationStructure:previous descriptor:d destination:as scratchBuffer:scratch scratchBufferOffset:0];[S.tempBuffers addObject:scratch];S.gpuBytes+=bytes;S.dynamicRefits++;}
+   else as=nil;
+  }
+ }else {as=buildStructure(d);if(dynamic && as)S.dynamicBuilds++;}
+ return as;
+}
+
+}
+
+extern "C" int
+mrtSetup(int width, int height, unsigned *glTex)
+{
+	mrtShutdown();
+	@autoreleasepool {
+#ifdef RW_METALGL
+		S.device = (__bridge id<MTLDevice>)mtlglDevice();
+#else
+		S.device = MTLCreateSystemDefaultDevice();
+#endif
+		if(!S.device){ logLine("no Metal device"); return 0; }
+		if(![S.device supportsRaytracing]){ logLine("this GPU has no ray tracing support"); return 0; }
+#ifdef RW_METALGL
+		S.queue = (__bridge id<MTLCommandQueue>)mtlglCommandQueue();
+#else
+		S.queue = [S.device newCommandQueue];
+#endif
+		NSError *err = nil;
+		id<MTLLibrary> lib = [S.device newLibraryWithSource:[NSString stringWithUTF8String:kernelSource] options:nil error:&err];
+		if(!lib){ logLine([[err localizedDescription] UTF8String]); return 0; }
+		id<MTLFunction> fn = [lib newFunctionWithName:@"traceReflections"];
+		S.pipeline = [S.device newComputePipelineStateWithFunction:fn error:&err];
+		S.surfaceEncoder=[fn newArgumentEncoderWithBufferIndex:8];
+		if(!S.pipeline){ logLine([[err localizedDescription] UTF8String]); return 0; }
+		id<MTLFunction> sfn = [lib newFunctionWithName:@"traceShadows"];
+		S.shadowPipeline = [S.device newComputePipelineStateWithFunction:sfn error:&err];
+		if(!S.shadowPipeline){ logLine([[err localizedDescription] UTF8String]); return 0; }
+		S.shaftPipeline = [S.device newComputePipelineStateWithFunction:[lib newFunctionWithName:@"traceSunShafts"] error:&err];
+		if(!S.shaftPipeline){ logLine([[err localizedDescription] UTF8String]); return 0; }
+		S.width = width; S.height = height;
+
+		GLint prev = 0;
+#ifndef RW_METALGL
+		glGetIntegerv(GL_TEXTURE_BINDING_RECTANGLE, &prev);
+#endif
+		bool ok =
+			makeShared(MRT_DEPTH, width, height, 16, 0x52476641, MTLPixelFormatRGBA32Float, MTLTextureUsageShaderRead, GL_RGBA32F, GL_RGBA, GL_FLOAT) &&
+			makeShared(MRT_DIRECTION, width, height, 8, 0x52476841, MTLPixelFormatRGBA16Float, MTLTextureUsageShaderRead, GL_RGBA16F, GL_RGBA, GL_HALF_FLOAT) &&
+			makeShared(MRT_OUTPUT, width, height, 8, 0x52476841, MTLPixelFormatRGBA16Float, MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite, GL_RGBA16F, GL_RGBA, GL_HALF_FLOAT) &&
+			makeShared(MRT_SHADOW, width, height, 8, 0x52476841, MTLPixelFormatRGBA16Float, MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite, GL_RGBA16F, GL_RGBA, GL_HALF_FLOAT) &&
+			makeShared(MRT_LIGHT, width, height, 8, 0x52476841, MTLPixelFormatRGBA16Float, MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite, GL_RGBA16F, GL_RGBA, GL_HALF_FLOAT) &&
+			makeShared(MRT_VOLUME, (width+3)/4, (height+3)/4, 8, 0x52476841, MTLPixelFormatRGBA16Float, MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite, GL_RGBA16F, GL_RGBA, GL_HALF_FLOAT);
+#ifndef RW_METALGL
+		glBindTexture(GL_TEXTURE_RECTANGLE, prev);
+#endif
+		if(!ok){ mrtShutdown(); return 0; }
+
+		S.colours.reserve(kMaxColours*4);
+		S.colourBuf = [S.device newBufferWithLength:kMaxColours*16 options:MTLResourceStorageModeShared];
+		S.firstColourBuf = [S.device newBufferWithLength:kMaxGeometries*4 options:MTLResourceStorageModeShared];
+		for(int i = 0; i < 2; i++){
+			MTLTextureDescriptor *hd = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA16Float width:width height:height mipmapped:NO];
+			hd.storageMode = MTLStorageModePrivate;
+			hd.usage = MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite;
+			S.hist[i] = [S.device newTextureWithDescriptor:hd];
+			MTLTextureDescriptor *pdsc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA32Float width:width height:height mipmapped:NO];
+			pdsc.storageMode = MTLStorageModePrivate;
+			pdsc.usage = MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite;
+			S.pos[i] = [S.device newTextureWithDescriptor:pdsc];
+		}
+		S.histValid = false;
+		for(int i = 0; i < MRT_NUM_TEXTURES; i++) glTex[i] = S.gl[i];
+		S.ready = true;
+		char b[96];
+		snprintf(b, sizeof(b), "ray tracing ready (%dx%d)", width, height);
+		logLine(b);
+	}
+	return 1;
+}
+
+extern "C" int mrtReady(void) { return S.ready ? 1 : 0; }
+
+extern "C" void
+mrtShutdown(void)
+{
+	@autoreleasepool {
+		closeBuild(true);
+		S.ready = false;
+		S.sceneColour=nil;S.sceneDepth=nil;S.sceneVelocity=nil;
+		S.surfaceEncoder=nil;S.surfaceBuffer=nil;S.surfaces.clear();S.surfaceResources.clear();S.dirtySurfaces.clear();S.surfaceRevision.clear();S.surfaceBytes=0;
+		S.animated.clear();
+		S.blas.clear();
+		S.firstColour.clear();
+		S.geomMask.clear();
+		S.geoms.clear();
+		S.staticUsed.clear(); S.dynamicUsed.clear();
+		S.uploadedColours = S.uploadedFirst = 0;
+		S.replaceColourBuffer = false;
+		S.colours.clear();
+		S.statics.clear();
+		S.dynamics.clear();
+		S.dynamicKeys.clear();
+		S.staticTLAS = nil; S.dynamicTLAS = nil; S.staticGeomBuf = nil; S.dynamicGeomBuf = nil;
+		S.colourBuf = nil; S.firstColourBuf = nil; S.tempBuffers = nil;
+		S.gpuBytes = 0;
+		S.pipeline = nil; S.shadowPipeline = nil; S.shaftPipeline = nil;
+		for(int i = 0; i < MRT_NUM_TEXTURES; i++){
+			S.tex[i] = nil;
+#ifdef RW_METALGL
+			S.gl[i] = 0;
+#else
+			if(S.gl[i]){ glDeleteTextures(1, &S.gl[i]); S.gl[i] = 0; }
+#endif
+			if(S.surface[i]){ CFRelease(S.surface[i]); S.surface[i] = nullptr; }
+		}
+		S.queue = nil;
+		S.device = nil;
+	}
+}
+
+extern "C" int
+mrtAddGeometry(const float *positions, int numVerts, int numMeshes, const uint32_t *const *indices, const int *indexCount, const float *colours, const int *meshCasts)
+{
+	if(!S.ready || numVerts <= 0 || numMeshes <= 0) return -1;
+	if(S.blas.size() + 2 >= kMaxGeometries || S.colours.size()/4 + numMeshes*2 > kMaxColours) return -1;
+	if(S.buildsThisFrame >= kMaxBuildsPerFrame) return -2;
+	@autoreleasepool {
+		size_t total = 0;
+		for(int m = 0; m < numMeshes; m++) total += indexCount[m];
+		if(total < 3) return -1;
+		id<MTLBuffer> vb = [S.device newBufferWithBytes:positions length:sizeof(float)*3*numVerts options:MTLResourceStorageModeShared];
+		id<MTLBuffer> ib = [S.device newBufferWithLength:total*4 options:MTLResourceStorageModeShared];
+		uint32_t *ip = (uint32_t*)ib.contents;
+		NSMutableArray *geoms = [NSMutableArray array];
+		size_t off = 0;
+		for(int m = 0; m < numMeshes; m++){
+			memcpy(ip + off, indices[m], indexCount[m]*4);
+			MTLAccelerationStructureTriangleGeometryDescriptor *g = [MTLAccelerationStructureTriangleGeometryDescriptor descriptor];
+			g.vertexBuffer = vb;
+			g.vertexStride = 12;
+			g.vertexFormat = MTLAttributeFormatFloat3;
+			g.indexBuffer = ib;
+			g.indexType = MTLIndexTypeUInt32;
+			g.indexBufferOffset = off*4;
+			g.triangleCount = indexCount[m]/3;
+			g.opaque = YES;
+			[geoms addObject:g];
+			off += indexCount[m];
+		}
+		MTLPrimitiveAccelerationStructureDescriptor *pd = [MTLPrimitiveAccelerationStructureDescriptor descriptor];
+		pd.geometryDescriptors = geoms;
+		id<MTLAccelerationStructure> as = buildStructure(pd);
+		if(!as) return -1;
+		// Meshes that must not cast shadows (glass, alpha tested parts) share a car body with meshes that do. When a geometry
+		// mixes both, shadow rays use a second structure made of the casting meshes only.
+		int castCount = 0;
+		NSMutableArray *casters = [NSMutableArray array];
+		for(int m = 0; m < numMeshes; m++)
+			if(meshCasts[m] & 1){ castCount++; [casters addObject:geoms[m]]; }
+		id<MTLAccelerationStructure> shadowAS = nil;
+		if(castCount > 0 && castCount < numMeshes){
+			MTLPrimitiveAccelerationStructureDescriptor *sd = [MTLPrimitiveAccelerationStructureDescriptor descriptor];
+			sd.geometryDescriptors = casters;
+			shadowAS = buildStructure(sd);
+		}
+		[S.tempBuffers addObject:vb];
+		[S.tempBuffers addObject:ib];
+		int mainIdx = (int)S.blas.size();
+		S.blas.push_back(as);
+		S.firstColour.push_back((uint32_t)(S.colours.size()/8));
+		int volumeCount=0; NSMutableArray *volumeMeshes=[NSMutableArray array];
+		for(int m=0;m<numMeshes;m++) if(meshCasts[m]){volumeCount++;[volumeMeshes addObject:geoms[m]];}
+		S.geomMask.push_back(0x01 | (castCount == numMeshes ? 0x02 : 0) | (volumeCount == numMeshes ? 0x04 : 0));
+		int shadowIdx = -1;
+		if(shadowAS){
+			shadowIdx = (int)S.blas.size();
+			S.blas.push_back(shadowAS);
+			S.firstColour.push_back((uint32_t)(S.colours.size()/8));
+			S.geomMask.push_back(0x02 | (volumeCount == castCount ? 0x04 : 0));
+		}
+		int id_ = (int)S.geoms.size();
+		int volumeIdx=-1;
+        if(volumeCount > 0 && volumeCount < numMeshes && volumeCount != castCount){
+            auto vd=[MTLPrimitiveAccelerationStructureDescriptor descriptor];vd.geometryDescriptors=volumeMeshes;
+            auto volumeAS=buildStructure(vd);if(!volumeAS)return -1;
+            volumeIdx=(int)S.blas.size();S.blas.push_back(volumeAS);
+            S.firstColour.push_back((uint32_t)(S.colours.size()/8));S.geomMask.push_back(0x04);
+        }
+        S.geoms.push_back({ mainIdx, shadowIdx, volumeIdx });
+		for(int m = 0; m < numMeshes; m++){
+			// per mesh: albedo (texture average x material colour), then the average prelit vertex light
+			for(int k = 0; k < 6; k++){
+				S.colours.push_back(colours[m*6 + k]);
+				if(k == 2) S.colours.push_back(1.0f);
+			}
+			S.colours.push_back(1.0f);
+		}
+		S.buildsThisFrame++;
+		return id_;
+	}
+}
+
+extern "C" int
+mrtAddAnimatedGeometry(uintptr_t key, const float *positions, int numVerts, int numMeshes,
+                       const uint32_t *const *indices, const int *indexCount, const float *colours)
+{
+	if(!S.ready || !key || numVerts <= 0 || numMeshes <= 0 || numMeshes > kMaxAnimatedMeshes) return -1;
+	// Topology is stable through animation. A recycled ped/atomic can use another model, so check its indices too.
+	uint64_t topology = uint64_t(numVerts)*1099511628211ull + numMeshes;
+	size_t total = 0;
+	for(int m = 0; m < numMeshes; m++){
+		if(indexCount[m] < 0 || indexCount[m]%3) return -1;
+		total += indexCount[m];
+		topology = (topology ^ uint32_t(indexCount[m]))*1099511628211ull;
+		for(int i = 0; i < indexCount[m]; i++){
+			if(indices[m][i] >= (uint32_t)numVerts) return -1;
+			topology = (topology ^ indices[m][i])*1099511628211ull;
+		}
+	}
+	if(total < 3) return -1;
+	AnimatedGeom *entry = nullptr;
+	for(auto &a : S.animated) if(a.key == key){ entry = &a; break; }
+	if(!entry){
+		for(auto &a : S.animated)
+			if(S.frame - a.frame > 2 && (!entry || a.frame < entry->frame)) entry = &a;
+		if(!entry){
+			if(S.animated.size() >= kMaxAnimatedGeometries) return -2;
+			S.animated.emplace_back(); entry = &S.animated.back();
+		}
+	}
+	bool refit = entry->descriptor && entry->topology == topology;
+	if(entry->key!=key || !refit) S.surfaceRevision.erase(entry->id);
+	if(entry->key == key && entry->frame == S.frame && refit) return entry->id;
+	@autoreleasepool {
+		id<MTLBuffer> vb = [S.device newBufferWithBytes:positions length:size_t(numVerts)*12 options:MTLResourceStorageModeShared];
+		if(!vb) return -1;
+		id<MTLBuffer> ib = refit ? ((MTLAccelerationStructureTriangleGeometryDescriptor*)entry->descriptor.geometryDescriptors[0]).indexBuffer :
+			[S.device newBufferWithLength:total*4 options:MTLResourceStorageModeShared];
+		if(!ib) return -1;
+		NSMutableArray *meshes = [NSMutableArray array];
+		size_t offset = 0;
+		for(int m = 0; m < numMeshes; m++){
+			if(!refit) memcpy((uint32_t*)ib.contents + offset, indices[m], indexCount[m]*4);
+			auto *g = [MTLAccelerationStructureTriangleGeometryDescriptor descriptor];
+			g.vertexBuffer = vb; g.vertexStride = 12; g.vertexFormat = MTLAttributeFormatFloat3;
+			g.indexBuffer = ib; g.indexType = MTLIndexTypeUInt32; g.indexBufferOffset = offset*4;
+			g.triangleCount = indexCount[m]/3; g.opaque = YES;
+			[meshes addObject:g]; offset += indexCount[m];
+		}
+		auto *desc = [MTLPrimitiveAccelerationStructureDescriptor descriptor];
+		desc.geometryDescriptors = meshes;
+		desc.usage = MTLAccelerationStructureUsageRefit;
+		auto sizes = [S.device accelerationStructureSizesWithDescriptor:desc];
+		id<MTLAccelerationStructure> old = entry->id >= 0 ? S.blas[S.geoms[entry->id].first] : nil;
+		size_t oldBytes = old ? old.size : 0;
+		if(S.gpuBytes - oldBytes + sizes.accelerationStructureSize > kMaxGpuBytes) return -1;
+		if(entry->id < 0 && (S.blas.size() >= kMaxGeometries || S.colours.size()/4 + kMaxAnimatedMeshes*2 > kMaxColours)) return -1;
+		id<MTLAccelerationStructure> next = [S.device newAccelerationStructureWithSize:sizes.accelerationStructureSize];
+		NSUInteger scratchSize = refit ? sizes.refitScratchBufferSize : sizes.buildScratchBufferSize;
+		id<MTLBuffer> scratch = [S.device newBufferWithLength:MAX(scratchSize, (NSUInteger)16) options:MTLResourceStorageModePrivate];
+		if(!next || !scratch) return -1;
+		openBuild();
+		if(refit)
+			[S.buildEnc refitAccelerationStructure:old descriptor:desc destination:next scratchBuffer:scratch scratchBufferOffset:0];
+		else
+			[S.buildEnc buildAccelerationStructure:next descriptor:desc scratchBuffer:scratch scratchBufferOffset:0];
+		[S.tempBuffers addObject:vb]; [S.tempBuffers addObject:ib]; [S.tempBuffers addObject:scratch];
+		S.gpuBytes = S.gpuBytes - oldBytes + sizes.accelerationStructureSize;
+		if(entry->id < 0){
+			int b = (int)S.blas.size();
+			entry->id = (int)S.geoms.size();
+			S.geoms.push_back({ b, -1 }); S.blas.push_back(next);
+			S.geomMask.push_back(0x01); // animated pedestrians participate in reflections only
+			S.firstColour.push_back((uint32_t)(S.colours.size()/8));
+			S.colours.resize(S.colours.size() + kMaxAnimatedMeshes*8, 0.0f);
+		}else{
+			S.blas[S.geoms[entry->id].first] = next;
+		}
+		size_t first = S.firstColour[S.geoms[entry->id].first]*8;
+		for(int m = 0; m < numMeshes; m++){
+			float colour[8] = {colours[m*6],colours[m*6+1],colours[m*6+2],1,
+			                   colours[m*6+3],colours[m*6+4],colours[m*6+5],1};
+			if(memcmp(S.colours.data()+first+m*8, colour, sizeof(colour))){
+				memcpy(S.colours.data()+first+m*8, colour, sizeof(colour));
+				if(first+m*8 < S.uploadedColours) S.replaceColourBuffer = true;
+			}
+		}
+		entry->key = key; entry->topology = topology; entry->frame = S.frame; entry->descriptor = desc;
+		return entry->id;
+	}
+}
+
+extern "C" void
+mrtFrameBegin(void)
+{
+	S.frame++;
+	S.dynamics.clear();
+	S.dynamicKeys.clear();
+	S.buildsThisFrame = 0;
+}
+
+extern "C" void
+mrtAddInstance(int geometry, const float *world, uintptr_t key, int dynamic)
+{
+	if(!S.ready || geometry < 0 || geometry >= (int)S.geoms.size()) return;
+	if(dynamic || key == 0){
+		// A resting prop can wake when hit. Remove its old shadow immediately rather than
+		// retaining a duplicate at its original position for the static cache lifetime.
+		if(key && S.statics.erase(key)){
+			S.staticDirty = true;
+			S.lastStaticBuild = S.frame - kStaticRebuildEvery;
+			S.histValid = false;
+		}
+		if(key){
+			auto found = S.dynamicKeys.find(key);
+			if(found != S.dynamicKeys.end()){
+				DynInst &d = S.dynamics[found->second];
+				d.geom = geometry; d.owner = d.primary = d.secondary = 0; memcpy(d.m, world, 64);
+				return;
+			}
+		}
+		if(S.dynamics.size() < 4096){
+			if(key) S.dynamicKeys[key] = S.dynamics.size();
+			DynInst d; d.geom = geometry; d.owner = d.primary = d.secondary = 0; memcpy(d.m, world, 64);
+			S.dynamics.push_back(d);
+		}
+		return;
+	}
+	auto it = S.statics.find(key);
+	if(it == S.statics.end()){
+		StaticInst s; s.geom = geometry; memcpy(s.m, world, 64); s.lastSeen = S.frame;
+		S.statics[key] = s;
+		S.staticDirty = true;
+	}else{
+		StaticInst &s = it->second;
+		if(s.geom != geometry || memcmp(s.m, world, 64) != 0){
+			s.geom = geometry; memcpy(s.m, world, 64);
+			S.staticDirty = true;
+		}
+		s.lastSeen = S.frame;
+	}
+}
+
+extern "C" void
+mrtAddVehicleInstance(int geometry, const float *world, uintptr_t key, uint32_t owner)
+{
+	mrtAddInstance(geometry, world, key, 1);
+	auto it = S.dynamicKeys.find(key);
+	if(it != S.dynamicKeys.end()) S.dynamics[it->second].owner = owner;
+}
+
+extern "C" int
+mrtAnimatedCurrent(uintptr_t key)
+{
+	for(const auto &entry:S.animated) if(entry.key==key && entry.frame==S.frame) return 1;
+	return 0;
+}
+
+extern "C" void
+mrtSetVehicleInstanceColours(uintptr_t key, uint32_t primary, uint32_t secondary)
+{
+	auto it=S.dynamicKeys.find(key);
+	if(it!=S.dynamicKeys.end()){S.dynamics[it->second].primary=primary;S.dynamics[it->second].secondary=secondary;}
+}
+
+// UVs and textures are immutable between topology/model changes. Each mesh keeps a retained
+// resource reference, and argument buffers are replaced rather than edited while in flight.
+extern "C" void
+mrtSetGeometrySurfaces(int geometry, uintptr_t revision, const float *uv, int numMeshes,
+                       const uint32_t *const *indices, const int *counts,
+                       const unsigned *textures, const float *tints, const uint32_t *paint)
+{
+	if(!S.ready || geometry<0 || geometry>=(int)S.geoms.size()) return;
+	auto old=S.surfaceRevision.find(geometry);
+	if(old!=S.surfaceRevision.end() && old->second==revision) return;
+	uint32_t base=S.firstColour[S.geoms[geometry].first];
+	if(S.surfaces.size()<S.colours.size()/8) S.surfaces.resize(S.colours.size()/8);
+	if(base+numMeshes>S.surfaces.size()) return;
+	for(int mesh=0;mesh<numMeshes;mesh++){
+		RaySurfaceCPU record;
+		memcpy(record.tint,tints+mesh*4,16);
+		record.flags=paint ? paint[mesh]<<1 : 0;
+		size_t oldBytes=S.surfaces[base+mesh].uv ? S.surfaces[base+mesh].uv.length : 0;
+		if(uv && counts[mesh]>0 && S.gpuBytes+S.surfaceBytes-oldBytes+size_t(counts[mesh])*8<kMaxGpuBytes){
+			std::vector<float> corners(counts[mesh]*2);
+			for(int i=0;i<counts[mesh];i++){corners[i*2]=uv[indices[mesh][i]*2];corners[i*2+1]=uv[indices[mesh][i]*2+1];}
+			record.uv=[S.device newBufferWithBytes:corners.data() length:corners.size()*4 options:MTLResourceStorageModeShared];
+#ifdef RW_METALGL
+			record.albedo=(__bridge id<MTLTexture>)mtlglTexture(textures[mesh]);
+#endif
+			if(record.uv && record.albedo) record.flags|=1u;
+		}
+		S.surfaceBytes-=oldBytes;
+		if(record.uv) S.surfaceBytes+=record.uv.length;
+		S.surfaces[base+mesh]=record;S.dirtySurfaces.push_back(base+mesh);
+	}
+	S.surfaceRevision[geometry]=revision;
+}
+
+extern "C" int
+mrtTrace(const float *invViewProj, const MrtEnvironment *env)
+{
+	if(!S.ready) return 0;
+#ifdef RW_METALGL
+	mtlglFlush();
+#endif
+	@autoreleasepool {
+		// bottom-level builds queued this frame run before the scenes that reference them: same queue, no CPU wait needed
+		closeBuild(false);
+
+		// the static scene changes rarely: rebuild it when objects appeared/moved, at most every few frames
+		if((S.staticDirty && S.frame - S.lastStaticBuild >= kStaticRebuildEvery) || (!S.staticTLAS && !S.statics.empty())){
+			std::vector<std::pair<int, const float*>> inst;
+			for(auto it = S.statics.begin(); it != S.statics.end();){
+				if(S.frame - it->second.lastSeen > kEvictFrames){ it = S.statics.erase(it); continue; }
+				inst.push_back({ S.geoms[it->second.geom].first, it->second.m });
+				if(S.geoms[it->second.geom].second >= 0) inst.push_back({ S.geoms[it->second.geom].second, it->second.m });
+				if(S.geoms[it->second.geom].volume >= 0) inst.push_back({ S.geoms[it->second.geom].volume, it->second.m });
+				++it;
+			}
+			if(!inst.empty()){
+				id<MTLAccelerationStructure> as = buildScene(inst, &S.staticGeomBuf, S.staticUsed);
+				closeBuild(false);
+				if(as){ if(S.staticTLAS) S.gpuBytes -= S.staticTLAS.size; S.staticTLAS = as; S.staticCount = (uint32_t)inst.size(); }
+			}
+			S.staticDirty = false;
+			S.lastStaticBuild = S.frame;
+		}
+		if(!S.staticTLAS){ closeBuild(true); [S.tempBuffers removeAllObjects]; return 0; }
+
+		bool haveDynamic = false;
+		if(!S.dynamics.empty()){
+			std::vector<std::pair<int, const float*>> inst;
+			std::vector<uint32_t> owners;
+			std::vector<std::array<uint32_t,2>> paints;
+			for(auto &d : S.dynamics){
+				inst.push_back({ S.geoms[d.geom].first, d.m }); owners.push_back(d.owner); paints.push_back({d.primary,d.secondary});
+				if(S.geoms[d.geom].second >= 0){ inst.push_back({ S.geoms[d.geom].second, d.m }); owners.push_back(d.owner); paints.push_back({d.primary,d.secondary}); }
+				if(S.geoms[d.geom].volume >= 0){ inst.push_back({ S.geoms[d.geom].volume, d.m }); owners.push_back(d.owner); paints.push_back({d.primary,d.secondary}); }
+			}
+			std::vector<int> order;order.reserve(inst.size());for(const auto &i:inst)order.push_back(i.first);
+            // Refit only an unchanged instance/geometry layout. Refresh the tree periodically
+            // to avoid progressively worse traversal as traffic moves. No meshes or rays are removed.
+            bool refit=S.dynamicTLAS && order==S.dynamicOrder && S.frame-S.lastDynamicBuild<30;
+            id<MTLAccelerationStructure> as = buildScene(inst, &S.dynamicGeomBuf, S.dynamicUsed, &owners, &paints,refit?S.dynamicTLAS:nil,true);
+            if(as){S.dynamicOrder=std::move(order);if(!refit)S.lastDynamicBuild=S.frame;}
+			closeBuild(false);
+			if(as){ if(S.dynamicTLAS) S.gpuBytes -= S.dynamicTLAS.size; S.dynamicTLAS = as; haveDynamic = true; }
+		}
+
+		if(S.surfaceEncoder && (!S.dirtySurfaces.empty() || !S.surfaceBuffer)){
+			NSUInteger stride=S.surfaceEncoder.encodedLength;
+			NSUInteger length=stride*std::max(size_t(1),S.surfaces.size());
+			id<MTLBuffer> next=[S.device newBufferWithLength:length options:MTLResourceStorageModeShared];
+			if(!next) return 0;
+			if(S.surfaceBuffer) memcpy(next.contents,S.surfaceBuffer.contents,std::min(next.length,S.surfaceBuffer.length));
+			for(uint32_t i:S.dirtySurfaces){
+				const auto &surface=S.surfaces[i];
+				[S.surfaceEncoder setArgumentBuffer:next offset:i*stride];
+				[S.surfaceEncoder setBuffer:surface.uv offset:0 atIndex:0];[S.surfaceEncoder setTexture:surface.albedo atIndex:1];
+				memcpy([S.surfaceEncoder constantDataAtIndex:2],surface.tint,16);
+				memcpy([S.surfaceEncoder constantDataAtIndex:3],&surface.flags,4);
+			}
+			// Only streaming/topology changes alter the referenced resources. Do not hash
+			// thousands of unchanged UV buffers and textures on every rendered frame.
+			S.surfaceResources.clear();std::unordered_set<void*> seen;
+			for(const auto &surface:S.surfaces)
+				for(id<MTLResource> resource:{(id<MTLResource>)surface.uv,(id<MTLResource>)surface.albedo})
+					if(resource && seen.insert((__bridge void*)resource).second) S.surfaceResources.push_back(resource);
+			S.surfaceBuffer=next;S.dirtySurfaces.clear();
+		}
+
+		// upload new colours
+		if(S.replaceColourBuffer){
+			id<MTLBuffer> next = [S.device newBufferWithLength:kMaxColours*16 options:MTLResourceStorageModeShared];
+			if(!next) return 0;
+			S.colourBuf = next; // previous command buffers retain their own colour buffer
+			S.uploadedColours = 0;
+			S.replaceColourBuffer = false;
+		}
+		if(S.colours.size() > S.uploadedColours){
+			memcpy((float*)S.colourBuf.contents + S.uploadedColours, S.colours.data() + S.uploadedColours, (S.colours.size() - S.uploadedColours)*sizeof(float));
+			S.uploadedColours = S.colours.size();
+		}
+		if(S.firstColour.size() > S.uploadedFirst){
+			memcpy((uint32_t*)S.firstColourBuf.contents + S.uploadedFirst, S.firstColour.data() + S.uploadedFirst, (S.firstColour.size() - S.uploadedFirst)*sizeof(uint32_t));
+			S.uploadedFirst = S.firstColour.size();
+		}
+
+		struct Uniforms {
+			float invVP[16];
+			float skyTop[3]; float pad0;
+			float skyHorizon[3]; float pad1;
+			float ambient[3]; float pad2;
+			float sunDir[3]; float pad3;
+			float sunColor[3]; float maxDistance;
+			float fogDistance;
+			uint32_t width, height, hasDynamic;
+			float toSun[3]; float sunVisibility;
+			float shadowDistance; uint32_t frame, pad4, pad5;
+			float prevVP[16];
+			uint32_t histValid, pad6, pad7, pad8;
+			float camera[3]; uint32_t shaftQuality;
+		} u;
+		memcpy(u.invVP, invViewProj, 64);
+		memcpy(u.skyTop, env->skyTop, 12); memcpy(u.skyHorizon, env->skyHorizon, 12);
+		memcpy(u.ambient, env->ambient, 12); memcpy(u.sunDir, env->sunDirection, 12);
+		memcpy(u.sunColor, env->sunColor, 12);
+		memcpy(u.camera, env->camera, 12); u.shaftQuality = (uint32_t)std::max(0, std::min(3, env->shaftQuality));
+		u.maxDistance = env->maxDistance; u.fogDistance = env->fogDistance;
+		u.width = S.width; u.height = S.height; u.hasDynamic = haveDynamic ? 1 : 0;
+		memcpy(u.toSun, env->toSun, 12); u.sunVisibility = env->sunVisibility;
+		u.shadowDistance = env->shadowDistance; u.frame = S.frame;
+		u.pad5 = (uint32_t)(S.lights.size()/8);
+		u.pad4 = (uint32_t)(((env->shadows & 1) && env->sunVisibility > 0.01f) ? 1 : 0) | (uint32_t)(env->shadows & (2 | 4 | 8)) |
+		         (uint32_t)((env->shadows & 16) && u.pad5 > 0 ? 16 : 0);	// 2 roof test, 4 occlusion	// what the shadow kernel does
+		{
+			memcpy(u.prevVP, S.prevVP, 64);
+			u.histValid = S.histValid ? 1 : 0;
+			u.pad6 = u.pad7 = u.pad8 = 0;
+			// this frame's view-projection becomes next frame's history projection
+			if(!invert4(S.prevVP, invViewProj)) S.histValid = false;
+		}
+		u.pad0 = getenv("MRT_DEBUG") ? (float)atoi(getenv("MRT_DEBUG")) : 0.0f; u.pad1 = env->giStrength; u.pad2 = env->lightStrength; u.pad3 = 0;
+		static bool probeEnabled=getenv("REGTA_RT_PROBE")!=nullptr;
+		bool capture=false;
+		if(probeEnabled) if(FILE *probe=fopen("rt_probe","r")){fclose(probe);u.pad3=1.0f;capture=true;}
+
+		id<MTLCommandBuffer> cb = [S.queue commandBuffer];
+		// reflection and shadow kernels write different textures: let the GPU run them side by side
+		id<MTLComputeCommandEncoder> enc = [cb computeCommandEncoderWithDispatchType:MTLDispatchTypeConcurrent];
+		[enc setComputePipelineState:S.pipeline];
+		[enc setTexture:S.tex[MRT_DEPTH] atIndex:0];
+		[enc setTexture:S.tex[MRT_DIRECTION] atIndex:1];
+		[enc setTexture:S.tex[MRT_OUTPUT] atIndex:2];
+		[enc setAccelerationStructure:S.staticTLAS atBufferIndex:0];
+		[enc setAccelerationStructure:(haveDynamic ? S.dynamicTLAS : S.staticTLAS) atBufferIndex:1];
+		auto reflectionUniforms=u;
+		reflectionUniforms.pad6=S.sceneVelocity ? 1 : 0;
+		reflectionUniforms.pad8=S.sceneColour && S.sceneDepth ? 1 : 0;
+		reflectionUniforms.pad7=S.surfaceEncoder && S.surfaceBuffer && !S.surfaces.empty() ? 1 : 0;
+		memcpy(reflectionUniforms.prevVP,S.prevVP,64);
+		[enc setBytes:&reflectionUniforms length:sizeof(reflectionUniforms) atIndex:2];
+		[enc setTexture:(S.sceneColour ? S.sceneColour : S.tex[MRT_DEPTH]) atIndex:3];
+		[enc setTexture:(S.sceneDepth ? S.sceneDepth : S.tex[MRT_DEPTH]) atIndex:4];
+		[enc setTexture:(S.sceneVelocity ? S.sceneVelocity : S.tex[MRT_DEPTH]) atIndex:5];
+		[enc setBuffer:S.colourBuf offset:0 atIndex:3];
+		[enc setBuffer:S.firstColourBuf offset:0 atIndex:4];
+		[enc setBuffer:(S.surfaceBuffer ? S.surfaceBuffer : S.firstColourBuf) offset:0 atIndex:8];
+		if(reflectionUniforms.pad7 && !S.surfaceResources.empty())
+			[enc useResources:S.surfaceResources.data() count:S.surfaceResources.size() usage:MTLResourceUsageRead];
+		[enc setBuffer:S.staticGeomBuf offset:0 atIndex:5];
+		[enc setBuffer:(haveDynamic ? S.dynamicGeomBuf : S.staticGeomBuf) offset:0 atIndex:6];
+		// every bottom-level structure referenced by the scenes must be resident
+		for(int b : S.staticUsed) [enc useResource:S.blas[b] usage:MTLResourceUsageRead];
+		if(haveDynamic) for(int b : S.dynamicUsed) [enc useResource:S.blas[b] usage:MTLResourceUsageRead];
+		MTLSize group = MTLSizeMake(8, 8, 1);
+		MTLSize grid = MTLSizeMake(S.width, S.height, 1);
+		[enc dispatchThreads:grid threadsPerThreadgroup:group];
+		S.histValid = u.pad4 != 0;	// next frame may use this frame's accumulation only if it was written
+		if(u.pad4 != 0){
+			[enc setComputePipelineState:S.shadowPipeline];
+			[enc setBytes:&u length:sizeof(u) atIndex:2];
+			[enc setTexture:S.tex[MRT_DEPTH] atIndex:0];
+			[enc setTexture:S.tex[MRT_SHADOW] atIndex:1];
+			[enc setTexture:S.tex[MRT_LIGHT] atIndex:2];
+			int cur = S.frame & 1;
+			[enc setTexture:S.hist[cur ^ 1] atIndex:3];
+			[enc setTexture:S.hist[cur] atIndex:4];
+			[enc setTexture:S.pos[cur ^ 1] atIndex:5];
+			[enc setTexture:S.pos[cur] atIndex:6];
+			{
+				static const float none[8] = {};
+				if(S.lights.empty()) [enc setBytes:none length:sizeof(none) atIndex:7];
+				else [enc setBytes:S.lights.data() length:S.lights.size()*sizeof(float) atIndex:7];
+			}
+			[enc dispatchThreads:grid threadsPerThreadgroup:group];
+		}
+		if(u.shaftQuality != 0 && u.sunVisibility > 0.01f){
+            [enc setComputePipelineState:S.shaftPipeline];
+            [enc setBytes:&u length:sizeof(u) atIndex:2];
+            [enc setTexture:S.tex[MRT_DEPTH] atIndex:0];
+            [enc setTexture:S.tex[MRT_VOLUME] atIndex:1];
+            [enc dispatchThreads:MTLSizeMake((S.width+3)/4,(S.height+3)/4,1) threadsPerThreadgroup:group];
+        }
+		[enc endEncoding];
+        [cb addCompletedHandler:^(id<MTLCommandBuffer> done){
+            if(done.status==MTLCommandBufferStatusCompleted && done.GPUEndTime>=done.GPUStartTime)
+                lastGpuNs.store((uint64_t)((done.GPUEndTime-done.GPUStartTime)*1.0e9),std::memory_order_relaxed);
+        }];
+		[cb commit];
+		if(capture){
+			remove("rt_probe");
+			for(int index=0;index<4;index++){
+				id<MTLTexture> source=index==3 ? S.sceneVelocity : S.tex[index];
+				if(!source) continue;
+				NSUInteger width=source.width,height=source.height;
+				size_t pixelBytes=source.pixelFormat==MTLPixelFormatRGBA32Float?16:8;
+				size_t row=((width*pixelBytes+255)/256)*256;
+				id<MTLBuffer> shared=[S.device newBufferWithLength:row*height options:MTLResourceStorageModeShared];
+				if(!shared) continue;
+				id<MTLCommandBuffer> readback=[S.queue commandBuffer];
+				id<MTLBlitCommandEncoder> blit=[readback blitCommandEncoder];
+				[blit copyFromTexture:source sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0,0,0) sourceSize:MTLSizeMake(width,height,1) toBuffer:shared destinationOffset:0 destinationBytesPerRow:row destinationBytesPerImage:row*height];
+				[blit endEncoding];[readback commit];[readback waitUntilCompleted];
+				if(readback.status!=MTLCommandBufferStatusCompleted) continue;
+				char name[64];snprintf(name,sizeof(name),"rt_probe_%d.bin",index);
+				if(FILE *f=fopen(name,"wb")){
+					uint32_t header[3]={(uint32_t)width,(uint32_t)height,(uint32_t)pixelBytes};fwrite(header,4,3,f);
+					for(int y=0;y<height;y++) fwrite((char*)shared.contents+y*row,1,width*pixelBytes,f);
+					fclose(f);
+				}
+			}
+		}
+#ifdef RW_METALGL
+		// same queue as the renderer: the passes that read the result are committed after this, so nobody waits on the CPU
+		[S.tempBuffers removeAllObjects];	// the command buffer keeps what it uses alive
+		if(0){
+#else
+		[cb waitUntilCompleted];
+		[S.tempBuffers removeAllObjects];
+		if(cb.status != MTLCommandBufferStatusCompleted){
+#endif
+			logLine("trace command buffer failed");
+			return 0;
+		}
+	}
+	return 1;
+}
+
+extern "C" void
+mrtSetSceneTextures(unsigned colour, unsigned depth)
+{
+#ifdef RW_METALGL
+	S.sceneColour=(__bridge id<MTLTexture>)mtlglTexture(colour);
+	S.sceneDepth=(__bridge id<MTLTexture>)mtlglTexture(depth);
+#else
+	(void)colour;(void)depth;
+#endif
+}
+
+extern "C" void
+mrtSetVelocityTexture(unsigned texture)
+{
+#ifdef RW_METALGL
+	S.sceneVelocity=(__bridge id<MTLTexture>)mtlglTexture(texture);
+#else
+	(void)texture;
+#endif
+}
+
+extern "C" void
+mrtSetLights(const float *data, int count)
+{
+	if(count < 0) count = 0;
+	if(count > 32) count = 32;
+	S.lights.assign(data, data + count*8);
+}
+
+extern "C" float mrtGpuMilliseconds(void){return (float)(lastGpuNs.load(std::memory_order_relaxed)/1.0e6);}
diff --git a/src/extras/metalfx/MetalRT.h b/src/extras/metalfx/MetalRT.h
new file mode 100644
index 00000000..e5792e0c
--- /dev/null
+++ b/src/extras/metalfx/MetalRT.h
@@ -0,0 +1,68 @@
+#pragma once
+#include <stdint.h>
+
+// Hardware-independent ray traced reflections for the OpenGL renderer through Metal's ray tracing API.
+// Geometry is registered once (bottom-level acceleration structures), instances are added every frame, and
+// mrtTrace() shoots one reflection ray per marked pixel and writes the colour that ray sees.
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// VOLUME (quarter width/height RGBA16F): rgb = premultiplied sun scattering, a = haze opacity.
+// LIGHT (RGBA16F): rgb = extra light (street/vehicle lights with traced shadows + one bounce of indirect light), a unused
+enum { MRT_DEPTH, MRT_DIRECTION, MRT_OUTPUT, MRT_SHADOW, MRT_LIGHT, MRT_VOLUME, MRT_NUM_TEXTURES };
+
+struct MrtEnvironment {
+	float skyTop[3], skyHorizon[3];
+	float ambient[3];
+	float sunDirection[3], sunColor[3];	// direction the light travels
+	float maxDistance;
+	float fogDistance;
+	float toSun[3];			// unit vector from the scene to the sun
+	float sunVisibility;		// 0..1: how strongly the sun lights the scene (0 = night / overcast: no shadow rays)
+	float shadowDistance;
+	int shadows;			// bits: 1 sun shadows, 2 roof test, 4 occlusion, 8 indirect light, 16 point lights
+	float giStrength, lightStrength;	// scale of the indirect light and of the point lights in the LIGHT texture
+	float camera[3]; int shaftQuality; // 0 off, 1/2/3 = 8/16/32 sun visibility samples
+};
+
+// Needs a current GL context. glTex receives MRT_NUM_TEXTURES GL_TEXTURE_RECTANGLE names:
+// DEPTH (RGBA32F: window depth, source pixel UV in gb, receiving vehicle tag in a, GL rows), DIRECTION (RGBA16F world reflection direction + weight), OUTPUT (RGBA16F colour), SHADOW (RGBA16F, r = occlusion 0..1).
+int mrtSetup(int width, int height, unsigned *glTex);
+void mrtShutdown(void);
+int mrtReady(void);
+
+// Registers a triangle mesh set. positions: float3[numVerts]. Each mesh m has indexCount[m] 16/32-bit indices
+// (indices[m]) forming triangles (already a list), colour[m] (rgb albedo) and meshCasts[m] (bit 0: casts surface shadows; bit 1: opaque volume occluder;
+// alpha tested or blended meshes should not). Returns an id >= 0,
+// -1 on failure or -2 when the per-frame build budget is used up (call again next frame).
+int mrtAddGeometry(const float *positions, int numVerts, int numMeshes, const uint32_t *const *indices,
+                   const int *indexCount, const float *colours, const int *meshCasts);
+
+// Reflection-only animated mesh, identified per atomic. Updates its pose with a BLAS refit each frame.
+// Unused cache entries are recycled, keeping streaming pedestrians bounded in memory.
+int mrtAddAnimatedGeometry(uintptr_t key, const float *positions, int numVerts, int numMeshes,
+                           const uint32_t *const *indices, const int *indexCount, const float *colours);
+
+void mrtFrameBegin(void);
+int mrtAnimatedCurrent(uintptr_t key);
+// world: column-major 4x4. key identifies the object across frames. Dynamic instances live
+// for this frame only and remove any cached resting instance with the same key.
+void mrtAddInstance(int geometry, const float *world, uintptr_t key, int dynamic);
+// Shared nonzero owner on all parts lets the receiver exclude its own interior from reflection rays.
+void mrtAddVehicleInstance(int geometry, const float *world, uintptr_t key, uint32_t owner);
+// invViewProj: inverse of the actual (including jitter) column-major view-projection matrix used for the depth texture.
+int mrtTrace(const float *invViewProj, const MrtEnvironment *env);
+// Current scene textures provide surface detail for depth-validated visible ray hits.
+void mrtSetSceneTextures(unsigned colour, unsigned depth);
+void mrtSetVelocityTexture(unsigned texture);
+void mrtSetVehicleInstanceColours(uintptr_t key, uint32_t primary, uint32_t secondary);
+void mrtSetGeometrySurfaces(int geometry, uintptr_t revision, const float *uv, int numMeshes,
+                           const uint32_t *const *indices, const int *counts,
+                           const unsigned *textures, const float *tints, const uint32_t *paint);
+// Point lights for this frame: 8 floats each (position xyz, radius, colour rgb, intensity), at most 32.
+void mrtSetLights(const float *data, int count);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/src/extras/modloader/ModLoader.cpp b/src/extras/modloader/ModLoader.cpp
new file mode 100644
index 00000000..1a18ce88
--- /dev/null
+++ b/src/extras/modloader/ModLoader.cpp
@@ -0,0 +1,868 @@
+#include "common.h"
+#include "crossplatform.h"
+
+#include <map>
+#include <set>
+#include <algorithm>
+#include <stdio.h>
+#include <string.h>
+#include <dirent.h>
+#include <fnmatch.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "CdStream.h"
+#include "ModLoader.h"
+
+#define ML_DIR "modloader"
+#define ML_CACHE ML_DIR "/.cache"
+#define ML_IMG ML_CACHE "/modloader.img"
+#define ML_DIRFILE ML_CACHE "/modloader.dir"
+#define ML_SECTOR 2048
+
+typedef std::string str;
+
+struct MlFile {
+	str full;	// path to open
+	str name;	// lowercase file name
+	long size;
+	long mtime;
+};
+
+struct MlMod {
+	str name;
+	int priority;
+	std::vector<MlFile> files;
+};
+
+struct MlConfig {
+	bool ignoreAll = false;
+	bool excludeAll = false;
+	std::map<str, int> priority;
+	std::vector<str> ignoreFiles, ignoreMods, includeMods;
+};
+
+static bool ms_active;
+static str ms_root;	// absolute game folder: the game changes directory while loading data files
+static std::map<str, MlFile> ms_replace;	// lowercase file name -> winning file
+static std::vector<str> ms_plugins;
+static std::vector<MlFile> ms_streamFiles;	// dff/txd candidates for the generated image
+// extra data lines per lowercase data file name (e.g. "default.ide")
+static std::map<str, std::vector<str> > ms_extraLines;
+static std::map<str, str> ms_mergedPath;	// data file name -> merged copy in cache
+static std::set<str> ms_addedModelNames;
+// files a mod adds to the game's level list (gta_vc.dat): lowercase kind -> full paths
+static std::map<str, std::vector<str> > ms_addedLevelFiles;
+// whole data files shipped by mods; merged line by line into the game's own file
+static std::map<str, std::vector<std::vector<str> > > ms_dataSources;
+static bool ReadAll(const char *path, std::vector<str> &lines);
+// Data files merged line by line instead of replaced. Modes for the generic ones:
+//   keyed      - a mod line replaces the game line with the same first word, otherwise it is appended
+//   positional - a mod line replaces the game line at the same data-line index, extra lines are appended
+// (everything else, e.g. block-structured particle.cfg, is replaced whole by the mod's copy)
+enum { MERGE_KEYED = 1, MERGE_POSITIONAL = 2 };
+static int GenericMergeMode(const str &n)
+{
+	if(n == "ped.dat" || n == "weapon.dat" || n == "object.dat" || n == "fistfite.dat") return MERGE_KEYED;
+	if(n == "pedstats.dat" || n == "pedgrp.dat" || n == "timecyc.dat" || n == "water.dat" ||
+	   n == "surface.dat" || n == "train.dat" || n == "train2.dat") return MERGE_POSITIONAL;
+	return 0;
+}
+static bool IsMergedDataFile(const str &n) { return n == "default.ide" || n == "carcols.dat" || n == "handling.cfg" || GenericMergeMode(n) != 0; }	// "cuban.dff", "cuban.txd" declared by merged IDE lines
+
+static str
+Lower(str s)
+{
+	for(size_t i = 0; i < s.size(); i++)
+		s[i] = tolower((unsigned char)s[i]);
+	return s;
+}
+
+static str
+Trim(const str &s)
+{
+	size_t a = 0, b = s.size();
+	while(a < b && isspace((unsigned char)s[a])) a++;
+	while(b > a && isspace((unsigned char)s[b-1])) b--;
+	return s.substr(a, b-a);
+}
+
+static str
+BaseName(const char *path)
+{
+	const char *p = path, *q;
+	for(q = path; *q; q++)
+		if(*q == '/' || *q == '\\')
+			p = q+1;
+	// game data lines often carry trailing blanks or a CR ("DATA\\DEFAULT.IDE ")
+	return Trim(Lower(p));
+}
+
+static str
+Ext(const str &name)
+{
+	size_t d = name.rfind('.');
+	return d == str::npos ? str() : name.substr(d+1);
+}
+
+static bool
+Wild(const str &pattern, const str &text)
+{
+	return fnmatch(Lower(pattern).c_str(), Lower(text).c_str(), 0) == 0;
+}
+
+static bool
+MatchAny(const std::vector<str> &list, const str &text)
+{
+	for(size_t i = 0; i < list.size(); i++)
+		if(Wild(list[i], text))
+			return true;
+	return false;
+}
+
+// ---- modloader.ini ----
+
+static MlConfig
+ReadConfig(void)
+{
+	MlConfig cfg;
+	FILE *f = fcaseopen(ML_DIR "/modloader.ini", "rb");
+	if(f == nil)
+		return cfg;
+	str profile = "Default", section;
+	std::vector<str> lines;
+	char buf[1024];
+	while(fgets(buf, sizeof(buf), f))
+		lines.push_back(buf);
+	fclose(f);
+	// two passes: the profile name is needed to recognise its sections
+	for(int pass = 0; pass < 2; pass++){
+		section.clear();
+		for(size_t i = 0; i < lines.size(); i++){
+			str l = lines[i];
+			size_t c = l.find(';');
+			if(c != str::npos) l = l.substr(0, c);
+			l = Trim(l);
+			if(l.empty()) continue;
+			if(l[0] == '['){
+				section = Lower(l.substr(1, l.find(']') - 1));
+				continue;
+			}
+			str key = l, val;
+			size_t eq = l.find('=');
+			if(eq != str::npos){
+				key = Trim(l.substr(0, eq));
+				val = Trim(l.substr(eq+1));
+			}
+			if(pass == 0){
+				if(section == "folder.config" && Lower(key) == "profile")
+					profile = val;
+				continue;
+			}
+			str pre = "profiles." + Lower(profile) + ".";
+			if(section == pre + "config"){
+				if(Lower(key) == "ignoreallmods") cfg.ignoreAll = Lower(val) == "true" || val == "1";
+				if(Lower(key) == "excludeallmods") cfg.excludeAll = Lower(val) == "true" || val == "1";
+			}else if(section == pre + "priority"){
+				cfg.priority[Lower(key)] = atoi(val.c_str());
+			}else if(section == pre + "ignorefiles")
+				cfg.ignoreFiles.push_back(key);
+			else if(section == pre + "ignoremods")
+				cfg.ignoreMods.push_back(key);
+			else if(section == pre + "includemods")
+				cfg.includeMods.push_back(key);
+		}
+	}
+	return cfg;
+}
+
+// ---- scanning ----
+
+static void
+Walk(const str &dir, MlMod &mod, const MlConfig &cfg, const str &rel)
+{
+	DIR *d = opendir(dir.c_str());
+	if(d == nil) return;
+	struct dirent *de;
+	while((de = readdir(d))){
+		str n = de->d_name;
+		if(n[0] == '.') continue;	// ., .., .DS_Store, hidden
+		str full = dir + "/" + n, relpath = rel.empty() ? n : rel + "/" + n;
+		struct stat st;
+		if(stat(full.c_str(), &st) != 0) continue;
+		if(S_ISDIR(st.st_mode)){
+			Walk(full, mod, cfg, relpath);
+			continue;
+		}
+		if(MatchAny(cfg.ignoreFiles, n) || MatchAny(cfg.ignoreFiles, relpath))
+			continue;
+		MlFile mf;
+		mf.full = full;
+		mf.name = Lower(n);
+		mf.size = (long)st.st_size;
+		mf.mtime = (long)st.st_mtime;
+		mod.files.push_back(mf);
+	}
+	closedir(d);
+}
+
+static bool
+IsDataTarget(const str &lname)
+{
+	str e = Ext(lname);
+	return e == "ide" || e == "dat" || e == "cfg";
+}
+
+// Collect extra data lines from a readme-style text file.
+// Layout understood:   <data file name>   followed by its lines.
+// IDE blocks run to their "end"; other files run to the next blank line.
+static void
+ParseReadme(const MlFile &f)
+{
+	FILE *fp = fopen(f.full.c_str(), "rb");
+	if(fp == nil) return;
+	str target;
+	bool ide = false;
+	std::vector<str> block;
+	char buf[1024];
+	while(fgets(buf, sizeof(buf), fp)){
+		str raw = Trim(buf), low = Lower(raw);
+		if(raw.empty()){
+			if(!target.empty() && !ide) target.clear();
+			continue;
+		}
+		if(IsDataTarget(low) && low.find(' ') == str::npos && low.find(',') == str::npos){
+			target = low;
+			ide = Ext(low) == "ide";
+			continue;
+		}
+		if(target.empty()) continue;
+		std::vector<str> &dst = ms_extraLines[target];
+		dst.push_back(raw);
+		if(ide){
+			// remember the model/txd names so their streaming files get into the image
+			if(isdigit((unsigned char)raw[0])){
+				std::vector<str> fld;
+				str cur;
+				for(size_t i = 0; i <= raw.size(); i++){
+					if(i == raw.size() || raw[i] == ','){
+						fld.push_back(Trim(cur));
+						cur.clear();
+					}else
+						cur += raw[i];
+				}
+				if(fld.size() >= 3){
+					ms_addedModelNames.insert(Lower(fld[1]) + ".dff");
+					ms_addedModelNames.insert(Lower(fld[2]) + ".txd");
+				}
+			}
+			if(low == "end")
+				target.clear();
+		}
+	}
+	fclose(fp);
+}
+
+// Names of the files default.dat and gta_vc.dat already list ("DATA\\MAPS\\X.IDE" -> "x.ide")
+static std::set<str>
+CollectLevelFileNames(void)
+{
+	std::set<str> names;
+	static const char *dats[] = { "data/default.dat", "data/gta_vc.dat" };
+	for(int i = 0; i < 2; i++){
+		std::vector<str> lines;
+		if(!ReadAll(dats[i], lines)) continue;
+		for(size_t k = 0; k < lines.size(); k++){
+			str t = Trim(lines[k]);
+			if(t.empty() || t[0] == '#') continue;
+			size_t sp = t.find_last_of(" \t");
+			str path = sp == str::npos ? t : t.substr(sp+1);
+			names.insert(BaseName(path.c_str()));
+		}
+	}
+	return names;
+}
+
+void
+CModLoader::Init(void)
+{
+	DIR *d = opendir(ML_DIR);
+	if(d == nil) return;
+	closedir(d);
+	{
+		char cwd[1024];
+		if(getcwd(cwd, sizeof(cwd)))
+			ms_root = cwd;
+	}
+
+	MlConfig cfg = ReadConfig();
+	if(cfg.ignoreAll){
+		debug("[modloader] IgnoreAllMods is set, no mods loaded\n");
+		return;
+	}
+
+	std::vector<MlMod> mods;
+	d = opendir(ML_DIR);
+	struct dirent *de;
+	while((de = readdir(d))){
+		str n = de->d_name;
+		if(n[0] == '.') continue;
+		str full = str(ML_DIR "/") + n;
+		struct stat st;
+		if(stat(full.c_str(), &st) != 0 || !S_ISDIR(st.st_mode)) continue;
+		bool included = MatchAny(cfg.includeMods, n);
+		if(MatchAny(cfg.ignoreMods, n) && !included) continue;
+		if(cfg.excludeAll && !included) continue;
+		MlMod mod;
+		mod.name = n;
+		mod.priority = 50;
+		std::map<str,int>::iterator p = cfg.priority.find(Lower(n));
+		if(p != cfg.priority.end()) mod.priority = p->second;
+		if(mod.priority <= 0) continue;
+		Walk(full, mod, cfg, str());
+		mods.push_back(mod);
+	}
+	closedir(d);
+
+	// ascending priority, then name: the last mod to provide a file wins
+	std::sort(mods.begin(), mods.end(), [](const MlMod &a, const MlMod &b){
+		if(a.priority != b.priority) return a.priority < b.priority;
+		return Lower(a.name) < Lower(b.name);
+	});
+
+	int nfiles = 0;
+	for(size_t m = 0; m < mods.size(); m++){
+		for(size_t i = 0; i < mods[m].files.size(); i++){
+			const MlFile &f = mods[m].files[i];
+			str e = Ext(f.name);
+			nfiles++;
+			if(e == "asi"){
+				ms_plugins.push_back(f.full);
+				continue;
+			}
+			if(e == "txt"){
+				ParseReadme(f);
+				continue;
+			}
+			if(IsMergedDataFile(f.name)){
+				std::vector<str> src;
+				if(ReadAll(f.full.c_str(), src)){
+					ms_dataSources[f.name].push_back(src);
+					// IDE models declared here may need their dff/txd streamed from the mod
+					if(e == "ide"){
+						for(size_t k = 0; k < src.size(); k++){
+							str t = Trim(src[k]);
+							if(t.empty() || !isdigit((unsigned char)t[0])) continue;
+							std::vector<str> fld;
+							str cur;
+							for(size_t c = 0; c <= t.size(); c++){
+								if(c == t.size() || t[c] == ','){ fld.push_back(Trim(cur)); cur.clear(); }
+								else cur += t[c];
+							}
+							if(fld.size() >= 3){
+								ms_addedModelNames.insert(Lower(fld[1]) + ".dff");
+								ms_addedModelNames.insert(Lower(fld[2]) + ".txd");
+							}
+						}
+					}
+				}
+				continue;
+			}
+			if(e == "ini" || e == "md" || e == "url" || e == "log" || e == "pdf" || e == "rtf" || e == "doc" || e == "docx")
+				continue;
+			ms_replace[f.name] = f;
+		}
+	}
+	for(std::map<str, MlFile>::iterator it = ms_replace.begin(); it != ms_replace.end(); ++it){
+		str e = Ext(it->first);
+		if(e == "dff" || e == "txd")
+			ms_streamFiles.push_back(it->second);
+	}
+	// like Mod Loader's gta.dat merger: ide/ipl/col/img files the game doesn't list get added to its level list
+	{
+		std::set<str> known = CollectLevelFileNames();
+		for(size_t m = 0; m < mods.size(); m++)
+			for(size_t i = 0; i < mods[m].files.size(); i++){
+				const MlFile &f = mods[m].files[i];
+				str e = Ext(f.name);
+				if(e != "ide" && e != "ipl" && e != "col" && e != "img") continue;
+				if(IsMergedDataFile(f.name) || known.count(f.name)) continue;
+				if(f.name == "gta3.img" || f.name == "txd.img") continue;
+				if(e == "img"){
+					// the image's directory file must sit next to it
+					str dir = f.full.substr(0, f.full.size() - 3) + "dir";
+					struct stat st;
+					if(stat(dir.c_str(), &st) != 0) continue;
+				}
+				ms_addedLevelFiles[e].push_back(f.full);
+				known.insert(f.name);	// first (highest priority) mod to provide a name wins
+			}
+	}
+	ms_active = !mods.empty();
+	{
+		int added = 0;
+		for(std::map<str, std::vector<str> >::iterator it = ms_addedLevelFiles.begin(); it != ms_addedLevelFiles.end(); ++it)
+			added += (int)it->second.size();
+		if(added) debug("[modloader] %d new level file(s) added to gta_vc.dat\n", added);
+	}
+	debug("[modloader] %d mod(s), %d file(s), %d replacement(s), %d plugin(s), %d data file(s) extended\n",
+		(int)mods.size(), nfiles, (int)ms_replace.size(), (int)ms_plugins.size(), (int)(ms_extraLines.size() + ms_dataSources.size()));
+}
+
+bool CModLoader::IsActive(void) { return ms_active; }
+const std::vector<str> &CModLoader::GetPluginPaths(void) { return ms_plugins; }
+
+// ---- generated cdimage ----
+
+static void
+CollectDirNames(const char *dirpath, std::set<str> &names)
+{
+	FILE *f = fcaseopen(dirpath, "rb");
+	if(f == nil) return;
+	struct { uint32 offset, size; char name[24]; } e;
+	while(fread(&e, sizeof(e), 1, f) == 1){
+		char n[25];
+		memcpy(n, e.name, 24);
+		n[24] = '\0';
+		names.insert(Lower(n));
+	}
+	fclose(f);
+}
+
+static unsigned long
+Fnv(unsigned long h, const str &s)
+{
+	for(size_t i = 0; i < s.size(); i++)
+		h = (h ^ (unsigned char)s[i]) * 1099511628211UL;
+	return h;
+}
+
+void
+CModLoader::AddStreamingImage(void)
+{
+	if(!ms_active || ms_streamFiles.empty()) return;
+	if(getenv("REGTA_NO_MODIMG")) return;	// debugging aid
+	for(int i = 0; i < CdStreamGetNumImages(); i++)
+		if(strcmp(CdStreamGetImageName(i), ML_IMG) == 0)
+			return;	// already registered in this session
+
+	// only files that override something already streamed, or that a merged IDE line declares
+	std::set<str> known;
+	CollectDirNames("models/gta3.dir", known);
+	CollectDirNames("models/txd.dir", known);
+	for(int i = 0; i < CdStreamGetNumImages(); i++){
+		char dn[132];
+		strcpy(dn, CdStreamGetImageName(i));
+		char *dot = strrchr(dn, '.');
+		if(dot){
+			strcpy(dot + 1, "dir");
+			CollectDirNames(dn, known);
+		}
+	}
+	std::vector<MlFile> files;
+	for(size_t i = 0; i < ms_streamFiles.size(); i++){
+		const MlFile &f = ms_streamFiles[i];
+		if(f.name.size() <= 24 && (known.count(f.name) || ms_addedModelNames.count(f.name)))
+			files.push_back(f);
+	}
+	if(files.empty()) return;
+
+	mkdir(ML_CACHE, 0755);
+	unsigned long h = 1469598103934665603UL;
+	char tmp[64];
+	for(size_t i = 0; i < files.size(); i++){
+		h = Fnv(h, files[i].full);
+		snprintf(tmp, sizeof(tmp), ":%ld:%ld;", files[i].size, files[i].mtime);
+		h = Fnv(h, tmp);
+	}
+	char sig[32];
+	snprintf(sig, sizeof(sig), "%lx", h);
+	str sigpath = ML_CACHE "/signature";
+	char old[32] = "";
+	if(FILE *s = fopen(sigpath.c_str(), "rb")){
+		if(!fgets(old, sizeof(old), s)) old[0] = '\0';
+		fclose(s);
+	}
+	struct stat st;
+	bool fresh = strcmp(old, sig) == 0 && stat(ML_IMG, &st) == 0 && stat(ML_DIRFILE, &st) == 0;
+	if(!fresh){
+		debug("[modloader] building streaming image (%d files)\n", (int)files.size());
+		FILE *img = fopen(ML_IMG, "wb");
+		FILE *dir = fopen(ML_DIRFILE, "wb");
+		if(img == nil || dir == nil){
+			debug("[modloader] cannot write %s\n", ML_CACHE);
+			if(img) fclose(img);
+			if(dir) fclose(dir);
+			return;
+		}
+		static char zero[ML_SECTOR];
+		uint32 block = 0;
+		std::vector<char> data;
+		for(size_t i = 0; i < files.size(); i++){
+			FILE *in = fopen(files[i].full.c_str(), "rb");
+			if(in == nil) continue;
+			data.resize(files[i].size);
+			size_t got = files[i].size ? fread(&data[0], 1, files[i].size, in) : 0;
+			fclose(in);
+			uint32 nblocks = (uint32)((got + ML_SECTOR - 1) / ML_SECTOR);
+			if(got) fwrite(&data[0], 1, got, img);
+			if(nblocks*ML_SECTOR > got) fwrite(zero, 1, nblocks*ML_SECTOR - got, img);
+			struct { uint32 offset, size; char name[24]; } e;
+			memset(&e, 0, sizeof(e));
+			e.offset = block;
+			e.size = nblocks;
+			strncpy(e.name, files[i].name.c_str(), 23);
+			fwrite(&e, sizeof(e), 1, dir);
+			block += nblocks;
+		}
+		fclose(img);
+		fclose(dir);
+		if(FILE *s = fopen(sigpath.c_str(), "wb")){
+			fputs(sig, s);
+			fclose(s);
+		}
+	}
+	CdStreamAddImage(ML_IMG);
+	debug("[modloader] streaming image registered (%d override/added models)\n", (int)files.size());
+}
+
+bool
+CModLoader::GetImageEntries(std::vector<ImageEntry> &entries, int &imageIndex)
+{
+	imageIndex = -1;
+	for(int i = 0; i < CdStreamGetNumImages(); i++){
+		const char *n = CdStreamGetImageName(i);
+		if(n && strcmp(n, ML_IMG) == 0)
+			imageIndex = i;
+	}
+	if(imageIndex < 0) return false;
+	str path = ms_root.empty() ? str(ML_DIRFILE) : ms_root + "/" ML_DIRFILE;
+	FILE *f = fopen(path.c_str(), "rb");
+	if(f == nil) return false;
+	struct { uint32 offset, size; char name[24]; } e;
+	while(fread(&e, sizeof(e), 1, f) == 1){
+		char n[25];
+		memcpy(n, e.name, 24);
+		n[24] = '\0';
+		str name = n;
+		size_t dot = name.rfind('.');
+		if(dot == str::npos) continue;
+		ImageEntry ie;
+		ie.isTxd = Lower(name.substr(dot+1)) == "txd";
+		ie.name = name.substr(0, dot);
+		ie.offset = e.offset;
+		ie.size = e.size;
+		entries.push_back(ie);
+	}
+	fclose(f);
+	return !entries.empty();
+}
+
+// ---- file redirection / data merging ----
+
+static bool
+ReadAll(const char *path, std::vector<str> &lines)
+{
+	FILE *f = fcaseopen(path, "rb");
+	if(f == nil) return false;
+	char buf[2048];
+	while(fgets(buf, sizeof(buf), f)){
+		str l = buf;
+		while(!l.empty() && (l[l.size()-1] == '\n' || l[l.size()-1] == '\r'))
+			l.erase(l.size()-1);
+		lines.push_back(l);
+	}
+	fclose(f);
+	return true;
+}
+
+static str
+FirstToken(const str &l)
+{
+	str t = Trim(l);
+	size_t e = t.find_first_of(" \t,");
+	return Lower(e == str::npos ? t : t.substr(0, e));
+}
+
+static bool
+IsCommentLine(const str &t)
+{
+	return t.empty() || t[0] == ';' || t[0] == '#' || t[0] == '!' || t[0] == '%';
+}
+
+// Find "<name> ... end" (header line index, line index of its "end")
+static bool
+FindSection(const std::vector<str> &lines, const char *name, size_t &begin, size_t &end)
+{
+	for(size_t i = 0; i < lines.size(); i++){
+		if(Lower(Trim(lines[i])) != name) continue;
+		for(size_t j = i+1; j < lines.size(); j++)
+			if(Lower(Trim(lines[j])) == "end"){
+				begin = i;
+				end = j;
+				return true;
+			}
+		return false;
+	}
+	return false;
+}
+
+// Merge a mod's complete data file into the game's lines:
+//  default.ide  - object lines replace the line with the same model id, new ids are appended in their section
+//  carcols.dat  - "col" lines by index, "car"/"car4" lines by vehicle name
+//  handling.cfg - lines replace/add by vehicle name
+static void
+ApplySource(const str &name, std::vector<str> &lines, const std::vector<str> &src)
+{
+	if(name == "default.ide"){
+		std::map<int, size_t> byId;
+		for(size_t i = 0; i < lines.size(); i++){
+			str t = Trim(lines[i]);
+			if(!t.empty() && isdigit((unsigned char)t[0]))
+				byId[atoi(t.c_str())] = i;
+		}
+		std::map<str, std::vector<str> > added;
+		std::vector<str> order;
+		str section;
+		for(size_t i = 0; i < src.size(); i++){
+			str t = Trim(src[i]), low = Lower(t);
+			if(t.empty() || t[0] == '#') continue;
+			if(low == "end"){ section.clear(); continue; }
+			if(!isdigit((unsigned char)t[0])){ section = low; continue; }
+			std::map<int, size_t>::iterator it = byId.find(atoi(t.c_str()));
+			if(it != byId.end())
+				lines[it->second] = src[i];
+			else if(!section.empty()){
+				if(!added.count(section)) order.push_back(section);
+				added[section].push_back(src[i]);
+			}
+		}
+		for(size_t k = 0; k < order.size(); k++){
+			lines.push_back(order[k]);
+			lines.insert(lines.end(), added[order[k]].begin(), added[order[k]].end());
+			lines.push_back("end");
+		}
+	}else if(name == "carcols.dat"){
+		// like Mod Loader: "col" lines merge by line index, "car"/"car4" lines by model name
+		static const char *secs[] = { "col", "car", "car4" };
+		for(int si = 0; si < 3; si++){
+			size_t sb, se;
+			if(!FindSection(src, secs[si], sb, se)) continue;
+			std::vector<str> modLines;
+			for(size_t i = sb+1; i < se; i++){
+				str t = Trim(src[i]);
+				if(!IsCommentLine(t)) modLines.push_back(src[i]);
+			}
+			if(modLines.empty()) continue;
+			size_t bb, be;
+			if(!FindSection(lines, secs[si], bb, be)){
+				lines.push_back(secs[si]);
+				lines.insert(lines.end(), modLines.begin(), modLines.end());
+				lines.push_back("end");
+				continue;
+			}
+			std::vector<size_t> baseData;
+			for(size_t i = bb+1; i < be; i++)
+				if(!IsCommentLine(Trim(lines[i])))
+					baseData.push_back(i);
+			std::vector<str> add;
+			for(size_t j = 0; j < modLines.size(); j++){
+				if(si == 0){
+					if(j < baseData.size()) lines[baseData[j]] = modLines[j];
+					else add.push_back(modLines[j]);
+				}else{
+					str tok = FirstToken(modLines[j]);
+					bool done = false;
+					for(size_t k = 0; k < baseData.size(); k++)
+						if(FirstToken(lines[baseData[k]]) == tok){ lines[baseData[k]] = modLines[j]; done = true; break; }
+					if(!done) add.push_back(modLines[j]);
+				}
+			}
+			if(!add.empty())
+				lines.insert(lines.begin() + be, add.begin(), add.end());
+		}
+	}else if(GenericMergeMode(name) != 0){
+		auto isData = [](const str &line){
+			str t = Trim(line);
+			return !t.empty() && t[0] != '#' && t[0] != ';' && t.compare(0, 2, "//") != 0;
+		};
+		std::vector<size_t> baseData;
+		for(size_t i = 0; i < lines.size(); i++)
+			if(isData(lines[i])) baseData.push_back(i);
+		size_t j = 0;
+		for(size_t k = 0; k < src.size(); k++){
+			if(!isData(src[k])) continue;
+			if(GenericMergeMode(name) == MERGE_POSITIONAL){
+				if(j < baseData.size()) lines[baseData[j]] = src[k];
+				else lines.push_back(src[k]);
+				j++;
+			}else{
+				str tok = FirstToken(src[k]);
+				bool done = false;
+				for(size_t b = 0; b < baseData.size(); b++)
+					if(FirstToken(lines[baseData[b]]) == tok){ lines[baseData[b]] = src[k]; done = true; break; }
+				if(!done) lines.push_back(src[k]);
+			}
+		}
+	}else if(name == "handling.cfg"){
+		for(size_t k = 0; k < src.size(); k++){
+			str t = Trim(src[k]);
+			if(IsCommentLine(t)) continue;
+			str tok = FirstToken(t);
+			bool done = false;
+			for(size_t i = 0; i < lines.size(); i++){
+				str bl = Trim(lines[i]);
+				if(IsCommentLine(bl)) continue;
+				if(FirstToken(bl) == tok){ lines[i] = src[k]; done = true; break; }
+			}
+			if(!done) lines.push_back(src[k]);
+		}
+	}
+}
+
+static str
+Merge(const str &name, const char *origPath)
+{
+	std::map<str, str>::iterator done = ms_mergedPath.find(name);
+	if(done != ms_mergedPath.end())
+		return done->second;
+
+	const std::vector<str> &extra = ms_extraLines[name];
+	std::vector<str> lines;
+	std::map<str, MlFile>::iterator rep = ms_replace.find(name);
+	if(!ReadAll(rep != ms_replace.end() ? rep->second.full.c_str() : origPath, lines)){
+		debug("[modloader] cannot read %s to merge extra lines\n", origPath);
+		ms_mergedPath[name] = origPath;
+		return origPath;
+	}
+	std::map<str, std::vector<std::vector<str> > >::iterator srcs = ms_dataSources.find(name);
+	if(srcs != ms_dataSources.end())
+		for(size_t i = 0; i < srcs->second.size(); i++)
+			ApplySource(name, lines, srcs->second[i]);
+	str e = Ext(name);
+	if(e == "ide"){
+		lines.insert(lines.end(), extra.begin(), extra.end());
+	}else if(name == "carcols.dat"){
+		size_t at = lines.size();
+		bool inCar = false;
+		for(size_t i = 0; i < lines.size(); i++){
+			str t = Lower(Trim(lines[i]));
+			if(t == "car") inCar = true;
+			else if(inCar && t == "end"){ at = i; break; }
+		}
+		lines.insert(lines.begin() + at, extra.begin(), extra.end());
+	}else if(name == "handling.cfg"){
+		for(size_t k = 0; k < extra.size(); k++){
+			str tok = FirstToken(extra[k]);
+			bool replaced = false;
+			for(size_t i = 0; i < lines.size(); i++){
+				str t = Trim(lines[i]);
+				if(t.empty() || t[0] == ';' || t[0] == '#' || t[0] == '!' || t[0] == '%') continue;
+				if(FirstToken(t) == tok){
+					lines[i] = extra[k];
+					replaced = true;
+					break;
+				}
+			}
+			if(!replaced) lines.push_back(extra[k]);
+		}
+	}else{
+		lines.insert(lines.end(), extra.begin(), extra.end());
+	}
+	str cacheDir = ms_root.empty() ? str(ML_CACHE) : ms_root + "/" ML_CACHE;
+	mkdir(cacheDir.c_str(), 0755);
+	str out = cacheDir + "/merged_" + name;
+	FILE *f = fopen(out.c_str(), "wb");
+	if(f == nil){
+		debug("[modloader] cannot write %s\n", out.c_str());
+		ms_mergedPath[name] = origPath;
+		return origPath;
+	}
+	for(size_t i = 0; i < lines.size(); i++)
+		fprintf(f, "%s\r\n", lines[i].c_str());
+	fclose(f);
+	debug("[modloader] merged %s (%d source file(s), %d readme line(s))\n", name.c_str(),
+		srcs != ms_dataSources.end() ? (int)srcs->second.size() : 0, (int)extra.size());
+	ms_mergedPath[name] = out;
+	return out;
+}
+
+// gta_vc.dat with the mods' extra level files inserted after the last line of their kind
+static str
+MergeGtaDat(const char *origPath)
+{
+	static str mergedPath;
+	static bool done;
+	if(done) return mergedPath;
+	done = true;
+	mergedPath = origPath;
+	std::vector<str> lines;
+	if(!ReadAll(origPath, lines)) return mergedPath;
+
+	struct Kind { const char *ext; const char *prefix; const char *after[3]; };
+	// where each kind goes: after the last line starting with one of "after" (case-insensitive)
+	static const Kind kinds[] = {
+		{ "img", "CDIMAGE ",  { "cdimage", nil, nil } },
+		{ "ide", "IDE ",      { "ide", "cdimage", nil } },
+		{ "col", "COLFILE 0 ",{ "colfile", "ide", "cdimage" } },
+		{ "ipl", "IPL ",      { "ipl", "colfile", "ide" } },
+	};
+	for(size_t k = 0; k < sizeof(kinds)/sizeof(kinds[0]); k++){
+		std::map<str, std::vector<str> >::iterator it = ms_addedLevelFiles.find(kinds[k].ext);
+		if(it == ms_addedLevelFiles.end()) continue;
+		size_t at = 0;
+		bool found = false;
+		for(int a = 0; a < 3 && !found && kinds[k].after[a]; a++){
+			str want = kinds[k].after[a];
+			for(size_t i = 0; i < lines.size(); i++){
+				str low = Lower(Trim(lines[i]));
+				if(low.compare(0, want.size(), want) == 0 && low.size() > want.size() && isspace((unsigned char)low[want.size()])){
+					at = i + 1;
+					found = true;
+				}
+			}
+		}
+		if(!found) at = lines.size();
+		std::vector<str> add;
+		for(size_t i = 0; i < it->second.size(); i++)
+			add.push_back(str(kinds[k].prefix) + it->second[i]);
+		lines.insert(lines.begin() + at, add.begin(), add.end());
+	}
+	str cacheDir = ms_root.empty() ? str(ML_CACHE) : ms_root + "/" ML_CACHE;
+	mkdir(cacheDir.c_str(), 0755);
+	str out = cacheDir + "/merged_gta_vc.dat";
+	if(FILE *f = fopen(out.c_str(), "wb")){
+		for(size_t i = 0; i < lines.size(); i++)
+			fprintf(f, "%s\r\n", lines[i].c_str());
+		fclose(f);
+		mergedPath = out;
+		debug("[modloader] gta_vc.dat extended with mod level files\n");
+	}
+	return mergedPath;
+}
+
+const char *
+CModLoader::Redirect(const char *path)
+{
+	if(!ms_active || path == nil) return path;
+	static thread_local str result;
+	str name = BaseName(path);
+	if(name.empty()) return path;
+	if(getenv("REGTA_TRACE_ML")){
+		str e = Ext(name);
+		if(e == "ide" || e == "dat" || e == "cfg")
+			debug("[modloader] open %s (merge %d)\n", path, (int)(ms_extraLines.count(name) || ms_dataSources.count(name)));
+	}
+	if(name == "gta_vc.dat" && !ms_addedLevelFiles.empty()){
+		result = MergeGtaDat(path);
+		return result.c_str();
+	}
+	if(ms_extraLines.count(name) || ms_dataSources.count(name)){
+		result = Merge(name, path);
+		return result.c_str();
+	}
+	std::map<str, MlFile>::iterator it = ms_replace.find(name);
+	if(it == ms_replace.end()) return path;
+	result = it->second.full;
+	return result.c_str();
+}
diff --git a/src/extras/modloader/ModLoader.h b/src/extras/modloader/ModLoader.h
new file mode 100644
index 00000000..894a3090
--- /dev/null
+++ b/src/extras/modloader/ModLoader.h
@@ -0,0 +1,38 @@
+#pragma once
+
+#include <vector>
+#include <string>
+
+// Native port of thelink2012's Mod Loader for reGTA.
+//
+// Reads modloader/modloader.ini (profile, priorities, ignore lists) and treats every
+// sub-folder of modloader/ as a mod. A mod file replaces the game file with the same name,
+// models/textures that live in a cdimage are streamed from a generated image that is
+// registered last, readme/data lines (IDE, carcols, handling) are merged into the game's
+// data files, and *.asi files inside a mod folder are handed to the plugin loader.
+class CModLoader
+{
+public:
+	// Scan modloader/. Must run before any game data is opened.
+	static void Init(void);
+	// Register the generated cdimage. Must run after gta3.dat has added its CDIMAGE lines
+	// (later images take priority) and before CStreaming::Init.
+	static void AddStreamingImage(void);
+	// Returns the path to open instead of "path" (replacement / merged file), or "path" itself.
+	static const char *Redirect(const char *path);
+	// *.asi files found inside enabled mod folders.
+	static const std::vector<std::string> &GetPluginPaths(void);
+	static bool IsActive(void);
+
+	// An entry of the generated cdimage (name has no extension, offset/size are in sectors).
+	struct ImageEntry {
+		std::string name;
+		bool isTxd;
+		unsigned int offset;
+		unsigned int size;
+	};
+	// Entries of the registered Mod Loader image plus the index it was registered at.
+	// Empty when there is none. Used to override streaming info once every directory is read,
+	// like Mod Loader does, so the result does not depend on the order images were added.
+	static bool GetImageEntries(std::vector<ImageEntry> &entries, int &imageIndex);
+};
