+   depth[i]=y>height*3/4?1:.5f;depth[i+1]=x<8 && y<8 ? 0:u;depth[i+2]=x<8 && y<8 ? 0:v;
+   positions[i]=u*2-1;positions[i+1]=v*2-1;positions[i+3]=1.3f;
+  }
