+
+"// Continuous, low-frequency grime in car coordinates: no screen-space grain or animated noise.\n"
+"float grimeHash(vec2 p)\n"
+"{\n"
+"	ivec2 i=ivec2(p);\n"
+"	uint h=uint(i.x)*0x9E3779B9u ^ uint(i.y)*0x85EBCA6Bu;\n"
+"	h^=h>>16u;h*=0x7FEB352Du;h^=h>>15u;h*=0x846CA68Bu;h^=h>>16u;\n"
