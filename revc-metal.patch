+	bool logHits = true, panels = true;
+	float panelStrength = 1.f, panelCrease = .5f, panelMaxFraction = .4f, panelMaxLift = .55f;
+	float panelMinDepth = .06f, panelCreaseRandomness = .12f;
+	bool panelFollowBody = true, rearLightDamage = true, frontLightDamage = true;
+	float rearLightMinDepth = .08f;
+	bool affectNPCs = true;
+	float npcRange = 100.f;
+	unsigned maxTracked = 64, maxNPCPerFrame = 32, maxTotalVertices = 400000;
+	bool wheelDetach = true;
+	float wheelMinImpact = 0.7f, wheelReach = 2.4f;
+	bool wheelClearance = true;
+	bool wheelByBody = true;
+	float wheelBodyIntrusion = 0.35f;	// fraction of the wheel radius the body must be pushed into it
+	bool structural = true;			// node-and-beam structure instead of the independent dent field
+	bool steerPull = true;
+	bool tearOff = true;
+	float skinDentScale = 0.5f;			// sheet-metal (paint) dents as a fraction of the dent field, always applied
+	std::string rigidFront = "stallion,banshee";	// models with no front crumple zone (engine block up front)
+	int smoothPasses = 2;
+	float smoothAmount = 0.5f;
+	float massStiffness = 1.0f, massCrush = .35f;	// weight scaling of crash damage (see ini)
+	float heavyAttacker = 1.0f, heavyAttackerMax = 4.0f;	// extra crush when hit by a much heavier body
+	float healthLossScale = .4f;	// share of the game's collision health loss that is kept
+	bool classProfiles = true, hangParts = true, stockScale = true, powerLoss = true;
+	bool handlingDamage = true, wheelTilt = true, keepFlipped = true;
+	float hubKnock = .45f;	// hub displacement (m) that tears a wheel off
+	bool weakWheels = true, wheelLock = true;
+	float wheelLockFrom = .45f, wheelLockFull = .80f, wheelJamImpact = .40f;	// bodywork intrusion (fraction of wheel radius) where a wheel starts to drag / is locked
+
+	bool deadDrivers = true, deadHorn = true;
+	float slumpDegrees = 40.f;
+	float steerLockLoss = .9f, steerWobble = .08f;
+	float wrapAround = .8f;	// how strongly the body folds around a thin object (0 = just pushed in)
+	bool extras = true, collisionShape = true, sounds = true, electrics = true;
+	float coolantRate = .012f, overheatRate = .05f, fuelIgnition = .10f, tyreLeak = .025f, balanceScale = 3.f;
+	bool narrowDents = true;
+	float narrowDepthBoost = .6f;	// a pole concentrates the same energy: up to this much deeper
+	bool occupantDamage = true;
+	float occupantPlayerScale = 0.f, occupantMinSpeed = 6.f, occupantFatalSpeed = 17.f, occupantExponent = 1.7f;
+	bool stopWheellessNPCs = true;
+	float rollCrush = .45f;	// share of the car's speed counted when its roof hits the ground
+	float brakeLoss = .7f, gripLoss = .6f, suspensionLoss = .8f, dragLoss = .25f, tiltScale = .8f;
+	float hangFraction = .6f, stockRefImpact = .5f, powerLossMax = .6f;
+	bool glassCrack = true, tyreBurst = true;
+	float glassThreshold = .10f, tyreThreshold = .30f;	// windscreen average / hub displacement (m)
+	float tearDoor = 0.55f, tearBumper = 0.70f, tearLid = 0.75f;	// average displacement (m) that tears a part off
+	bool engineReliability = true;
+	bool engineDamage = true;
+	float engineMaxLoss = 550.f;					// health lost when the engine bay is fully crushed
+	float wheelOffsetScale = 1.0f;				// how far bent hubs drag the visible wheels
+	float steerPullGain = 1.2f;
+} cfg;
+structural::Params structParams;
+
+std::string iniPath, logPath;
+const RegtaPluginAPI *ms_api;
+
+void
+logLine(const char *message)
+{
+	if(FILE *f = fopen(logPath.c_str(), "a")){
+		fprintf(f, "%s\n", message);
+		fclose(f);
+	}
+}
+
+// ---- ini ----
+
+bool
+iniLookup(const char *section, const char *key, std::string &value)
+{
+	FILE *f = fopen(iniPath.c_str(), "rb");
+	if(f == nil) return false;
+	char line[512];
+	std::string cur;
+	bool found = false;
+	while(!found && fgets(line, sizeof(line), f)){
+		char *c = strchr(line, ';');
+		if(c) *c = '\0';
+		std::string l = line;
+		size_t a = l.find_first_not_of(" \t\r\n");
+		if(a == std::string::npos) continue;
+		size_t b = l.find_last_not_of(" \t\r\n");
+		l = l.substr(a, b-a+1);
+		if(l[0] == '['){
+			cur = l.substr(1, l.find(']') - 1);
+			continue;
+		}
+		size_t eq = l.find('=');
+		if(eq == std::string::npos) continue;
+		std::string k = l.substr(0, eq), v = l.substr(eq+1);
+		while(!k.empty() && isspace((unsigned char)k[k.size()-1])) k.erase(k.size()-1);
+		while(!v.empty() && isspace((unsigned char)v[0])) v.erase(0, 1);
+		if(strcasecmp(cur.c_str(), section) == 0 && strcasecmp(k.c_str(), key) == 0){
+			value = v;
+			found = true;
+		}
+	}
+	fclose(f);
+	return found;
+}
+
+float
+setting(const char *key, float fallback, float lo, float hi, const char *section = "Deformation")
+{
+	std::string v;
+	if(!iniLookup(section, key, v)) return fallback;
+	char *end = nullptr;
+	float n = strtof(v.c_str(), &end);
+	if(end == v.c_str() || !std::isfinite(n)) return fallback;
+	return std::min(std::max(n, lo), hi);
+}
+
+int
+iniInt(const char *section, const char *key, int fallback)
+{
+	std::string v;
+	return iniLookup(section, key, v) ? atoi(v.c_str()) : fallback;
+}
+
+// ---- vector helpers ----
+
+Vec vec(const RwV3d &v) { return { v.x, v.y, v.z }; }
+Vec vec(const CVector &v) { return { v.x, v.y, v.z }; }
+RwV3d rwv(Vec v) { RwV3d r; r.x = v.x; r.y = v.y; r.z = v.z; return r; }
+
+dent::Pose poseOf(const RwMatrix &m) { return { vec(m.right), vec(m.up), vec(m.at), vec(m.pos) }; }
+dent::Pose poseOf(CMatrix &m) { return { vec(m.GetRight()), vec(m.GetForward()), vec(m.GetUp()), vec(m.GetPosition()) }; }
+
+// Stock automobile frame transforms are rigid. Reject scaled custom meshes.
+bool
+rigid(const dent::Pose &p)
+{
+	const Vec a = p.right, b = p.forward, c = p.up;
+	return dent::finite(a) && dent::finite(b) && dent::finite(c) && dent::finite(p.position) &&
+		std::fabs(dent::dot(a, a) - 1) < .02f && std::fabs(dent::dot(b, b) - 1) < .02f &&
+		std::fabs(dent::dot(c, c) - 1) < .02f && std::fabs(dent::dot(a, b)) < .02f &&
+		std::fabs(dent::dot(a, c)) < .02f && std::fabs(dent::dot(b, c)) < .02f;
+}
+
+Vec localVector(Vec v, const dent::Pose &p) { return dent::toLocalVector(v, p); }
+Vec localPoint(Vec v, const dent::Pose &p) { return dent::toLocalPoint(v, p); }
+
+// ---- state ----
+
+dent::ContactQueue<> contacts;
+bool gameStopping = false;
+
+enum class PanelKind { None, Bonnet, Boot };
+
+struct PanelData {
+	PanelKind kind = PanelKind::None;
+	bool damaged = false;
+	dent::PanelShape shape;
+	float compression{}, episodeDemand{};
+	std::vector<Vec> base, normals;
+	std::vector<int> sides;
+	dent::SpanFold span;
+	dent::PanelLattice lattice;
+};
+
+struct Mesh {
+	rw::Geometry *original{};
+	rw::Geometry *copy{};
+	std::vector<Vec> rest;
+	PanelData panel;
+	RpAtomic *atomic{};
+	RwFrame *frame{};
+	std::vector<Vec> carRest;			// rest position of each vertex in the car's frame (structural mode)
+	std::vector<Vec> restNormals;			// vertex normals before any damage (structural mode)
+	std::vector<int> weld;				// normal-smoothing group of each vertex (vertices that share a spot and a facing)
+	int weldCount{};
+	float windingSign{ 1.f };
+	std::vector<int> adjStart, adjList;		// vertex neighbours along mesh edges (displacement smoothing)
+	std::vector<Vec> dentDisp;			// sheet-metal dent layer on top of the frame (atomic-local displacement)
+	std::vector<structural::SkinSample> skin;
+	unsigned episodeId{};
+	float episodeDepth{}, episodeRadius{};
+	~Mesh()
+	{
+		if(copy) copy->destroy();
+		if(original) original->destroy();
+	}
+};
