+// ---- keys, crouch and walk (Main.cpp: WalkKeyDown / DuckKeyDown / SetDuck / ClearDuck) ----
+
+static int
+CA_StringToKey(const std::string &name)
+{
+	std::string n = name;
+	for(size_t i = 0; i < n.size(); i++) n[i] = toupper((unsigned char)n[i]);
+	if(n.empty() || n == "NULL") return -1;
+	if(n.size() == 1 && ((n[0] >= 'A' && n[0] <= 'Z') || (n[0] >= '0' && n[0] <= '9'))) return n[0];	// GLFW uses ASCII for these
+	if(n == "LALT") return GLFW_KEY_LEFT_ALT;
+	if(n == "RALT") return GLFW_KEY_RIGHT_ALT;
+	if(n == "LSHIFT") return GLFW_KEY_LEFT_SHIFT;
+	if(n == "RSHIFT") return GLFW_KEY_RIGHT_SHIFT;
+	if(n == "LCTRL" || n == "LCONTROL") return GLFW_KEY_LEFT_CONTROL;
+	if(n == "RCTRL" || n == "RCONTROL") return GLFW_KEY_RIGHT_CONTROL;
+	if(n == "SPACE") return GLFW_KEY_SPACE;
+	if(n == "TAB") return GLFW_KEY_TAB;
+	if(n == "CAPSLOCK" || n == "CAPS") return GLFW_KEY_CAPS_LOCK;
+	return -1;
+}
+
+static bool
+CA_KeyDown(int key)
+{
+	if(key < 0 || PSGLOBAL(window) == nil) return false;
+	return glfwGetKey(PSGLOBAL(window), key) == GLFW_PRESS;
+}
+
+static bool
+CA_CanDuckWithThisWeapon(eWeaponType w)
+{
+	return w == WEAPONTYPE_COLT45 || w == WEAPONTYPE_UZI || w == WEAPONTYPE_RUGER || w == WEAPONTYPE_M4;
+}
+
+static bool
+CA_IsAbleToAim(CPed *ped)
+{
+	eWeaponType w = ped->m_weapons[ped->m_currentWeapon].m_eWeaponType;
+	if(w == WEAPONTYPE_UNARMED) return false;
+	switch(ped->m_nPedState){
+	case PED_NONE:
+	case PED_IDLE:
+	case PED_FLEE_POS:
+	case PED_FLEE_ENTITY:
+	case PED_ATTACK:
+	case PED_FIGHT:
+	case PED_AIM_GUN:
+		return ped->m_nMoveState != PEDMOVE_SPRINT && ped->IsPedInControl();
+	default:
+		return false;
+	}
+}
+
+static void
+CA_SetDuck(CPlayerPed *ped)
+{
+	if(ped->bIsDucking || CTimer::GetTimeInMilliseconds() <= ped->m_duckTimer){
+		if(CTimer::GetTimeInMilliseconds() + 60000 > ped->m_duckTimer)
+			ped->m_duckTimer = CTimer::GetTimeInMilliseconds() + 60000;
+		return;
+	}
+	CAnimBlendAssociation *duckAssoc = RpAnimBlendClumpGetAssociation(ped->GetClump(), ANIM_STD_DUCK_DOWN);
+	if(!duckAssoc || duckAssoc->blendDelta < 0.0f){
+		CAnimManager::BlendAnimation(ped->GetClump(), ASSOCGRP_STD, ANIM_STD_DUCK_DOWN, 4.0f);
+		ped->bIsDucking = true;
+		ped->m_duckTimer = CTimer::GetTimeInMilliseconds() + 60000;
+	}
+}
+
+static void
+CA_ClearDuck(CPlayerPed *ped)
+{
+	CAnimBlendAssociation *a = RpAnimBlendClumpGetAssociation(ped->GetClump(), ANIM_STD_DUCK_DOWN);
+	if(!a) a = RpAnimBlendClumpGetAssociation(ped->GetClump(), ANIM_STD_DUCK_LOW);
+	if(!a) a = RpAnimBlendClumpGetAssociation(ped->GetClump(), ANIM_STD_RBLOCK_SHOOT);
+	if(a){
+		a->flags |= ASSOC_DELETEFADEDOUT;
+		a->blendDelta = -4.0f;
+	}
+	ped->bIsDucking = false;
+	ped->m_duckTimer = 0;
+	ped->bCrouchWhenShooting = false;
+	ped->RestorePreviousState();
+}
+
+// ---- crouched shooting, mouse target, aiming state ----
+
+static CWeaponInfo ca_savedWeaponInfo;
+static CWeaponInfo *ca_modifiedWeaponInfo;
+static int32 ca_mouseTargetHandle = -1;
+
+// While crouching the weapon plays the crouch-and-shoot animation and cannot aim with one arm.
+static void
+CA_AdjustWeaponInfoForCrouch(CPlayerPed *ped)
+{
+	if(!ped->bIsDucking) return;
+	CWeaponInfo *info = CWeaponInfo::GetWeaponInfo(ped->m_weapons[ped->m_currentWeapon].m_eWeaponType);
+	if(!info) return;
+	ca_savedWeaponInfo = *info;
+	ca_modifiedWeaponInfo = info;
+	info->m_Flags |= WEAPONFLAG_CROUCHFIRE;
+	info->m_fAnimLoopStart = Min(info->m_fAnimLoopStart, 12.0f / 30.0f);
+	info->m_fAnimLoopEnd = Min(info->m_fAnimLoopEnd, 15.0f / 30.0f);
+	info->m_fAnimFrameFire = Min(info->m_fAnimFrameFire, 14.0f / 30.0f);
+	info->m_fAnim2FrameFire = info->m_fAnimFrameFire;
+	info->m_Flags &= ~WEAPONFLAG_CANAIM_WITHARM;
+}
+
+void
+ClassicAxis::AfterPlayerControl(CPlayerPed *ped)
+{
+	if(ca_modifiedWeaponInfo){
+		*ca_modifiedWeaponInfo = ca_savedWeaponInfo;
+		ca_modifiedWeaponInfo = nil;
+	}
+}
+
+bool
+ClassicAxis::IsAiming(void)
+{
+	CPlayerPed *p = FindPlayerPed();
+	if(!p || p->bInVehicle) return false;
+	if(p->m_weapons[p->m_currentWeapon].m_eWeaponType == WEAPONTYPE_UNARMED) return false;
+	return CPad::GetPad(0)->GetTarget() || p->m_nPedState == PED_AIM_GUN;
+}
+
+// The pedestrian under the crosshair while aiming with the mouse: it notices the gun and gets the triangle.
+static void
+CA_FindMouseTarget(CPlayerPed *ped)
+{
+	if(CPad::IsAffectedByController){
+		ca_mouseTargetHandle = -1;
+		return;
+	}
+	if(ClassicAxis::IsAiming()){
+		CCam *cam = &TheCamera.Cams[TheCamera.ActiveCam];
+		CWeaponInfo *info = CWeaponInfo::GetWeaponInfo(ped->m_weapons[ped->m_currentWeapon].m_eWeaponType);
+		CVector source, target;
+		CColPoint point;
+		CEntity *e = nil;
+		TheCamera.Find3rdPersonCamTargetVector(info->m_fRange, cam->Source, source, target);
+		if(CWorld::ProcessLineOfSight(source, target, point, e, false, false, true, false, false, false, false)){
+			if(e && e->IsPed()){
+				CPed *t = (CPed*)e;
+				if(t != ped && t->m_nPedState != PED_DEAD && t->m_nPedState != PED_DIE){
+					int32 h = CPools::GetPedRef(t);
+					if(h != ca_mouseTargetHandle){
+						ca_mouseTargetHandle = h;
+						if(t->CanSeeEntity(ped, DEGTORAD(60.0f) * 2))
+							t->ReactToPointGun(ped);
+					}
+				}
+			}
+			return;
+		}
+	}
+	ca_mouseTargetHandle = -1;
+}
+
+static void
+CA_DrawTriangle(float x, float y, float w, float h, float angle, const CRGBA &col)
+{
+	float px[4] = { x + w * 0.5f, x - w * 0.5f, x, x };
+	float py[4] = { y - h * 0.5f, y - h * 0.5f, y + h * 0.5f, y + h * 0.5f };
+	float s = sinf(angle), c = cosf(angle);
+	for(int i = 0; i < 4; i++){
+		float dx = px[i] - x, dy = py[i] - y;
+		px[i] = x + dx * c + dy * s;
+		py[i] = y - dx * s + dy * c;
+	}
+	CSprite2d::SetVertices(px[0], py[0], px[1], py[1], px[2], py[2], px[3], py[3], col, col, col, col);
+	RwRenderStateSet(rwRENDERSTATETEXTURERASTER, nil);
+	RwRenderStateSet(rwRENDERSTATESHADEMODE, (void*)rwSHADEMODEFLAT);
+	RwRenderStateSet(rwRENDERSTATEVERTEXALPHAENABLE, (void*)(col.a != 255));
+	RwIm2DRenderPrimitive(rwPRIMTYPETRIFAN, CSprite2d::GetVertices(), 4);
+	RwRenderStateSet(rwRENDERSTATESHADEMODE, (void*)rwSHADEMODEGOURAUD);
+}
+
+void
+ClassicAxis::DrawHud(void)
+{
+	if(!enabled || !settings.showTriangleForMouseRecruit || ca_mouseTargetHandle < 0) return;
+	if(TheCamera.m_uiTransitionState != 0) return;
+	CPlayerPed *ped = FindPlayerPed();
+	CPed *t = CPools::GetPed(ca_mouseTargetHandle);
+	if(!ped || !t || !ped->OurPedCanSeeThisOne(t)) return;
+
+	RwRenderStateSet(rwRENDERSTATEVERTEXALPHAENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATESRCBLEND, (void*)rwBLENDSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATEDESTBLEND, (void*)rwBLENDINVSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATEFOGENABLE, (void*)FALSE);
+	RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, (void*)FALSE);
+	RwRenderStateSet(rwRENDERSTATEZTESTENABLE, (void*)FALSE);
+
+	RwV3d in = { t->GetPosition().x, t->GetPosition().y, t->GetPosition().z }, out;
+	float w, h;
+	t->m_pedIK.GetComponentPosition(in, 1);
+	in.z += 1.0f;
+	float health = Clamp(t->m_fHealth / 100.0f, 0.0f, 1.0f);
+	CRGBA col((1.0f - health) * 255, health * 255, 0, 150);
+	if(t->m_fHealth <= 0.0f) col = CRGBA(0, 0, 0, 255);
+	if(CSprite::CalcScreenCoors(in, &out, &w, &h, false)){
+		float dist = Clamp(w / 128.0f, 0.0f, 1.0f);
+		CA_DrawTriangle(out.x, out.y, SCREEN_SCALE_Y(20.0f * dist), SCREEN_SCALE_Y(10.0f * dist), DEGTORAD(180.0f), col);
+	}
+}
+
+void
+ClassicAxis::BeforePlayerControl(CPlayerPed *ped)
+{
+	if(ped == FindPlayerPed()){
+		CA_AdjustWeaponInfoForCrouch(ped);
+		CA_FindMouseTarget(ped);
+	}
+	if(ped != FindPlayerPed()) return;
+	CPad *pad = CPad::GetPad(0);
+
+	static int walkKey = -2, crouchKey = -2;
+	static bool crouchWasDown;
+	if(walkKey == -2){
+		walkKey = CA_StringToKey(settings.walkKey);
+		crouchKey = CA_StringToKey(settings.crouchKey);
+	}
+
+	static bool trace = getenv("REGTA_TRACE_CA") != nil;
+	if(trace){
+		static bool lastWalk, lastCrouch;
+		static int tick;
+		bool w = CA_KeyDown(walkKey), c = CA_KeyDown(crouchKey);
+		if(w != lastWalk || c != lastCrouch || ++tick % 300 == 0){
+			debug("[ClassicAxis] keys: walk(%s=%d)=%d crouch(%s=%d)=%d | controlsDisabled=%d weapon=%d state=%d ducking=%d ableToAim=%d stick=(%d,%d)\n",
+				settings.walkKey.c_str(), walkKey, (int)w, settings.crouchKey.c_str(), crouchKey, (int)c,
+				(int)pad->ArePlayerControlsDisabled(), (int)ped->m_weapons[ped->m_currentWeapon].m_eWeaponType,
+				(int)ped->m_nPedState, (int)ped->bIsDucking, (int)CA_IsAbleToAim(ped),
+				(int)pad->NewState.LeftStickX, (int)pad->NewState.LeftStickY);
+			lastWalk = w; lastCrouch = c;
+		}
+	}
+
+	if(pad->ArePlayerControlsDisabled()){
+		crouchWasDown = CA_KeyDown(crouchKey);
+		return;
+	}
+
+	// walk key: cap the stick at walking speed (keyboard movement is always full tilt)
+	if(CA_KeyDown(walkKey)){
+		const float maxMag = 60.0f;	// PAD_MOVE_TO_GAME_WORLD_MOVE: walking speed
+		float x = pad->NewState.LeftStickX, y = pad->NewState.LeftStickY;
+		float mag = sqrtf(x*x + y*y);
+		if(mag > maxMag){
+			pad->NewState.LeftStickX = (int16)(x * maxMag / mag);
+			pad->NewState.LeftStickY = (int16)(y * maxMag / mag);
+		}
+	}
+
+	// crouch key (toggle)
+	bool down = CA_KeyDown(crouchKey);
+	bool duckJustDown = down && !crouchWasDown;
+	crouchWasDown = down;
+	if(crouchKey < 0) return;
+
+	eWeaponType weapon = ped->m_weapons[ped->m_currentWeapon].m_eWeaponType;
+	if(!CA_IsAbleToAim(ped) && !ped->bIsDucking) return;
+
+	if(!ped->bIsDucking && duckJustDown && ped->m_nMoveState != PEDMOVE_SPRINT){
+		ped->bCrouchWhenShooting = true;
+		CA_SetDuck(ped);
+	}else if(ped->bIsDucking && (duckJustDown || ped->m_nMoveState == PEDMOVE_SPRINT || pad->GetSprint() ||
+	         pad->JumpJustDown() || pad->ExitVehicleJustDown() || (pad->GetWeapon() && !CA_CanDuckWithThisWeapon(weapon)))){
+		CA_ClearDuck(ped);
+	}
+
+	if(ped->bIsDucking){
+		// keep the crouch alive (the engine clears it when the timer runs out)
+		if(CTimer::GetTimeInMilliseconds() + 60000 > ped->m_duckTimer)
+			ped->m_duckTimer = CTimer::GetTimeInMilliseconds() + 60000;
+	}
+}
+
+bool
+ClassicAxis::IsCrouchKeyDown(void)
+{
+	static int key = -2;
+	if(key == -2) key = CA_StringToKey(settings.crouchKey);
+	return CA_KeyDown(key);
+}
