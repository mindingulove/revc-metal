diff --git a/tools-mtl/metalfx-endurance-test.mm b/tools-mtl/metalfx-endurance-test.mm
new file mode 100644
index 00000000..96cefb49
--- /dev/null
+++ b/tools-mtl/metalfx-endurance-test.mm
@@ -0,0 +1,28 @@
+#import <Metal/Metal.h>
+#include "mtlgl.h"
+#include "metalfx/MetalFXBridge.h"
+#include <cassert>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+extern "C" int revcMetalFXEnduranceTest(int argc,char**argv){@autoreleasepool{
+ int frames=argc>1?atoi(argv[1]):100000;assert(mtlglInit(nullptr,320,180));unsigned ids[MFX_NUM_TEXTURES];assert(mfxSetup(320,180,640,360,ids));
+ id<MTLDevice> dev=(__bridge id<MTLDevice>)mtlglDevice();id<MTLCommandQueue> queue=(__bridge id<MTLCommandQueue>)mtlglCommandQueue();
+ // Initialise private input textures through the same queue as the scaler; no window/game.
+ for(int i:{MFX_COLOR,MFX_DEPTH,MFX_MOTION,MFX_REACTIVE}){
+  id<MTLTexture> t=(__bridge id<MTLTexture>)mtlglTexture(ids[i]);size_t bpp=i==MFX_MOTION?8:i==MFX_REACTIVE?1:4;
+  std::vector<unsigned char> bytes(320*180*bpp,0);
+  if(i==MFX_COLOR)for(size_t k=0;k<bytes.size();k+=4){bytes[k]=64;bytes[k+1]=96;bytes[k+2]=128;bytes[k+3]=255;}
+  if(i==MFX_DEPTH){float *f=(float*)bytes.data();for(int k=0;k<320*180;k++)f[k]=.5f;}
+  id<MTLBuffer> buffer=[dev newBufferWithBytes:bytes.data() length:bytes.size() options:MTLResourceStorageModeShared];id<MTLCommandBuffer> cb=[queue commandBuffer];id<MTLBlitCommandEncoder> b=[cb blitCommandEncoder];
+  [b copyFromBuffer:buffer sourceOffset:0 sourceBytesPerRow:320*bpp sourceBytesPerImage:bytes.size() sourceSize:MTLSizeMake(320,180,1) toTexture:t destinationSlice:0 destinationLevel:0 destinationOrigin:MTLOriginMake(0,0,0)];[b endEncoding];[cb commit];[cb waitUntilCompleted];assert(cb.status==MTLCommandBufferStatusCompleted);
+ }
+ for(int frame=0;frame<frames;frame++){@autoreleasepool{
+  assert(mfxRun((frame%2)*.5f-.25f,((frame/2)%2)*.5f-.25f,frame==0));
+  // Bounded two-frame overlap, matching a real presentation workload.
+  if(frame%2==1){id<MTLCommandBuffer> fence=[queue commandBuffer];[fence commit];[fence waitUntilCompleted];assert(fence.status==MTLCommandBufferStatusCompleted);}
+  if((frame+1)%10000==0){printf("MetalFX temporal endurance: %d/%d inferences completed\n",frame+1,frames);fflush(stdout);}
+ }}
+ id<MTLCommandBuffer> fence=[queue commandBuffer];[fence commit];[fence waitUntilCompleted];assert(fence.status==MTLCommandBufferStatusCompleted);
+ printf("PASS MetalFX temporal %d inferences, two-frame overlap, same scaler, no window/game launched.\n",frames);fflush(stdout);std::_Exit(0);
+}}
