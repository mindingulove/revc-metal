+OP(opOpenFile)
+{
+	Arg name = ReadArg(s);
+	bool modeIsStr = NextType(s) == 14;
+	Arg mode = ReadArg(s);
+	char m[16] = "r";
+	if(modeIsStr) strncpy(m, Str(mode), 15);
+	else{ memcpy(m, &mode.i, 4); m[4] = 0; }
+	FILE *f = fopen(Slashes(Str(name)).c_str(), m);
+	if(f){
+		gFiles.push_back(f);
+		Store(s, (int32_t)(VA_FILE + (gFiles.size() - 1) * 4));
