+
+// ---- extra damage systems -------------------------------------------------------------------------------------
+// Cooling, fuel, drivetrain, slow punctures, dragging parts, electrics, balance and the car's collision shape. They
+// all read how far the frame was bent (nose, tail, engine bay, wheel hubs, parts) and act on the car each frame.
+
+std::set<CVehicle*> leakFires;	// cars set alight by a fuel leak (the flipped-car fire guard leaves these alone)
+
+float
+hash01(uint32_t x)
+{
+	x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16;
+	return (x & 0xFFFFFF) / 16777216.0f;
+}
+
+float
+rand01(void)
+{
+	return CGeneral::GetRandomNumberInRange(0.0f, 1.0f);
+}
+
+void
+sparksAt(const CVector &pos, const CVector &back)
+{
+	for(int i = 0; i < 2; i++){
+		CVector dir = back * CGeneral::GetRandomNumberInRange(0.01f, 0.05f);
+		dir.z += CGeneral::GetRandomNumberInRange(0.01f, 0.05f);
+		dir.x += CGeneral::GetRandomNumberInRange(-0.02f, 0.02f);
+		CParticle::AddParticle(PARTICLE_SPARK, pos, dir);
+	}
+}
+
+void
+updateDamagedCollision(Car &c)
+{
+	if(!cfg.collisionShape || !c.st) return;
+	CVehicle *v = c.vehicle;
+	if(c.bodyBend < 0.03f && !v->m_pDamagedColModel) return;
+	uint32_t now = CTimer::GetTimeInMilliseconds();
+	if(now - c.colStamp < 500) return;
+	c.colStamp = now;
+	CBaseModelInfo *mi = CModelInfo::GetModelInfo(v->GetModelIndex());
+	CColModel *orig = mi ? mi->GetColModel() : nullptr;
+	if(!orig || (!orig->numSpheres && !orig->numBoxes && !orig->numTriangles)) return;
+	CColModel *d = v->m_pDamagedColModel;
+	if(!d){
+		d = new CColModel;
+		d->level = orig->level;
+		d->ownsCollisionVolumes = true;
+		v->m_pDamagedColModel = d;
+	}
+	CCollision::ReleaseTrianglePlanes(d);	// the collision code rebuilds the planes for the new shape when needed
+	*d = *orig;	// start from the undamaged shape every time, then move it with the frame
+	auto disp = [&](const CVector &p) {
+		Vec dv = structural::displacement(*c.st, structural::skinFor(*c.st, vec(p)));
+		return CVector(dv.x, dv.y, dv.z);
+	};
+	for(int i = 0; i < d->numSpheres; i++) d->spheres[i].center += disp(d->spheres[i].center);
+	for(int i = 0; i < d->numBoxes; i++){
+		CVector a = d->boxes[i].min + disp(d->boxes[i].min), b = d->boxes[i].max + disp(d->boxes[i].max);
+		d->boxes[i].min = CVector(Min(a.x, b.x), Min(a.y, b.y), Min(a.z, b.z));
+		d->boxes[i].max = CVector(Max(a.x, b.x), Max(a.y, b.y), Max(a.z, b.z));
+	}
+	int numVerts = 0;
+	for(int i = 0; i < d->numTriangles; i++)
+		numVerts = Max(numVerts, Max(d->triangles[i].a, Max(d->triangles[i].b, d->triangles[i].c)) + 1);
+	if(d->vertices)
+		for(int i = 0; i < numVerts; i++){
+			CVector p = d->vertices[i].Get();
+			p += disp(p);
+			d->vertices[i].Set(p.x, p.y, p.z);
+		}
+	// new bounds
+	CVector lo(1e9f, 1e9f, 1e9f), hi(-1e9f, -1e9f, -1e9f);
+	auto grow = [&](const CVector &p, float r) {
+		lo = CVector(Min(lo.x, p.x - r), Min(lo.y, p.y - r), Min(lo.z, p.z - r));
+		hi = CVector(Max(hi.x, p.x + r), Max(hi.y, p.y + r), Max(hi.z, p.z + r));
+	};
+	for(int i = 0; i < d->numSpheres; i++) grow(d->spheres[i].center, d->spheres[i].radius);
+	for(int i = 0; i < d->numBoxes; i++){ grow(d->boxes[i].min, 0.f); grow(d->boxes[i].max, 0.f); }
+	for(int i = 0; i < numVerts && d->vertices; i++) grow(d->vertices[i].Get(), 0.f);
+	if(lo.x < hi.x){
+		d->boundingBox.min = lo;
+		d->boundingBox.max = hi;
+		CVector centre = (lo + hi) * 0.5f;
+		d->boundingSphere.center = centre;
+		d->boundingSphere.radius = (hi - centre).Magnitude();
+	}
+}
+
+CVector
+nodeWorld(CAutomobile *car, int node, float drop)
+{
+	RwFrame *f = car->m_aCarNodes[node];
+	CVector p = car->GetPosition();
+	if(f){ RwV3d q = RwFrameGetLTM(f)->pos; p = CVector(q.x, q.y, q.z); }
+	p.z -= drop;
+	return p;
+}
+
+void
+processExtras(Car &c)
+{
+	if(!cfg.extras || !c.vehicle->IsCar()) return;
+	CAutomobile *car = (CAutomobile*)c.vehicle;
+	if(!clumpOf(car)) return;
+	const uint32_t now = CTimer::GetTimeInMilliseconds();
+	const float dt = std::min(CTimer::GetTimeStepInMilliseconds() * 0.001f, 0.1f);
+	const float speed = std::sqrt(car->m_vecMoveSpeed.MagnitudeSqr()) * 50.0f;	// m/s
+	const bool running = car->bEngineOn && (car->GetStatus() == STATUS_PLAYER || car->GetStatus() == STATUS_PHYSICS);
+	const bool onGround = car->m_nWheelsOnGround >= 2;
+	const float gas = std::fabs(car->m_fGasPedal);
+	c.sparking = false;
+	if(!c.st) return;
+	CBaseModelInfo *mi = CModelInfo::GetModelInfo(car->GetModelIndex());
+	CVector backDir = -car->GetForward();
+
+	// 1. cooling: a crushed nose breaks the radiator
+	if(c.frontCrush > .10f)
+		c.coolantLeak = std::max(c.coolantLeak, std::min(1.f, (c.frontCrush - .10f) / .30f));
+	if(c.coolantLeak > 0.f) c.coolant = std::max(0.f, c.coolant - c.coolantLeak * cfg.coolantRate * dt);
+	if(running && c.coolant < .85f)
+		c.overheat = std::min(1.f, c.overheat + (1.f - c.coolant) * cfg.overheatRate * (.4f + .6f * gas) * dt);
+	else
+		c.overheat = std::max(0.f, c.overheat - .03f * dt);
+	if(c.overheat > .35f && mi && now >= c.nextSteam){
+		c.nextSteam = now + (c.overheat > .8f ? 90 : 190);
+		CVector pos = car->GetMatrix() * (((CVehicleModelInfo*)mi)->m_positions[CAR_POS_HEADLIGHTS] + CVector(0.f, .15f, .35f));
+		CParticle::AddParticle(PARTICLE_ENGINE_STEAM, pos, CVector(0.f, 0.f, CGeneral::GetRandomNumberInRange(0.02f, 0.07f)), nil, .45f);
+	}
+
+	// 2. fuel: a crushed tail or a roll over the roof tears the tank
+	float tankFromRear = std::min(1.f, std::max(0.f, (c.rearCrush - .15f) / .30f));
+	float tankFromRoll = (car->GetUp().z < .3f && c.roofBend > .08f) ? .6f : 0.f;
+	c.fuelLeak = std::max(c.fuelLeak, std::max(tankFromRear, tankFromRoll));
+
+	// 3. parts dragging: a bumper hanging off its mounts scrapes the road
+	const float hangAt = cfg.tearBumper * cfg.hangFraction * .8f;
+	bool dragFront = !(c.torn & (1u << 6)) && c.partDisp[6] > hangAt;
+	bool dragRear = !(c.torn & (1u << 7)) && c.partDisp[7] > hangAt;
+	if((dragFront || dragRear) && running && onGround && speed > 3.f && now >= c.nextSpark){
+		c.nextSpark = now + 55 + (uint32_t)CGeneral::GetRandomNumberInRange(0, 70);
+		if(dragFront) sparksAt(nodeWorld(car, CAR_BUMP_FRONT, .25f), backDir);
+		if(dragRear) sparksAt(nodeWorld(car, CAR_BUMP_REAR, .25f), backDir);
+		c.sparking = true;
+	}
+	if(cfg.sounds && (dragFront || dragRear || c.hung) && speed > 2.f && now >= c.nextRattle){
+		c.nextRattle = now + 550;
+		DMAudio.PlayOneShot(car->m_audioEntityId, SOUND_CAR_DOOR_CLOSE_BUMPER, dragFront || dragRear ? .6f : .35f);
+	}
+
+	// 4. tyres: a bent hub or a rim hit loses air slowly; a burst tyre throws sparks from the rim
+	for(int i = 0; i < 4; i++){
+		int status = car->Damage.GetWheelStatus(kWheels[i].wheel);
+		float hub = std::sqrt(c.hubD[i][0] * c.hubD[i][0] + c.hubD[i][1] * c.hubD[i][1] + c.hubD[i][2] * c.hubD[i][2]);
+		if(status == WHEEL_STATUS_OK){
+			float leak = std::min(1.f, std::max(0.f, (hub - .12f) / .30f)) * cfg.tyreLeak;
+			c.tyrePressure[i] = std::max(0.f, c.tyrePressure[i] - leak * dt);
+			if(c.tyrePressure[i] <= 0.f){
+				car->BurstTyre(kWheels[i].wheel, true);
+				if(cfg.logHits) logLine("TyreBurst: slow puncture ran out of air");
+			}
+		}else if(status == WHEEL_STATUS_BURST && running && onGround && speed > 2.f && now >= c.nextSpark){
+			c.nextSpark = now + 80;
+			sparksAt(nodeWorld(car, kWheels[i].node, .25f), backDir);
+			c.sparking = true;
+		}
+	}
+
+	// 2 again: a leaking tank ignites from sparks, a boiling engine, or smouldering damage
+	if(c.fuelLeak > .05f && car->m_fHealth > 260.f && !car->m_pSetOnFireEntity){
+		float source = (c.sparking ? 1.f : 0.f) + (c.overheat > .85f ? .5f : 0.f) +
+			(car->Damage.GetEngineStatus() >= ENGINE_STATUS_SMOKE ? .3f : 0.f) + (running && c.fuelLeak > .5f ? .03f : 0.f);
+		if(source > 0.f && rand01() < cfg.fuelIgnition * c.fuelLeak * source * dt){
+			car->m_fHealth = 240.0f;
+			leakFires.insert(car);
+			if(cfg.logHits) logLine("FuelLeak: the leaking tank caught fire");
+		}
+	}
+
+	// 1. drivetrain: a damaged gearbox slips; a hot or smashed engine stalls
+	c.gearbox = std::max(0.f, 1.f - c.engineFrac * .7f - std::min(1.f, c.rearCrush / .6f) * .5f);
+	if(running && now >= c.slipUntil && c.gearbox < .7f && gas > .3f && rand01() < (1.f - c.gearbox) * .3f * dt)
+		c.slipUntil = now + 250 + (uint32_t)CGeneral::GetRandomNumberInRange(0, 300);
+
+
+	// 7. electrics: a crushed nose / engine bay makes the headlights flicker
+	if(cfg.electrics){
+		float electrical = std::max(.1f, 1.f - c.frontCrush / .5f - c.engineFrac * .4f);
+		if(electrical < .75f && car->bLightsOn && hash01((now / 110) + (uint32_t)c.handle * 31u) < (1.f - electrical) * .7f)
+			car->bLightsOn = false;
+	}
+
+	// 9. balance: lost parts move the centre of mass (a missing front bumper or wheel shifts weight rearward / sideways)
+	{
+		float mx = 0.f, my = 0.f;
+		auto lose = [&](bool missing, int node, float kg){
+			if(!missing || !car->m_aCarNodes[node]) return;
+			RwV3d p = RwFrameGetMatrix(car->m_aCarNodes[node])->pos;
+			mx += kg * p.x;
+			my += kg * p.y;
+		};
+		for(int i = 0; i < 4; i++) lose(car->Damage.GetWheelStatus(kWheels[i].wheel) == WHEEL_STATUS_MISSING, kWheels[i].node, 20.f);
+		for(int i = 0; i < 8; i++){
+			const TearPart &tp = kParts[i];
+			bool missing = tp.bumper ? car->Damage.GetPanelStatus(tp.id) == PANEL_STATUS_MISSING : car->Damage.GetDoorStatus(tp.id) == DOOR_STATUS_MISSING;
+			lose(missing, tp.node, tp.bumper ? 18.f : (i >= 4 ? 26.f : 22.f));
+		}
+		float mass = std::max(500.f, car->m_fMass);
+		c.comX = -mx / mass * cfg.balanceScale;	// kg*m / kg, scaled: weight moves away from what was lost
+		c.comY = -my / mass * cfg.balanceScale;
+	}
+
+	updateDamagedCollision(c);
+}
+
+
+// ---- damage kept in saved games ---------------------------------------------------------------------------------------
+// The game saves its own damage flags for the cars it keeps (garage and mission cars) but not how the body is bent. The
+// crumpled shape of every damaged car is written to userfiles/LocalDent_slotN.dat when the game is saved. After a load the
+// file is read back and each car of the same model standing where it was saved gets its shape and extra damage again.
+
+struct SavedCar {
+	int model{};
+	float pos[3]{};
+	std::vector<float> disp;
+	float scalars[24]{};
+	uint32_t torn{};
+	bool glass{};
+};
+std::vector<SavedCar> savedCars;
+uint32_t savedExpire = 0;
+
+std::string
+slotFile(int slot)
+{
+	char b[96];
+	snprintf(b, sizeof(b), "userfiles/LocalDent_slot%d.dat", slot);
+	return b;
+}
+
+void
+processRestore(void)
+{
+	if(savedCars.empty()) return;
+	uint32_t now = CTimer::GetTimeInMilliseconds();
+	if(now > savedExpire){ savedCars.clear(); return; }
+	auto *pool = CPools::GetVehiclePool();
+	for(int i = 0; i < pool->GetSize() && !savedCars.empty(); ++i){
+		CVehicle *v = pool->GetSlot(i);
+		if(!v || !isDentableCar(v) || !clumpOf(v)) continue;
+		bool known = false;
+		for(auto &c : context->cars) if(c->vehicle == v){ known = true; break; }
+		if(known) continue;
+		for(size_t k = 0; k < savedCars.size(); k++){
+			SavedCar &sc = savedCars[k];
+			if(sc.model != v->GetModelIndex()) continue;
+			CVector d = v->GetPosition() - CVector(sc.pos[0], sc.pos[1], sc.pos[2]);
+			if(d.Magnitude() > 4.0f) continue;
+			if(!reserveCarSlot(nullptr, now)) return;
+			auto fresh = std::make_unique<Car>();
+			fresh->vehicle = v;
+			fresh->handle = CPools::GetVehicleRef(v);
+			fresh->clump = clumpOf(v);
+			fresh->panelSeed = now ^ ((uint32_t)fresh->handle * 0x9e3779b9u);
+			fresh->lastHealth = v->m_fHealth;
+			fresh->lastTouched = now;
+			Car *car = fresh.get();
+			context->cars.push_back(std::move(fresh));
+			if(ensureStructure(*car) && car->st && car->st->nodes.size() * 3 == sc.disp.size()){
+				auto &st = *car->st;
+				for(size_t n = 0; n < st.nodes.size(); n++){
+					Vec dv{ sc.disp[n * 3], sc.disp[n * 3 + 1], sc.disp[n * 3 + 2] };
+					st.pos[n] = st.nodes[n].rest + dv;
+					st.start[n] = st.pos[n];
+					st.vel[n] = Vec{};
+				}
+				st.dirty = true;
+				st.sleepFrames = 0;
+				car->coolant = sc.scalars[0]; car->coolantLeak = sc.scalars[1]; car->overheat = sc.scalars[2]; car->fuelLeak = sc.scalars[3];
+				for(int w = 0; w < 4; w++){ car->tyrePressure[w] = sc.scalars[4 + w]; car->wheelJam[w] = sc.scalars[8 + w]; }
+				car->jamArmed = sc.scalars[12] > .5f;
+				car->torn = sc.torn;
+				car->glassCracked = sc.glass;
+				logLine("Restored saved crash damage for a car.");
+			}
+			savedCars.erase(savedCars.begin() + k);
+			break;
+		}
+	}
+}
+
+void
+update(void *)
+{
+	debugBreakCar();
+	if(gameStopping || !context) return;
+	if(FrontEndMenuManager.m_bMenuActive || CTimer::GetIsPaused()){
+		contacts.clear();
+		return;
+	}
+	for(auto it=engines.begin();it!=engines.end();){
+		if(CPools::GetVehicle(it->second.handle)!=it->first) it=engines.erase(it);else ++it;
+	}
+	auto &cars = context->cars;
+	for(auto it = cars.begin(); it != cars.end();){
+		if(!alive(**it)){ it = cars.erase(it); continue; }
+		auto &c = **it;
+		if(cfg.keepFlipped && c.vehicle->IsCar() && c.vehicle->GetUp().z < 0.2f){
+			// rolling and flipping never sets a car on fire by itself: the rollover impacts push the engine damage up
+			// until it burns, so cap it while the car is on its side or roof (real fires, molotovs etc. keep their culprit)
+			CAutomobile *car = (CAutomobile*)c.vehicle;
+			if(!car->m_pSetOnFireEntity && car->Damage.GetEngineStatus() >= ENGINE_STATUS_ON_FIRE){
+				car->Damage.SetEngineStatus(ENGINE_STATUS_SMOKE);
+				car->m_fFireBlowUpTimer = 0.0f;
+			}
+			if(!car->m_pSetOnFireEntity && c.vehicle->m_fHealth < 260.0f && c.vehicle->m_fHealth > 0.0f && c.pendingLoss > 0.f &&
+			   contacts.find(c.vehicle, CPools::GetVehicleRef(c.vehicle), clumpOf(c.vehicle)))
+				c.vehicle->m_fHealth = 260.0f;
+		}
+		processExtras(c);
+		if(cfg.stopWheellessNPCs && c.vehicle != FindPlayerVehicle() && c.vehicle->IsCar()){
+			CAutomobile *car = (CAutomobile*)c.vehicle;
+			bool missing = false;
+			for(int w = 0; w < 4; w++)
+				if(car->Damage.GetWheelStatus(kWheels[w].wheel) == WHEEL_STATUS_MISSING) missing = true;
+			if(missing){
+				// the AI cannot drive a car with a wheel gone: it stops where it is
+				car->AutoPilot.m_nCruiseSpeed = 0;
+				car->m_fGasPedal = 0.0f;
+				car->m_fBrakePedal = 1.0f;
+			}
+		}
+		float hp = c.vehicle->m_fHealth;
+		c.pendingLoss = c.lastHealth - hp;
+		if(cfg.healthLossScale < 1.f && std::isfinite(hp) && hp > 0 && c.pendingLoss > 0.f && c.pendingLoss < 400.f &&
+		   contacts.find(c.vehicle, CPools::GetVehicleRef(c.vehicle), clumpOf(c.vehicle))){
+			// collision damage only: the car survives more slams (fire/drowning drain has no contact)
+			hp += c.pendingLoss * (1.f - cfg.healthLossScale);
+			c.vehicle->m_fHealth = hp;
+			c.pendingLoss *= cfg.healthLossScale;
+		}
+		c.lastHealth = hp;
+		if(std::isfinite(hp) && c.pendingLoss < -25.f){ restore(c); c.pendingLoss = 0; }	// repaired (e.g. respray)
+		++it;
+	}
+	updateWheelRecords();
+	processRestore();
+	if(cfg.keepFlipped){
+		// A car on its side or roof never starts burning by itself: fire is health < 250 and the rollover impacts push
+		// it there. Fires lit by something (molotov, a shot petrol tank, an explosion) keep their culprit and burn on.
+		auto *pool = CPools::GetVehiclePool();
+		for(int i = 0; i < pool->GetSize(); ++i){
+			CVehicle *v = pool->GetSlot(i);
+			if(!v || !v->IsCar() || v->GetUp().z >= 0.2f || v->m_fHealth <= 0.f || v->m_fHealth >= 250.f) continue;
+			CAutomobile *car = (CAutomobile*)v;
+			if(car->m_pSetOnFireEntity || leakFires.count(v)) continue;
+			if(car->m_pDamageEntity && !car->m_pDamageEntity->IsBuilding()) continue;	// shot or rammed: that is a real kill
+			v->m_fHealth = 260.0f;
+			car->m_fFireBlowUpTimer = 0.0f;
+			if(car->Damage.GetEngineStatus() >= ENGINE_STATUS_ON_FIRE) car->Damage.SetEngineStatus(ENGINE_STATUS_SMOKE);
+		}
+	}
+	if(cfg.deadDrivers){
+		// a dead driver: the car stops being driven, and the horn sounds like a body fell on it (GTA IV)
+		auto *pool = CPools::GetVehiclePool();
+		for(int i = 0; i < pool->GetSize(); ++i){
+			CVehicle *v = pool->GetSlot(i);
+			if(!v || !v->IsCar() || !v->pDriver || v->pDriver == FindPlayerPed() || !v->pDriver->bInVehicle) continue;
+			if(!v->pDriver->DyingOrDead() || v->m_fHealth <= 0.f) continue;
+			CAutomobile *car = (CAutomobile*)v;
+			car->AutoPilot.m_nCruiseSpeed = 0;
+			car->m_fGasPedal = 0.0f;
+			car->m_fBrakePedal = 0.5f;
+			if(cfg.deadHorn){ car->m_nCarHornPattern = 1; car->m_nCarHornTimer = 20; }	// pattern 1 is one long blast; the timer is held mid-way so it never runs out
+		}
+	}
+	CVehicle *player = FindPlayerVehicle();
+	bool reset = PSGLOBAL(window) && glfwGetKey(PSGLOBAL(window), GLFW_KEY_F8) == GLFW_PRESS;
+	bool pressed = reset && !context->resetDown;
+	context->resetDown = reset;
+	if(player) processVehicle(player, true, pressed, player);
+	else if(pressed){
+		CVehicle *target = pickTargetCar(nullptr);
+		if(target && isDentableCar(target)) processVehicle(target, true, true, target);
+		else logLine("F8: no car nearby to repair.");
+	}
+	// F9: turn the car back onto its wheels without repairing anything
+	bool flip = PSGLOBAL(window) && glfwGetKey(PSGLOBAL(window), GLFW_KEY_F9) == GLFW_PRESS;
+	bool flipPressed = flip && !context->flipDown;
+	context->flipDown = flip;
+	if(flipPressed){
+		CVehicle *target = pickTargetCar(player);
+		if(target && isDentableCar(target)){
+			uprightVehicle(target);
+			logLine("F9: car turned upright (damage kept).");
+		}else
+			logLine("F9: no car nearby to flip.");
+	}
+	if(cfg.affectNPCs){
+		CEntity *obs = player ? (CEntity*)player : (CEntity*)FindPlayerPed();
+		if(obs){
+			Vec observer = vec(obs->GetPosition());
+			auto *pool = CPools::GetVehiclePool();
+			std::vector<dent::TrafficCandidate> candidates;
+			for(int i = 0; i < pool->GetSize(); ++i){
+				CVehicle *v = pool->GetSlot(i);
+				if(!v || v == player || !isDentableCar(v)) continue;
+				int handle = CPools::GetVehicleRef(v);
+				Vec position = vec(v->GetPosition());
+				if(!dent::inTrafficRange(position, observer, cfg.npcRange)) continue;
+				auto contact = contacts.find(v, handle, clumpOf(v));
+				if(!contact) continue;
+				auto r = dent::response(contact->impulse, v->m_fMass, cfg.curve);
+				if(r.depth <= 0) continue;
+				Vec delta = position - observer;
+				candidates.push_back({ v, dent::dot(delta, delta), false, handle });
+			}
+			std::sort(candidates.begin(), candidates.end(), dent::trafficPriority);
+			unsigned handled = 0;
+			for(auto &candidate : candidates){
+				if(handled++ >= cfg.maxNPCPerFrame) break;
+				processVehicle((CVehicle*)candidate.vehicle, false, false, player);
+			}
+		}
+	}
+	// advance every car's structure and move the meshes that follow it
+	{
+		const unsigned now = CTimer::GetTimeInMilliseconds();
+		const float dt = CTimer::GetTimeStepInSeconds();
+		for(auto &c : cars){
+			if(!c->st) continue;
+			structural::step(*c->st, dt, now);
+			if(c->st->dirty) applyStructure(*c);
+			// The beams settle over several frames; injury must see the actual final cabin deformation.
+			if(c->occPending && now-c->occHitAt<=1500)
+				hurtOccupants(*c,c->occImpact,c->vehicle==FindPlayerVehicle(),c->occDepth,c->occContact,c->occRadius);
+			else c->occPending=false;
+		}
+	}
+	contacts.clear();	// contacts are only valid for the frame they were captured in
+}
+
+void
+shutdownGame(void *)
+{
+	gameStopping = true;
+	engines.clear();
+	occApplied.clear();
+	cleanup();
+	gameStopping = false;
+}
