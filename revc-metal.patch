+		size_t eq = l.find('=');
+		if(eq == std::string::npos) continue;
+		std::string k = l.substr(0, eq), v = l.substr(eq+1);
+		while(!k.empty() && isspace((unsigned char)k[k.size()-1])) k.erase(k.size()-1);
+		while(!k.empty() && isspace((unsigned char)k[0])) k.erase(0, 1);
+		while(!v.empty() && isspace((unsigned char)v[v.size()-1])) v.erase(v.size()-1);
+		while(!v.empty() && isspace((unsigned char)v[0])) v.erase(0, 1);
+		if(strcasecmp(k.c_str(), key) == 0){ value = v; found = true; }
+	}
+	fclose(f);
+	return found;
+}
+
+static bool
+ReadBool(const std::string &f, const char *key, bool def)
+{
+	std::string v;
+	if(!IniLookup(f, key, v)) return def;
+	return v == "1" || strcasecmp(v.c_str(), "true") == 0;
+}
+static int
+ReadInt(const std::string &f, const char *key, int def)
+{
+	std::string v;
+	return IniLookup(f, key, v) ? atoi(v.c_str()) : def;
+}
+static float
+ReadFloat(const std::string &f, const char *key, float def)
+{
+	std::string v;
+	return IniLookup(f, key, v) ? (float)atof(v.c_str()) : def;
+}
