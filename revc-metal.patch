+static bool
+CameraIsSheltered(void)
+{
+	static uint32 lastCheck = 0xFFFFFFFF;
+	static bool sheltered = false;
+	uint32 now = CTimer::GetFrameCounter();
+	if(now - lastCheck >= 6){
+		lastCheck = now;
+		// three lines a metre apart must all hit: power lines and thin signs above the camera are not a roof
+		CVector cam = TheCamera.GetPosition();
+		static const float offs[3][2] = { { 0.0f, 1.0f }, { 0.87f, -0.5f }, { -0.87f, -0.5f } };
+		sheltered = true;
+		for(int i = 0; i < 3 && sheltered; i++){
+			CVector pos(cam.x + offs[i][0], cam.y + offs[i][1], cam.z);
+			CColPoint colPoint;
+			CEntity *entity = nil;
+			if(!CWorld::ProcessVerticalLine(pos, pos.z + 45.0f, colPoint, entity, true, false, false, false, false, true, nil))
+				sheltered = false;
+		}
+	}
+	return sheltered;
+}
