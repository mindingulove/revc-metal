+
+// screen space reflection of the scene drawn so far; rgb = colour, a = confidence
+// Marches the reflected ray in a few pixels per step (so thin things like poles and wires are not
+// skipped), then refines the hit with a binary search.
+vec4 ssrTrace(vec3 reflected)
+{
+	vec3 R = mat3(u_ssrView)*reflected;
+	if(R.z < -0.1)
+		return vec4(0.0);	// pointing back at the camera, nothing on screen to hit
+	vec2 ndc0 = (gl_FragCoord.xy - u_ssrVP.xy)/u_ssrVP.zw*2.0 - 1.0;
+	float z0 = ssrEyeZ(gl_FragCoord.z);
+	vec3 P0 = vec3((ndc0.x*z0 - u_ssrProj[2][0]*z0 - u_ssrProj[3][0])/u_ssrProj[0][0],
+	               (ndc0.y*z0 - u_ssrProj[2][1]*z0 - u_ssrProj[3][1])/u_ssrProj[1][1], z0);
+
+	float tmax = 90.0;
+	if(R.z < 0.0)
+		tmax = min(tmax, (0.3 - P0.z)/R.z*0.99);
+	vec3 P1 = P0 + R*tmax;
+	vec4 c0 = u_ssrProj*vec4(P0, 1.0);
+	vec4 c1 = u_ssrProj*vec4(P1, 1.0);
+	vec2 n1 = c1.xy/c1.w;
+	float k0 = 1.0/c0.w, k1 = 1.0/c1.w;		// 1/z, linear in screen space
+
+	// pixel length of the ray (clipped to the screen)
+	vec2 dn = n1 - ndc0;
+	vec2 over = max(abs(n1) - 1.0, 0.0)/max(abs(dn), vec2(1e-5));
+	float clipT = 1.0 - max(over.x, over.y);
+	if(clipT <= 0.0)
+		return vec4(0.0);
+	vec2 dpx = dn*clipT*0.5*u_ssrVP.zw;
+	float pl = max(abs(dpx.x), abs(dpx.y));
+	if(pl < 1.5)
+		return vec4(0.0);
