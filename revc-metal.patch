@@ -0,0 +1,10 @@
+#pragma once
+#include "ImpactMath.hpp"
+namespace dent {
+// Use a lamp-local impact threshold, so a corner hit need not break both sides.
+inline bool rearLampHit(Vec point,Vec lamp,float depth,float radius,float minDepth,float power) {
+    if(!finite(point)||!finite(lamp)||!std::isfinite(depth)||!std::isfinite(radius)||depth<=0||radius<=0) return false;
+    if(lamp.y>=-.1f||point.y>=0||point.y>lamp.y+1.25f) return false;
+    return depth*weight(length(point-lamp),radius,power)>=minDepth;
+}
+}
