 "FSIN vec4 v_color;\n"
+"FSIN vec4 v_lighting;\n"
+"uniform float u_liveryMode;\n"
 "FSIN vec4 v_reflcolor;\n"
 "FSIN vec2 v_tex0;\n"
 "FSIN vec2 v_tex1;\n"
 "FSIN float v_fog;\n"
