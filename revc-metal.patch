@@ -0,0 +1,47 @@
+#pragma once
+#include "ImpactMath.hpp"
+#include <array>
+#include <cstddef>
+
+namespace dent {
+struct Contact {
+    void* vehicle{};
+    int handle{};
+    void* clump{};
+    Vec point{},normal{}; // car-local, captured while physics transforms are current
+    float impulse{};
+    unsigned piece{};
+    // impulse is the mass-encoded energy equivalent used by the legacy curve.
+    // Preserve solver inputs separately for collision diagnostics.
+    float rawImpulse{}, otherMass{}, closingSpeed{}, dissipatedJ{}, absorbedJ{};
+    float otherWidth{99.f}; // horizontal size of what was hit (m): a pole or trunk is narrow, a wall is not
+};
+// Cleared before each game Process call. No heap allocation in collision hooks.
+// A pool generation and clump identity must both match before consuming a hit.
+template<std::size_t Capacity=256> struct ContactQueue {
+    std::array<Contact,Capacity> entries{};
+    std::size_t count{};
+    unsigned dropped{};
+    void clear() { count=0; dropped=0; }
+    bool add(Contact c) {
+        if(!c.vehicle||!c.clump||!finite(c.point)||!finite(c.normal)||
+           !std::isfinite(c.impulse)||c.impulse<=0||length(c.normal)<.01f) return false;
+        for(std::size_t i=0;i<count;++i) {
+            auto& old=entries[i];
+            if(old.vehicle!=c.vehicle) continue;
+            if(old.handle!=c.handle||old.clump!=c.clump||c.impulse>old.impulse) old=c;
+            return true;
+        }
+        if(count==Capacity) {++dropped;return false;}
+        entries[count++]=c;
+        return true;
+    }
+    const Contact* find(void* vehicle,int handle,void* clump) const {
+        for(std::size_t i=0;i<count;++i) {
+            const auto& c=entries[i];
+            if(c.vehicle==vehicle&&c.handle==handle&&c.clump==clump) return &c;
+        }
+        return nullptr;
+    }
+};
+}
diff --git a/src/extras/localdent/DentMath.hpp b/src/extras/localdent/DentMath.hpp
new file mode 100644
index 00000000..ef8605bf
--- /dev/null
+++ b/src/extras/localdent/DentMath.hpp
@@ -0,0 +1,31 @@
+#pragma once
+#include <algorithm>
+#include <cmath>
+namespace dent {
+struct Vec { float x{}, y{}, z{}; };
+inline Vec operator+(Vec a, Vec b) { return {a.x+b.x,a.y+b.y,a.z+b.z}; }
+inline Vec operator-(Vec a, Vec b) { return {a.x-b.x,a.y-b.y,a.z-b.z}; }
+inline Vec operator*(Vec a, float s) { return {a.x*s,a.y*s,a.z*s}; }
+inline float dot(Vec a, Vec b) { return a.x*b.x+a.y*b.y+a.z*b.z; }
+// Surface orientation is two-sided for thin sheet metal: inner skin normals
+// oppose the exterior normals but both skins must receive the same impact weight.
+inline float sheetFacing(Vec direction, Vec normal) {
+ return std::clamp(std::fabs(dot(direction,normal))*1.4f+.1f,0.f,1.f);
+}
+inline Vec cross(Vec a, Vec b) { return { a.y*b.z-a.z*b.y, a.z*b.x-a.x*b.z, a.x*b.y-a.y*b.x }; }
+inline float length(Vec a) { return std::sqrt(dot(a,a)); }
+inline bool finite(Vec a) { return std::isfinite(a.x)&&std::isfinite(a.y)&&std::isfinite(a.z); }
+inline Vec unit(Vec a) { float n=length(a); return n>0.00001f ? a*(1.f/n) : Vec{}; }
+inline Vec displace(Vec original, Vec current, Vec contact, Vec direction,
+                    float radius, float depth, float limit) {
+    if (!finite(original)||!finite(current)||!finite(contact)||!finite(direction)||
+        !std::isfinite(radius)||!std::isfinite(depth)||!std::isfinite(limit)||
+        radius<=0||depth<=0||limit<=0) return current;
+    float t=std::clamp(1.f-length(current-contact)/radius,0.f,1.f);
+    float weight=t*t*(3.f-2.f*t);
+    Vec delta=current+unit(direction)*(depth*weight)-original;
+    float n=length(delta);
+    if(n>limit) delta=delta*(limit/n);
+    return original+delta;
+}
+}
diff --git a/src/extras/localdent/EngineReliability.hpp b/src/extras/localdent/EngineReliability.hpp
new file mode 100644
index 00000000..cc59526c
--- /dev/null
+++ b/src/extras/localdent/EngineReliability.hpp
@@ -0,0 +1,45 @@
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+namespace reliability {
+inline float severity(float health, float crush, float heat)
+{
+    return std::clamp(std::max({(600.f-health)/400.f, (crush-.5f)/.5f, (heat-.8f)/.2f}),0.f,1.f);
+}
+enum class Phase { Off, Cranking, Running };
+enum class Event { None, Crank, Started, Failed, Stalled };
+struct Engine {
+    Phase phase = Phase::Off;
+    bool initialized = false;
+    float crank = 0, retry = 0, grace = 0;
+    uint32_t seed = 1;
+    float random(){seed ^= seed<<13;seed ^= seed>>17;seed ^= seed<<5;return (seed>>8)*(1.f/16777216.f);}
+    void reset(bool running){phase=running?Phase::Running:Phase::Off;initialized=true;crank=retry=grace=0;}
+    Event step(float dt, float damage, bool wantsStart, bool switchedOn, bool canRun)
+    {
+        dt=std::clamp(dt,0.f,.1f);damage=std::clamp(damage,0.f,1.f);
+        if(!initialized) reset(switchedOn);
+        if(!canRun){reset(false);return Event::None;}
+        retry=std::max(0.f,retry-dt);grace=std::max(0.f,grace-dt);
+        if(phase==Phase::Running){
+            if(!switchedOn){reset(false);return Event::None;}
+            float rate=damage>0 ? .015f+.12f*damage*damage : 0.f;
+            if(grace<=0 && rate>0 && random()<1.f-std::exp(-rate*dt)){
+                phase=Phase::Off;retry=.6f;return Event::Stalled;
+            }
+        }else if(phase==Phase::Cranking){
+            crank-=dt;
+            if(crank<=0){
+                if(damage>0 && random()<.1f+.75f*damage){phase=Phase::Off;retry=.6f+.5f*damage;return Event::Failed;}
+                phase=Phase::Running;grace=3.f;return Event::Started;
+            }
+        }else if(wantsStart && retry<=0){
+            if(damage<=0){phase=Phase::Running;grace=3.f;return Event::Started;}
+            phase=Phase::Cranking;crank=.65f+.55f*damage;return Event::Crank;
+        }
+        return Event::None;
+    }
+};
+}
diff --git a/src/extras/localdent/ImpactMath.hpp b/src/extras/localdent/ImpactMath.hpp
new file mode 100644
index 00000000..0496ac84
--- /dev/null
+++ b/src/extras/localdent/ImpactMath.hpp
@@ -0,0 +1,92 @@
+#pragma once
+#include "DentMath.hpp"
+#include <cstdint>
+namespace dent {
+struct Pose { Vec right,forward,up,position; };
+inline Vec toLocalVector(Vec v,const Pose& p) {
+    return {dot(v,p.right),dot(v,p.forward),dot(v,p.up)};
+}
+inline Vec toLocalPoint(Vec v,const Pose& p) { return toLocalVector(v-p.position,p); }
+inline Vec toWorldVector(Vec v,const Pose& p) { return p.right*v.x+p.forward*v.y+p.up*v.z; }
+inline Vec toWorldPoint(Vec v,const Pose& p) { return p.position+toWorldVector(v,p); }
+struct ImpactConfig {
+    float minImpact=.04f,referenceImpact=.65f,strength=1.f,exponent=1.15f;	// referenceImpact/exponent: old curve, unused
+    // Crash physics: impact*50 is the speed change in m/s. Parts spring back below elasticSpeed (bumpers,
+    // sheet metal); beyond it the crush depth follows the kinetic energy (speed squared), calibrated so that
+    // a 50 km/h crash crushes crushAt50 metres, and levels off at maxDepth where the structure is solid.
+    float elasticSpeed=2.2f,crushAt50=.16f;
+    float maxDepth=.65f,minRadius=1.1f,maxRadius=2.25f;
+};
+struct Response { float impact{},depth{},radius{},wrap{}; };	// wrap: 0..1 how much the dent folds around a thin object
+inline Response response(float impulse,float mass,const ImpactConfig& c) {
+    if(!std::isfinite(impulse)||!std::isfinite(mass)||mass<=1||impulse<=0) return {};
+    float impact=impulse/mass;
+    if(!std::isfinite(impact)||impact<=c.minImpact||c.referenceImpact<=c.minImpact) return {};
+    // v = speed change in m/s. Energy per kg beyond the elastic limit (smooth knee, no step):
+    // soft(e) = eps*ln(1+exp(e/eps)), e = v^2 - ve^2.
+    float v=std::max(0.f,impact*c.strength)*50.f;
+    float ve2=c.elasticSpeed*c.elasticSpeed,eps=.35f*ve2;
+    auto soft=[&](float speed){ float e=speed*speed-ve2; float t=e/eps; return t>40.f?e:eps*std::log1p(std::exp(t)); };
+    const float ref=50.f/3.6f;	// 50 km/h in m/s
+    float dmax=std::max(c.maxDepth,.01f);
+    float x50=std::atanh(std::clamp(c.crushAt50/dmax,.001f,.98f))*dmax;
+    float k=x50/std::max(soft(ref),1e-4f);
+    float depth=dmax*std::tanh(k*soft(v)/dmax);
+    float amount=std::clamp(depth/dmax,0.f,1.f);
+    return {impact,depth,c.minRadius+(c.maxRadius-c.minRadius)*std::sqrt(amount)};
+}
+// One peak budget for a continuous contact. Repeated frames cannot add full dents.
+struct Episode {
+    Vec point{},direction{};
+    float depth{},radius{};
+    uint32_t id{},lastMs{};
+    bool active{};
+    bool observe(Vec p,Vec n,Response r,uint32_t now,uint32_t gapMs) {
+        if(!finite(p)||!finite(n)||length(n)<.001f||!std::isfinite(r.depth)||
+           !std::isfinite(r.radius)||r.depth<=0||r.radius<=0) return false;
+        n=unit(n);
+        bool fresh=!active||uint32_t(now-lastMs)>gapMs||length(p-point)>.85f||dot(n,direction)<.65f;
+        lastMs=now;
+        if(fresh) {point=p;direction=n;depth=0;radius=0;++id;active=true;}
+        bool changed=r.depth>depth+.00001f||r.radius>radius+.00001f;
+        depth=std::max(depth,r.depth);radius=std::max(radius,r.radius);
+        return changed;
+    }
+};
+inline float weight(float distance,float radius,float power) {
+    if(radius<=0||distance>=radius) return 0;
+    float t=std::clamp(1.f-distance/radius,0.f,1.f);
+    // smootherstep: zero slope AND zero curvature at the rim and at the centre, so there is no crease
+    return std::pow(t*t*t*(t*(t*6.f-15.f)+10.f),power);
+}
+// Evaluate in rest space: prior dents must not move the affected region away.
+// Subtract the envelope already applied in this episode, including radius growth.
+inline Vec displaceImpact(Vec rest,Vec current,Vec contact,Vec direction,float depth,float radius,
+                         float oldDepth,float oldRadius,float limit,float power) {
+    if(!finite(rest)||!finite(current)||!finite(contact)||!finite(direction)||
+       !std::isfinite(depth)||!std::isfinite(radius)||!std::isfinite(oldDepth)||
+       !std::isfinite(oldRadius)||!std::isfinite(limit)||!std::isfinite(power)||
+       depth<=0||radius<=0||limit<=0||power<=0) return current;
+    float distance=length(rest-contact);
+    float extra=std::max(0.f,depth*weight(distance,radius,power)-oldDepth*weight(distance,oldRadius,power));
+    Vec delta=current+unit(direction)*extra-rest;
+    float size=length(delta);
+    if(size>limit) delta=delta*(limit/size);
+    return rest+delta;
+}
+// Same as displaceImpact, but the metal beside the contact line is also pulled in toward it: a car hitting a pole or a
+// trunk folds around it instead of just being pushed in.
+inline Vec displaceImpactWrap(Vec rest,Vec current,Vec contact,Vec direction,float depth,float radius,
+                         float oldDepth,float oldRadius,float limit,float power,float wrap) {
+    if(wrap<=0.f||!finite(rest)||!finite(contact)||!finite(direction)||length(direction)<.001f)
+        return displaceImpact(rest,current,contact,direction,depth,radius,oldDepth,oldRadius,limit,power);
+    Vec dir=unit(direction);
+    Vec off=rest-contact;
+    Vec lateral=off-dir*dot(off,dir);
+    float lat=length(lateral);
+    float t=radius>0?std::min(1.f,lat/radius):0.f;
+    Vec pull=lat>1e-4f?lateral*(1.f/lat):Vec{};
+    Vec steered=unit(dir-pull*(wrap*t));
+    return displaceImpact(rest,current,contact,steered,depth*(1.f+.35f*wrap*t),radius,oldDepth,oldRadius,limit,power);
+}
+}
