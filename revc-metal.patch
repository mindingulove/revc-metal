+#pragma once
+
+#include <string>
+
+class CPlayerPed;
+
+// Native port of gennariarmando's Classic Axis (camera/aiming mod) for reGTA.
+// Stage 1: the third-person on-foot and aiming cameras. Enabled by the loader when it meets
+// iii_classic_axis.asi / ClassicAxisIII.asi (see NativePorts.cpp).
+struct ClassicAxisSettings {
+	bool forceAutoAim = false;
+	int lockOnTargetType = 1;		// 0 default, 1 SA, 2 LCS
+	bool showTriangleForMouseRecruit = true;
+	bool storiesAimingCoords = false;
+	float cameraCrosshairMultX = 0.53f;
+	float cameraCrosshairMultY = 0.4f;
+	bool storiesPointingArm = false;
+	float rightAnalogStickSensitivityX = 1.0f;
+	float rightAnalogStickSensitivityY = 1.0f;
+	bool zoomForAssaultRifles = true;
+	bool modernCamera = true;
+	std::string walkKey = "LALT";	// "NULL" disables
+	std::string crouchKey = "C";	// "NULL" disables
+};
+
+namespace ClassicAxis {
+	extern bool enabled;
+	extern ClassicAxisSettings settings;
+	// Read ClassicAxisIII.ini (looked up next to the .asi, then in the game folder) and switch the mod on.
+	void Enable(const std::string &asiDir);
+	// Called at the start of CPlayerPed::ProcessControl: crouch key, walk key.
+	void BeforePlayerControl(CPlayerPed *ped);
+	// Called when CPlayerPed::ProcessControl is done (puts weapon data back after the crouch changes).
+	void AfterPlayerControl(CPlayerPed *ped);
+	// True while the player is aiming with the third-person aim camera.
+	bool IsAiming(void);
+	// HUD overlay: health-coloured triangle over the pedestrian under the crosshair.
+	void DrawHud(void);
+	// True while the configured crouch key is held (lets the engine ignore its own use of that key).
+	bool IsCrouchKeyDown(void);
+}
