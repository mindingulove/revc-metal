+// -- file system plugin (0B00-0B05) --
+
+bool
+CopyFileTo(const std::string &a, const std::string &b)
+{
+	FILE *in = fopen(a.c_str(), "rb");
+	if(!in) return false;
+	FILE *out = fopen(b.c_str(), "wb");
+	if(!out){ fclose(in); return false; }
+	char buf[8192];
+	size_t n;
+	bool ok = true;
+	while((n = fread(buf, 1, sizeof(buf), in)) > 0)
+		if(fwrite(buf, 1, n, out) != n){ ok = false; break; }
+	fclose(in);
+	fclose(out);
+	return ok;
+}
+
+bool
+CopyDirTo(const std::string &a, const std::string &b)
+{
+	if(mkdir(b.c_str(), 0755) != 0) return false;
+	DIR *d = opendir(a.c_str());
+	if(!d) return false;
+	bool ok = true;
+	while(struct dirent *e = readdir(d)){
+		if(!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..")) continue;
+		std::string sa = a + "/" + e->d_name, sb = b + "/" + e->d_name;
+		if(FileExists(sa.c_str(), true)){ if(!CopyDirTo(sa, sb)) ok = false; }
+		else if(!CopyFileTo(sa, sb)) ok = false;
+	}
+	closedir(d);
+	return ok;
+}
+
+bool
+DeleteDirAll(const std::string &p)
+{
+	DIR *d = opendir(p.c_str());
+	if(d){
+		while(struct dirent *e = readdir(d)){
+			if(!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..")) continue;
+			std::string sp = p + "/" + e->d_name;
+			if(FileExists(sp.c_str(), true)) DeleteDirAll(sp);
+			else unlink(sp.c_str());
+		}
+		closedir(d);
+	}
+	return rmdir(p.c_str()) == 0;
+}
+
+OP(opDeleteFile) { Arg a = ReadArg(s); Flag(s, unlink(Slashes(Str(a)).c_str()) == 0); return CONTINUE; }
+OP(opDeleteDir)
+{
+	Arg a = ReadArg(s), all = ReadArg(s);
+	std::string p = Slashes(Str(a));
+	Flag(s, all.i ? DeleteDirAll(p) : rmdir(p.c_str()) == 0);
+	return CONTINUE;
+}
+OP(opMoveFile) { Arg a = ReadArg(s), b = ReadArg(s); std::string pa = Slashes(Str(a)); Flag(s, !FileExists(pa.c_str(), true) && rename(pa.c_str(), Slashes(Str(b)).c_str()) == 0); return CONTINUE; }
+OP(opMoveDir) { Arg a = ReadArg(s), b = ReadArg(s); std::string pa = Slashes(Str(a)); Flag(s, FileExists(pa.c_str(), true) && rename(pa.c_str(), Slashes(Str(b)).c_str()) == 0); return CONTINUE; }
+OP(opCopyFile) { Arg a = ReadArg(s), b = ReadArg(s); Flag(s, CopyFileTo(Slashes(Str(a)), Slashes(Str(b)))); return CONTINUE; }
+OP(opCopyDir) { Arg a = ReadArg(s), b = ReadArg(s); Flag(s, CopyDirTo(Slashes(Str(a)), Slashes(Str(b)))); return CONTINUE; }
+
+// -- ini files (0AF0-0AF5) --
+
+bool
+IniRead(const std::string &file, const char *section, const char *key, std::string &value)
+{
+	FILE *f = fopen(Slashes(file.c_str()).c_str(), "r");
+	if(!f) return false;
+	char line[1024];
+	bool in = false, found = false;
+	while(fgets(line, sizeof(line), f)){
+		char *p = line;
+		while(*p == ' ' || *p == '\t') p++;
+		if(*p == ';' || *p == '#' || *p == '\n' || *p == '\r' || !*p) continue;
+		if(*p == '['){
+			char *e = strchr(p, ']');
+			in = e && strncasecmp(p + 1, section, e - p - 1) == 0 && strlen(section) == (size_t)(e - p - 1);
+			continue;
+		}
+		if(!in) continue;
+		char *eq = strchr(p, '=');
+		if(!eq) continue;
+		std::string k(p, eq - p);
+		while(!k.empty() && (k.back() == ' ' || k.back() == '\t')) k.pop_back();
+		if(strcasecmp(k.c_str(), key) != 0) continue;
+		std::string v = eq + 1;
+		while(!v.empty() && (v.back() == '\n' || v.back() == '\r' || v.back() == ' ' || v.back() == '\t')) v.pop_back();
+		size_t b = 0;
+		while(b < v.size() && (v[b] == ' ' || v[b] == '\t')) b++;
+		value = v.substr(b);
+		found = true;
+		break;
+	}
+	fclose(f);
+	return found;
+}
+
+bool
+IniWrite(const std::string &file, const char *section, const char *key, const std::string &value)
+{
+	std::string path = Slashes(file.c_str());
+	std::vector<std::string> lines;
+	if(FILE *f = fopen(path.c_str(), "r")){
+		char line[1024];
+		while(fgets(line, sizeof(line), f)) lines.push_back(line);
+		fclose(f);
+	}
+	int secStart = -1, secEnd = (int)lines.size(), keyLine = -1;
+	for(size_t i = 0; i < lines.size(); i++){
+		const char *p = lines[i].c_str();
+		while(*p == ' ' || *p == '\t') p++;
+		if(*p == '['){
+			const char *e = strchr(p, ']');
+			bool match = e && strncasecmp(p + 1, section, e - p - 1) == 0 && strlen(section) == (size_t)(e - p - 1);
+			if(secStart >= 0 && !match){ secEnd = (int)i; break; }
+			if(match) secStart = (int)i;
+		}else if(secStart >= 0){
+			const char *eq = strchr(p, '=');
+			if(eq && *p != ';'){
+				std::string k(p, eq - p);
+				while(!k.empty() && (k.back() == ' ' || k.back() == '\t')) k.pop_back();
+				if(strcasecmp(k.c_str(), key) == 0) keyLine = (int)i;
+			}
+		}
+	}
+	std::string entry = std::string(key) + "=" + value + "\n";
+	if(keyLine >= 0) lines[keyLine] = entry;
+	else if(secStart >= 0) lines.insert(lines.begin() + secEnd, entry);
+	else{
+		if(!lines.empty() && lines.back().find('\n') == std::string::npos) lines.back() += "\n";
+		lines.push_back(std::string("[") + section + "]\n");
+		lines.push_back(entry);
+	}
+	FILE *f = fopen(path.c_str(), "w");
+	if(!f) return false;
+	for(auto &l : lines) fputs(l.c_str(), f);
+	fclose(f);
+	return true;
+}
+
+OP(opIniGetInt)
+{
