+{
+	const CColPoint saved = colpoint;
+	float before = 0.0f;
+	if(LocalDent::enabled)
+		before = DotProduct(DentContactSpeed(this, saved.point) - DentContactSpeed(B, saved.point), saved.normal);
+	bool result = ApplyCollision_Impl(B, colpoint, impulseA, impulseB);
+	if(result && LocalDent::enabled){
+		float after = DotProduct(DentContactSpeed(this, saved.point) - DentContactSpeed(B, saved.point), saved.normal);
+		LocalDent::OnCollisionPair(this, B, saved, impulseA, impulseB, before, after);
+	}
+	return result;
+}
