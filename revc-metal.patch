+// -- memory allocation --
+
+OP(opAlloc)
+{
+	Arg a = ReadArg(s);
+	uint32_t n = (uint32_t)a.i;
+	if(n == 0 || n > 64 * 1024 * 1024){ Store(s, 0); Flag(s, false); return CONTINUE; }
+	uint32_t at = gHeapNext;
+	gHeapNext += (n + 0xFFF) & ~0xFFFu;
+	if(gHeapNext < at){ Store(s, 0); Flag(s, false); return CONTINUE; }
+	gHeap[at] = std::vector<uint8_t>(n, 0);
+	Store(s, (int32_t)at);
+	Flag(s, true);
+	return CONTINUE;
+}
+
+OP(opFree) { Arg a = ReadArg(s); gHeap.erase((uint32_t)a.i); return CONTINUE; }
