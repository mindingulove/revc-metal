+		float sz = ssrEyeZ(textureLod(ssrDepth, ssrToTex(ndc), 0.0).r);
+		float diff = z - sz;
+		if(diff > 0.04 + 0.01*z && diff < 0.5 + 0.08*z){
+			float a = tPrev, b = t;
+			for(int j = 0; j < 7; j++){
