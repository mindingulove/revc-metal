+FILE *
+FileOf(int32_t h)
+{
+	uint32_t i = ((uint32_t)h - VA_FILE) / 4;
+	if((uint32_t)h >= VA_FILE && (uint32_t)h < VA_FIND && i < gFiles.size()) return gFiles[i];
+	return nullptr;
+}
