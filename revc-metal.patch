@@ -0,0 +1,51 @@
+// Regression: front rails must plastically shorten before passenger-cell damage.
+#include "StructuralBody.hpp"
+#include <cassert>
+#include <cstdio>
+using dent::Vec;
+std::vector<Vec> body()
+{
+ std::vector<Vec> p;
+ for(int x=0;x<=20;x++) for(int y=0;y<=50;y++) for(int z=0;z<=12;z++)
+  if(x==0||x==20||y==0||y==50||z==0||z==12)
+   p.push_back({-.9f+x*.09f,-2.5f+y*.1f,-.4f+z*.1f});
+ return p;
+}
+struct Result {float front,cabin,lift; int yielded;};
+Result crash(float travel, float buckle, float depth, bool frame = false)
+{
+ structural::Params prm; prm.crumpleTravelScale=travel;prm.crumpleBuckle=buckle;
+ structural::Structure s; assert(structural::build(s,body(),1500,nullptr,prm));
+ structural::drive(s,{0,2.6f,0},{0,-1,0},depth,1.548f,.65f,1,0);
+ float endDepth=-1.f, endRadius=0.f;
+ if(frame){dent::ImpactConfig cfg;cfg.referenceImpact=.5f;cfg.exponent=2.f;auto r=dent::response(.246f*1500,1500,cfg);endDepth=r.depth*.6f;endRadius=r.radius;}
+ float nodeMass=0;for(const auto &nd:s.nodes)nodeMass+=nd.mass;
+ assert(std::fabs(nodeMass-750.f)<.01f);
+ for(unsigned t=0;t<4000;t+=16){
+  // Same contact frames must share the episode budget, not stack dents.
+  if(t<240) structural::drive(s,{0,2.6f,0},{0,-1,0},depth,1.548f,.65f,1,t,endDepth,endRadius);
+  structural::step(s,.016f,t);
+ }
+ Result r{};
+ r.front=-structural::displacement(s,structural::skinFor(s,{0,2.5f,0})).y;
+ r.cabin=dent::length(structural::displacement(s,structural::skinFor(s,{0,0,.2f})));
+ for(size_t i=0;i<s.nodes.size();i++){
+  assert(dent::finite(s.pos[i]));
+  if(s.nodes[i].pinned) assert(dent::length(s.pos[i]-s.nodes[i].rest)<1.e-6f);
+  if(s.nodes[i].region==structural::FRONT)r.lift=std::max(r.lift,s.lift[i]);
+ }
+ for(const auto &b:s.beams)if(b.L0<b.L00-.001f)r.yielded++;
+ return r;
+}
+int main()
+{
+ auto frame=crash(3,1,.021f,true);
+ assert(frame.front>.12f && frame.cabin<.02f);
+ auto old=crash(1,0,.0594f), corrected=crash(3,1,.0594f), small=crash(3,1,.001f), hard=crash(3,1,.3f);
+ assert(corrected.front>old.front*2 && corrected.front>.07f);
+ assert(corrected.cabin<.01f && corrected.yielded>0 && corrected.lift>.01f);
+ assert(small.front<.005f && small.lift<.001f);
+ assert(hard.front>corrected.front && hard.cabin<.1f);
+ printf("PASS: front crush %.3fm -> %.3fm; cabin %.4fm; upper-front buckle %.3fm; noise and hard-hit bounds pass\n",old.front,corrected.front,corrected.cabin,corrected.lift);
+ return 0;
+}
