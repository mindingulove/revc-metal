+#pragma once
+
+#include <stdint.h>
+
+class CRunningScript;
+
+// Native port of the CLEO library for GTA III (III.VC.CLEO by cleolibrary, 2.2.0) for reGTA.
+//
+// Every *.cs file in CLEO/ and scripts/ starts as a custom script thread. Custom scripts run on the
+// game's own script interpreter; the opcodes CLEO adds (file access, strings, formatted text, custom
+// threads, SCM functions, shared variables, ini files, integer maths, ...) are implemented here.
+// Windows-only features cannot exist on this platform: loading DLLs, calling code at exe addresses and
+// reading/writing exe memory. Those opcodes report failure to the script instead of crashing.
+namespace Cleo {
+	extern bool enabled;
+	// Called when the script engine is initialised (new game, game load): starts the custom scripts.
+	void Init(void);
+	// Called once per frame before the scripts are processed.
+	void Update(void);
+	// Called before the game's own command handlers. Returns true when `id` is a CLEO opcode that was
+	// executed for this custom script; `result` is then ProcessOneCommand's return value.
+	bool ProcessOpcode(CRunningScript *script, int32_t id, int8_t &result);
+}
