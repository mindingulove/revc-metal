+static CVector
+DentContactSpeed(CPhysical *body, const CVector &point)
+{
+	// Static/infinite bodies are the solver's immovable counterpart, even if
+	// a stale velocity remains stored on a parked or previously moving entity.
+	if(body->GetIsStatic() || body->bInfiniteMass)
+		return CVector(0.0f, 0.0f, 0.0f);
+	return body->GetSpeed(point - body->GetPosition());
+}
+
 bool
