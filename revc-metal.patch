+#define main previous_structural_test_main
+#include "test_structural_crumple.cpp"
+#undef main
+float roofCrash(float impact,bool roofHit)
+{
+ structural::Structure s;structural::Params prm;assert(structural::build(s,body(),1500,nullptr,prm));
+ dent::ImpactConfig curve;curve.referenceImpact=.65f;curve.exponent=2.f;curve.maxDepth=.45f;
+ auto r=dent::response(impact*1500,1500,curve);
+ Vec contact=roofHit?Vec{0,0,.85f}:Vec{.95f,0,0};Vec dir=roofHit?Vec{0,0,-1}:Vec{-1,0,0};
+ for(unsigned t=0;t<4000;t+=16){
+  if(t<240)structural::drive(s,contact,dir,r.depth*.6f,r.radius,.65f,1,t,-1,0,r.depth*.6f,r.radius);
+  structural::step(s,.016f,t);
+ }
+ assert(s.roofCrushed== (roofHit && r.depth*.6f>.005f));
+ for(size_t i=0;i<s.nodes.size();i++){
+  assert(dent::finite(s.pos[i]));if(s.nodes[i].pinned)assert(dent::length(s.pos[i]-s.nodes[i].rest)<1.e-6f);
+ }
+ return structural::displacement(s,structural::skinFor(s,{0,0,.8f})).z;
+}
+int main()
+{
+ float gentle=roofCrash(.04f,true),medium=roofCrash(.3f,true),hard=roofCrash(.6f,true);
+ float side=roofCrash(.3f,false);
