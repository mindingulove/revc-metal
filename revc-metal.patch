+}
+
+namespace {
+
+// ---- virtual 32-bit addresses -------------------------------------------------------------------
+// Script variables are 32 bits wide, so a pointer cannot be stored in one on a 64-bit build. Scripts get
+// 32-bit "addresses" that this file maps back to the memory they stand for.
+constexpr uint32_t VA_SCRIPT = 0x10000000u;	// script space (code and global variables)
+constexpr uint32_t VA_LOCALS = 0x20000000u;	// local variables of a thread, 0x100 per thread
+constexpr uint32_t VA_ARRAY  = 0x21000000u;	// CLEO array of a thread, 0x400 per thread
+constexpr uint32_t VA_HEAP   = 0x30000000u;	// memory from 0AC8
+constexpr uint32_t VA_FILE   = 0x40000000u;	// open files
+constexpr uint32_t VA_FIND   = 0x41000000u;	// find_first_file handles
+constexpr uint32_t VA_PED    = 0x51000000u;	// game struct stand-ins (only convertible back to handles)
+constexpr uint32_t VA_VEH    = 0x52000000u;
+constexpr uint32_t VA_OBJ    = 0x53000000u;
+constexpr uint32_t VA_THREAD = 0x60000000u;
+
+enum { NUM_LOCALS = NUM_LOCAL_VARS + NUM_TIMERS, ARRAY_SIZE_CLEO = 0xFF, NUM_SHARED = 0xFFFF };
+
+struct Frame {
+	int32_t locals[16];
+	uint32_t retAddr;
+};
+
+struct Slot {
+	bool used = false;
+	CRunningScript *script = nullptr;
+	uint32_t base = 0, size = 0;
+	std::vector<Frame> frames;
+	int32_t arr[ARRAY_SIZE_CLEO];
+	uint32_t lastPed = 0, lastVeh = 0, lastObj = 0;
+	std::string path;
+};
+
+Slot gSlots[MAX_NUM_SCRIPTS];
+int32_t gShared[NUM_SHARED];
+bool gUp = false;
+
+struct Chunk { uint32_t start, size; bool free; };
+std::vector<Chunk> gChunks;			// carving of the CLEO part of the script space
+
+std::map<uint32_t, std::vector<uint8_t>> gHeap;
+uint32_t gHeapNext = VA_HEAP;
+std::vector<FILE*> gFiles;
+std::vector<DIR*> gFinds;
+std::vector<std::string> gFindPatterns;
+int gLogCount = 0;
+
+void
+Log(const char *fmt, ...)
+{
+	if(gLogCount > 200) return;
+	gLogCount++;
+	char buf[400];
+	va_list ap;
+	va_start(ap, fmt);
+	vsnprintf(buf, sizeof(buf), fmt, ap);
+	va_end(ap);
+	debug("[CLEO] %s\n", buf);
+}
+
+int
+SlotIndex(CRunningScript *s)
+{
+	int i = (int)(s - CTheScripts::ScriptsArray);
+	return (i >= 0 && i < MAX_NUM_SCRIPTS) ? i : 0;
+}
+
+Slot &
+SlotOf(CRunningScript *s)
+{
+	return gSlots[SlotIndex(s)];
+}
+
+uint8_t *
+Space(void)
+{
+	return CTheScripts::ScriptSpace;
+}
+
+uint32_t
+AllocChunk(uint32_t size)
+{
+	size = (size + 15) & ~15u;
+	for(size_t i = 0; i < gChunks.size(); i++){
+		if(!gChunks[i].free || gChunks[i].size < size) continue;
+		uint32_t start = gChunks[i].start;
+		if(gChunks[i].size > size){
+			Chunk rest = { start + size, gChunks[i].size - size, true };
+			gChunks[i].size = size;
+			gChunks[i].free = false;
+			gChunks.insert(gChunks.begin() + i + 1, rest);
+		}else
+			gChunks[i].free = false;
+		memset(&Space()[start], 0, size);
+		return start;
+	}
+	return 0;
+}
+
+void
+FreeChunk(uint32_t start)
+{
+	for(auto &c : gChunks)
+		if(c.start == start) c.free = true;
+	for(size_t i = 0; i + 1 < gChunks.size();){	// merge neighbours
+		if(gChunks[i].free && gChunks[i+1].free){
+			gChunks[i].size += gChunks[i+1].size;
+			gChunks.erase(gChunks.begin() + i + 1);
+		}else
+			i++;
+	}
+}
+
+void *
+Resolve(uint32_t a, uint32_t n)
+{
+	if(a >= VA_SCRIPT && a < VA_SCRIPT + SIZE_SCRIPT_SPACE){
+		uint32_t off = a - VA_SCRIPT;
+		if(off + n <= SIZE_SCRIPT_SPACE) return &Space()[off];
+	}else if(a >= VA_LOCALS && a < VA_LOCALS + MAX_NUM_SCRIPTS * 0x100){
+		uint32_t idx = (a - VA_LOCALS) / 0x100, off = (a - VA_LOCALS) % 0x100;
+		if(off + n <= NUM_LOCALS * 4) return (uint8_t*)CTheScripts::ScriptsArray[idx].m_anLocalVariables + off;
+	}else if(a >= VA_ARRAY && a < VA_ARRAY + MAX_NUM_SCRIPTS * 0x400){
+		uint32_t idx = (a - VA_ARRAY) / 0x400, off = (a - VA_ARRAY) % 0x400;
+		if(off + n <= ARRAY_SIZE_CLEO * 4) return (uint8_t*)gSlots[idx].arr + off;
+	}else if(a >= VA_HEAP){
+		auto it = gHeap.upper_bound(a);
+		if(it != gHeap.begin()){
+			--it;
+			uint32_t off = a - it->first;
+			if(off + n <= it->second.size()) return it->second.data() + off;
+		}
+	}
+	return nullptr;
+}
+
+// ---- script stream ------------------------------------------------------------------------------
+
+struct Arg {
+	int32_t i = 0;
+	const char *lit = nullptr;	// inline string
+	bool var = false;
+	float f() const { float v; memcpy(&v, &i, 4); return v; }
+};
+
+Arg
+ReadArg(CRunningScript *s)
+{
+	uint8_t *sp = Space();
+	uint32_t &ip = s->m_nIp;
+	Arg a;
+	uint8_t t = sp[ip];
+	ip++;
+	switch(t & 0x7F){
+	case 1: memcpy(&a.i, &sp[ip], 4); ip += 4; break;
+	case 2: { uint16_t g = *(uint16_t*)&sp[ip]; if(g + 4 <= SIZE_MAIN_SCRIPT + SIZE_MISSION_SCRIPT) memcpy(&a.i, &sp[g], 4); ip += 2; a.var = true; break; }
+	case 3: { uint16_t l = *(uint16_t*)&sp[ip]; a.i = l < NUM_LOCALS ? s->m_anLocalVariables[l] : 0; ip += 2; a.var = true; break; }
+	case 4: a.i = *(int8_t*)&sp[ip]; ip += 1; break;
+	case 5: a.i = *(int16_t*)&sp[ip]; ip += 2; break;
+	case 6: { float f = *(int16_t*)&sp[ip] / 16.0f; memcpy(&a.i, &f, 4); ip += 2; break; }
+	case 14:
+		if(!(t & 0x80)){	// length-prefixed: turn it into a zero-terminated string in place, once
+			uint8_t len = sp[ip];
+			memmove(&sp[ip], &sp[ip + 1], len);
+			sp[ip + len] = 0;
+			sp[ip - 1] = t | 0x80;
+		}
+		a.lit = (const char*)&sp[ip];
+		ip += (uint32_t)strlen(a.lit) + 1;
+		break;
+	default:	// eight raw bytes: a text label
+		ip--;
+		a.lit = (const char*)&sp[ip];
+		ip += 8;
+		break;
+	}
+	return a;
+}
+
+int32_t gDummyVar;
+
+// A variable operand; its value pointer and (optionally) its virtual address.
+int32_t *
+VarRef(CRunningScript *s, uint32_t *va = nullptr)
+{
+	uint8_t *sp = Space();
+	uint32_t &ip = s->m_nIp;
+	uint8_t t = sp[ip] & 0x7F;
+	ip++;
+	if(t == 2){
+		uint16_t g = *(uint16_t*)&sp[ip]; ip += 2;
+		if(va) *va = VA_SCRIPT + g;
+		return (int32_t*)&sp[g];
+	}
+	if(t == 3){
+		uint16_t l = *(uint16_t*)&sp[ip]; ip += 2;
+		if(l >= NUM_LOCALS) return &gDummyVar;
+		if(va) *va = VA_LOCALS + SlotIndex(s) * 0x100 + l * 4;
+		return &s->m_anLocalVariables[l];
+	}
+	Log("%s: a variable was expected but the script gave type %d", s->m_abScriptName, t);
+	ip--;	// not a variable: leave the operand for the caller's next read
+	ReadArg(s);
+	return &gDummyVar;
+}
+
+void
+Store(CRunningScript *s, int32_t v)
+{
+	*VarRef(s) = v;
+}
+
+void
+StoreF(CRunningScript *s, float f)
+{
+	int32_t v;
+	memcpy(&v, &f, 4);
+	Store(s, v);
+}
+
+uint8_t
+NextType(CRunningScript *s)
+{
+	return Space()[s->m_nIp] & 0x7F;
+}
+
+void
+SkipVarArgs(CRunningScript *s)
+{
+	while(NextType(s) != 0) ReadArg(s);
+	s->m_nIp++;
+}
+
+const char *
+Str(const Arg &a)
+{
+	if(a.lit) return a.lit;
+	const char *p = (const char*)Resolve((uint32_t)a.i, 1);
+	return p ? p : "";
+}
+
+char *
+Buf(const Arg &a, uint32_t n = 1)
+{
+	if(a.lit) return (char*)a.lit;
+	return (char*)Resolve((uint32_t)a.i, n);
+}
+
+void
+Flag(CRunningScript *s, bool b)
+{
+	s->UpdateCompareFlag(b);
+}
+
+// ---- formatted strings (sprintf with script arguments) -----------------------------------------
+
+int
+Format(CRunningScript *s, char *str, size_t len, const char *fmt)
+{
+	size_t written = 0;
+	const char *it = fmt;
+	char tmp[256], spec[64], *sp;
+	while(*it){
+		while(*it && *it != '%'){
+			if(written++ >= len) return -1;
+			*str++ = *it++;
+		}
+		if(*it != '%') continue;
+		if(it[1] == '%'){
+			if(written++ >= len) return -1;
+			*str++ = '%';
+			it += 2;
+			continue;
+		}
+		sp = spec;
+		*sp++ = *it++;
+		while(*it == '0' || *it == '+' || *it == '-' || *it == ' ' || *it == '*' || *it == '#'){
+			if(*it == '*'){
+				Arg a = ReadArg(s);
+				snprintf(tmp, sizeof(tmp), "%d", a.i);
+				for(char *t = tmp; *t; t++) *sp++ = *t;
+			}else
+				*sp++ = *it;
+			it++;
+		}
+		while(isdigit((unsigned char)*it)) *sp++ = *it++;
+		if(*it == '.'){
+			*sp++ = *it++;
+			if(*it == '*'){
+				Arg a = ReadArg(s);
+				snprintf(tmp, sizeof(tmp), "%d", a.i);
+				for(char *t = tmp; *t; t++) *sp++ = *t;
+				it++;
+			}else
+				while(isdigit((unsigned char)*it)) *sp++ = *it++;
+		}
+		if(*it == 'h' || *it == 'l') *sp++ = *it++;
+		switch(*it){
+		case 's': {
+			Arg a = ReadArg(s);
+			const char *p = (a.lit || a.i) ? Str(a) : "(null)";
+			while(*p){
+				if(written++ >= len) return -1;
+				*str++ = *p++;
+			}
+			it++;
+			break;
+		}
+		case 'c':
+			if(written++ >= len) return -1;
+			*str++ = (char)ReadArg(s).i;
+			it++;
+			break;
+		default: {
+			char *out = tmp;
+			if(*it == 'p' || *it == 'P'){
+				snprintf(out, sizeof(tmp), "%08X", (unsigned)ReadArg(s).i);
+			}else{
+				*sp++ = *it;
+				*sp = '\0';
+				Arg a = ReadArg(s);
+				if(strchr("aAeEfFgG", *it)) snprintf(out, sizeof(tmp), spec, (double)a.f());
+				else if(strchr(spec, 'l')) snprintf(out, sizeof(tmp), spec, (long)a.i);
+				else snprintf(out, sizeof(tmp), spec, (int)a.i);
+			}
+			while(*out){
+				if(written++ >= len) return -1;
+				*str++ = *out++;
+			}
+			it++;
+			break;
+		}
+		}
+	}
+	if(written >= len) return -1;
+	*str = 0;
+	return (int)written;
+}
+
+// ---- helpers for the game side ------------------------------------------------------------------
+
+wchar *
+WideBuf(const char *text)
+{
+	static wchar ring[32][256];
+	static int next;
+	wchar *w = ring[next++ & 31];
+	int n = 0;
+	for(const unsigned char *p = (const unsigned char*)text; *p && n < 255; p++) w[n++] = *p;
+	w[n] = 0;
+	return w;
+}
+
+int
+KeyFromVK(int vk)
+{
+	if((vk >= 'A' && vk <= 'Z') || (vk >= '0' && vk <= '9')) return vk;
+	if(vk >= 0x70 && vk <= 0x7B) return GLFW_KEY_F1 + (vk - 0x70);
+	if(vk >= 0x60 && vk <= 0x69) return GLFW_KEY_KP_0 + (vk - 0x60);
+	switch(vk){
+	case 0x08: return GLFW_KEY_BACKSPACE;
+	case 0x09: return GLFW_KEY_TAB;
+	case 0x0D: return GLFW_KEY_ENTER;
+	case 0x10: case 0xA0: return GLFW_KEY_LEFT_SHIFT;
+	case 0xA1: return GLFW_KEY_RIGHT_SHIFT;
+	case 0x11: case 0xA2: return GLFW_KEY_LEFT_CONTROL;
+	case 0xA3: return GLFW_KEY_RIGHT_CONTROL;
+	case 0x12: case 0xA4: return GLFW_KEY_LEFT_ALT;
+	case 0xA5: return GLFW_KEY_RIGHT_ALT;
+	case 0x13: return GLFW_KEY_PAUSE;
+	case 0x14: return GLFW_KEY_CAPS_LOCK;
+	case 0x1B: return GLFW_KEY_ESCAPE;
+	case 0x20: return GLFW_KEY_SPACE;
+	case 0x21: return GLFW_KEY_PAGE_UP;
+	case 0x22: return GLFW_KEY_PAGE_DOWN;
+	case 0x23: return GLFW_KEY_END;
+	case 0x24: return GLFW_KEY_HOME;
+	case 0x25: return GLFW_KEY_LEFT;
+	case 0x26: return GLFW_KEY_UP;
+	case 0x27: return GLFW_KEY_RIGHT;
+	case 0x28: return GLFW_KEY_DOWN;
+	case 0x2D: return GLFW_KEY_INSERT;
+	case 0x2E: return GLFW_KEY_DELETE;
+	case 0x5B: return GLFW_KEY_LEFT_SUPER;
+	case 0x5C: return GLFW_KEY_RIGHT_SUPER;
+	case 0x6A: return GLFW_KEY_KP_MULTIPLY;
+	case 0x6B: return GLFW_KEY_KP_ADD;
+	case 0x6D: return GLFW_KEY_KP_SUBTRACT;
+	case 0x6E: return GLFW_KEY_KP_DECIMAL;
+	case 0x6F: return GLFW_KEY_KP_DIVIDE;
+	case 0x90: return GLFW_KEY_NUM_LOCK;
+	case 0x91: return GLFW_KEY_SCROLL_LOCK;
+	case 0xBA: return GLFW_KEY_SEMICOLON;
+	case 0xBB: return GLFW_KEY_EQUAL;
+	case 0xBC: return GLFW_KEY_COMMA;
+	case 0xBD: return GLFW_KEY_MINUS;
+	case 0xBE: return GLFW_KEY_PERIOD;
+	case 0xBF: return GLFW_KEY_SLASH;
+	case 0xC0: return GLFW_KEY_GRAVE_ACCENT;
+	case 0xDB: return GLFW_KEY_LEFT_BRACKET;
+	case 0xDC: return GLFW_KEY_BACKSLASH;
+	case 0xDD: return GLFW_KEY_RIGHT_BRACKET;
+	case 0xDE: return GLFW_KEY_APOSTROPHE;
+	}
+	return -1;
+}
+
+CRunningScript *
+StartScript(const std::string &path);
+
+std::string
+Slashes(const char *p)
+{
+	std::string r = p;
+	for(char &c : r) if(c == '\\') c = '/';
+	return r;
+}
+
+bool
+FileExists(const char *p, bool dir)
+{
+	struct stat st;
+	if(stat(p, &st) != 0) return false;
+	return dir ? S_ISDIR(st.st_mode) : !S_ISDIR(st.st_mode);
+}
+
+// ---- opcodes ------------------------------------------------------------------------------------
+
+typedef int8_t (*OpFn)(CRunningScript*);
+OpFn gOps[0x8000];
+
+#define OP(name) static int8_t name(CRunningScript *s)
+#define CONTINUE 0
+#define REG(id, fn) gOps[id] = fn
+
+OP(opDummy) { return CONTINUE; }
+
+void
+RemoveSlot(CRunningScript *s)
+{
+	Slot &sl = SlotOf(s);
+	if(!sl.used) return;
+	FreeChunk(sl.base);
+	sl.used = false;
+	sl.script = nullptr;
+	sl.frames.clear();
+	s->m_bIsCustom = false;
+	if(s->prev || CTheScripts::pActiveScripts == s)
+		s->RemoveScriptFromList(&CTheScripts::pActiveScripts);
+	s->AddScriptToList(&CTheScripts::pIdleScripts);
+}
+
+OP(opTerminate)
+{
+	Log("terminating custom script %s", s->m_abScriptName);
+	RemoveSlot(s);
+	return 1;
+}
+
+OP(opTerminateNamed)
+{
+	char name[9];
+	memcpy(name, &Space()[s->m_nIp], 8);
+	name[8] = 0;
+	s->m_nIp += 8;
+	bool found = false, self = false;
+	for(int i = 0; i < MAX_NUM_SCRIPTS; i++){
+		if(!gSlots[i].used || strcasecmp(gSlots[i].script->m_abScriptName, name) != 0) continue;
+		if(gSlots[i].script == s) self = true;
+		else RemoveSlot(gSlots[i].script);
+		found = true;
+	}
+	Flag(s, found);
+	if(self) RemoveSlot(s);
+	return self ? 1 : CONTINUE;
+}
+
+void
+CopyParamsToNew(CRunningScript *s, CRunningScript *ns)
+{
+	for(int i = 0; NextType(s) != 0; i++){
+		Arg a = ReadArg(s);
+		if(ns && i < NUM_LOCALS) ns->m_anLocalVariables[i] = a.i;
+	}
+	s->m_nIp++;
+}
+
+OP(opStartThread)	// 05DE: 8-byte label
+{
+	char name[9];
+	memcpy(name, &Space()[s->m_nIp], 8);
+	name[8] = 0;
+	s->m_nIp += 8;
+	CRunningScript *ns = StartScript(std::string("CLEO/") + name);
+	CopyParamsToNew(s, ns);
+	Flag(s, ns != nullptr);
+	return CONTINUE;
+}
+
+OP(opStartThreadStr)	// 0A92 / 0600
+{
+	Arg a = ReadArg(s);
+	CRunningScript *ns = StartScript(std::string("CLEO/") + Str(a));
+	CopyParamsToNew(s, ns);
+	Flag(s, ns != nullptr);
+	return CONTINUE;
+}
+
+// -- memory --
+
+bool gWarnedMem;
+
+void
+NoMem(const char *what, uint32_t addr)
+{
+	if(!gWarnedMem){
+		gWarnedMem = true;
+		Log("%s at 0x%08X is not available: game memory of the original exe does not exist on this platform", what, addr);
+	}
+}
+
+OP(opMemWrite)
+{
+	Arg addr = ReadArg(s), size = ReadArg(s), val = ReadArg(s);
+	ReadArg(s);
+	uint32_t n = (uint32_t)size.i;
+	void *p = n ? Resolve((uint32_t)addr.i, n) : nullptr;
+	if(!p){ NoMem("write_memory", (uint32_t)addr.i); return CONTINUE; }
+	switch(n){
+	case 1: *(int8_t*)p = (int8_t)val.i; break;
+	case 2: *(int16_t*)p = (int16_t)val.i; break;
+	case 4: *(int32_t*)p = val.i; break;
+	default: memset(p, val.i, n);
+	}
+	return CONTINUE;
+}
+
+OP(opMemRead)
+{
+	Arg addr = ReadArg(s), size = ReadArg(s);
+	ReadArg(s);
+	uint32_t n = (uint32_t)size.i;
+	int32_t out = 0;
+	void *p = (n == 1 || n == 2 || n == 4) ? Resolve((uint32_t)addr.i, n) : nullptr;
+	if(!p) NoMem("read_memory", (uint32_t)addr.i);
+	else if(n == 1) out = *(uint8_t*)p;
+	else if(n == 2) out = *(uint16_t*)p;
+	else out = *(int32_t*)p;
+	Store(s, out);
+	return CONTINUE;
+}
+
+// the call opcodes begin with fixed params and end with a variable list
+OP(opCall)		// 05E1 / 0AA5: func, numParams, pop
+{
+	ReadArg(s); ReadArg(s); ReadArg(s);
+	SkipVarArgs(s);
+	NoMem("call", 0);
+	return CONTINUE;
+}
+OP(opCallFunction)	// func, numParams, pop, params..., result
+{
+	ReadArg(s);
+	Arg n = ReadArg(s);
+	ReadArg(s);
+	for(int i = 0; i < n.i && i < 32; i++) ReadArg(s);
+	Store(s, 0);
+	SkipVarArgs(s);
+	NoMem("call_function", 0);
+	return CONTINUE;
+}
+OP(opCallFunctionMethod)	// func, struct, numParams, pop, params..., result
+{
+	ReadArg(s); ReadArg(s);
+	Arg n = ReadArg(s);
+	ReadArg(s);
+	for(int i = 0; i < n.i && i < 32; i++) ReadArg(s);
+	Store(s, 0);
+	SkipVarArgs(s);
+	NoMem("call_function_method", 0);
+	return CONTINUE;
+}
+
+OP(opGameVersion) { Store(s, 0); return CONTINUE; }
+
+#define MATH2(name, expr) OP(name) { Arg a = ReadArg(s), b = ReadArg(s); int32_t x = a.i, y = b.i; (void)x; (void)y; Store(s, (expr)); return CONTINUE; }
+MATH2(op0A8E, x + y)
+MATH2(op0A8F, x - y)
+MATH2(op0A90, x * y)
+MATH2(op0A91, y ? x / y : 0)
+MATH2(opAnd, x & y)
+MATH2(opOr, x | y)
+MATH2(opXor, x ^ y)
+MATH2(opMod, y ? x % y : 0)
+MATH2(opShr, x >> (y & 31))
+MATH2(opShl, (int32_t)((uint32_t)x << (y & 31)))
+OP(opNot) { Arg a = ReadArg(s); Store(s, ~a.i); return CONTINUE; }
+
+#define COMPOUND(name, stmt) OP(name) { int32_t *op = VarRef(s); Arg a = ReadArg(s); int32_t v = a.i; (void)v; stmt; return CONTINUE; }
+COMPOUND(opAndEq, *op &= v)
+COMPOUND(opOrEq, *op |= v)
+COMPOUND(opXorEq, *op ^= v)
+COMPOUND(opModEq, if(v) *op %= v)
+COMPOUND(opShrEq, *op >>= (v & 31))
+COMPOUND(opShlEq, *op = (int32_t)((uint32_t)*op << (v & 31)))
+OP(opNotEq) { int32_t *op = VarRef(s); *op = ~*op; return CONTINUE; }
+
+OP(opExp) { Arg a = ReadArg(s), b = ReadArg(s); StoreF(s, powf(a.f(), b.f())); return CONTINUE; }
+OP(opLog) { Arg a = ReadArg(s), b = ReadArg(s); StoreF(s, logf(a.f()) / logf(b.f())); return CONTINUE; }
+OP(opPopFloat) { StoreF(s, 0.0f); return CONTINUE; }
+
+// -- game structs and handles (there are no x86 structs here; scripts get tokens they can pass back) --
+
+OP(opPedStruct) { Arg a = ReadArg(s); CPed *p = CPools::GetPed(a.i); Store(s, p ? (int32_t)(VA_PED | (a.i & 0xFFFFFF)) : 0); return CONTINUE; }
+OP(opVehStruct) { Arg a = ReadArg(s); CVehicle *p = CPools::GetVehicle(a.i); Store(s, p ? (int32_t)(VA_VEH | (a.i & 0xFFFFFF)) : 0); return CONTINUE; }
+OP(opObjStruct) { Arg a = ReadArg(s); CObject *p = CPools::GetObject(a.i); Store(s, p ? (int32_t)(VA_OBJ | (a.i & 0xFFFFFF)) : 0); return CONTINUE; }
+OP(opPedHandle) { Arg a = ReadArg(s); Store(s, (a.i & 0xFF000000) == (int32_t)VA_PED ? (a.i & 0xFFFFFF) : -1); return CONTINUE; }
+OP(opVehHandle) { Arg a = ReadArg(s); Store(s, (a.i & 0xFF000000) == (int32_t)VA_VEH ? (a.i & 0xFFFFFF) : -1); return CONTINUE; }
+OP(opObjHandle) { Arg a = ReadArg(s); Store(s, (a.i & 0xFF000000) == (int32_t)VA_OBJ ? (a.i & 0xFFFFFF) : -1); return CONTINUE; }
+
+OP(opThreadPointer) { Store(s, (int32_t)(VA_THREAD + SlotIndex(s))); return CONTINUE; }
+
+OP(opNamedThreadPointer)
+{
+	char name[9];
+	memcpy(name, &Space()[s->m_nIp], 8);
+	name[8] = 0;
+	s->m_nIp += 8;
+	int found = -1;
+	for(int i = 0; i < MAX_NUM_SCRIPTS && found < 0; i++){
+		CRunningScript *sc = &CTheScripts::ScriptsArray[i];
+		bool active = gSlots[i].used || (sc->m_bIsMissionScript);
+		if(!active) continue;
+		if(strncasecmp(sc->m_abScriptName, name, 8) == 0) found = i;
+	}
+	for(int i = 0; i < MAX_NUM_SCRIPTS && found < 0; i++){
+		CRunningScript *sc = &CTheScripts::ScriptsArray[i];
+		for(CRunningScript *a = CTheScripts::pActiveScripts; a; a = a->GetNext())
+			if(a == sc && strncasecmp(sc->m_abScriptName, name, 8) == 0) found = i;
+	}
+	Store(s, found >= 0 ? (int32_t)(VA_THREAD + found) : 0);
+	Flag(s, found >= 0);
+	return CONTINUE;
+}
+
+// -- keys --
+
+OP(opKeyPressed)
+{
+	Arg a = ReadArg(s);
+	int key = KeyFromVK(a.i);
+	Flag(s, key >= 0 && PSGLOBAL(window) && glfwGetKey(PSGLOBAL(window), key) == GLFW_PRESS);
+	return CONTINUE;
+}
+
+// -- finding things --
+
+OP(opFindChar)
+{
+	Arg x = ReadArg(s), y = ReadArg(s), z = ReadArg(s), r = ReadArg(s), next = ReadArg(s), pass = ReadArg(s);
+	Slot &sl = SlotOf(s);
+	auto *pool = CPools::GetPedPool();
+	int32_t size = pool->GetSize();
+	int32_t start = next.i ? (int32_t)sl.lastPed : size;
+	if(next.i && !sl.lastPed){ Store(s, 0); Flag(s, false); return CONTINUE; }
+	float maxsq = r.f() * r.f();
+	for(int32_t i = start - 1; i >= 0; i--){
+		CPed *p = pool->GetSlot(i);
+		if(!p || !p->GetClump()) continue;
+		if(pass.i && (p->m_nPedState == PED_DEAD || p->m_nPedState == PED_DIE)) continue;
+		CVector d = p->GetPosition() - CVector(x.f(), y.f(), z.f());
+		if(d.MagnitudeSqr() <= maxsq){
+			sl.lastPed = i;
+			Store(s, CPools::GetPedRef(p));
+			Flag(s, true);
+			return CONTINUE;
+		}
+	}
+	Store(s, -1);
+	Flag(s, false);
+	sl.lastPed = 0;
+	return CONTINUE;
+}
+
+OP(opFindCar)
+{
+	Arg x = ReadArg(s), y = ReadArg(s), z = ReadArg(s), r = ReadArg(s), next = ReadArg(s), pass = ReadArg(s);
+	Slot &sl = SlotOf(s);
+	auto *pool = CPools::GetVehiclePool();
+	int32_t size = pool->GetSize();
+	int32_t start = next.i ? (int32_t)sl.lastVeh : size;
+	if(next.i && !sl.lastVeh){ Store(s, 0); Flag(s, false); return CONTINUE; }
+	float maxsq = r.f() * r.f();
+	for(int32_t i = start - 1; i >= 0; i--){
+		CVehicle *v = pool->GetSlot(i);
+		if(!v) continue;
+		if(pass.i && v->GetStatus() == STATUS_WRECKED) continue;
+		CVector d = v->GetPosition() - CVector(x.f(), y.f(), z.f());
+		if(d.MagnitudeSqr() <= maxsq){
+			sl.lastVeh = i;
+			Store(s, CPools::GetVehicleRef(v));
+			Flag(s, true);
+			return CONTINUE;
+		}
+	}
+	Store(s, -1);
+	Flag(s, false);
+	sl.lastVeh = 0;
+	return CONTINUE;
+}
+
+OP(opFindObject)
+{
+	Arg x = ReadArg(s), y = ReadArg(s), z = ReadArg(s), r = ReadArg(s), next = ReadArg(s);
+	Slot &sl = SlotOf(s);
+	auto *pool = CPools::GetObjectPool();
+	int32_t size = pool->GetSize();
+	int32_t start = next.i ? (int32_t)sl.lastObj : size;
+	if(next.i && !sl.lastObj){ Store(s, 0); Flag(s, false); return CONTINUE; }
+	float maxsq = r.f() * r.f();
+	for(int32_t i = start - 1; i >= 0; i--){
+		CObject *o = pool->GetSlot(i);
+		if(!o) continue;
+		CVector d = o->GetPosition() - CVector(x.f(), y.f(), z.f());
+		if(d.MagnitudeSqr() <= maxsq){
+			sl.lastObj = i;
+			Store(s, CPools::GetObjectRef(o));
+			Flag(s, true);
+			return CONTINUE;
+		}
+	}
+	Store(s, -1);
+	Flag(s, false);
+	sl.lastObj = 0;
+	return CONTINUE;
+}
+
+// -- SCM functions --
+
+OP(opCallScm)	// 05F5 / 0AB1
+{
+	Slot &sl = SlotOf(s);
+	Frame f;
+	for(int i = 0; i < 16; i++) f.locals[i] = s->m_anLocalVariables[i];
+	Arg label = ReadArg(s), count = ReadArg(s);
+	int32_t params[32];
+	int n = std::max(0, std::min(count.i, 16));
+	for(int i = 0; i < n; i++) params[i] = ReadArg(s).i;
+	for(int i = 0; i < 16; i++) s->m_anLocalVariables[i] = i < n ? params[i] : 0;
+	f.retAddr = s->m_nIp;
+	sl.frames.push_back(f);
+	s->SetIP(s->JumpTarget(label.i));
+	return CONTINUE;
+}
+
+OP(opRetScm)	// 05F6 / 0AB2
+{
+	Slot &sl = SlotOf(s);
+	Arg count = ReadArg(s);
+	int n = std::max(0, std::min(count.i, 16));
+	int32_t vals[16];
+	for(int i = 0; i < n; i++) vals[i] = ReadArg(s).i;
+	if(sl.frames.empty()){
+		Log("%s: cleo_return without a call", s->m_abScriptName);
+		return CONTINUE;
+	}
+	Frame f = sl.frames.back();
+	sl.frames.pop_back();
+	for(int i = 0; i < 16; i++) s->m_anLocalVariables[i] = f.locals[i];
+	s->m_nIp = f.retAddr;
+	for(int i = 0; i < n; i++) Store(s, vals[i]);
+	s->m_nIp++;
+	return CONTINUE;
+}
+
+OP(opLabelOffset)	// 0AC6 / 05F7
+{
+	Arg a = ReadArg(s);
+	uint32_t off = a.i >= 0 ? (uint32_t)a.i : s->JumpTarget(a.i);
+	Store(s, (int32_t)(VA_SCRIPT + off));
+	return CONTINUE;
+}
+
+OP(opVarOffset)	// 0AC7 / 05F8
+{
+	uint32_t va = 0;
+	VarRef(s, &va);
+	Store(s, (int32_t)va);
+	return CONTINUE;
+}
+
+OP(opGosubIfFalse)
+{
+	Arg a = ReadArg(s);
+	if(!s->m_bCondResult){
+		if(s->m_nStackPointer < MAX_STACK_DEPTH) s->m_anStack[s->m_nStackPointer++] = s->m_nIp;
+		s->SetIP(s->JumpTarget(a.i));
+	}
+	return CONTINUE;
+}
+
+OP(opReturnIfFalse)
+{
+	if(!s->m_bCondResult && s->m_nStackPointer > 0) s->SetIP(s->m_anStack[--s->m_nStackPointer]);
+	return CONTINUE;
+}
+
+// -- shared variables and CLEO arrays --
+
+OP(opSetShared) { Arg a = ReadArg(s), b = ReadArg(s); if((uint32_t)a.i < NUM_SHARED) gShared[a.i] = b.i; return CONTINUE; }
+OP(opGetShared) { Arg a = ReadArg(s); Store(s, (uint32_t)a.i < NUM_SHARED ? gShared[a.i] : 0); return CONTINUE; }
+OP(opSetArray) { Arg a = ReadArg(s), b = ReadArg(s); if((uint32_t)a.i < ARRAY_SIZE_CLEO) SlotOf(s).arr[a.i] = b.i; return CONTINUE; }
+OP(opGetArray) { Arg a = ReadArg(s); Store(s, (uint32_t)a.i < ARRAY_SIZE_CLEO ? SlotOf(s).arr[a.i] : 0); return CONTINUE; }
+OP(opArrayPtr)
+{
+	Arg a = ReadArg(s);
+	Store(s, (uint32_t)a.i < ARRAY_SIZE_CLEO ? (int32_t)(VA_ARRAY + SlotIndex(s) * 0x400 + a.i * 4) : 0);
+	return CONTINUE;
+}
+OP(opArrayPtrScript)
+{
+	Arg t = ReadArg(s), a = ReadArg(s);
+	uint32_t idx = (uint32_t)t.i - VA_THREAD;
+	Store(s, (idx < MAX_NUM_SCRIPTS && (uint32_t)a.i < ARRAY_SIZE_CLEO) ? (int32_t)(VA_ARRAY + idx * 0x400 + a.i * 4) : 0);
+	return CONTINUE;
+}
