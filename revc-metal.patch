diff --git a/src/extras/plugins/NativePorts.cpp b/src/extras/plugins/NativePorts.cpp
new file mode 100644
index 00000000..946dd910
--- /dev/null
+++ b/src/extras/plugins/NativePorts.cpp
@@ -0,0 +1,196 @@
+#include "common.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+
+#include "skeleton.h"
+#include "Camera.h"
+#include "Pad.h"
+#include "World.h"
+#include "Frontend.h"
+#include "ClassicAxis.h"
+#include "LocalDentPort.h"
+#include "NativePorts.h"
+#include "ZMenuPort.h"
+
+static const RegtaPluginAPI *ms_api;
+
+static std::string
+LowerBaseName(const std::string &path)
+{
+	size_t s = path.find_last_of("/\\");
+	std::string n = s == std::string::npos ? path : path.substr(s+1);
+	for(size_t i = 0; i < n.size(); i++)
+		n[i] = tolower((unsigned char)n[i]);
+	return n;
+}
+
+static std::string
+DirName(const std::string &path)
+{
+	size_t s = path.find_last_of("/\\");
+	return s == std::string::npos ? std::string(".") : path.substr(0, s);
+}
+
+// Reads "key = value" from an ini section (case-insensitive, ';' comments). Returns false if absent.
+static bool
+IniGet(const std::string &file, const char *section, const char *key, std::string &value)
+{
+	FILE *f = fopen(file.c_str(), "rb");
+	if(f == nil) return false;
+	char line[512];
+	std::string cur;
+	bool found = false;
+	while(!found && fgets(line, sizeof(line), f)){
+		char *c = strchr(line, ';');
+		if(c) *c = '\0';
+		std::string l = line;
+		size_t a = l.find_first_not_of(" \t\r\n");
+		if(a == std::string::npos) continue;
+		size_t b = l.find_last_not_of(" \t\r\n");
+		l = l.substr(a, b-a+1);
+		if(l[0] == '['){
+			cur = l.substr(1, l.find(']') - 1);
+			continue;
+		}
+		size_t eq = l.find('=');
+		if(eq == std::string::npos) continue;
+		std::string k = l.substr(0, eq), v = l.substr(eq+1);
+		while(!k.empty() && isspace((unsigned char)k[k.size()-1])) k.erase(k.size()-1);
+		while(!v.empty() && isspace((unsigned char)v[0])) v.erase(0, 1);
+		if(strcasecmp(cur.c_str(), section) == 0 && strcasecmp(k.c_str(), key) == 0){
+			value = v;
+			found = true;
+		}
+	}
+	fclose(f);
+	return found;
+}
+
+// ---- FramerateVigilante (Junior_Djjr) ----
+// The original raises the frame cap used while the game's frame limiter is on ("FPSlimit") and fixes
+// frame-rate dependent behaviour. Here: honour FPSlimit by setting the engine's frame cap. The
+// RefreshRate setting only describes the display for the original's timing patches and is not needed.
+static int ms_fpsLimit;
+
+static void
+FramerateVigilanteInit(void *)
+{
+	if(ms_fpsLimit >= 1){
+		RsGlobal.maxFPS = ms_fpsLimit;
+		ms_api->log("FramerateVigilante: frame limit set to %d FPS", ms_fpsLimit);
+	}
+}
+
+static bool
+LoadFramerateVigilante(const std::string &asiPath, const RegtaPluginAPI *api)
+{
+	std::string v;
+	ms_fpsLimit = 0;
+	if(IniGet(DirName(asiPath) + "/FramerateVigilante.ini", "Settings", "FPSlimit", v))
+		ms_fpsLimit = atoi(v.c_str());
+	if(ms_fpsLimit < 1) ms_fpsLimit = 30;	// the original's default
+	api->registerEvent(REGTA_EVENT_INIT_GAME, FramerateVigilanteInit, nil);
+	return true;
+}
+
+// ---- SACarCam ----
+// The original is a closed-source .asi that brings San Andreas' follow-car camera to GTA III.
+// reGTA already contains that camera (CCam::Process_FollowCar_SA, behind the FreeCam option, which
+// also changes on-foot aiming). This port enables just the vehicle camera, with its zoom values.
+static void
+SACarCamInit(void *)
+{
+	CCamera::bSACarCam = true;
+	ms_api->log("SACarCam: SA vehicle camera enabled");
+}
+
+static bool
+LoadSACarCam(const std::string &, const RegtaPluginAPI *api)
+{
+	api->registerEvent(REGTA_EVENT_INIT_GAME, SACarCamInit, nil);
+	return true;
+}
+
+// ---- Classic Axis ----
+// Stage 1 (camera): the third-person on-foot camera. Like the original it forces mouse-look
+// camera mode every frame and sets the crosshair position multipliers from the ini.
+static void
+ClassicAxisProcess(void *)
+{
+	CCamera::m_bUseMouse3rdPerson = true;
+	// reGTA's mouse third-person mode alone makes Claude strafe like a first-person shooter. Its FreeCam
+	// flag selects the normal third-person walking (he turns to face the way he walks, relative to the
+	// camera) and SA-style aiming, which is what Classic Axis plays like.
+	CCamera::bFreeCam = true;
+	FrontEndMenuManager.m_ControlMethod = 0;
+	if(getenv("REGTA_TRACE_CA")){
+		static int frame;
+		static float maxX, maxY;
+		CPad *pad = CPad::GetPad(0);
+		if(Abs(pad->NewMouseControllerState.x) > maxX) maxX = Abs(pad->NewMouseControllerState.x);
+		if(Abs(pad->NewMouseControllerState.y) > maxY) maxY = Abs(pad->NewMouseControllerState.y);
+		if(++frame % 120 == 0){
+			ms_api->log("ClassicAxis: cam mode=%d onFoot=%d mouse peak=(%.1f,%.1f) controlMethod=%d useMouse3rd=%d",
+				(int)TheCamera.Cams[TheCamera.ActiveCam].Mode, FindPlayerVehicle() == nil, maxX, maxY,
+				(int)FrontEndMenuManager.m_ControlMethod, (int)CCamera::m_bUseMouse3rdPerson);
+			maxX = maxY = 0.0f;
+		}
+	}
+	TheCamera.m_f3rdPersonCHairMultX = ClassicAxis::settings.cameraCrosshairMultX;
+	TheCamera.m_f3rdPersonCHairMultY = ClassicAxis::settings.cameraCrosshairMultY;
+}
+
+static bool
+LoadClassicAxis(const std::string &asiPath, const RegtaPluginAPI *api)
+{
+	ClassicAxis::Enable(DirName(asiPath));
+	api->registerEvent(REGTA_EVENT_PROCESS, ClassicAxisProcess, nil);
+	return true;
+}
+
+// ---- LocalDentIII ----
+void LocalDentRegister(const RegtaPluginAPI *api);
+
+static bool
+LoadLocalDent(const std::string &asiPath, const RegtaPluginAPI *api)
+{
+	LocalDent::Enable(DirName(asiPath));
+	if(!LocalDent::enabled) return true;	// disabled in its ini: nothing to run, but the .asi is handled
+	LocalDentRegister(api);
+	return true;
+}
+
+bool
+CNativePorts::TryLoad(const std::string &asiPath, const RegtaPluginAPI *api)
+{
+	ms_api = api;
+	std::string n = LowerBaseName(asiPath);
+	if(n == "zmenuiii.asi"){
+		ZMenuPortRegister(DirName(asiPath), api);
+		return true;
+	}
+	if(n == "frameratevigilante.iii.asi" || n == "frameratevigilante.asi"){
+		bool ok = LoadFramerateVigilante(asiPath, api);
+		if(ok) api->log("native port active: %s", n.c_str());
+		return ok;
+	}
+	if(n == "iii_classic_axis.asi" || n == "classicaxisiii.asi"){
+		bool ok = LoadClassicAxis(asiPath, api);
+		if(ok) api->log("native port active: %s (camera stage)", n.c_str());
+		return ok;
+	}
+	if(n == "localdentiii.asi"){
+		bool ok = LoadLocalDent(asiPath, api);
+		if(ok) api->log("native port active: %s", n.c_str());
+		return ok;
+	}
+	if(n == "sacarcam.asi"){
+		bool ok = LoadSACarCam(asiPath, api);
+		if(ok) api->log("native port active: %s", n.c_str());
+		return ok;
+	}
+	return false;
+}
