+
+namespace {
+bool registered, visible, god, neverWanted, unlimitedAmmo, ownsControlBit;
+bool previousDamageable;
+CPlayerPed *godPlayer;
+int row, carIndex, toggleF = 6;
+const RegtaPluginAPI *plugin;
+struct SpawnCarEntry { int model; std::string name; };
+std::vector<SpawnCarEntry> carModels;
+bool vehicleMenu;
+bool weatherMenu;
+int weatherIndex;
+const char *weatherNames[] = { "Sunny", "Cloudy", "Rainy", "Foggy", "Normal (random) weather" };
+const int numWeathers = 5;
+void BuildCarList()
+{
+	carModels.clear();
+	for(int id=0; id<MODELINFOSIZE; ++id){
+		auto *base=CModelInfo::GetModelInfo(id);
+		if(!base || base->GetModelType()!=MITYPE_VEHICLE) continue;
+		auto *info=(CVehicleModelInfo*)base;
+		if(info->m_vehicleType!=VEHICLE_TYPE_CAR) continue;
+		std::string name=UnicodeToAscii(TheText.Get(info->m_gameName));
+		if(name.empty() || name[0]=='~' || name.find("missing")!=std::string::npos) {
+			name=base->GetModelName();
+			for(size_t i=0;i<name.size();i++){if(name[i]=='_') name[i]=' ';else if(i==0 || name[i-1]==' ') name[i]=(char)toupper((unsigned char)name[i]);}
+		}
+		carModels.push_back({id,name});
+	}
+	std::sort(carModels.begin(),carModels.end(),[](const SpawnCarEntry &a,const SpawnCarEntry &b){return a.name==b.name?a.model<b.model:a.name<b.name;});
+	carIndex=0;
+	plugin->log("Trainer: %zu installed car models in spawn browser",carModels.size());
+}
+const int rows = 12;
+
+void Close()
+{
+	visible = false;
+	vehicleMenu=false;
+	weatherMenu=false;
+	if(ownsControlBit) CPad::GetPad(0)->SetEnablePlayerControls(PLAYERCONTROL_UNK10);
+	ownsControlBit = false;
+}
+
+void Reset(void *)
+{
+	Close();
+	// Never retain a player pointer across restarts or save loads.
+	godPlayer = nil;
+	carModels.clear();
+}
+
+void SpawnCar()
+{
+	CPlayerPed *ped = FindPlayerPed();
+	if(carModels.empty()) return;
+	int model = carModels[carIndex].model;
+	CVector pos = ped->GetPosition() + ped->GetForward() * 7.0f;
+	bool ground = false;
+	float z = CWorld::FindGroundZFor3DCoord(pos.x, pos.y, pos.z + 10.0f, &ground);
+	if(!ground){ plugin->log("ZMenu native subset: no ground ahead; vehicle not spawned"); return; }
+	pos.z = z + 1.0f;
+	CStreaming::RequestModel(model, 0);
+	CStreaming::LoadAllRequestedModels(false);
+	if(CStreaming::ms_aInfoForModel[model].m_loadState != STREAMSTATE_LOADED) return;
+	CAutomobile *car = new CAutomobile(model, RANDOM_VEHICLE);
+	if(car){
+		car->SetPosition(pos);
+		car->SetOrientation(0.0f, 0.0f, FindPlayerHeading());
+		car->SetStatus(STATUS_ABANDONED);
+		car->m_nDoorLock = CARLOCK_UNLOCKED;
+		CWorld::Add(car);
+	}
+	CStreaming::SetModelIsDeletable(model);
+}
+
+void Activate()
+{
+	CPlayerPed *ped = FindPlayerPed();
+	switch(row){
+	case 0: god = !god; break;
+	case 1: neverWanted = !neverWanted; break;
+	case 2: unlimitedAmmo = !unlimitedAmmo; break;
+	case 3: ped->m_fHealth = 100.0f; ped->m_fArmour = 100.0f; break;
+	case 4:
+		for(eWeaponType w : kNativeLoadout){
+			int model = CWeaponInfo::GetWeaponInfo((eWeaponType)w)->m_nModelId;
+			if(model >= 0) CStreaming::RequestModel(model, 0);
+		}
+		CStreaming::LoadAllRequestedModels(false);
+		for(eWeaponType w : kNativeLoadout){
+			ped->GiveWeapon((eWeaponType)w, 999);
+			int model = CWeaponInfo::GetWeaponInfo((eWeaponType)w)->m_nModelId;
+			if(model >= 0) CStreaming::SetModelIsDeletable(model);
+		}
+		break;
+	case 5: ped->m_pWanted->SetWantedLevel(0); break;
+	case 6: CWorld::Players[CWorld::PlayerInFocus].m_nMoney += 100000; break;
+	case 7:
+		if(CVehicle *car = FindPlayerVehicle()){
+			car->m_fHealth = 1000.0f;
+			if(car->IsCar()) ((CAutomobile*)car)->Fix();
+		}
+		break;
+	case 8: vehicleMenu=true; break;
+	case 9: weatherMenu=true; weatherIndex = CWeather::ForcedWeatherType >= 0 ? CWeather::ForcedWeatherType : numWeathers-1; break;
+	case 10: CWeather::ReleaseWeather(); break;
+	case 11: CClock::SetGameClock((CClock::GetHours() + 1) % 24, 0); break;
+	}
+}
+
+void Process(void *)
+{
+	CPlayerPed *ped = FindPlayerPed();
+	CPad *pad = CPad::GetPad(0);
+	if(!ped || FrontEndMenuManager.m_bMenuActive){ Close(); return; }
+	if(pad->GetFJustDown(toggleF)){
+		if(visible) Close();
+		else {
+			visible = true;
+			if(carModels.empty()) BuildCarList();
+			ownsControlBit = !pad->IsPlayerControlsDisabledBy(PLAYERCONTROL_UNK10);
+			if(ownsControlBit) pad->SetDisablePlayerControls(PLAYERCONTROL_UNK10);
+		}
+	}
+	if(visible){
+		bool back=pad->GetTabJustDown() || pad->GetBackspaceJustDown() || pad->GetPad0JustDown();
+		if(back){if(vehicleMenu) vehicleMenu=false;else if(weatherMenu) weatherMenu=false;else Close();}
+		else if(weatherMenu){
+			if(pad->GetUpJustDown() || pad->GetPad8JustDown()) weatherIndex=(weatherIndex+numWeathers-1)%numWeathers;
+			if(pad->GetDownJustDown() || pad->GetPad2JustDown()) weatherIndex=(weatherIndex+1)%numWeathers;
+			if(pad->GetEnterJustDown() || pad->GetPad5JustDown()){
+				if(weatherIndex < WEATHER_TOTAL) CWeather::ForceWeatherNow(weatherIndex);
+				else CWeather::ReleaseWeather();
+			}
+		}
+		else if(vehicleMenu){
+			int n=(int)carModels.size();
+			if(n){
+				if(pad->GetUpJustDown() || pad->GetPad8JustDown()) carIndex=(carIndex+n-1)%n;
+				if(pad->GetDownJustDown() || pad->GetPad2JustDown()) carIndex=(carIndex+1)%n;
+				if(pad->GetLeftJustDown() || pad->GetPad4JustDown()) carIndex=(carIndex+n-Min(n,10))%n;
+				if(pad->GetRightJustDown() || pad->GetPad6JustDown()) carIndex=(carIndex+10)%n;
+				if(pad->GetEnterJustDown() || pad->GetPad5JustDown()) SpawnCar();
+			}
+		}else{
+			if(pad->GetUpJustDown() || pad->GetPad8JustDown()) row=(row+rows-1)%rows;
+			if(pad->GetDownJustDown() || pad->GetPad2JustDown()) row=(row+1)%rows;
+			if(pad->GetEnterJustDown() || pad->GetPad5JustDown()) Activate();
+		}
+	}
+	if(god){
+		if(godPlayer != ped){ godPlayer = ped; previousDamageable = ped->m_bCanBeDamaged; }
+		ped->m_bCanBeDamaged = false;
+		ped->m_fHealth = Max(ped->m_fHealth, 100.0f);
+	}else if(godPlayer == ped){
+		ped->m_bCanBeDamaged = previousDamageable;
+		godPlayer = nil;
+	}
+	if(neverWanted) ped->m_pWanted->SetWantedLevel(0);
+	if(unlimitedAmmo)
+		for(int i = 0; i < ARRAY_SIZE(ped->m_weapons); ++i)
+			if(ped->m_weapons[i].m_nAmmoTotal > 0) ped->m_weapons[i].m_nAmmoTotal = 9999;
+}
+
+void Text(float x, float y, const char *s, const CRGBA &color)
+{
+	wchar wide[160];
+	int i = 0;
+	for(; s[i] && i < 159; ++i) wide[i] = (unsigned char)s[i];
+	wide[i] = 0;
+	CFont::SetColor(color);
+	CFont::PrintString(SCREEN_SCALE_X(x), SCREEN_SCALE_Y(y), wide);
+}
+
+void Draw(void *)
+{
+	if(!visible || FrontEndMenuManager.m_bMenuActive) return;
+	RwRenderStateSet(rwRENDERSTATEZTESTENABLE, (void*)FALSE);
+	RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, (void*)FALSE);
+	RwRenderStateSet(rwRENDERSTATEVERTEXALPHAENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATESRCBLEND, (void*)rwBLENDSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATEDESTBLEND, (void*)rwBLENDINVSRCALPHA);
+	CSprite2d::DrawRect(CRect(SCREEN_SCALE_X(16), SCREEN_SCALE_Y(24), SCREEN_SCALE_X(370), SCREEN_SCALE_Y(406)), CRGBA(10, 18, 30, 225));
+	CFontDetails saved = CFont::Details;
+	CFont::SetBackgroundOff(); CFont::SetCentreOff(); CFont::SetRightJustifyOff();
+	CFont::SetJustifyOff(); CFont::SetPropOn(); CFont::SetFontStyle(FONT_BANK);
+	CFont::SetScale(SCREEN_SCALE_X(0.42f), SCREEN_SCALE_Y(0.78f));
+	CFont::SetWrapx(SCREEN_SCALE_X(360)); CFont::SetDropShadowPosition(0);
+	Text(28, 34, "ZMenu - native compatibility subset", CRGBA(255, 205, 70, 255));
+	Text(28, 54, "Up/Down select | Enter apply | Tab back", CRGBA(185, 195, 210, 255));
+	const char *labels[] = { "God mode", "Never wanted", "Unlimited ammo", "Restore health and armour", "Give all weapons", "Clear wanted level", "Add $100,000", "Repair current vehicle", "Spawn vehicle", "Weather", "Restore normal weather", "Advance time one hour" };
+	if(weatherMenu){
+		Text(28, 78, "Weather", CRGBA(255, 205, 70, 255));
+		for(int i = 0; i < numWeathers; ++i){
+			char line[96];
+			bool current = i < WEATHER_TOTAL ? CWeather::ForcedWeatherType == i : CWeather::ForcedWeatherType < 0;
+			snprintf(line, sizeof(line), "%s%s", weatherNames[i], current ? "   (active)" : "");
+			Text(28, 103 + i*23, line, i == weatherIndex ? CRGBA(255, 205, 70, 255) : CRGBA(235, 235, 240, 255));
+		}
+	}else if(vehicleMenu){
+		char title[128];snprintf(title,sizeof(title),"All cars: %d / %zu",carModels.empty()?0:carIndex+1,carModels.size());
+		Text(28,78,title,CRGBA(255,205,70,255));
+		int first=carIndex/10*10;
+		for(int i=first;i<Min(first+10,(int)carModels.size());++i){
+			char line[160];snprintf(line,sizeof(line),"%s  [%d]",carModels[i].name.c_str(),carModels[i].model);
+			Text(28,103+(i-first)*23,line,i==carIndex?CRGBA(255,205,70,255):CRGBA(235,235,240,255));
+		}
+	}else for(int i = 0; i < rows; ++i){
+		char line[160];
+		const char *state = i == 0 ? (god ? "ON" : "OFF") : i == 1 ? (neverWanted ? "ON" : "OFF") : (unlimitedAmmo ? "ON" : "OFF");
+		if(i < 3) snprintf(line, sizeof(line), "%s: %s", labels[i], state);
+		else if(i == 8) snprintf(line, sizeof(line), "Spawn vehicle > (%zu cars)", carModels.size());
+		else if(i == 9) snprintf(line, sizeof(line), "Weather >");
+		else snprintf(line, sizeof(line), "%s", labels[i]);
+		Text(28, 82 + i * 23, line, i == row ? CRGBA(255, 205, 70, 255) : CRGBA(235, 235, 240, 255));
+	}
+	Text(28, 369, vehicleMenu ? "Enter spawn | Left/right page | Tab back" : weatherMenu ? "Enter apply | Tab back" : "F7 toggle | Enter opens the vehicle and weather menus", CRGBA(165, 175, 190, 255));
+	CFont::DrawFonts();
+	CFont::Details = saved;
+}
+}
+
+void ZMenuPortRegister(const std::string &directory, const RegtaPluginAPI *api)
+{
+	if(registered) return;
+	registered = true;
+	plugin = api;
+	// Import supported startup options; other original ZMenu settings are ignored.
+	FILE *f = fopen((directory + "/ZMenuIII.ini").c_str(), "r");
+	if(f){
+		char line[512], key[128]; int value;
+		while(fgets(line, sizeof(line), f))
+			if(sscanf(line, " %127[^=]=%d", key, &value) == 2){
+				char *end = key + strlen(key); while(end > key && (end[-1] == ' ' || end[-1] == '\t')) *--end = 0;
+				if(!strcmp(key, "AlwaysGodMode")) god = value != 0;
+				if(!strcmp(key, "NeverWanted")) neverWanted = value != 0;
+				if(!strcmp(key, "UnlimitedAmmo")) unlimitedAmmo = value != 0;
+				if(!strcmp(key, "MenuToggle") && value >= 112 && value <= 123) toggleF = value - 112;
+			}
+		fclose(f);
+	}
+	api->registerEvent(REGTA_EVENT_PROCESS, Process, nil);
+	api->registerEvent(REGTA_EVENT_DRAW2D, Draw, nil);
+	api->registerEvent(REGTA_EVENT_INIT_SCRIPTS, Reset, nil);
+	api->registerEvent(REGTA_EVENT_SHUTDOWN_GAME, Reset, nil);
+	api->log("ZMenuIII: native compatibility subset active (F%d); Windows PE/x86 code is NOT executed", toggleF + 1);
+}
