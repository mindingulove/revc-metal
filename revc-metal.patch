+namespace FreeRoam {
+bool Active = false;
+struct Road { int pedestrian; CVector a, b; };
+static std::vector<Road> roads;
+static CVector spawn(223.0f, -1288.0f, 12.0f);
+static bool selected = false;
+static float minX, maxX, minY, maxY;
+static float zoom = 1.0f, centreU = 0.5f, centreV = 0.5f;
+
+static void LoadMap()
+{
+	if (!roads.empty()) return;
+	FILE *file = fopen("data/freeroam-map.dat", "r");
+	if (!file) return;
+	Road r;
+	minX = minY = 100000.0f; maxX = maxY = -100000.0f;
+	while (fscanf(file, "%d %f %f %f %f %f %f", &r.pedestrian, &r.a.x, &r.a.y, &r.a.z, &r.b.x, &r.b.y, &r.b.z) == 7) {
+		roads.push_back(r);
+		minX = Min(minX, Min(r.a.x, r.b.x)); maxX = Max(maxX, Max(r.a.x, r.b.x));
+		minY = Min(minY, Min(r.a.y, r.b.y)); maxY = Max(maxY, Max(r.a.y, r.b.y));
+	}
+	fclose(file);
+	minX -= 80; maxX += 80; minY -= 80; maxY += 80;
+}
+
+static freeroammap::View MapView()
+{
+	LoadMap();
+	const float size = Min(SCREEN_WIDTH * 0.86f, SCREEN_HEIGHT * 0.69f) * zoom;
+	return {SCREEN_WIDTH * 0.5f - centreU * size, SCREEN_HEIGHT * 0.485f - centreV * size, size,
+		-(WORLD_SIZE_X / 2 + MENU_MAP_LEFT_OFFSET * MENU_MAP_LENGTH_UNIT),
+		WORLD_SIZE_Y / 2 - MENU_MAP_TOP_OFFSET * MENU_MAP_LENGTH_UNIT,
+		WORLD_SIZE_X / MENU_MAP_WIDTH_SCALE, WORLD_SIZE_Y / MENU_MAP_HEIGHT_SCALE};
+}
+static bool InMap(float x, float y)
+{
+	return x >= SCREEN_WIDTH*.07f && x <= SCREEN_WIDTH*.93f && y >= SCREEN_HEIGHT*.14f && y <= SCREEN_HEIGHT*.83f;
+}
+static void Text(float x, float y, const char *str, float size = 0.55f)
+{
+	wchar buffer[256];
+	AsciiToUnicode(str, buffer);
+	CFont::SetBackgroundOff(); CFont::SetPropOn();
+	CFont::SetFontStyle(FONT_BANK);
+	CFont::SetScale(SCREEN_SCALE_X(size), SCREEN_SCALE_Y(size));
+	CFont::SetColor(CRGBA(255, 220, 155, 255));
+	CFont::SetCentreOff(); CFont::SetRightJustifyOff(); CFont::SetJustifyOff();
+	CFont::SetWrapx(SCREEN_WIDTH * 0.98f);
+	CFont::SetDropShadowPosition(0);
+	CFont::PrintString(x, y, buffer);
+}
+static void Select(float x, float y)
+{
+	float best = 1.0e20f;
+	selected = false;
+	// Use pedestrian paths so the player starts on a sidewalk rather than in traffic.
+	for (const Road &r : roads) {
+		if (!r.pedestrian) continue;
+		CVector d = r.b-r.a;
+		float length = d.x*d.x + d.y*d.y;
+		float t = length > 0 ? Clamp(((x-r.a.x)*d.x+(y-r.a.y)*d.y)/length, 0.0f, 1.0f) : 0;
+		CVector p = r.a+d*t;
+		float distance = (p.x-x)*(p.x-x)+(p.y-y)*(p.y-y);
+		if (distance < best) { best = distance; spawn = p; selected = true; }
+	}
+}
+void DrawMap(CMenuManager &menu)
+{
+#ifdef CUSTOM_FRONTEND_OPTIONS
+	auto view = MapView();
+	CSprite2d::DrawRect(CRect(0,0,SCREEN_WIDTH,SCREEN_HEIGHT), CRGBA(12,19,24,255));
+	const float vl=SCREEN_WIDTH*.07f, vt=SCREEN_HEIGHT*.14f, vr=SCREEN_WIDTH*.93f, vb=SCREEN_HEIGHT*.83f;
+	CSprite2d::DrawRect(CRect(vl,vt,vr,vb),CRGBA(53,100,115,255));
+	RwRenderStateSet(rwRENDERSTATETEXTUREFILTER,(void*)rwFILTERLINEAR);
+	// Use the same nine map textures as VC's pause map, without accessing a
+	// player or radar blips before the world has been initialized.
+	for(int row=0;row<3;row++) for(int col=0;col<3;col++){
+		float tile=view.size/3, x=view.left+col*tile, y=view.top+row*tile;
+		float l=Max(x,vl), t=Max(y,vt), r=Min(x+tile,vr), b=Min(y+tile,vb);
+		if(l>=r || t>=b) continue;
+		float u0=(l-x)/tile,v0=(t-y)/tile,u1=(r-x)/tile,v1=(b-y)/tile;
+		menu.m_aFrontEndSprites[MENUSPRITE_MAPTOP01+row*3+col].Draw(CRect(l,t,r,b),CRGBA(255,255,255,255),u0,v0,u1,v0,u0,v1,u1,v1);
+	}
+	if(selected){
+		float x=view.screenX(spawn.x),y=view.screenY(spawn.y);
+		if(InMap(x,y)){
+			CSprite2d::DrawRect(CRect(x-6,y-6,x+6,y+6),CRGBA(0,0,0,255));
+			CSprite2d::DrawRect(CRect(x-4,y-4,x+4,y+4),CRGBA(255,190,50,255));
+		}
+	}
+	float x=menu.m_bShowMouse?menu.m_nMousePosX:SCREEN_WIDTH*.5f;
+	float y=menu.m_bShowMouse?menu.m_nMousePosY:SCREEN_HEIGHT*.485f;
+	if(InMap(x,y)){
+		CSprite2d::DrawRect(CRect(x-10,y-1,x+10,y+1),CRGBA(255,255,255,255));
+		CSprite2d::DrawRect(CRect(x-1,y-10,x+1,y+10),CRGBA(255,255,255,255));
+	}
+	Text(SCREEN_WIDTH*.07f,SCREEN_HEIGHT*.035f,"START FREE ROAM",.9f);
+	Text(SCREEN_WIDTH*.07f,SCREEN_HEIGHT*.095f,"VICE CITY / SELECT A STARTING LOCATION",.42f);
+	Text(SCREEN_WIDTH*.07f,SCREEN_HEIGHT*.85f,roads.empty()?"Spawn paths unavailable":"Click: select | Wheel / PgUp-PgDn: zoom | Right-drag / arrows: pan",.4f);
+	Text(SCREEN_WIDTH*.07f,SCREEN_HEIGHT*.90f,"Esc / B: Back",.5f);
+	CSprite2d::DrawRect(CRect(SCREEN_WIDTH*.55f,SCREEN_HEIGHT*.89f,SCREEN_WIDTH*.93f,SCREEN_HEIGHT*.945f),selected?CRGBA(50,95,65,255):CRGBA(40,50,50,255));
+	Text(SCREEN_WIDTH*.55f,SCREEN_HEIGHT*.90f,selected?"ENTER / A: START HERE":"Choose a location",.5f);
+	if(selected){char info[160];snprintf(info,sizeof(info),"X %.0f Y %.0f / %.1fx zoom / sidewalk spawn",spawn.x,spawn.y,zoom);Text(SCREEN_WIDTH*.07f,SCREEN_HEIGHT*.96f,info,.35f);}
+	CFont::DrawFonts();
+#endif
+}
+void ProcessMap(CMenuManager &menu)
+{
+#ifdef CUSTOM_FRONTEND_OPTIONS
+	CPad *pad=CPad::GetPad(0);
+	if(pad->GetEscapeJustDown() || pad->GetBackspaceJustDown() || pad->GetTriangleJustDown() || pad->GetCircleJustDown()){
+		menu.SwitchToNewScreen(MENUPAGE_NEW_GAME); return;
+	}
+	if(menu.m_nMousePosX!=menu.m_nMouseOldPosX || menu.m_nMousePosY!=menu.m_nMouseOldPosY) menu.m_bShowMouse=true;
+	auto view=MapView();
+	float mx=menu.m_nMousePosX,my=menu.m_nMousePosY;
+	bool click=pad->GetLeftMouseJustDown();
+	bool startWithPad=selected && !menu.m_bShowMouse && pad->GetCrossJustDown();
+	float factor=1;
+	if(pad->GetMouseWheelUpJustDown()) factor=1.2f;
+	if(pad->GetMouseWheelDownJustDown()) factor=1/1.2f;
+	float dt=Clamp(CTimer::GetTimeStepNonClipped()/30.f,0.f,.05f);
+	if(pad->GetPageUp() || pad->GetRightShoulder1()) factor=powf(2.f,dt);
+	if(pad->GetPageDown() || pad->GetRightShoulder2()) factor=powf(.5f,dt);
+	if(factor!=1){
+		float ax=menu.m_bShowMouse && InMap(mx,my)?mx:SCREEN_WIDTH*.5f;
+		float ay=menu.m_bShowMouse && InMap(mx,my)?my:SCREEN_HEIGHT*.485f;
+		float u=(ax-view.left)/view.size,v=(ay-view.top)/view.size;
+		zoom=Clamp(zoom*factor,1.f,6.f);
+		float size=Min(SCREEN_WIDTH*.86f,SCREEN_HEIGHT*.69f)*zoom;
+		centreU=u-(ax-SCREEN_WIDTH*.5f)/size;centreV=v-(ay-SCREEN_HEIGHT*.485f)/size;
+	}
+	view=MapView();
+	float dx=(pad->GetRight() || pad->GetDPadRight())-(pad->GetLeft() || pad->GetDPadLeft());
+	float dy=(pad->GetDown() || pad->GetDPadDown())-(pad->GetUp() || pad->GetDPadUp());
+	dx+=pad->GetLeftStickX()/128.f;dy+=pad->GetLeftStickY()/128.f;
+	if(dx || dy){menu.m_bShowMouse=false;centreU+=dx*dt*.6f/zoom;centreV+=dy*dt*.6f/zoom;}
+	if(pad->GetRightMouse() && InMap(mx,my)){
+		centreU-=(mx-menu.m_nMouseOldPosX)/view.size;centreV-=(my-menu.m_nMouseOldPosY)/view.size;
+	}
+	centreU=Clamp(centreU,0.f,1.f);centreV=Clamp(centreV,0.f,1.f);
+	view=MapView();
+	if(click && InMap(mx,my) && !roads.empty()){
+		float u=(mx-view.left)/view.size,v=(my-view.top)/view.size;
+		if(u>=0 && u<=1 && v>=0 && v<=1) Select(view.worldX(mx),view.worldY(my));
+	}
+	// With a pad, A selects at the crosshair; Enter starts after a selection.
+	if(pad->GetCrossJustDown() && !startWithPad && !menu.m_bShowMouse && !roads.empty()) Select(view.worldX(SCREEN_WIDTH*.5f),view.worldY(SCREEN_HEIGHT*.485f));
+	if(selected && (pad->GetEnterJustDown() || startWithPad || (click && mx>SCREEN_WIDTH*.55f && my>SCREEN_HEIGHT*.89f && my<SCREEN_HEIGHT*.945f))){
+		menu.m_bWantToLoad=false;menu.DoSettingsBeforeStartingAGame();Active=true;
+	}
+#endif
+}
+// Stable reference addresses allow deleted dynamic objects to clear their records.
+struct WorldChange { CEntity *entity; bool visible,collision; int model; };
+static std::list<WorldChange> worldChanges;
+void RestoreWorld()
+{
+	for(auto &change:worldChanges) if(CEntity *entity=change.entity){
+		if(entity->IsBuilding() && entity->GetModelIndex()!=change.model)
+			((CBuilding*)entity)->ReplaceWithNewModel(change.model);
+		entity->bIsVisible=change.visible;entity->bUsesCollision=change.collision;
+		change.entity=nil;entity->PruneReferences();
+	}
+	worldChanges.clear();
+}
+template<class Pool> static void UnlockPool(Pool *pool)
+{
+	if(!pool)return;
+	for(int i=0;i<pool->GetSize();i++){
+		CEntity *entity=pool->GetSlot(i);if(!entity)continue;
+		auto *model=CModelInfo::GetModelInfo(entity->GetModelIndex());if(!model)continue;
+		const char *name=model->GetModelName();
+		bool hide=freeroamworld::blocksIsland(name);
+		const char *replacement=entity->IsBuilding()?freeroamworld::repairedModel(name):nil;
+		int replacementId=-1;
+		if(replacement && !CModelInfo::GetModelInfo(replacement,&replacementId)) replacement=nil;
+		if(!hide && !replacement)continue;
+		worldChanges.push_back({entity,(bool)entity->bIsVisible,(bool)entity->bUsesCollision,entity->GetModelIndex()});
+		entity->RegisterReference(&worldChanges.back().entity);
+		if(hide){entity->bIsVisible=false;entity->bUsesCollision=false;}
+		if(replacement)((CBuilding*)entity)->ReplaceWithNewModel(replacementId);
+	}
+}
+static void UnlockIslands()
+{
+	RestoreWorld();
+	UnlockPool(CPools::GetBuildingPool());UnlockPool(CPools::GetTreadablePool());
+	UnlockPool(CPools::GetDummyPool());UnlockPool(CPools::GetObjectPool());
+	printf("[FreeRoam] Open island access: %zu closure/bridge entities changed\n",worldChanges.size());
+}
+void Start()
+{
+	UnlockIslands();
+	CTheZones::InitFreeRoamTraffic();
+	// The engine only preloads taxi and police. Warm the civilian pool before its
+	// initial traffic burst, instead of waiting for one model every 500 frames.
+	std::vector<int> civilianModels;
+	for (int rating=0; rating<CCarCtrl::NUM_CAR_CLASSES; ++rating) {
+		for (int i=0; i<Min(2, CCarCtrl::TotalNumOfCarsOfRating[rating]); ++i) {
+			int model=CCarCtrl::CarArrays[rating][i];
+			civilianModels.push_back(model);
+			CStreaming::RequestModel(model,STREAMFLAGS_DEPENDENCY);
+		}
+	}
+	// Warm a bounded number of civilian add-ons too; do not preload every mod.
+	int addedWarm = 0;
+	for(int id=MI_LAST_VEHICLE+1; id<MODELINFOSIZE && addedWarm<4; id++){
+		auto *base=CModelInfo::GetModelInfo(id);
+		if(!base || base->GetModelType()!=MITYPE_VEHICLE) continue;
+		auto *mi=(CVehicleModelInfo*)base;
+		if(mi->m_vehicleType!=VEHICLE_TYPE_CAR || mi->m_vehicleClass<0 || mi->m_vehicleClass>=CCarCtrl::NUM_CAR_CLASSES || mi->m_frequency<=0) continue;
+		civilianModels.push_back(id);CStreaming::RequestModel(id,STREAMFLAGS_DEPENDENCY);addedWarm++;
+	}
+	CStreaming::RequestSpecialModel(MI_PLAYER,"player",STREAMFLAGS_DONT_REMOVE|STREAMFLAGS_DEPENDENCY);
+	for (eWeaponType i : kNativeLoadout) {
+		int model=CWeaponInfo::GetWeaponInfo((eWeaponType)i)->m_nModelId;
+		if (model>=0) CStreaming::RequestModel(model,STREAMFLAGS_DONT_REMOVE);
+	}
+	CStreaming::LoadAllRequestedModels(false);
+	printf("[FreeRoam] Civilian traffic pool warmed: %zu models; 3%% police / 7%% taxis\n", civilianModels.size());
+	CPlayerPed::SetupPlayerPed(0);
+	CPlayerPed::DeactivatePlayerPed(0);
+	CPlayerPed *ped=FindPlayerPed();
+	ped->SetPosition(spawn+CVector(0,0,1.0f));
+	CGame::currLevel=CTheZones::GetLevelFromPosition(&spawn);
+	CCollision::LoadCollisionWhenINeedIt(true);
+	CStreaming::LoadScene(spawn);
+	bool found=false;
+	float ground=CWorld::FindGroundZFor3DCoord(spawn.x,spawn.y,spawn.z+3.0f,&found);
+	if (found) spawn.z=ground;
+	ped->SetPosition(spawn+CVector(0,0,ped->GetDistanceFromCentreOfMassToBaseOfModel()+0.1f));
+	ped->CharCreatedBy=MISSION_CHAR;
+	CPlayerPed::ReactivatePlayerPed(0);
+	ped->m_fHealth=100.0f; ped->m_fArmour=100.0f;
+	for (eWeaponType i : kNativeLoadout) ped->GiveWeapon((eWeaponType)i,999);
+	ped->SetCurrentWeapon(WEAPONTYPE_UNARMED);
+	CWorld::Players[0].m_nMoney=CWorld::Players[0].m_nVisibleMoney=999999;
+	CWorld::Players[0].m_bInfiniteSprint=true;
+	CStats::IndustrialPassed=CStats::CommercialPassed=CStats::SuburbanPassed=1;
+	for (int i=0;i<ThePaths.m_numPathNodes;i++) ThePaths.m_pathNodes[i].bDisabled=false;
+	CWanted::SetMaximumWantedLevel(6);
+	CRestart::AddHospitalRestartPoint(spawn,0);
+	CRestart::AddPoliceRestartPoint(spawn,0);
+	for (int model : civilianModels) CStreaming::SetModelIsDeletable(model);
+	CClock::SetGameClock(12,0);
+	TheCamera.RestoreWithJumpCut();
+	TheCamera.SetFadeColour(0,0,0);
+	TheCamera.Fade(0.0f,FADE_IN);
+	printf("[FreeRoam] Started at %.2f %.2f %.2f; story scripts disabled\n",spawn.x,spawn.y,spawn.z);
+}
+}
