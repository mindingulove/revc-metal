+// A car in the pool may have no RenderWare object (not streamed in yet, or being removed); GetClump() asserts and
+// crashes on those, so everything here goes through clumpOf().
+inline RpClump *
+clumpOf(CEntity *e)
+{
+	return (e && e->m_rwObject && RwObjectGetType(e->m_rwObject) == rpCLUMP) ? (RpClump*)e->m_rwObject : nullptr;
+}
+
+bool
+alive(const Car &c)
+{
+	return CPools::GetVehicle(c.handle) == c.vehicle && clumpOf(c.vehicle) == c.clump;
+}
+
+bool
+isDentableCar(CVehicle *v)
+{
+	if(v == nil || !v->IsCar() || clumpOf(v) == nil) return false;
+	// Model slots differ between III, VC and replacement packs.
+	CBaseModelInfo *model = CModelInfo::GetModelInfo(v->GetModelIndex());
+	return model && model->GetModelType() == MITYPE_VEHICLE &&
+		((CVehicleModelInfo*)model)->m_vehicleType == VEHICLE_TYPE_CAR;
+}
+
+// ---- contact capture ----
+
+// Horizontal size of what the car hit. A tree trunk or a lamp post is narrow and concentrates the crash into a
+// narrow, deeper dent; a wall or another car spreads it wide.
+float
+entityWidth(CEntity *e)
+{
+	if(!e || e->IsVehicle() || e->IsPed()) return 99.f;
+	CColModel *cm = e->GetColModel();
+	if(!cm) return 99.f;
+	float w = std::max(cm->boundingBox.max.x - cm->boundingBox.min.x, cm->boundingBox.max.y - cm->boundingBox.min.y);
+	return std::isfinite(w) && w > 0.05f ? std::min(w, 99.f) : 99.f;
+}
+
+void
+capture(CVehicle *vehicle, const CColPoint &point, float impulse, bool second,
+        float rawImpulse, float otherMass, float closingSpeed, float dissipatedJ, float absorbedJ, float otherWidth = 99.f)
+{
+	if(gameStopping || !context || !isDentableCar(vehicle) || !std::isfinite(impulse) || impulse <= 0) return;
+	RpClump *clump = clumpOf(vehicle);
+	// more mass means more energy to dissipate at the same speed
+	{
+		float m = std::min(std::max(vehicle->m_fMass, 500.0f), 20000.0f);
+		float f = std::pow(m / 1500.0f, cfg.massCrush);
+		impulse *= f; rawImpulse *= f;
+		// a much heavier body (truck, bus) pushes its stiff frame into the lighter car: more of the crash energy goes
+		// into that car than its own speed change suggests
+		if(cfg.heavyAttacker > 0.f && otherMass > vehicle->m_fMass && otherMass < 100000.f){
+			float boost = std::min(std::pow(otherMass / std::max(vehicle->m_fMass, 500.0f), cfg.heavyAttacker), cfg.heavyAttackerMax);
+			impulse *= boost; rawImpulse *= boost;
+		}
+	}
+	dent::Pose pose = poseOf(vehicle->GetMatrix());
+	if(!rigid(pose) || !dent::finite(vec(point.point)) || !dent::finite(vec(point.normal))) return;
+	Vec p = localPoint(vec(point.point), pose);
+	Vec n = localVector(second ? vec(point.normal) * (-1.f) : vec(point.normal), pose);
+	if(dent::length(p) > 12.f || dent::length(n) < .01f) return;
+	n = dent::unit(n);
+	if(dent::dot(n, p) > 0) n = n * (-1.f);
+	// Reject road support; wheel atomics are independently excluded by ancestry.
+	if(p.z < -.15f && std::fabs(n.z) > .75f) return;
+	// Rollover: the roof meets the ground at the car's travelling speed, but the contact solver only reports the
+	// small part of it along the surface normal. Count a share of the car's speed for roof strikes on the world.
+	if(cfg.rollCrush > 0.f && (otherMass <= 0.f || otherWidth < 30.f) && n.z < -.65f){
+		CColModel *cm = vehicle->GetColModel();
+		float top = cm ? cm->boundingBox.max.z : 1.5f, bottom = cm ? cm->boundingBox.min.z : 0.f;
+		if(p.z > top - .3f * (top - bottom)){
+			float speed = std::sqrt(vehicle->m_vecMoveSpeed.MagnitudeSqr());	// 1.0 = 50 m/s
+			// something heavy coming down on the roof (a bending pole, a fallen trunk): count its closing speed too
+			if(otherMass > 0.f) speed = std::max(speed, closingSpeed / 50.0f);
+			float rollImpulse = speed * cfg.rollCrush * vehicle->m_fMass;
+			if(rollImpulse > impulse){ impulse = rollImpulse; rawImpulse = std::max(rawImpulse, rollImpulse); }
+		}
+	}
+	if(dent::response(impulse, vehicle->m_fMass, cfg.curve).depth <= 0) return;
+	int handle = CPools::GetVehicleRef(vehicle);
+	if(CPools::GetVehicle(handle) != vehicle) return;
+	contacts.add({ vehicle, handle, clump, p, n, impulse, second ? point.pieceB : point.pieceA,
+	               rawImpulse, otherMass, closingSpeed, dissipatedJ, absorbedJ, otherWidth });
+}
+
+dent::CollisionBody collisionBody(CPhysical *body, const CColPoint &point)
+{
+	if(!body) return { 1.0f, 0.0f, 0.0f }; // immovable world
+	float mass = body->m_fMass;
+	if(!std::isfinite(mass) || mass <= 0) return {};
+	bool fixed = body->GetIsStatic() || body->bInfiniteMass;
+	float effective = fixed ? 0.0f : body->GetMass(point.point - body->GetPosition(), point.normal);
+	float inverse = !fixed && std::isfinite(effective) && effective > 0 ? 1.0f / effective : 0.0f;
+	// Equal crush compliance for two dentable cars: no per-model stiffness data
+	// exists here. Buildings/rigid props take no modeled crush work themselves.
+	// A heavier car has a stronger structure (stiffness grows with mass), so in a car-on-car crash the
+	// lighter one takes the larger share of the crushing.
+	float compliance = !fixed && body->IsVehicle() && isDentableCar((CVehicle*)body) ?
+		std::pow(1500.0f / std::min(std::max(mass, 500.0f), 20000.0f), cfg.massStiffness) : 0.0f;
+	return { mass, inverse, compliance };
+}
+
+// ---- geometry ----
+
+bool
+validCpuGeometry(rw::Geometry *g)
+{
+	if(g == nil) return false;
+	if(g->numVertices <= 0 || g->numVertices > 65535 || g->numTriangles <= 0 || g->numTriangles > 60000 ||
+	   g->numMorphTargets != 1 || g->numTexCoordSets < 0 || g->numTexCoordSets > 8 ||
+	   (g->flags & rw::Geometry::NATIVE)) return false;
+	if(g->morphTargets == nil || g->morphTargets[0].vertices == nil || g->triangles == nil) return false;
+	if((g->flags & rw::Geometry::NORMALS) && g->morphTargets[0].normals == nil) return false;
+	if((g->flags & rw::Geometry::PRELIT) && g->colors == nil) return false;
+	for(int i = 0; i < g->numTexCoordSets; i++)
+		if(g->texCoords[i] == nil) return false;
+	if(g->matList.numMaterials <= 0 || g->matList.materials == nil) return false;
+	return true;
+}
+
+// Copies the materials by reference; triangle material indices stay valid.
+bool
+copyMaterials(rw::Geometry *dst, rw::Geometry *src)
+{
+	for(int i = 0; i < src->matList.numMaterials; i++){
+		if(src->matList.materials[i] == nil) return false;
+		if(dst->matList.appendMaterial(src->matList.materials[i]) < 0) return false;
+	}
+	return true;
+}
+
+uint32
+cloneFlags(rw::Geometry *src)
+{
+	uint32 format = src->flags & 0xFFu;
+	format &= ~(uint32)rw::Geometry::TRISTRIP;
+	if(!src->morphTargets[0].normals) format &= ~(uint32)rw::Geometry::NORMALS;
+	if(!src->colors) format &= ~(uint32)rw::Geometry::PRELIT;
+	return format | ((uint32)src->numTexCoordSets << 16);
+}
+
+rw::Geometry *
+cloneGeometry(rw::Geometry *src)
+{
+	if(!validCpuGeometry(src)) return nullptr;
+	// The BinMesh is what the renderer actually draws. Some replacement DFFs (including
+	// the HD taxi) retain an older triangle array whose material IDs no longer agree
+	// with that mesh. Rebuilding from it makes the first dent replace paint/lights
+	// with unrelated parts of the texture atlas. Preserve the rendered topology and
+	// material assignment, also for the CPU triangles used by deformation/normals.
+	std::vector<rw::Triangle> triangles;
+	if(src->meshHeader){
+		auto *header = src->meshHeader;
+		if(header->flags != 0 && header->flags != rw::MeshHeader::TRISTRIP) return nullptr;
+		auto *meshes = header->getMeshes();
+		for(unsigned m = 0; m < header->numMeshes; ++m){
+			auto &mesh = meshes[m];
+			if(mesh.numIndices == 0) continue;
+			int material = src->matList.findIndex(mesh.material);
+			if(material < 0 || !mesh.indices || mesh.numIndices > 180000) return nullptr;
+			bool strip = header->flags == rw::MeshHeader::TRISTRIP;
+			if(!strip && mesh.numIndices % 3 != 0) return nullptr;
+			for(unsigned i = 0; i < mesh.numIndices; ++i)
+				if(mesh.indices[i] >= src->numVertices) return nullptr;
+			for(unsigned i = 0; i + 2 < mesh.numIndices; i += strip ? 1 : 3){
+				rw::Triangle t;
+				t.v[0] = mesh.indices[i];
+				t.v[1] = mesh.indices[i + 1 + (strip ? i % 2 : 0)];
+				t.v[2] = mesh.indices[i + 2 - (strip ? i % 2 : 0)];
+				t.matId = (uint16)material;
+				if(t.v[0] == t.v[1] || t.v[0] == t.v[2] || t.v[1] == t.v[2]) continue;
+				triangles.push_back(t);
+				if(triangles.size() > 60000) return nullptr;
+			}
+		}
+	}else{
+		for(int i = 0; i < src->numTriangles; i++){
+			const auto &t = src->triangles[i];
+			if(t.matId >= src->matList.numMaterials || t.v[0] >= src->numVertices || t.v[1] >= src->numVertices || t.v[2] >= src->numVertices)
+				return nullptr;
+			triangles.push_back(t);
+		}
+	}
+	if(triangles.empty()) return nullptr;
+	uint32 format = cloneFlags(src);
+	rw::Geometry *copy = rw::Geometry::create(src->numVertices, (int)triangles.size(), format);
+	if(!copy) return nullptr;
+	auto fail = [&](){ copy->destroy(); return (rw::Geometry*)nullptr; };
+	const size_t count = (size_t)src->numVertices;
+	auto &dst = copy->morphTargets[0];
+	const auto &origin = src->morphTargets[0];
+	memcpy(dst.vertices, origin.vertices, count*sizeof(rw::V3d));
+	dst.boundingSphere = origin.boundingSphere;
+	if(format & rw::Geometry::NORMALS){
+		if(!dst.normals) return fail();
+		memcpy(dst.normals, origin.normals, count*sizeof(rw::V3d));
+	}
+	if(format & rw::Geometry::PRELIT){
+		if(!copy->colors) return fail();
+		memcpy(copy->colors, src->colors, count*sizeof(rw::RGBA));
+	}
+	for(int t = 0; t < src->numTexCoordSets; t++){
+		if(!copy->texCoords[t]) return fail();
+		memcpy(copy->texCoords[t], src->texCoords[t], count*sizeof(rw::TexCoords));
+	}
+	if(!copyMaterials(copy, src)) return fail();
+	std::copy(triangles.begin(), triangles.end(), copy->triangles);
+	copy->buildMeshes();
+	return copy;
+}
+
+// Standard, unskinned car panels: recreate vertex channels with extra vertices along the crease.
+rw::Geometry *
+addPanelCrease(rw::Geometry *src, PanelData &panel)
+{
+	float lo = 1.e20f, hi = -1.e20f, zlo = 1.e20f, zhi = -1.e20f, xlo = 1.e20f, xhi = -1.e20f;
+	const auto &morph = src->morphTargets[0];
+	for(int i = 0; i < src->numVertices; ++i){
+		float x = morph.vertices[i].x, y = panel.shape.sign * morph.vertices[i].y, z = morph.vertices[i].z;
+		if(!std::isfinite(x) || !std::isfinite(y) || !std::isfinite(z)) return nullptr;
+		xlo = std::min(xlo, x); xhi = std::max(xhi, x);
+		lo = std::min(lo, y); hi = std::max(hi, y);
+		zlo = std::min(zlo, z); zhi = std::max(zhi, z);
+	}
+	float length = hi - lo;
+	// This version folds horizontal lids, not tall hatchback/van tailgates.
+	if(!dent::supportedPanelBounds(length, zhi - zlo, panel.damaged) || src->numTriangles <= 0 || src->numTriangles > 10000){
+		if(cfg.logHits){
+			char b[180];
+			snprintf(b, sizeof(b), "PanelBounds: kind=%s damaged=%d length=%.4f height=%.4f rejected",
+				panel.kind == PanelKind::Bonnet ? "bonnet" : "boot", (int)panel.damaged, length, zhi - zlo);
+			logLine(b);
+		}
+		return nullptr;
+	}
+	if(xhi - xlo < .02f) return nullptr;
+	panel.shape.hinge = lo;
+	panel.shape.length = length;
+	panel.span.init(xlo, xhi, (zlo + zhi)*.5f, 6, panel.shape);
+	panel.lattice.init(panel.span, panel.shape);
+
+	std::vector<dent::PanelTriangle> triangles;
+	for(int t = 0; t < src->numTriangles; ++t){
+		const auto &from = src->triangles[t];
+		dent::PanelTriangle tri;
+		tri.material = from.matId;
+		for(int k = 0; k < 3; ++k){
+			auto index = from.v[k];
+			if(index >= src->numVertices) return nullptr;
+			auto &v = tri.v[k];
+			v.position = vec(morph.vertices[index]);
+			if(morph.normals) v.normal = vec(morph.normals[index]);
+			if(src->colors){
+				auto c = src->colors[index];
+				v.color = { float(c.red), float(c.green), float(c.blue), float(c.alpha) };
+			}
+			for(int uv = 0; uv < src->numTexCoordSets; ++uv){
+				auto c = src->texCoords[uv][index];
+				v.uv[uv] = { c.u, c.v };
+			}
+		}
+		auto parts = dent::splitPanelLattice(tri, panel.shape, panel.span, panel.lattice);
+		triangles.insert(triangles.end(), parts.begin(), parts.end());
+		if(triangles.size() > 10000) return nullptr;
+	}
+	if(triangles.empty()) return nullptr;
+
+	uint32 flags = cloneFlags(src);
+	rw::Geometry *copy = rw::Geometry::create((int)triangles.size()*3, (int)triangles.size()*2, flags);
+	if(!copy) return nullptr;
+	auto fail = [&](){ copy->destroy(); return (rw::Geometry*)nullptr; };
+	auto &dst = copy->morphTargets[0];
+	dst.boundingSphere = morph.boundingSphere;
+	if((flags & rw::Geometry::NORMALS) && !dst.normals) return fail();
+	if((flags & rw::Geometry::PRELIT) && !copy->colors) return fail();
+	if(!copyMaterials(copy, src)) return fail();
+	panel.sides.clear();
+	panel.sides.reserve(copy->numVertices);
+	for(size_t t = 0; t < triangles.size(); ++t){
+		auto &tri = triangles[t];
+		if(tri.material >= (unsigned)src->matList.numMaterials) return fail();
+		for(int k = 0; k < 3; ++k){
+			auto &v = tri.v[k];
+			size_t i = t*3 + k;
+			dst.vertices[i] = rwv(v.position);
+			if(dst.normals) dst.normals[i] = rwv(dent::unit(v.normal));
+			if(copy->colors){
+				auto cl = [](float f){ return (uint8)std::min(std::max(std::round(f), 0.f), 255.f); };
+				rw::RGBA c;
+				c.red = cl(v.color[0]); c.green = cl(v.color[1]); c.blue = cl(v.color[2]); c.alpha = cl(v.color[3]);
+				copy->colors[i] = c;
+			}
+			for(int uv = 0; uv < src->numTexCoordSets; ++uv){
+				rw::TexCoords tc; tc.u = v.uv[uv][0]; tc.v = v.uv[uv][1];
+				copy->texCoords[uv][i] = tc;
+			}
+			panel.sides.push_back(v.side);
+		}
+		for(int back = 0; back < 2; ++back){
+			auto ids = dent::panelFaceIndices(t, back != 0);
+			auto &face = copy->triangles[t*2 + back];
+			face.v[0] = ids[0]; face.v[1] = ids[1]; face.v[2] = ids[2];
+			face.matId = (uint16)tri.material;
+		}
+	}
+	copy->buildMeshes();
+	return copy;
+}
+
+// ---- wheels ----
+
+float
+wheelRadius(CAutomobile *car, int node)
+{
+	CVehicleModelInfo *mi = (CVehicleModelInfo*)CModelInfo::GetModelInfo(car->GetModelIndex());
+	RwObject *obj = car->m_aCarNodes[node] ? GetFirstObject(car->m_aCarNodes[node]) : nullptr;
+	float scale = mi ? mi->m_wheelScale : 1.0f;
+	float r = obj ? ((RpAtomic*)obj)->boundingSphere.radius * scale : 0.35f;
+	if(!std::isfinite(r) || r < 0.15f || r > 1.2f) r = 0.35f;
+	return r;
+}
+
+WheelRecord &
+wheelRecordFor(CVehicle *v)
+{
+	for(auto &r : wheelRecords) if(r.vehicle == v) return r;
+	WheelRecord r;
+	r.vehicle = v;
+	r.handle = CPools::GetVehicleRef(v);
+	r.clump = clumpOf(v);
+	wheelRecords.push_back(r);
+	return wheelRecords.back();
+}
+
+bool knockOffWheel(CVehicle *vehicle, int i, const char *why, float distance);
+
+// Knock off the wheel nearest to the hit (car-local point), if it is within reach.
+bool
+detachWheel(CVehicle *vehicle, const dent::Episode &ep)
+{
+	CAutomobile *car = (CAutomobile*)vehicle;
+	if(car->GetModelIndex() == MI_RHINO) return false;
+	int best = -1;
+	float bestDist = cfg.wheelReach;
+	for(int i = 0; i < 4; i++){
+		RwFrame *frame = car->m_aCarNodes[kWheels[i].node];
+		if(!frame || !GetFirstObject(frame)) continue;
+		if(car->Damage.GetWheelStatus(kWheels[i].wheel) == WHEEL_STATUS_MISSING) continue;
+		float d = dent::length(vec(RwFrameGetMatrix(frame)->pos) - ep.point);
+		if(d < bestDist){ bestDist = d; best = i; }
+	}
+	if(best < 0) return false;
+	return knockOffWheel(vehicle, best, "impact", bestDist);
+}
+// Knock off wheel kWheels[i]: flying wheel clear of the bodywork, original hidden, damage state "missing".
+bool
+knockOffWheel(CVehicle *vehicle, int i, const char *why, float distance)
+{
+	CAutomobile *car = (CAutomobile*)vehicle;
+	if(car->Damage.GetWheelStatus(kWheels[i].wheel) == WHEEL_STATUS_MISSING) return false;
+	RwFrame *frame = car->m_aCarNodes[kWheels[i].node];
+	if(!frame || !GetFirstObject(frame)) return false;
+	const int node = kWheels[i].node, wheel = kWheels[i].wheel;
+	RpAtomic *atomic = (RpAtomic*)GetFirstObject(car->m_aCarNodes[node]);
+
+	CObject *flying = car->SpawnFlyingComponent(node, COMPGROUP_WHEEL);
+	if(flying){
+		// Start the wheel clear of the bodywork so it does not clip through the car it came from.
+		CVector away = flying->GetPosition() - car->GetPosition();
+		away.z = 0.0f;
+		if(away.Magnitude() > 0.001f) away.Normalise();
+		float push = wheelRadius(car, node) + 0.25f;
+		flying->GetMatrix().Translate(away * push + car->GetUp() * 0.15f);
+	}
+	WheelRecord &rec = wheelRecordFor(vehicle);
+	rec.atomicFlags[wheel] = RpAtomicGetFlags(atomic);
+	rec.gone |= (uint8_t)(1 << wheel);
+	RpAtomicSetFlags(atomic, 0);	// hide the wheel that is still on the car
+	car->Damage.SetWheelStatus(wheel, WHEEL_STATUS_MISSING);
+	if(cfg.logHits){
+		char b[160];
+		snprintf(b, sizeof(b), "WheelOff: cause=%s model=%d wheel=%d distance=%.2f flying=%d", why, car->GetModelIndex(), wheel, distance, flying ? 1 : 0);
+		logLine(b);
+	}
+	return true;
+}
+
+// Show wheels again once their damage state was repaired (respray, fix cheat, new car in the slot).
+void
+updateWheelRecords()
+{
+	for(size_t i = 0; i < wheelRecords.size();){
+		WheelRecord &r = wheelRecords[i];
+		bool valid = CPools::GetVehicle(r.handle) == r.vehicle && clumpOf(r.vehicle) == r.clump;
+		if(!valid){ wheelRecords.erase(wheelRecords.begin() + i); continue; }
+		CAutomobile *car = (CAutomobile*)r.vehicle;
+		for(int k = 0; k < 4; k++){
+			if(!(r.gone & (1 << kWheels[k].wheel))) continue;
+			if(car->Damage.GetWheelStatus(kWheels[k].wheel) != WHEEL_STATUS_MISSING){
+				RwFrame *frame = car->m_aCarNodes[kWheels[k].node];
+				if(frame && GetFirstObject(frame)) RpAtomicSetFlags((RpAtomic*)GetFirstObject(frame), r.atomicFlags[kWheels[k].wheel]);
+				r.gone &= ~(1 << kWheels[k].wheel);
+			}
+		}
+		if(!r.gone) wheelRecords.erase(wheelRecords.begin() + i); else ++i;
+	}
+}
+
+// Keep dented bodywork from swallowing a wheel: vertices that start outside a wheel's volume
+// are not allowed to end up inside it.
+struct WheelSphere { Vec centre; float radius; int index; };
+
+void
+collectWheelSpheres(CVehicle *vehicle, const dent::Pose &framePose, std::vector<WheelSphere> &out)
+{
+	out.clear();
+	if((!cfg.wheelClearance && !cfg.wheelByBody) || !vehicle->IsCar()) return;
+	CAutomobile *car = (CAutomobile*)vehicle;
+	for(int i = 0; i < 4; i++){
+		RwFrame *frame = car->m_aCarNodes[kWheels[i].node];
+		if(!frame || !GetFirstObject(frame)) continue;
+		if(car->Damage.GetWheelStatus(kWheels[i].wheel) == WHEEL_STATUS_MISSING) continue;
+		RwMatrix *m = RwFrameGetLTM(frame);
+		if(!m) continue;
+		out.push_back({ localPoint(vec(m->pos), framePose), wheelRadius(car, kWheels[i].node) + 0.04f, i });
+	}
+}
+
+inline void
+keepOutOfWheels(Vec &v, Vec rest, const std::vector<WheelSphere> &wheels, float *intrusion)
+{
+	for(const auto &w : wheels){
+		Vec d = v - w.centre;
+		float dist = dent::length(d);
+		if(dist >= w.radius || dist < 1e-4f) continue;
+		if(dent::length(rest - w.centre) < w.radius * 0.97f) continue;	// the stock mesh already overlaps the wheel here
+		// remember how deep the body wanted to go: a deep intrusion knocks the wheel off
+		float depth = (w.radius - dist) / w.radius;
+		if(intrusion && depth > intrusion[w.index]) intrusion[w.index] = depth;
+		v = w.centre + d * (w.radius / dist);
+	}
+}
+
+// ---- panels / frames ----
+
+std::string
+lowerName(RwFrame *f)
+{
+	const char *name = GetFrameNodeName(f);
+	std::string n = name ? name : "";
+	for(char &ch : n) ch = (char)tolower((unsigned char)ch);
+	return n;
+}
+
+bool
+bodyFrame(RwFrame *f)
+{
+	// Glass and windscreens share the body dent field. Check ancestry too: wheel child atomics
+	// need not be named wheel_*.
+	for(int depth = 0; f && depth < 24; ++depth){
+		std::string n = lowerName(f);
+		for(auto skip : { "wheel", "exhaust", "misc", "ug_", "chassis_vlo" })
+			if(n.find(skip) != std::string::npos) return false;
+		f = RwFrameGetParent(f);
+	}
+	return true;
+}
+
+PanelKind
+identifyPanel(RwFrame *f)
+{
+	for(int depth = 0; f && depth < 24; ++depth){
+		std::string n = lowerName(f);
+		if(n.rfind("bonnet", 0) == 0 || n.rfind("hood", 0) == 0) return PanelKind::Bonnet;
+		if(n.rfind("boot", 0) == 0 || n.rfind("trunk", 0) == 0) return PanelKind::Boot;
+		f = RwFrameGetParent(f);
+	}
+	return PanelKind::None;
+}
+
+struct Hit {
+	Car *car;
+	Vec point, direction;
+	float depth, radius;
+	unsigned episodeId, touched{}, folded{}, visited{};
+};
+
+RpAtomic *
+deformAtomic(RpAtomic *a, void *data)
+{
+	auto &hit = *static_cast<Hit*>(data);
+	++hit.visited;
+	auto &c = *hit.car;
+	RwFrame *f = RpAtomicGetFrame(a);
+	rw::Geometry *g = a->geometry;
+	if(!f || !g || !bodyFrame(f)) return a;
+	if(!validCpuGeometry(g)){
+		static unsigned warnings = 0;
+		if(warnings++ < 12) logLine("GeometryGuard: unsupported or invalid CPU buffers; atomic skipped.");
+		return a;
+	}
+	RwMatrix *ltm = RwFrameGetLTM(f);
+	if(!ltm) return a;
+	dent::Pose fpose = poseOf(*ltm);
+	if(!rigid(fpose)) return a;
+	Vec point = localPoint(hit.point, fpose), direction = localVector(hit.direction, fpose);
+	rw::V3d *verts = g->morphTargets[0].vertices;
+	Mesh *mesh = nullptr;
+	for(auto &m : c.meshes) if(m->copy == g){ mesh = m.get(); break; }
+	bool affected = false;
+	for(int i = 0; i < g->numVertices; ++i){
+		Vec rest = mesh ? mesh->rest[i] : vec(verts[i]);
+		if(dent::length(rest - point) < hit.radius){ affected = true; break; }
+	}
+	if(!affected) return a;
+
+	if(!mesh){
+		if(c.meshes.size() >= 64 || c.vertices + g->numVertices > 200000) return a;
+		auto fresh = std::make_unique<Mesh>();
+		fresh->copy = cloneGeometry(g);
+		if(!fresh->copy){ logLine("Geometry clone failed; mesh skipped."); return a; }
+		auto kind = cfg.panels ? identifyPanel(f) : PanelKind::None;
+		if(kind != PanelKind::None){
+			fresh->panel.kind = kind;
+			fresh->panel.damaged = (CVisibilityPlugins::GetAtomicId(a) & ATOMIC_FLAG_DAM) != 0;
+			fresh->panel.shape.crease = dent::variedCrease(c.panelSeed, (uint32_t)kind, cfg.panelCrease, cfg.panelCreaseRandomness);
+			fresh->panel.shape.sign = kind == PanelKind::Bonnet ? 1.f : -1.f;
+			if(rw::Geometry *refined = addPanelCrease(fresh->copy, fresh->panel)){
+				fresh->copy->destroy();
+				fresh->copy = refined;
+				if(cfg.logHits){
+					char b[170];
+					snprintf(b, sizeof(b), "PanelMesh: kind=%s variant=%s sharedLattice=1 sharedVertexBackfaces=1 length=%.4f triangles=%d",
+						kind == PanelKind::Bonnet ? "bonnet" : "boot", fresh->panel.damaged ? "damaged" : "original",
+						fresh->panel.shape.length, refined->numTriangles);
+					logLine(b);
+				}
+			}else{
+				fresh->panel = PanelData{};
+				logLine("Panel crease unsupported; using ordinary dent for this mesh.");
+			}
+		}
+		rw::Geometry &cloned = *fresh->copy;
+		if(cloned.numMorphTargets != 1 || !cloned.morphTargets[0].vertices || cloned.numVertices <= 0 || cloned.numVertices > 65535 ||
+		   c.vertices + cloned.numVertices > 200000 || totalVertices() + cloned.numVertices > cfg.maxTotalVertices) return a;
+		fresh->rest.reserve(cloned.numVertices);
+		for(int i = 0; i < cloned.numVertices; ++i) fresh->rest.push_back(vec(cloned.morphTargets[0].vertices[i]));
+		if(fresh->panel.kind != PanelKind::None){
+			fresh->panel.base = fresh->rest;
+			if(cloned.morphTargets[0].normals){
+				fresh->panel.normals.reserve(cloned.numVertices);
+				for(int i = 0; i < cloned.numVertices; ++i) fresh->panel.normals.push_back(vec(cloned.morphTargets[0].normals[i]));
+			}
+		}
+		// Hold one reference to the original; the atomic drops its own when the copy is attached.
+		fresh->original = g;
+		g->addRef();
+		mesh = fresh.get();
+		c.meshes.push_back(std::move(fresh));
+		a->setGeometry(mesh->copy, 0);
+		c.vertices += mesh->copy->numVertices;
+		g = mesh->copy;
+	}
+
+	std::vector<WheelSphere> wheelSpheres;
+	collectWheelSpheres(c.vehicle, fpose, wheelSpheres);
+	bool panel = mesh->panel.kind != PanelKind::None;
+	int lockFlags = rw::Geometry::LOCKVERTICES;
+	if(panel && !mesh->panel.normals.empty()) lockFlags |= rw::Geometry::LOCKNORMALS;
+	g->lock(lockFlags);
+	verts = g->morphTargets[0].vertices;
+	float oldDepth = mesh->episodeId == hit.episodeId ? mesh->episodeDepth : 0.f;
+	float oldRadius = mesh->episodeId == hit.episodeId ? mesh->episodeRadius : 0.f;
+	if(panel){
+		auto &p = mesh->panel;
+		if(mesh->episodeId != hit.episodeId) p.episodeDemand = 0;
+		float axial = std::max(0.f, -direction.y * p.shape.sign);
+		bool buckle = axial > .4f && hit.depth > cfg.panelMinDepth;
+		if(buckle){
+			float influence = 0;
+			for(auto rest : mesh->rest)
+				influence = std::max(influence, dent::weight(dent::length(rest - point), hit.radius, cfg.falloffPower));
+			float demand = (hit.depth - cfg.panelMinDepth) * cfg.panelStrength * axial * influence;
+			float extra = std::max(0.f, demand - p.episodeDemand);
+			p.episodeDemand = std::max(p.episodeDemand, demand);
+			auto folded = dent::limitedFold(p.shape.length, p.shape.crease,
+				std::min(p.compression + extra, p.shape.length * cfg.panelMaxFraction), cfg.panelMaxLift);
+			p.compression = folded.compression;
+			++hit.folded;
+			if(cfg.logHits){
+				char b[180];
+				snprintf(b, sizeof(b), "PanelFold: kind=%s variant=%s compression=%.3f lift=%.3f crease=%.3f vertices=%d",
+					p.kind == PanelKind::Bonnet ? "bonnet" : "boot", p.damaged ? "damaged" : "original", p.compression, folded.height, p.shape.crease, g->numVertices);
+				logLine(b);
+			}
+		}
+		auto folded = dent::foldFor(p.shape.length, p.shape.crease, p.compression);
+		std::vector<Vec> moved;
+		moved.reserve(p.lattice.points.size());
+		for(auto &sample : p.lattice.points){
+			Vec rest = sample.rest[0];
+			if(buckle && cfg.panelFollowBody)
+				sample.base[0] = sample.base[0] + dent::panelBodyStep(rest, p.shape, point, direction,
+					hit.depth, hit.radius, oldDepth, oldRadius, cfg.maxTotal, cfg.falloffPower);
+			else if(!buckle)
+				sample.base[0] = dent::displaceImpact(rest, sample.base[0], point, direction,
+					hit.depth, hit.radius, oldDepth, oldRadius, cfg.maxTotal, cfg.falloffPower);
+			Vec result = sample.base[0] + dent::foldOffset(rest, p.shape, folded);
+			Vec delta = result - rest;
+			float size = dent::length(delta);
+			if(size > cfg.maxTotal) result = rest + delta * (cfg.maxTotal / size);
+			moved.push_back(result);
+		}
+		p.lattice.keepOrdered(moved);
+		dent::PanelLighting lighting(p.lattice, moved, p.shape);
+		for(int i = 0; i < g->numVertices; ++i){
+			Vec result = mesh->rest[i] + p.lattice.displacement(mesh->rest[i], moved);
+			keepOutOfWheels(result, mesh->rest[i], wheelSpheres, c.wheelIntrusion);
+			verts[i] = rwv(result);
+			if(!p.normals.empty()) g->morphTargets[0].normals[i] = rwv(lighting.normal(p.lattice, mesh->rest[i], p.normals[i], p.sides[i]));
+		}
+	}else{
+		for(int i = 0; i < g->numVertices; ++i){
+			Vec result = dent::displaceImpact(mesh->rest[i], vec(verts[i]), point, direction,
+				hit.depth, hit.radius, oldDepth, oldRadius, cfg.maxTotal, cfg.falloffPower);
+			keepOutOfWheels(result, mesh->rest[i], wheelSpheres, c.wheelIntrusion);
+			verts[i] = rwv(result);
+		}
+	}
+	mesh->episodeId = hit.episodeId;
+	mesh->episodeDepth = hit.depth;
+	mesh->episodeRadius = hit.radius;
+	// Conservative sphere around the original centre.
+	auto &sphere = g->morphTargets[0].boundingSphere;
+	float radius = sphere.radius;
+	for(int i = 0; i < g->numVertices; ++i)
+		radius = std::max(radius, dent::length(vec(verts[i]) - vec(sphere.center)));
+	sphere.radius = radius;
+	g->unlock();
+	a->boundingSphere = sphere;
+	a->object.object.privateFlags |= rw::Atomic::WORLDBOUNDDIRTY;
+	++hit.touched;
+	return a;
+}
+
+// ---- structural mode ----
+
+// Clone a body atomic's geometry so it can be edited per car (no panel logic).
+Mesh *
+attachPlainMesh(Car &c, RpAtomic *a, RwFrame *f, rw::Geometry *g)
+{
+	for(auto &m : c.meshes) if(m->copy == g) return m.get();
+	if(c.meshes.size() >= 64 || c.vertices + g->numVertices > 200000 || totalVertices() + g->numVertices > cfg.maxTotalVertices) return nullptr;
+	auto fresh = std::make_unique<Mesh>();
+	fresh->copy = cloneGeometry(g);
+	if(!fresh->copy) return nullptr;
+	rw::Geometry &cl = *fresh->copy;
+	fresh->rest.reserve(cl.numVertices);
+	for(int i = 0; i < cl.numVertices; ++i) fresh->rest.push_back(vec(cl.morphTargets[0].vertices[i]));
+	if(cl.morphTargets[0].normals){
+		// smoothing groups: vertices at the same spot with a similar facing share one normal, so seams
+		// between split vertices do not show once the body is bent
+		for(int i = 0; i < cl.numVertices; ++i) fresh->restNormals.push_back(dent::unit(vec(cl.morphTargets[0].normals[i])));
+		std::map<std::array<long, 3>, std::vector<int>> spots;
+		fresh->weld.assign(cl.numVertices, -1);
+		std::vector<int> groupRep;
+		for(int i = 0; i < cl.numVertices; ++i){
+			const Vec &p = fresh->rest[i];
+			std::array<long, 3> key = { std::lround(p.x*500.f), std::lround(p.y*500.f), std::lround(p.z*500.f) };
+			auto &list = spots[key];
+			int found = -1;
+			for(int j : list)
+				if(dent::dot(fresh->restNormals[j], fresh->restNormals[i]) > .8f){ found = fresh->weld[j]; break; }
+			if(found < 0){ found = (int)groupRep.size(); groupRep.push_back(i); }
+			fresh->weld[i] = found;
+			list.push_back(i);
+		}
+		fresh->weldCount = (int)groupRep.size();
+		// which way do this mesh's triangles wind relative to its normals?
+		float agree = 0;
+		for(int t = 0; t < cl.numTriangles; ++t){
+			const auto &tr = cl.triangles[t];
+			Vec p0 = fresh->rest[tr.v[0]], p1 = fresh->rest[tr.v[1]], p2 = fresh->rest[tr.v[2]];
+			Vec fn = dent::cross(p1 - p0, p2 - p0);
+			Vec vn = fresh->restNormals[tr.v[0]] + fresh->restNormals[tr.v[1]] + fresh->restNormals[tr.v[2]];
+			agree += dent::dot(fn, vn);
+		}
+		fresh->windingSign = agree < 0 ? -1.f : 1.f;
+	}
+	{
+		// vertex adjacency (including vertices at the same spot), used to smooth the displacement field
+		std::vector<std::vector<int>> nb(cl.numVertices);
+		for(int t = 0; t < cl.numTriangles; ++t){
+			const auto &tr = cl.triangles[t];
+			for(int k = 0; k < 3; k++){
+				int u = tr.v[k], v = tr.v[(k+1)%3];
+				nb[u].push_back(v); nb[v].push_back(u);
+			}
+		}
+		std::map<std::array<long, 3>, std::vector<int>> spots;
+		for(int i = 0; i < cl.numVertices; ++i){
+			const Vec &p = fresh->rest[i];
+			spots[{ std::lround(p.x*500.f), std::lround(p.y*500.f), std::lround(p.z*500.f) }].push_back(i);
+		}
+		for(auto &kv : spots) for(int u : kv.second) for(int v : kv.second) if(u != v) nb[u].push_back(v);
+		fresh->adjStart.assign(cl.numVertices + 1, 0);
+		for(int i = 0; i < cl.numVertices; ++i){
+			std::sort(nb[i].begin(), nb[i].end());
+			nb[i].erase(std::unique(nb[i].begin(), nb[i].end()), nb[i].end());
+			fresh->adjStart[i+1] = fresh->adjStart[i] + (int)nb[i].size();
+		}
+		fresh->adjList.reserve(fresh->adjStart.back());
+		for(int i = 0; i < cl.numVertices; ++i) fresh->adjList.insert(fresh->adjList.end(), nb[i].begin(), nb[i].end());
+	}
+	fresh->original = g;
+	g->addRef();
+	Mesh *mesh = fresh.get();
+	c.meshes.push_back(std::move(fresh));
+	a->setGeometry(mesh->copy, 0);
+	c.vertices += mesh->copy->numVertices;
+	mesh->atomic = a;
+	mesh->frame = f;
+	return mesh;
+}
+
+struct PrepCtx { Car *car; dent::Pose rpose; std::vector<Mesh*> meshes; };
+
+RpAtomic *
+prepAtomic(RpAtomic *a, void *data)
+{
+	auto &ctx = *static_cast<PrepCtx*>(data);
+	RwFrame *f = RpAtomicGetFrame(a);
+	rw::Geometry *g = a->geometry;
+	if(!f || !g || !bodyFrame(f) || !validCpuGeometry(g)) return a;
+	RwMatrix *ltm = RwFrameGetLTM(f);
+	if(!ltm) return a;
+	dent::Pose fpose = poseOf(*ltm);
+	if(!rigid(fpose)) return a;
+	Mesh *m = attachPlainMesh(*ctx.car, a, f, g);
+	if(!m) return a;
+	if(m->carRest.empty()){
+		m->carRest.reserve(m->rest.size());
+		for(Vec v : m->rest) m->carRest.push_back(localPoint(dent::toWorldPoint(v, fpose), ctx.rpose));
+	}
+	ctx.meshes.push_back(m);
+	return a;
+}
+
+// How different body styles fail. Multipliers on the structure defaults and on the depth of each hit.
+struct BodyClass {
+	const char *label;
+	float stiff, front, rear, roof, yield;	// frame stiffness, crumple-zone, roof and yield-strain multipliers
+	float crush, skin;			// multiplier on crush depth pushed into the frame / on paint dents
+	bool rigidFront, rigidRear;		// engine block (no crumple zone) at that end
+};
+std::string
+modelNameLower(CVehicle *v)
+{
+	CBaseModelInfo *bmi = CModelInfo::GetModelInfo(v->GetModelIndex());
+	std::string name = bmi ? bmi->GetModelName() : "";
+	for(char &ch : name) ch = (char)tolower((unsigned char)ch);
+	return name;
+}
+
+// Body style from the vehicle's own handling line (the same data that tells the game what kind of vehicle
+// it is): collision-damage multiplier (how tough the body is), IS_VAN/IS_BUS/IS_BIG/IS_LOW/no-roof/
+// double-exhaust flags, reverse bonnet, drive and engine type, height. Works for modded vehicles too.
+bool
+bodyClassOf(CVehicle *v, BodyClass &out)
+{
+	const tHandlingData *h = v->pHandling;
+	if(!h) return false;
+	const float coll = std::min(std::max(h->fCollisionDamageMultiplier, 0.01f), 2.0f);
+	const float t = coll / 0.8f;			// 0.8 = an ordinary saloon
+	const uint32_t fl = h->Flags;
+	out = { "car", 1, 1, 1, 1, 1, 1, 1, false, false };
+	out.crush = std::min(std::max(std::pow(t, .45f), .04f), 1.3f);
+	out.skin = std::min(std::max(std::pow(t, .30f), .0f), 1.2f);
+	out.stiff = std::min(std::max(std::pow(1.f / t, .35f), 1.f), 3.5f);
+	out.roof = std::min(std::max(std::pow(1.f / t, .30f), 1.f), 3.0f);
+	out.yield = std::min(std::max(std::pow(1.f / t, .20f), 1.f), 2.0f);
+	const bool diesel = h->Transmission.nEngineType == 'D';
+	const bool rearDrive = h->Transmission.nDriveType == 'R';
+	const bool low = (fl & HANDLING_IS_LOW) != 0, noRoof = (fl & HANDLING_HAS_NO_ROOF) != 0;
+	const bool performance = (fl & HANDLING_DBL_EXHAUST) && (low || noRoof || (fl & HANDLING_NEUTRALHANDLING)) && !diesel;
+	if(performance && low && !noRoof && rearDrive){
+		out.label = "mid-engine sports"; out.front = .8f; out.rear = 1.3f; out.rigidRear = true; out.roof *= 1.1f;
+	}else if(performance){
+		out.label = "front-engine sports/muscle"; out.front = 1.3f; out.rigidFront = true;
+	}else if((fl & HANDLING_IS_BUS) || (h->Dimension.z > 3.4f && diesel)){
+		out.label = "bus/heavy truck"; out.front = .8f; out.rear = 1.4f;
+	}else if((fl & HANDLING_REV_BONNET) || ((fl & HANDLING_IS_BIG) && diesel && h->Dimension.z > 2.4f)){
+		out.label = "cab-over truck"; out.front = .85f; out.rear = 1.3f;
+	}else if(fl & HANDLING_IS_VAN){
+		out.label = "van"; out.front = .9f; out.rear = 1.1f;
+	}else if((fl & HANDLING_IS_BIG) || coll < .45f){
+		out.label = "SUV/heavy-duty"; out.front = 1.2f; out.rear = 1.2f;
+	}else if(h->fMass < 1300.f){
+		out.label = "compact";
+	}
+	return true;
+}
+
+// Build the car's node-and-beam structure from its body mesh (once per car, on its first real hit).
+bool
+ensureStructure(Car &c)
+{
+	if(c.st) return true;
+	if(c.structTried) return false;
+	c.structTried = true;
+	RwFrame *root = RpClumpGetFrame(c.clump);
+	RwMatrix *rm = root ? RwFrameGetLTM(root) : nullptr;
+	if(!rm) return false;
+	dent::Pose rpose = poseOf(*rm);
+	if(!rigid(rpose)) return false;
+	PrepCtx ctx{ &c, rpose, {} };
+	RpClumpForAllAtomics(c.clump, prepAtomic, &ctx);
+	if(ctx.meshes.empty()) return false;
+	size_t total = 0;
+	for(Mesh *m : ctx.meshes) total += m->carRest.size();
+	size_t stride = std::max<size_t>(1, total / 30000), k = 0;
+	std::vector<Vec> pts;
+	for(Mesh *m : ctx.meshes)
+		for(const Vec &p : m->carRest)
+			if((k++ % stride) == 0) pts.push_back(p);
+	Vec hubs[4];
+	bool haveHubs = true;
+	CAutomobile *car = (CAutomobile*)c.vehicle;
+	for(int i = 0; i < 4 && haveHubs; i++){
+		RwFrame *frame = car->m_aCarNodes[kWheels[i].node];
+		RwMatrix *wm = frame ? RwFrameGetLTM(frame) : nullptr;
+		if(!wm){ haveHubs = false; break; }
+		hubs[i] = localPoint(vec(wm->pos), rpose);
+	}
+	if(haveHubs){
+		for(int i = 0; i < 4; i++){
+			RwFrame *frame = car->m_aCarNodes[kWheels[i].node];
+			c.wheelBase[i][0] = RwFrameGetMatrix(frame)->pos.x;
+			c.wheelBase[i][1] = RwFrameGetMatrix(frame)->pos.y;
+		}
+		c.wheelBaseSet = true;
+	}
+	structural::Params prm = structParams;
+	{
+		// no crumple zone at the front of a muscle car: the engine block is solid, only the skin dents
+		CBaseModelInfo *bmi = CModelInfo::GetModelInfo(c.vehicle->GetModelIndex());
+		std::string name = bmi ? bmi->GetModelName() : "";
+		for(char &ch : name) ch = (char)tolower((unsigned char)ch);
+		size_t at = 0;
+		while(at <= cfg.rigidFront.size()){
+			size_t comma = cfg.rigidFront.find(',', at);
+			std::string item = cfg.rigidFront.substr(at, comma == std::string::npos ? std::string::npos : comma - at);
+			while(!item.empty() && isspace((unsigned char)item[0])) item.erase(0, 1);
+			while(!item.empty() && isspace((unsigned char)item[item.size()-1])) item.erase(item.size()-1);
+			for(char &ch : item) ch = (char)tolower((unsigned char)ch);
+			if(!item.empty() && item == name){
+				prm.frontSoft = 0.9f;				// stiffer than the ordinary crumple zone, but it still gives
+				prm.yieldFront = prm.yieldCabin * 1.2f;
+				prm.crushFront = 0.20f;
+				if(cfg.logHits) logLine("Structure: rigid front (no crumple zone) for this model.");
+				break;
+			}
+			if(comma == std::string::npos) break;
+			at = comma + 1;
+		}
+	}
+	if(cfg.classProfiles){
+		BodyClass body, *bc = &body;
+		if(bodyClassOf(c.vehicle, body)){
+			prm.baseStiffness *= bc->stiff;
+			prm.frontSoft *= bc->front; prm.rearSoft *= bc->rear;
+			prm.roofSoft *= bc->roof;
+			prm.yieldFront *= bc->yield; prm.yieldRear *= bc->yield; prm.yieldCabin *= bc->yield; prm.yieldRoof *= bc->yield;
+			// engine block at that end: stiffer than a crumple zone, but it still crushes about 20 cm before it is solid
+			if(bc->rigidFront){ prm.frontSoft = 0.9f; prm.yieldFront = prm.yieldCabin * 1.2f; prm.crushFront = 0.20f; }
+			if(bc->rigidRear){ prm.rearSoft = 0.9f; prm.yieldRear = prm.yieldCabin * 1.2f; prm.crushRear = 0.20f; }
+			c.crushMul = bc->crush; c.skinMul = bc->skin;
+			if(cfg.logHits){
+				char b[200];
+				snprintf(b, sizeof(b), "Structure: body style '%s' for model %s (collisionDamage=%.2f crush=%.2f stiff=%.2f)", bc->label,
+					modelNameLower(c.vehicle).c_str(), c.vehicle->pHandling->fCollisionDamageMultiplier, bc->crush, bc->stiff);
+				logLine(b);
+			}
+		}
+	}
+	auto st = std::make_unique<structural::Structure>();
+	if(!structural::build(*st, pts, c.vehicle->m_fMass, haveHubs ? hubs : nullptr, prm)){
+		logLine("Structure: could not build a node-and-beam structure for this car; using the plain dent field.");
+		return false;
+	}
+	for(Mesh *m : ctx.meshes){
+		m->skin.resize(m->carRest.size());
+		for(size_t i = 0; i < m->carRest.size(); i++) m->skin[i] = structural::skinFor(*st, m->carRest[i]);
+	}
+	if(cfg.logHits){
+		char b[160];
+		unsigned withNormals = 0;
+		for(Mesh *m : ctx.meshes) if(!m->restNormals.empty()) withNormals++;
+		snprintf(b, sizeof(b), "Structure: model=%d nodes=%u beams=%u meshes=%u meshesWithNormals=%u", c.vehicle->GetModelIndex(),
+			(unsigned)st->nodes.size(), (unsigned)st->beams.size(), (unsigned)ctx.meshes.size(), withNormals);
+		logLine(b);
+	}
+	c.st = std::move(st);
+	return true;
+}
+
+struct TearPart { int node; bool bumper; int id; float *threshold; };
+TearPart kParts[8] = {
+	{ CAR_DOOR_LF, false, DOOR_FRONT_LEFT, &cfg.tearDoor }, { CAR_DOOR_RF, false, DOOR_FRONT_RIGHT, &cfg.tearDoor },
+	{ CAR_DOOR_LR, false, DOOR_REAR_LEFT, &cfg.tearDoor },  { CAR_DOOR_RR, false, DOOR_REAR_RIGHT, &cfg.tearDoor },
+	{ CAR_BONNET,  false, DOOR_BONNET, &cfg.tearLid },      { CAR_BOOT,    false, DOOR_BOOT, &cfg.tearLid },
+	{ CAR_BUMP_FRONT, true, VEHBUMPER_FRONT, &cfg.tearBumper }, { CAR_BUMP_REAR, true, VEHBUMPER_REAR, &cfg.tearBumper },
+};
+
+int
+partOfFrame(CAutomobile *car, RwFrame *f)
+{
+	for(int depth = 0; f && depth < 4; ++depth){
+		for(int i = 0; i < 8; i++)
+			if(car->m_aCarNodes[kParts[i].node] == f) return i;
+		f = RwFrameGetParent(f);
+	}
+	return -1;
+}
+
+void
+tearOffPart(CAutomobile *car, int i)
+{
+	const TearPart &p = kParts[i];
+	if(p.bumper){
+		if(car->Damage.GetPanelStatus(p.id) == PANEL_STATUS_MISSING) return;
+		car->Damage.SetPanelStatus(p.id, PANEL_STATUS_MISSING);
+		car->SetBumperDamage(p.node, (ePanels)p.id);
+	}else{
+		if(car->Damage.GetDoorStatus(p.id) == DOOR_STATUS_MISSING) return;
+		car->Damage.SetDoorStatus(p.id, DOOR_STATUS_MISSING);
+		car->SetDoorDamage(p.node, (eDoors)p.id);
+	}
+	if(cfg.logHits){
+		char b[120];
+		snprintf(b, sizeof(b), "TornOff: model=%d part=%s id=%d", car->GetModelIndex(), p.bumper ? "bumper" : (p.id == DOOR_BONNET ? "bonnet" : p.id == DOOR_BOOT ? "boot" : "door"), p.id);
+		logLine(b);
+	}
+}
+
+// A door/lid whose hinge the frame bent: it comes loose and dangles instead of closing.
+void
+hangPart(CAutomobile *car, int i)
+{
+	const TearPart &p = kParts[i];
+	if(p.bumper || car->Damage.GetDoorStatus(p.id) != DOOR_STATUS_OK) return;
+	car->Damage.SetDoorStatus(p.id, DOOR_STATUS_SWINGING);
+	car->Doors[p.id].m_fAngle = car->Doors[p.id].m_fPrevAngle = car->Doors[p.id].RetAngleWhenOpen() * .3f;
+	car->SetDoorDamage(p.node, (eDoors)p.id);
+	if(cfg.logHits) logLine("HangPart: door/lid bent off its hinge");
+}
+
+// A crushed engine bay costs health, which brings smoke and eventually fire through the game's own rules.
+void
+applyEngineDamage(Car &c)
+{
+	if(!c.st || c.st->engineNode < 0) return;
+	const auto &st = *c.st;
+	float crush = dent::length(st.pos[st.engineNode] - st.nodes[st.engineNode].rest);
+	float frac = std::min(1.f, std::max(0.f, (crush - .12f) / .7f));
+	c.engineFrac = frac;
+	float target = 1000.f - frac * cfg.engineMaxLoss;
+	if(cfg.engineDamage && c.vehicle->m_fHealth > target){ c.vehicle->m_fHealth = target; c.lastHealth = target; }
+}
+
+// Drag the visible wheels with their (possibly bent) hubs.
+void
+updateBodyBend(Car &c)
+{
+	if(!c.st) return;
+	float sum = 0.f;
+	for(size_t i = 0; i < c.st->nodes.size(); i++) sum += dent::length(c.st->pos[i] - c.st->nodes[i].rest);
+	c.bodyBend = c.st->nodes.empty() ? 0.f : sum / (float)c.st->nodes.size();
+	{
+		float fs = 0.f, rs2 = 0.f;
+		int fn = 0, rn2 = 0;
+		for(size_t i = 0; i < c.st->nodes.size(); i++){
+			float d = dent::length(c.st->pos[i] - c.st->nodes[i].rest);
+			if(c.st->nodes[i].region == structural::FRONT){ fs += d; fn++; }
+			else if(c.st->nodes[i].region == structural::REAR){ rs2 += d; rn2++; }
+		}
+		c.frontCrush = fn ? fs / fn : 0.f;
+		c.rearCrush = rn2 ? rs2 / rn2 : 0.f;
+	}
+	float rs = 0.f;
+	int rn = 0;
+	for(size_t i = 0; i < c.st->nodes.size(); i++)
+		if(c.st->nodes[i].region == structural::ROOF){
+			Vec d = c.st->pos[i] - c.st->nodes[i].rest;
+			d.z += i < c.st->lift.size() ? c.st->lift[i] : 0.f;
+			rs += dent::length(d);
+			rn++;
+		}
+	c.roofBend = rn ? rs / (float)rn : 0.f;
+	// a crushed roof breaks the glass: the windscreen cracks as the pillars and roof give way
+	if(cfg.glassCrack && !c.glassCracked && c.roofBend > cfg.glassThreshold * .4f){
+		CAutomobile *car = (CAutomobile*)c.vehicle;
+		c.glassCracked = true;
+		if(car->Damage.GetPanelStatus(VEHPANEL_WINDSCREEN) == PANEL_STATUS_OK){
+			car->Damage.SetPanelStatus(VEHPANEL_WINDSCREEN, PANEL_STATUS_SMASHED1);
+			car->SetPanelDamage(CAR_WINDSCREEN, VEHPANEL_WINDSCREEN);
+			if(cfg.logHits) logLine("GlassCracked: roof crushed");
+		}
+	}
+}
+
+void
+applyWheelOffsets(Car &c)
+{
+	updateBodyBend(c);
+	if(!c.wheelBaseSet || !c.st) return;
+	CAutomobile *car = (CAutomobile*)c.vehicle;
+	for(int i = 0; i < 4; i++){
+		int hub = c.st->hubNode[i];
+		RwFrame *frame = car->m_aCarNodes[kWheels[i].node];
+		if(hub < 0 || !frame) continue;
+		Vec d = c.st->pos[hub] - c.st->nodes[hub].rest;
+		// the hub sits in the wheel arch: it is carried back with the crushed bodywork around it, not only by its own
+		// (floor-pinned) node, so a hard frontal hit pushes the front wheels back
+		Vec around = structural::displacement(*c.st, structural::skinFor(*c.st, c.st->nodes[hub].rest));
+		if(dent::length(around) > dent::length(d)) d = around;
+		c.hubD[i][0] = d.x; c.hubD[i][1] = d.y; c.hubD[i][2] = d.z;
+		if(cfg.hubKnock > 0.f && dent::length(d) > cfg.hubKnock)	// the frame tore the hub out of line
+			knockOffWheel(c.vehicle, i, "hub", dent::length(d));
+		RwMatrix *fm = RwFrameGetMatrix(frame);
+		if(cfg.tyreBurst && !(c.burst & (1 << i)) && dent::length(d) > cfg.tyreThreshold &&
+		   car->Damage.GetWheelStatus(kWheels[i].wheel) == WHEEL_STATUS_OK){
+			c.burst |= 1 << i;
+			car->BurstTyre(kWheels[i].wheel, true);
+			if(cfg.logHits) logLine("TyreBurst: bent hub");
+		}
+		fm->pos.x = c.wheelBase[i][0] + d.x * cfg.wheelOffsetScale;
+		fm->pos.y = c.wheelBase[i][1] + d.y * cfg.wheelOffsetScale;
+	}
+}
+
+// Deform the model's existing body and cabin parts with the crash structure.
+// Keep their geometry and materials; do not attach a generated cage or replacement frame.
+void
+applyStructure(Car &c)
+{
+	if(!c.st || !alive(c)) return;
+	RwFrame *root = RpClumpGetFrame(c.clump);
+	RwMatrix *rm = root ? RwFrameGetLTM(root) : nullptr;
+	if(!rm) return;
+	dent::Pose rpose = poseOf(*rm);
+	if(!rigid(rpose)) return;
+	std::vector<WheelSphere> wheels;
+	collectWheelSpheres(c.vehicle, rpose, wheels);
+	if(c.jamArmed)
+		for(int w = 0; w < 4; w++) c.wheelJam[w] = std::max(c.wheelJam[w], c.wheelIntrusion[w]);
+	for(float &x : c.wheelIntrusion) x = 0.0f;
+	for(auto &mp : c.meshes){
+		Mesh &m = *mp;
+		if(m.skin.empty() || !m.atomic || m.atomic->geometry != m.copy) continue;
+		RwMatrix *ltm = RwFrameGetLTM(m.frame);
+		if(!ltm) continue;
+		dent::Pose fpose = poseOf(*ltm);
+		if(!rigid(fpose)) continue;
+		rw::Geometry *g = m.copy;
+		const bool haveNormals = g->morphTargets[0].normals && !m.weld.empty();
+		g->lock(rw::Geometry::LOCKVERTICES | (haveNormals ? rw::Geometry::LOCKNORMALS : 0));
+		rw::V3d *verts = g->morphTargets[0].vertices;
+		const int count = std::min<int>(g->numVertices, (int)m.skin.size());
+		float sumDisp = 0;
+		// displacement of every vertex, then a few passes of smoothing along the mesh so neighbouring
+		// vertices cannot move very differently (that is what folds triangles and flips the texture)
+		std::vector<Vec> disp(count), tmp;
+		for(int i = 0; i < count; ++i) disp[i] = structural::displacement(*c.st, m.skin[i]);
+		if(cfg.smoothPasses > 0 && (int)m.adjStart.size() == g->numVertices + 1){
+			tmp.resize(count);
+			for(int pass = 0; pass < cfg.smoothPasses; ++pass){
+				for(int i = 0; i < count; ++i){
+					int b = m.adjStart[i], e = m.adjStart[i+1];
+					if(e <= b){ tmp[i] = disp[i]; continue; }
+					Vec avg{};
+					for(int k = b; k < e; ++k) avg = avg + disp[m.adjList[k] < count ? m.adjList[k] : i];
+					avg = avg * (1.f / (e - b));
+					tmp[i] = disp[i] * (1.f - cfg.smoothAmount) + avg * cfg.smoothAmount;
+				}
+				disp.swap(tmp);
+			}
+		}
+		for(int i = 0; i < count; ++i){
+			Vec rawDisp = disp[i];
+			sumDisp += dent::length(rawDisp);
+			Vec carPos = m.carRest[i] + rawDisp;
+			if(!wheels.empty()) keepOutOfWheels(carPos, m.carRest[i], wheels, c.wheelIntrusion);
+			Vec d = localVector(dent::toWorldVector(carPos - m.carRest[i], rpose), fpose);
+			Vec total = m.rest[i] + d;
+			if(i < (int)m.dentDisp.size()) total = total + m.dentDisp[i];
+			verts[i] = rwv(total);
+		}
+		if(haveNormals && count == g->numVertices){
+			// recompute the vertex normals from the bent faces (area weighted, smoothed within each group)
+			std::vector<Vec> acc(m.weldCount, Vec{});
+			for(int t = 0; t < g->numTriangles; ++t){
+				const auto &tr = g->triangles[t];
+				Vec p0 = vec(verts[tr.v[0]]), p1 = vec(verts[tr.v[1]]), p2 = vec(verts[tr.v[2]]);
+				Vec fn = dent::cross(p1 - p0, p2 - p0) * m.windingSign;
+				for(int k = 0; k < 3; k++) acc[m.weld[tr.v[k]]] = acc[m.weld[tr.v[k]]] + fn;
+			}
+			for(int i = 0; i < count; ++i){
+				Vec n = dent::unit(acc[m.weld[i]]);
+				if(dent::length(n) < .5f) n = m.restNormals[i];
+				g->morphTargets[0].normals[i] = rwv(n);
+			}
+		}
+		auto &sphere = g->morphTargets[0].boundingSphere;
+		float radius = sphere.radius;
+		for(int i = 0; i < count; ++i)
+			radius = std::max(radius, dent::length(vec(verts[i]) - vec(sphere.center)));
+		sphere.radius = radius;
+		g->unlock();
+		m.atomic->boundingSphere = sphere;
+		m.atomic->object.object.privateFlags |= rw::Atomic::WORLDBOUNDDIRTY;
+		if(cfg.glassCrack && count > 0 && !c.glassCracked && m.frame == ((CAutomobile*)c.vehicle)->m_aCarNodes[CAR_WINDSCREEN] &&
+		   sumDisp / count > cfg.glassThreshold){
+			c.glassCracked = true;
+			CAutomobile *car = (CAutomobile*)c.vehicle;
+			if(car->Damage.GetPanelStatus(VEHPANEL_WINDSCREEN) == PANEL_STATUS_OK){
+				car->Damage.SetPanelStatus(VEHPANEL_WINDSCREEN, PANEL_STATUS_SMASHED1);
+				car->SetPanelDamage(CAR_WINDSCREEN, VEHPANEL_WINDSCREEN);
+				if(cfg.logHits) logLine("GlassCracked: windscreen bent by frame");
+			}
+		}
+		if(cfg.tearOff && count > 0){
+			int part = partOfFrame((CAutomobile*)c.vehicle, m.frame);
+			if(part >= 0 && count > 0) c.partDisp[part] = std::max(c.partDisp[part] * .98f, sumDisp / count);
+			if(cfg.hangParts && part >= 0 && !kParts[part].bumper && !(c.torn & (1u << part)) && !(c.hung & (1u << part)) &&
+			   sumDisp / count > *kParts[part].threshold * cfg.hangFraction){
+				c.hung |= 1u << part;
+				hangPart((CAutomobile*)c.vehicle, part);
+			}
+			if(part >= 0 && !(c.torn & (1u << part)) && sumDisp / count > *kParts[part].threshold){
+				c.torn |= 1u << part;
+				tearOffPart((CAutomobile*)c.vehicle, part);
+			}
+		}
+	}
+	applyWheelOffsets(c);
+	applyEngineDamage(c);
+	if(cfg.wheelByBody)
+		for(int w = 0; w < 4; w++)
+			if(c.wheelIntrusion[w] >= cfg.wheelBodyIntrusion)
+				knockOffWheel(c.vehicle, w, "body", c.wheelIntrusion[w]);
+	c.st->dirty = false;
+}
+
+// ---- restore ----
+
+RpAtomic *
+restoreAtomic(RpAtomic *a, void *data)
+{
+	auto &c = *static_cast<Car*>(data);
+	for(auto &m : c.meshes)
+		if(a->geometry == m->copy){
+			a->setGeometry(m->original, 0);
+			break;
+		}
+	return a;
+}
+
+void
+restore(Car &c)
+{
+	if(alive(c)) RpClumpForAllAtomics(c.clump, restoreAtomic, &c);
+	if(c.wheelBaseSet && alive(c)){
+		CAutomobile *car = (CAutomobile*)c.vehicle;
+		for(int i = 0; i < 4; i++)
+			if(RwFrame *frame = car->m_aCarNodes[kWheels[i].node]){
+				RwFrameGetMatrix(frame)->pos.x = c.wheelBase[i][0];
+				RwFrameGetMatrix(frame)->pos.y = c.wheelBase[i][1];
+			}
+	}
+	c.wheelBaseSet = false;
+	c.torn = 0;
+	c.burst = 0;
+	c.hung = 0;
+	memset(c.hubD, 0, sizeof(c.hubD));
+	memset(c.wheelJam, 0, sizeof(c.wheelJam));
+	c.jamArmed = false;
+	c.bodyBend = 0.f;
+	c.roofBend = 0.f;
+	c.engineFrac = 0.f;
+	c.frontCrush = c.rearCrush = 0.f;
+	memset(c.partDisp, 0, sizeof(c.partDisp));
+	c.coolant = 1.f; c.coolantLeak = 0.f; c.overheat = 0.f; c.fuelLeak = 0.f; c.gearbox = 1.f;
+	for(float &p : c.tyrePressure) p = 1.f;
+	c.comX = c.comY = 0.f;
+	c.slipUntil = 0;
+	c.occPending = false;
+	engines.erase(c.vehicle);
+	if(alive(c) && c.vehicle->m_pDamagedColModel){ CCollision::ReleaseTrianglePlanes(c.vehicle->m_pDamagedColModel); delete c.vehicle->m_pDamagedColModel; c.vehicle->m_pDamagedColModel = nullptr; }
+	c.glassCracked = false;
+	c.meshes.clear();
+	c.st.reset();
+	c.structTried = false;
+	c.vertices = 0;
+	c.episode = {};
+	for(int k = 0; k < 5; k++) c.dCur[k] = c.dRest[k];
+	c.dEpisode = 0;
+}
+
+void
+cleanup()
+{
+	if(!context) return;
+	for(auto &c : context->cars) restore(*c);
+	context->cars.clear();
+}
+
+bool
+reserveCarSlot(CVehicle *protectedPlayer, unsigned now)
+{
+	if(context->cars.size() < cfg.maxTracked) return true;
+	auto victim = context->cars.end();
+	unsigned oldest = 0;
+	for(auto it = context->cars.begin(); it != context->cars.end(); ++it){
+		if((*it)->vehicle == protectedPlayer) continue;
+		unsigned age = now - (*it)->lastTouched;
+		if(age >= 1000 && (victim == context->cars.end() || age > oldest)){ victim = it; oldest = age; }
+	}
+	if(victim == context->cars.end()) return false;
+	restore(**victim);
+	context->cars.erase(victim);
+	return true;
+}
+
+// Carry the effect anchors through the same dent field as the body mesh.
+void
+applyDummies(Car &car, const dent::Episode &episode)
+{
+	CVehicleModelInfo *mi = (CVehicleModelInfo*)CModelInfo::GetModelInfo(car.vehicle->GetModelIndex());
+	if(!mi) return;
+	if(!car.dInit){
+		Vec head = vec(mi->m_positions[CAR_POS_HEADLIGHTS]), tail = vec(mi->m_positions[CAR_POS_TAILLIGHTS]);
+		car.dRest[0] = head; car.dRest[1] = { -head.x, head.y, head.z };
+		car.dRest[2] = tail; car.dRest[3] = { -tail.x, tail.y, tail.z };
+		car.dRest[4] = vec(mi->m_positions[CAR_POS_EXHAUST]);
+		for(int k = 0; k < 5; k++) car.dCur[k] = car.dRest[k];
+		car.dInit = true;
+	}
+	float oldDepth = car.dEpisode == episode.id ? car.dDepth : 0.f;
+	float oldRadius = car.dEpisode == episode.id ? car.dRadius : 0.f;
+	for(int k = 0; k < 5; k++){
+		if(!dent::finite(car.dRest[k]) || dent::length(car.dRest[k]) < 1e-4f) continue;	// model has no such dummy
+		car.dCur[k] = dent::displaceImpact(car.dRest[k], car.dCur[k], episode.point, episode.direction,
+			episode.depth, episode.radius, oldDepth, oldRadius, cfg.maxTotal, cfg.falloffPower);
+	}
+	car.dEpisode = episode.id;
+	car.dDepth = episode.depth;
+	car.dRadius = episode.radius;
+}
+
+// Smash the lamp(s) the dent reached. front=true mirrors the rear logic (the mod's lamp test is
+// written for the tail of the car, so the y axis is flipped for the front).
+void
+damageLamps(CVehicle *vehicle, const dent::Episode &hit, bool player, bool front)
+{
+	if(front ? !cfg.frontLightDamage : !cfg.rearLightDamage) return;
+	if(front ? hit.point.y <= 0 : hit.point.y >= 0) return;
+	int model = vehicle->GetModelIndex();
+	CVehicleModelInfo *mi = (CVehicleModelInfo*)CModelInfo::GetModelInfo(model);
+	if(!mi || !isDentableCar(vehicle)) return;
+	Vec lamp = vec(mi->m_positions[front ? CAR_POS_HEADLIGHTS : CAR_POS_TAILLIGHTS]);
+	if(!dent::finite(lamp) || (front ? lamp.y <= .1f : lamp.y >= -.1f) || dent::length(lamp) > 12.f) return;
+	auto mirrored = [&](Vec v){ return front ? Vec{ v.x, -v.y, v.z } : v; };
+	CAutomobile *car = (CAutomobile*)vehicle;
+	const int left = front ? VEHLIGHT_FRONT_LEFT : VEHLIGHT_REAR_LEFT, right = front ? VEHLIGHT_FRONT_RIGHT : VEHLIGHT_REAR_RIGHT;
+	for(int light : { left, right }){
+		Vec position = lamp;
+		position.x = light == right ? std::fabs(lamp.x) : -std::fabs(lamp.x);
+		if(car->Damage.GetLightStatus((eLights)light) != 0) continue;
+		if(!dent::rearLampHit(mirrored(hit.point), mirrored(position), hit.depth, hit.radius, cfg.rearLightMinDepth, cfg.falloffPower)) continue;
+		car->Damage.SetLightStatus((eLights)light, 1);	// smashed; other lamps untouched
+		if(cfg.logHits){
+			char b[130];
+			snprintf(b, sizeof(b), "%sLight: actor=%s side=%s model=%d smashed", front ? "Front" : "Rear", player ? "player" : "npc", light == right ? "right" : "left", model);
+			logLine(b);
+		}
+	}
+}
+
+// A thin object (tree, pole) hits a narrow strip: the dent gets as wide as the object plus the spread of the
+// crush it causes, and deeper where it is narrowest. `spread` = how far (per metre of depth) the damage reaches.
+void
+narrowDent(dent::Response &r, float width, float spread)
+{
+	if(!cfg.narrowDents || width >= 6.0f || r.depth <= 0.f) return;
+	float narrow = std::min(std::max(1.0f - width / 1.5f, 0.0f), 1.0f);	// 1 for a pole, 0 for anything wider than 1.5 m
+	float radius = .30f * spread + .55f * width + 1.4f * spread * r.depth;
+	r.radius = std::min(r.radius, std::max(radius, .35f));
+	r.depth *= 1.0f + cfg.narrowDepthBoost * narrow;
+	r.wrap = cfg.wrapAround * narrow;
+}
+
+// People inside get hurt by the crash itself, like in GTA IV: nothing under ~22 km/h of speed change, bad around
+// 45, fatal around 60. Applied once per crash as the crash deepens; armour absorbs first (InflictDamage).
+struct OccApplied { CPed *ped; unsigned episode; float applied; int vehicle = 0, pedHandle = 0; };
+std::vector<OccApplied> occApplied;
+
+void
+hurtOccupants(Car &c, float impact, bool isPlayerCar, float crushDepth, const Vec &contact, float radius)
+{
+	if(!cfg.occupantDamage) return;
+	CVehicle *v = c.vehicle;
+	float massFactor = std::pow(std::min(std::max(v->m_fMass, 500.0f), 20000.0f) / 1500.0f, cfg.massCrush);
+	float dv = impact * 50.0f / std::max(massFactor, .1f);	// speed change in m/s
+	// not capped: a crash far beyond the fatal speed is far beyond survivable, so the damage keeps growing with the speed change
+	float t = std::max((dv - cfg.occupantMinSpeed) / (cfg.occupantFatalSpeed - cfg.occupantMinSpeed), 0.f);
+	float speedPart = std::min(400.0f, 100.0f * std::pow(t, cfg.occupantExponent));
+	RwFrame *root = RpClumpGetFrame(clumpOf(v));
+	RwMatrix *rm = root ? RwFrameGetLTM(root) : nullptr;
+	dent::Pose pose = rm ? poseOf(*rm) : dent::Pose{};
+	const bool havePose = rm && rigid(pose);
+	auto hurt = [&](CPed *p){
+		if(!p || !p->bInVehicle || p->m_pMyVehicle != v || p->DyingOrDead()) return;
+		bool player = p == FindPlayerPed();
+		float scale = player ? cfg.occupantPlayerScale : 1.0f;
+		if(scale <= 0.f) return;
+		// How badly the bodywork is pushed in at THIS seat: the crush reaches it in proportion to its distance from the
+		// point of impact, and a frame already bent there counts too. The harder the cabin is crushed around a person, the
+		// likelier they are to die; someone sitting far from the impact survives what kills the one next to it.
+		float intrusion = 0.f;
+		if(havePose){
+			Vec seat = localPoint(vec(p->GetPosition()), pose);
+			float proximity = dent::weight(dent::length(seat - contact), std::max(radius * 1.2f, .8f), cfg.falloffPower);
+			intrusion = crushDepth * proximity;
+			if(c.st) intrusion = structural::seatIntrusion(*c.st, seat);
+		}
+		float iFactor = std::min(1.f, intrusion / .25f);
+		float crushPart = 140.0f * std::pow(std::min(1.f, std::max(0.f, (intrusion - .12f) / .30f)), 1.5f);
+		float total = std::min(400.f, speedPart * (.8f + .5f * iFactor) + crushPart);
+		OccApplied *rec = nullptr;
+		for(auto &r : occApplied) if(r.ped == p){ rec = &r; break; }
+		if(!rec){ occApplied.push_back({ p, 0u, 0.f }); rec = &occApplied.back(); if(occApplied.size() > 64) occApplied.erase(occApplied.begin()); rec = &occApplied.back(); }
+		if(rec->episode != c.episode.id || rec->vehicle != c.handle || rec->pedHandle != CPools::GetPedRef(p)){ rec->episode = c.episode.id; rec->applied = 0.f; rec->vehicle=c.handle; rec->pedHandle=CPools::GetPedRef(p); }
+		float delta = total - rec->applied;
+		if(delta < 1.0f) return;
+		rec->applied = total;
+		// InflictDamage refuses people sitting in a car (their collision is off), so apply it directly:
+		// armour takes the first of it, then health; at zero the ped dies (SetDie keeps an AI driver in the seat)
+		float rest = delta * scale;
+		float takeArmour = std::min(p->m_fArmour, rest);
+		p->m_fArmour -= takeArmour;
+		rest -= takeArmour;
+		p->m_fHealth -= rest;
+		if(cfg.logHits){
+			char b[160];
+			snprintf(b, sizeof(b), "Occupants: speedChange=%.1f m/s intrusion=%.2f m total=%.0f (+%.0f) health=%.0f %s", dv, intrusion, total, delta,
+				p->m_fHealth, player ? "player" : "npc");
+			logLine(b);
+		}
+		if(p->m_fHealth <= 0.5f){
+			p->m_fHealth = 1.0f;
+			p->SetDie(ANIM_STD_NUM, 4.0f, 0.0f);
+		}
+	};
+	hurt(v->pDriver);
+	for(int i = 0; i < 8; i++) hurt(v->pPassengers[i]);
+}
+
+// A wheel whose hub was already bent by an earlier crash is a weak point: the nearer a new blow lands to a damaged
+// corner, the less force it takes to tear that wheel off (1 = a sound wheel, 0.2 = one hanging by a thread).
+float
+wheelStrength(const Car &c, Vec point)
+{
+	if(!cfg.weakWheels || !c.vehicle->IsCar()) return 1.0f;
+	CAutomobile *car = (CAutomobile*)c.vehicle;
+	int best = -1;
+	float bestDist = cfg.wheelReach;
+	for(int i = 0; i < 4; i++){
+		RwFrame *frame = car->m_aCarNodes[kWheels[i].node];
+		if(!frame || !GetFirstObject(frame)) continue;
+		if(car->Damage.GetWheelStatus(kWheels[i].wheel) == WHEEL_STATUS_MISSING) continue;
+		float d = dent::length(vec(RwFrameGetMatrix(frame)->pos) - point);
+		if(d < bestDist){ bestDist = d; best = i; }
+	}
+	if(best < 0) return 1.0f;
+	float damaged = std::sqrt(c.hubD[best][0] * c.hubD[best][0] + c.hubD[best][1] * c.hubD[best][1] + c.hubD[best][2] * c.hubD[best][2]);
+	if(car->Damage.GetWheelStatus(kWheels[best].wheel) == WHEEL_STATUS_BURST) damaged += .12f;
+	return 1.0f - std::min(.8f, damaged / .35f * .8f);
+}
+
+// Put a car that lies on its roof or side back on its wheels where it is, facing the same way. Damage is kept.
+void
+uprightVehicle(CVehicle *v)
+{
+	if(!v || !clumpOf(v) || v->GetUp().z >= 0.7f) return;
+	CVector pos = v->GetPosition();
+	float heading = v->GetForward().Heading();
+	v->GetMatrix().SetRotateZ(heading);
+	v->SetPosition(pos + CVector(0.0f, 0.0f, 0.8f));
+	v->m_vecMoveSpeed = CVector(0.0f, 0.0f, 0.0f);
+	v->m_vecTurnSpeed = CVector(0.0f, 0.0f, 0.0f);
+}
+
+// The car F8/F9 act on: the one you drive, else the one you just left, else the nearest within reach.
+CVehicle *
+pickTargetCar(CVehicle *player)
+{
+	if(player) return player;
+	CPlayerPed *ped = FindPlayerPed();
+	if(!ped) return nullptr;
+	CVehicle *target = ped->m_pMyVehicle;
+	if(target && (!clumpOf(target) || (target->GetPosition() - ped->GetPosition()).Magnitude() > 25.f)) target = nullptr;
+	if(!target){
+		float best = 12.f;
+		auto *pool = CPools::GetVehiclePool();
+		for(int i = 0; i < pool->GetSize(); ++i){
+			CVehicle *v = pool->GetSlot(i);
+			if(!v || !clumpOf(v)) continue;
+			float d = (v->GetPosition() - ped->GetPosition()).Magnitude();
+			if(d < best){ best = d; target = v; }
+		}
+	}
+	return target;
+}
+
+// F8: undo everything a crash did, not only the body shape.
+void
+repairVehicle(CVehicle *vehicle)
+{
+	vehicle->m_fHealth = 1000.0f;
+	if(!vehicle->IsCar()) return;
+	CAutomobile *car = (CAutomobile*)vehicle;
+	car->Fix();				// panels, doors, bumpers, lights, engine back to undamaged
+	for(int i = 0; i < 4; i++)
+		car->Damage.SetWheelStatus(kWheels[i].wheel, WHEEL_STATUS_OK);	// knocked-off and burst wheels
+	car->SetupDamageAfterLoad();		// show the undamaged parts again
+	if(car->m_pSetOnFireEntity) car->m_pSetOnFireEntity = nullptr;
+	car->m_fFireBlowUpTimer = 0.0f;
+	uprightVehicle(vehicle);
+}
+
+void
+processVehicle(CVehicle *vehicle, bool isPlayer, bool reset, CVehicle *protectedPlayer)
+{
+	auto &cars = context->cars;
+	if(!isDentableCar(vehicle)) return;
+	Car *car = nullptr;
+	for(auto &c : cars) if(c->vehicle == vehicle){ car = c.get(); break; }
+	if(reset){
+		if(car) restore(*car);
+		repairVehicle(vehicle);
+		logLine("Player car repaired (deformation, wheels, panels, doors, glass, lights).");
+		return;
+	}
+	float hp = vehicle->m_fHealth, loss = car ? car->pendingLoss : 0.f;
+	if(!std::isfinite(hp) || !std::isfinite(loss)) return;
+	if(hp <= 0) return;
+	// Respect the vanilla collision-proof flag.
+	if(vehicle->bCollisionProof) return;
+	int handle = CPools::GetVehicleRef(vehicle);
+	const auto *contact = contacts.find(vehicle, handle, clumpOf(vehicle));
+	if(!contact) return;
+	const float impulse = contact->impulse, mass = vehicle->m_fMass;
+	auto response = dent::response(impulse, mass, cfg.curve);
+	if(response.depth <= 0) return;
+	const float objWidth = contact->otherWidth;
+	narrowDent(response, objWidth, 1.0f);
+	unsigned piece = contact->piece;
+	Vec localHit = contact->point, localNormal = contact->normal;
+	RwFrame *root = RpClumpGetFrame(clumpOf(vehicle));
+	if(!root) return;
+	RwMatrix *renderMatrix = RwFrameGetLTM(root);
+	if(!renderMatrix) return;
+	dent::Pose rpose = poseOf(*renderMatrix);
+	if(!rigid(rpose)) return;
+	unsigned now = CTimer::GetTimeInMilliseconds();
+	if(!car){
+		if(!reserveCarSlot(protectedPlayer, now)) return;
+		auto fresh = std::make_unique<Car>();
+		fresh->vehicle = vehicle;
+		fresh->handle = handle;
+		fresh->clump = clumpOf(vehicle);
+		fresh->panelSeed = now ^ ((uint32_t)handle * 0x9e3779b9u);
+		fresh->lastHealth = hp;
+		fresh->lastTouched = now;
+		car = fresh.get();
+		cars.push_back(std::move(fresh));
+	}
+	car->lastTouched = now;
+	if(!car->episode.observe(localHit, localNormal, response, now, cfg.contactGapMs)) return;
+	const auto &episode = car->episode;
+	if(!cfg.structural) hurtOccupants(*car, response.impact, isPlayer, response.depth, episode.point, episode.radius);
+	if(response.impact >= cfg.wheelJamImpact) car->jamArmed = true;
+	applyDummies(*car, episode);
+	damageLamps(vehicle, episode, isPlayer, false);
+	damageLamps(vehicle, episode, isPlayer, true);
+	if(cfg.wheelDetach && response.impact >= cfg.wheelMinImpact * wheelStrength(*car, episode.point) && car->lastWheelEpisode != episode.id){
+		car->lastWheelEpisode = episode.id;
+		detachWheel(vehicle, episode);
+	}
+	if(cfg.structural && ensureStructure(*car)){
+		// crash load goes into the node-and-beam structure; update() steps it and moves the mesh
+		// A frame's available crush travel follows crash energy. Reusing the cosmetic
+		// panel dent curve here left the radiator support nearly rigid after the hood folded.
+		dent::ImpactConfig frameCurve = cfg.curve;
+		frameCurve.crushAt50 = cfg.crumpleCrush50;
+		auto frameResponse = dent::response(impulse,mass,frameCurve);
+		narrowDent(frameResponse, objWidth, 1.6f);
+		dent::ImpactConfig roofCurve=frameCurve;
+		roofCurve.crushAt50=cfg.roofCrush50;
+		roofCurve.maxDepth=std::min(roofCurve.maxDepth,.45f);
+		auto roofResponse=dent::response(impulse,mass,roofCurve);
+		narrowDent(roofResponse, objWidth, 1.6f);
+		const float cm = structParams.crushScale * car->crushMul;
+		structural::drive(*car->st, episode.point, episode.direction, episode.depth * cm,
+			episode.radius, cfg.falloffPower, episode.id, now,
+			frameResponse.depth * cm,frameResponse.radius,
+			roofResponse.depth * cm,roofResponse.radius, response.wrap);
+		car->occImpact=response.impact;car->occDepth=frameResponse.depth*cm;
+		car->occContact=episode.point;car->occRadius=episode.radius;car->occHitAt=now;car->occPending=true;
+		if(cfg.skinDentScale > 0.f){
+			// the outer paint / sheet metal always bends where it is hit, whatever the frame underneath does
+			for(auto &mp : car->meshes){
+				Mesh &m = *mp;
+				if(!m.atomic || m.atomic->geometry != m.copy || !m.frame) continue;
+				RwMatrix *ltm = RwFrameGetLTM(m.frame);
+				if(!ltm) continue;
+				dent::Pose fpose = poseOf(*ltm);
+				if(!rigid(fpose)) continue;
+				Vec p = localPoint(dent::toWorldPoint(episode.point, rpose), fpose);
+				Vec d = localVector(dent::toWorldVector(episode.direction, rpose), fpose);
+				if(m.dentDisp.size() != m.rest.size()) m.dentDisp.assign(m.rest.size(), Vec{});
+				float oldD = m.episodeId == episode.id ? m.episodeDepth : 0.f, oldR = m.episodeId == episode.id ? m.episodeRadius : 0.f;
+				const bool haveN = m.restNormals.size() == m.rest.size();
+				const float skinR = episode.radius * .6f, skinOldR = oldR * .6f;
+				for(size_t i = 0; i < m.rest.size(); ++i){
+					// Inner and outer sheet-metal skins share impact orientation, while perpendicular surfaces remain weakly affected.
+					float facing = haveN ? dent::sheetFacing(d,m.restNormals[i]) : 1.f;
+					if(facing <= 0.f && m.dentDisp[i].x == 0.f && m.dentDisp[i].y == 0.f && m.dentDisp[i].z == 0.f) continue;
+					Vec cur = m.rest[i] + m.dentDisp[i];
+					Vec nxt = dent::displaceImpactWrap(m.rest[i], cur, p, d, episode.depth * cfg.skinDentScale * car->skinMul * facing, skinR,
+						oldD * cfg.skinDentScale * car->skinMul * facing, skinOldR, cfg.maxTotal, cfg.falloffPower, response.wrap * facing);
+					m.dentDisp[i] = nxt - m.rest[i];
+				}
+				m.episodeId = episode.id;
+				m.episodeDepth = episode.depth;
+				m.episodeRadius = episode.radius;
+			}
+			car->st->dirty = true;
+		}
+		if(cfg.logHits){
+			char b[760];
+			snprintf(b, sizeof(b), "StructHit: actor=%s model=%d episode=%u impact=%.4f depth=%.3f radius=%.3f drivenNodes=%u frameDepth=%.3f contact=%.2f,%.2f,%.2f massKg=%.1f otherMassKg=%.1f closingMps=%.2f absorbedJ=%.0f pairLossJ=%.0f solverImpulse=%.1f objectWidth=%.2f wrap=%.2f",
+				isPlayer ? "player" : "npc", vehicle->GetModelIndex(), episode.id, response.impact, episode.depth, episode.radius, (unsigned)car->st->drivers.size(),frameResponse.depth * structParams.crushScale,episode.point.x,episode.point.y,episode.point.z,
+				mass,contact->otherMass,contact->closingSpeed,contact->absorbedJ,contact->dissipatedJ,contact->rawImpulse,objWidth,response.wrap);
+			logLine(b);
+		}
+		return;
+	}
+	Hit hit{ car, dent::toWorldPoint(episode.point, rpose), dent::toWorldVector(episode.direction, rpose),
+		episode.depth, episode.radius, episode.id };
+	for(float &x : car->wheelIntrusion) x = 0.0f;
+	RpClumpForAllAtomics(car->clump, deformAtomic, &hit);
+	if(cfg.wheelByBody)
+		for(int w = 0; w < 4; w++)
+			if(car->wheelIntrusion[w] >= cfg.wheelBodyIntrusion)
+				knockOffWheel(vehicle, w, "body", car->wheelIntrusion[w]);
+	if(!hit.visited) logLine("Geometry traversal returned no atomics; no visual deformation applied.");
+	if(cfg.logHits){
+		Vec speed = vec(vehicle->m_vecMoveSpeed);
+		char b[320];
+		snprintf(b, sizeof(b),
+			"Hit: actor=%s handle=%d model=%d episode=%u impact=%.4f impulse=%.1f mass=%.1f speedAfter=%.4f healthLoss=%.1f depth=%.3f radius=%.3f piece=%u meshes=%u visited=%u",
+			isPlayer ? "player" : "npc", car->handle, vehicle->GetModelIndex(), episode.id, response.impact, impulse, mass, dent::length(speed), loss,
+			hit.depth, hit.radius, piece, hit.touched, hit.visited);
+		logLine(b);
+	}
+}
+
+
+extern "C" int regtaDumpRequest;
+
+// Debug aid (REGTA_DEBUG_BREAKCAR=1): smash the player car's glass and wings, point a fixed camera at
+// it, save the game's own frame to regta_signal_N.ppm, then quit. Nothing happens without the variable.
+void
+debugBreakCar()
+{
+	static const bool on = getenv("REGTA_DEBUG_BREAKCAR") != nil;
+	if(!on) return;
+	static int tick = 0;
+	static CVehicle *chosen = nullptr;
+	static int chosenHandle = -1;
+	if(chosen && CPools::GetVehicle(chosenHandle) != chosen) return;	// car went away
+	if(!chosen){
+		CEntity *me = FindPlayerVehicle() ? (CEntity*)FindPlayerVehicle() : (CEntity*)FindPlayerPed();
+		if(!me) return;
+		float best = 60.f;
+		auto *pool = CPools::GetVehiclePool();
+		for(int i = 0; i < pool->GetSize(); ++i){
+			CVehicle *c = pool->GetSlot(i);
+			if(!c || !c->IsCar() || !clumpOf(c)) continue;
+			float d = (c->GetPosition() - me->GetPosition()).Magnitude();
+			if(d < best){ best = d; chosen = c; }
+		}
+		if(!chosen){
+			// nothing nearby: put a Kuruma next to the player (like the debug menu's spawn)
+			static int waited = 0;
+			if(++waited < 120) return;
+			CStreaming::RequestModel(MI_SENTINEL, 0);
+			CStreaming::LoadAllRequestedModels(false);
+			if(!CStreaming::HasModelLoaded(MI_SENTINEL)) return;
+			CVehicle *nv = new CAutomobile(MI_SENTINEL, RANDOM_VEHICLE);
+			nv->SetPosition(me->GetPosition() + CVector(7.f, 0.f, 1.5f));
+			nv->SetOrientation(0.0f, 0.0f, 0.f);
+			nv->SetStatus(STATUS_ABANDONED);
+			nv->m_nDoorLock = CARLOCK_UNLOCKED;
+			CWorld::Add(nv);
+			chosen = nv;
+			logLine("Debug: spawned a Kuruma next to the player");
+		}
+		chosenHandle = CPools::GetVehicleRef(chosen);
+		char b[100];
+		snprintf(b, sizeof(b), "Debug: chose car model=%d at %.1f m", chosen->GetModelIndex(), best);
+		logLine(b);
+	}
+	CVehicle *v = chosen;
+	CAutomobile *car = (CAutomobile*)v;
+	++tick;
+	if(tick == 400 && context){
+		// verify the cloned body meshes keep every triangle's material/texture
+		auto fresh = std::make_unique<Car>();
+		fresh->vehicle = v;
+		fresh->handle = CPools::GetVehicleRef(v);
+		fresh->clump = clumpOf(v);
+		Car *tc = fresh.get();
+		context->cars.push_back(std::move(fresh));
+		bool built = ensureStructure(*tc);
+		char hb[120];
+		snprintf(hb, sizeof(hb), "Debug: structure built=%d meshes=%u", (int)built, (unsigned)tc->meshes.size());
+		logLine(hb);
+		int total = 0, bad = 0;
+		for(auto &mp : tc->meshes){
+			Mesh &m = *mp;
+			if(!m.original || !m.copy) continue;
+			// triangle order differs (librw rebuilds it), so compare as sets: (sorted vertices, texture name)
+			auto keys = [&](rw::Geometry *g){
+				std::vector<std::string> out;
+				if(g == m.original && g->meshHeader){
+					// what the game really draws: the mesh groups (indices + material per group)
+					rw::MeshHeader *h = g->meshHeader;
+					rw::Mesh *ms = h->getMeshes();
+					bool strip = h->flags == rw::MeshHeader::TRISTRIP;
+					for(unsigned mi = 0; mi < h->numMeshes; ++mi){
+						const char *tn = ms[mi].material && ms[mi].material->texture ? ms[mi].material->texture->name : "(none)";
+						for(unsigned i = 0; i + 2 < ms[mi].numIndices; i += strip ? 1 : 3){
+							int v[3] = { ms[mi].indices[i], ms[mi].indices[i + 1 + (strip ? i % 2 : 0)], ms[mi].indices[i + 2 - (strip ? i % 2 : 0)] };
+							if(v[0] == v[1] || v[0] == v[2] || v[1] == v[2]) continue;
+							std::sort(v, v + 3);
+							char kb[96];
+							snprintf(kb, sizeof(kb), "%d,%d,%d,%s", v[0], v[1], v[2], tn);
+							out.push_back(kb);
+						}
+					}
+					std::sort(out.begin(), out.end());
+					return out;
+				}
+				for(int t = 0; t < g->numTriangles; ++t){
+					const auto &tr = g->triangles[t];
+					rw::Material *mt = tr.matId < g->matList.numMaterials ? g->matList.materials[tr.matId] : nullptr;
+					const char *tn = mt && mt->texture ? mt->texture->name : "(none)";
+					int v[3] = { tr.v[0], tr.v[1], tr.v[2] };
+					std::sort(v, v + 3);
+					char kb[96];
+					snprintf(kb, sizeof(kb), "%d,%d,%d,%s", v[0], v[1], v[2], tn);
+					out.push_back(kb);
+				}
+				std::sort(out.begin(), out.end());
+				return out;
+			};
+			std::vector<std::string> ko = keys(m.original), kc = keys(m.copy);
+			int texBad = 0, vtxBad = 0, matBad = 0, firstBad = -1;
+			std::vector<std::string> onlyO, onlyC;
+			std::set_difference(ko.begin(), ko.end(), kc.begin(), kc.end(), std::back_inserter(onlyO));
+			std::set_difference(kc.begin(), kc.end(), ko.begin(), ko.end(), std::back_inserter(onlyC));
+			texBad = (int)onlyO.size();
+			total += (int)ko.size();
+			bad += texBad;
+			if(!onlyO.empty() && cfg.logHits){
+				char eb[220];
+				snprintf(eb, sizeof(eb), "Debug:   e.g. original has [%s] but the clone has [%s]", onlyO[0].c_str(), onlyC.empty() ? "-" : onlyC[0].c_str());
+				logLine(eb);
+			}
+			RwFrame *f = m.frame;
+			char b[260];
+			snprintf(b, sizeof(b), "Debug: mesh %s tris=%d mats=%d trianglesWithDifferentVerticesOrTexture=%d",
+				f ? GetFrameNodeName(f) : "?", m.original->numTriangles, m.original->matList.numMaterials, texBad);
+			(void)vtxBad; (void)matBad; (void)firstBad;
+			logLine(b);
+		}
+		char b[100];
+		snprintf(b, sizeof(b), "Debug: triangles checked=%d texture mismatches=%d", total, bad);
+		logLine(b);
+	}
+	if(tick >= 380){	// the new-game script holds the screen black; this is a test
+		TheCamera.m_bFading = false;
+		TheCamera.m_fFLOATingFade = 0.0f;
+		CDraw::FadeValue = 0;
+	}
+	if(tick >= 380 && tick < 700 && tick % 20 == 0){
+		char b[140];
+		snprintf(b, sizeof(b), "Debug tick %d: fadeValue=%d cutscene=%d camMode=%d", tick, (int)CDraw::FadeValue, (int)CCutsceneMgr::IsRunning(), (int)TheCamera.Cams[TheCamera.ActiveCam].Mode);
+		logLine(b);
+	}
+	if(tick == 420){
+		car->Damage.SetPanelStatus(VEHPANEL_WINDSCREEN, PANEL_STATUS_SMASHED1);
+		car->SetPanelDamage(CAR_WINDSCREEN, VEHPANEL_WINDSCREEN);
+		car->Damage.SetDoorStatus(DOOR_FRONT_LEFT, DOOR_STATUS_SMASHED);
+		car->SetDoorDamage(CAR_DOOR_LF, DOOR_FRONT_LEFT);
+		car->Damage.SetDoorStatus(DOOR_FRONT_RIGHT, DOOR_STATUS_SMASHED);
+		car->SetDoorDamage(CAR_DOOR_RF, DOOR_FRONT_RIGHT);
+		car->Damage.SetPanelStatus(VEHPANEL_FRONT_LEFT, PANEL_STATUS_SMASHED1);
+		car->SetPanelDamage(CAR_WING_LF, VEHPANEL_FRONT_LEFT);
+		car->Damage.SetPanelStatus(VEHPANEL_FRONT_RIGHT, PANEL_STATUS_SMASHED1);
+		car->SetPanelDamage(CAR_WING_RF, VEHPANEL_FRONT_RIGHT);
+		car->Damage.SetLightStatus(VEHLIGHT_FRONT_LEFT, 1);
+		car->Damage.SetLightStatus(VEHLIGHT_FRONT_RIGHT, 1);
+		logLine("Debug: smashed windscreen, front doors, front wings, headlights");
+	}
+	CVector pos = v->GetPosition(), fwd = v->GetForward(), right = v->GetRight();
+	if(tick == 430 || tick == 560){
+		CVector cam = tick == 430 ? pos + fwd*5.5f - right*3.0f + CVector(0.f, 0.f, 1.6f)
+		                          : pos + fwd*3.0f + right*1.8f + CVector(0.f, 0.f, 0.9f);
+		TheCamera.SetCamPositionForFixedMode(cam, CVector(0.f, 0.f, 0.f));
+		TheCamera.TakeControlNoEntity(pos + CVector(0.f, 0.f, 0.8f), JUMP_CUT, 1);
+	}
+	if(tick == 520 || tick == 650) regtaDumpRequest = 2;
+	if(tick == 700) RsGlobal.quit = TRUE;
+}
