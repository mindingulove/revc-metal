diff --git a/tools/test_engine_reliability.cpp b/tools/test_engine_reliability.cpp
new file mode 100644
index 00000000..319b6e80
--- /dev/null
+++ b/tools/test_engine_reliability.cpp
@@ -0,0 +1,26 @@
+#include "EngineReliability.hpp"
+#include <cassert>
+#include <cstdio>
+using namespace reliability;
+int main(){
+ assert(severity(1000,0,0)==0);assert(severity(600,0,0)==0);assert(severity(400,0,0)==.5f);assert(severity(1000,1,0)==1);
+ Engine healthy;for(int i=0;i<36000;i++)assert(healthy.step(1.f/60,0,false,true,true)==Event::None);
+ healthy.reset(false);assert(healthy.step(.016f,0,true,false,true)==Event::Started);
+ Engine bad;bad.seed=12345;bad.reset(true);int stalls=0,failures=0,cranks=0,starts=0;float offTime=0;
+ for(int i=0;i<36000;i++){
+  bool on=bad.phase==Phase::Running;auto event=bad.step(1.f/60,1,true,on,true);
+  stalls+=event==Event::Stalled;failures+=event==Event::Failed;cranks+=event==Event::Crank;starts+=event==Event::Started;
+  if(bad.phase!=Phase::Running)offTime+=1.f/60;
+ }
+ assert(stalls>5&&failures>10&&starts>5&&cranks>failures&&offTime>10);
+ bad.reset(false);for(int i=0;i<1000;i++)assert(bad.step(.016f,1,false,false,true)==Event::None);assert(bad.phase==Phase::Off);
+ assert(bad.step(.016f,1,true,false,true)==Event::Crank);assert(bad.phase==Phase::Cranking);
+ bad.step(.016f,1,true,false,false);assert(bad.phase==Phase::Off); // wrecked/submerged cannot start
+ bad.reset(false);assert(bad.step(.016f,0,true,false,true)==Event::Started); // repair clears failed ignition
+ // Rate depends on elapsed time, not frame rate: same severity, long runs at 30/60/120 Hz have comparable counts.
+ int counts[3]={};for(int rate=0;rate<3;rate++){Engine e;e.seed=555;int hz=30<<rate;
+  for(int i=0;i<hz*3600;i++){auto ev=e.step(1.f/hz,.5f,true,e.phase==Phase::Running,true);counts[rate]+=ev==Event::Stalled;}
+ }
+ for(int n:counts)assert(n>70&&n<180);
+ printf("PASS engine reliability: %d stalls, %d failed starts, %d successful retries; rate counts %d/%d/%d; healthy, manual retries, wreck and repair paths.\n",stalls,failures,starts,counts[0],counts[1],counts[2]);
+}
