diff --git a/src/extras/plugins/PluginAPI.h b/src/extras/plugins/PluginAPI.h
new file mode 100644
index 00000000..fda62e68
--- /dev/null
+++ b/src/extras/plugins/PluginAPI.h
@@ -0,0 +1,46 @@
+#pragma once
+
+// reGTA plugin API: the native equivalent of an ASI loader.
+//
+// A plugin is a shared library with the ".asi" extension placed in the game's
+// "scripts" or "plugins" folder (or next to the executable). It must export
+//     extern "C" REGTA_PLUGIN_EXPORT void RegtaPluginInit(const RegtaPluginAPI *api);
+// which is called once when the plugin is loaded (before the game initialises).
+// Plugins register callbacks for game lifecycle events. Because the executable
+// exports its symbols, a plugin built against the game's headers may also call
+// engine functions directly (build it with unresolved symbols allowed).
+//
+// Windows/x86 .asi binaries made for the original gta3.exe patch fixed addresses
+// and cannot run here; they must be ported to this API from their source.
+
+#include <stdint.h>
+
+#if defined(_WIN32)
+#define REGTA_PLUGIN_EXPORT __declspec(dllexport)
+#else
+#define REGTA_PLUGIN_EXPORT __attribute__((visibility("default")))
+#endif
+
+#define REGTA_PLUGIN_API_VERSION 1
+
+enum RegtaEvent {
+	REGTA_EVENT_INIT_RW,		// after RenderWare, fonts, HUD, pipelines are initialised
+	REGTA_EVENT_SHUTDOWN_RW,	// before RenderWare shutdown
+	REGTA_EVENT_INIT_GAME,		// after CGame::Initialise (level data loaded)
+	REGTA_EVENT_INIT_SCRIPTS,	// after CTheScripts::Init (also on game restart)
+	REGTA_EVENT_PROCESS,		// every frame in CGame::Process
+	REGTA_EVENT_DRAW2D,			// every frame before 2D/HUD drawing
+	REGTA_EVENT_SHUTDOWN_GAME,	// before CGame::ShutDown
+	REGTA_EVENT_COUNT
+};
+
+typedef void (*RegtaEventCallback)(void *user);
+
+struct RegtaPluginAPI {
+	uint32_t version;			// REGTA_PLUGIN_API_VERSION
+	void (*registerEvent)(int event, RegtaEventCallback callback, void *user);
+	void (*log)(const char *format, ...);
+	const char *gameDir;		// working directory of the game
+};
+
+typedef void (*RegtaPluginInitFn)(const RegtaPluginAPI *api);
diff --git a/src/extras/plugins/PluginLoader.cpp b/src/extras/plugins/PluginLoader.cpp
new file mode 100644
index 00000000..17724c6e
--- /dev/null
+++ b/src/extras/plugins/PluginLoader.cpp
@@ -0,0 +1,136 @@
+#include "common.h"
+
+#include <vector>
+#include <string>
+#include <algorithm>
+#include <stdarg.h>
+#include <dirent.h>
+
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <dlfcn.h>
+#endif
+
+#include "PluginLoader.h"
+#include "ModLoader.h"
+#include "NativePorts.h"
+
+struct Callback {
+	RegtaEventCallback fn;
+	void *user;
+};
+
+static std::vector<Callback> ms_callbacks[REGTA_EVENT_COUNT];
+static int ms_numLoaded;
+static bool ms_loaded;
+
+static void
+PluginRegisterEvent(int event, RegtaEventCallback fn, void *user)
+{
+	if(event < 0 || event >= REGTA_EVENT_COUNT || fn == nil)
+		return;
+	Callback cb = { fn, user };
+	ms_callbacks[event].push_back(cb);
+}
+
+static void
+PluginLog(const char *format, ...)
+{
+	char buf[512];
+	va_list args;
+	va_start(args, format);
+	vsnprintf(buf, sizeof(buf), format, args);
+	va_end(args);
+	debug("[plugin] %s\n", buf);
+}
+
+static const RegtaPluginAPI ms_api = {
+	REGTA_PLUGIN_API_VERSION,
+	PluginRegisterEvent,
+	PluginLog,
+	"."
+};
+
+static bool
+HasAsiExtension(const char *name)
+{
+	size_t n = strlen(name);
+	return n > 4 && strcasecmp(name + n - 4, ".asi") == 0;
+}
+
+static void
+LoadPlugin(const std::string &path)
+{
+#ifdef _WIN32
+	HMODULE lib = LoadLibraryA(path.c_str());
+	if(lib == nil){
+		debug("[plugin] %s: failed to load\n", path.c_str());
+		return;
+	}
+	RegtaPluginInitFn init = (RegtaPluginInitFn)GetProcAddress(lib, "RegtaPluginInit");
+#else
+	void *lib = dlopen(path.c_str(), RTLD_NOW | RTLD_LOCAL);
+	if(lib == nil){
+		dlerror();
+		if(CNativePorts::TryLoad(path, &ms_api)){
+			ms_numLoaded++;
+			return;
+		}
+		debug("[plugin] %s: skipped (not a native plugin)\n", path.c_str());
+		return;
+	}
+	RegtaPluginInitFn init = (RegtaPluginInitFn)dlsym(lib, "RegtaPluginInit");
+#endif
+	if(init == nil){
+		debug("[plugin] %s: skipped (no RegtaPluginInit export; original-exe .asi plugins must be ported)\n", path.c_str());
+		return;
+	}
+	init(&ms_api);
+	ms_numLoaded++;
+	debug("[plugin] loaded %s\n", path.c_str());
+}
+
+void
+CPluginLoader::LoadAll(void)
+{
+	if(ms_loaded)
+		return;
+	ms_loaded = true;
+
+	static const char *dirs[] = { "scripts", "plugins", "." };
+	for(size_t d = 0; d < sizeof(dirs)/sizeof(dirs[0]); d++){
+		DIR *dir = opendir(dirs[d]);
+		if(dir == nil)
+			continue;
+		std::vector<std::string> files;
+		struct dirent *de;
+		while((de = readdir(dir)) != nil)
+			if(HasAsiExtension(de->d_name))
+				files.push_back(std::string(dirs[d]) + "/" + de->d_name);
+		closedir(dir);
+		std::sort(files.begin(), files.end());	// deterministic load order
+		for(size_t i = 0; i < files.size(); i++)
+			LoadPlugin(files[i]);
+	}
+	// plugins that live inside Mod Loader mod folders
+	const std::vector<std::string> &mp = CModLoader::GetPluginPaths();
+	for(size_t i = 0; i < mp.size(); i++)
+		LoadPlugin(mp[i]);
+}
+
+void
+CPluginLoader::Fire(RegtaEvent event)
+{
+	// copy by index: a callback may register more callbacks
+	for(size_t i = 0; i < ms_callbacks[event].size(); i++){
+		Callback cb = ms_callbacks[event][i];
+		cb.fn(cb.user);
+	}
+}
+
+int
+CPluginLoader::NumLoaded(void)
+{
+	return ms_numLoaded;
+}
