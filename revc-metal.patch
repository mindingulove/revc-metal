+  id<MTLTexture> tex[7];for(auto &t:tex){auto d=[MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA32Float width:width height:height mipmapped:NO];d.storageMode=MTLStorageModeShared;d.usage=MTLTextureUsageShaderRead|MTLTextureUsageShaderWrite;t=[S.device newTextureWithDescriptor:d];assert(t);}
