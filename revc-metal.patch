diff --git a/tools/build_freeroam_map.py b/tools/build_freeroam_map.py
new file mode 100644
index 00000000..cb86d14f
--- /dev/null
+++ b/tools/build_freeroam_map.py
@@ -0,0 +1,48 @@
+#!/usr/bin/env python3
+"""Build a startup-safe road overview from the installed map's IDE/IPL paths."""
+import math
+from pathlib import Path
+import sys
+root = Path(sys.argv[1])
+files = {str(p.relative_to(root)).lower(): p for p in root.glob('data/**/*') if p.is_file()}
+def resolve(name):
+    return files[name.replace('\\', '/').lower()]
+def lines(path):
+    return [s for line in path.read_text(errors='replace').splitlines() if (s := line.split('#')[0].strip().replace(',', ' '))]
+paths = {}
+entries = lines(root / 'data/gta3.dat')
+for entry in entries:
+    if not entry.startswith('IDE '): continue
+    data = lines(resolve(entry.split()[1]))
+    for i, line in enumerate(data):
+        fields = line.split()
+        if fields[0] not in ('car', 'ped'): continue
+        paths[int(fields[1]), fields[0]] = [list(map(float, n.split())) for n in data[i+1:i+13]]
+segments = []
+for entry in entries:
+    if not entry.startswith('IPL '): continue
+    section = ''
+    for line in lines(resolve(entry.split()[1])):
+        f = line.split()
+        if len(f) == 1:
+            section = f[0]; continue
+        if section != 'inst' or len(f) != 12: continue
+        model = int(f[0]); tx, ty, tz, sx, sy, sz, qx, qy, qz, qw = map(float, f[2:])
+        # FileLoader rotates by -2*acos(w); instance scale is intentionally ignored there.
+        angle = -2 * math.acos(max(-1, min(1, qw)))
+        norm = math.sqrt(qx*qx + qy*qy + qz*qz)
+        axis = [v/norm for v in (qx,qy,qz)] if norm else [0,0,1]
+        def transform(n):
+            x,y,z = n[3:6]; x/=16; y/=16; z/=16
+            a,b,c = axis; co=math.cos(angle); si=math.sin(angle); dot=a*x+b*y+c*z
+            return (tx+x*co+(b*z-c*y)*si+a*dot*(1-co), ty+y*co+(c*x-a*z)*si+b*dot*(1-co), tz+z*co+(a*y-b*x)*si+c*dot*(1-co))
+        for kind in ('car','ped'):
+            nodes = paths.get((model,kind), [])
+            for n in nodes:
+                target = int(n[1])
+                if n[0] and 0 <= target < len(nodes) and nodes[target][0]:
+                    segments.append((int(kind=='ped'), *transform(n), *transform(nodes[target])))
+assert len(segments) > 1000, len(segments)
+out = root / 'data/freeroam-map.dat'
+out.write_text(''.join('%d %.3f %.3f %.3f %.3f %.3f %.3f\n' % s for s in segments))
+print(f'{len(segments)} road/footpath segments -> {out}')
