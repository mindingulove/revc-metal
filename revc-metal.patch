+
+void
+LocalDent::OnCollisionPair(CPhysical *a, CPhysical *b, const CColPoint &point, float impulseA, float impulseB,
+                         float normalBefore, float normalAfter)
+{
+	if(!enabled) return;
+	auto bodyA = collisionBody(a, point), bodyB = collisionBody(b, point);
+	auto energy = dent::collisionEnergy(bodyA, bodyB, normalBefore, normalAfter, impulseA, impulseB);
+	float closing = Max(0.0f, -normalBefore) * 50.0f;
+	if(a && a->IsVehicle()) capture((CVehicle*)a, point, energy.speedA * bodyA.mass, false,
+		impulseA, bodyB.inverseEffectiveMass > 0 ? bodyB.mass : 0, closing, energy.available * 2500.0f, energy.absorbedA * 2500.0f, entityWidth(b));
+	if(b && b->IsVehicle()) capture((CVehicle*)b, point, energy.speedB * bodyB.mass, true,
+		impulseB, bodyA.inverseEffectiveMass > 0 ? bodyA.mass : 0, closing, energy.available * 2500.0f, energy.absorbedB * 2500.0f, entityWidth(a));
+}
+
+float
+LocalDent::SteerBias(CVehicle *v)
+{
+	if(!enabled || !context || !cfg.structural || !cfg.steerPull) return 0.0f;
+	for(auto &c : context->cars){
+		if(c->vehicle != v || !c->st) continue;
+		const auto &st = *c->st;
+		int lf = st.hubNode[0], rf = st.hubNode[1];	// kWheels order: left front, right front
+		if(lf < 0 || rf < 0) return 0.0f;
+		Vec dLF = st.pos[lf] - st.nodes[lf].rest, dRF = st.pos[rf] - st.nodes[rf].rest;
+		float track = std::max(1.0f, dent::length(st.nodes[rf].rest - st.nodes[lf].rest));
+		// the right wheel dragged forward of the left one (or the reverse) turns the whole axle
+		float bias = (dRF.y - dLF.y) / track * cfg.steerPullGain;
+		// a twisted frame: the rear axle sits sideways of the front one, so the car crabs and needs steering to run straight
+		if(cfg.extras){
+			float rearX = (c->hubD[2][0] + c->hubD[3][0]) * .5f, frontX = (c->hubD[0][0] + c->hubD[1][0]) * .5f;
+			bias += (rearX - frontX) / 2.6f * .6f;
+		}
+		if(!std::isfinite(bias)) return 0.0f;
+		return std::min(std::max(bias, -0.3f), 0.3f);
+	}
+	return 0.0f;
+}
+
+float
+LocalDent::ScaleStockDamage(CVehicle *v, float impulse)
+{
+	if(!enabled || !cfg.stockScale || !isDentableCar(v) || !(impulse > 0.f) || !std::isfinite(impulse)) return impulse;
+	float impact = impulse / std::max(v->m_fMass, 1.f);
+	float f = std::pow(impact / cfg.stockRefImpact, 2.5f);
+	return impulse * std::min(std::max(f, .05f), 1.5f);
+}
+
+bool
+LocalDent::KeepFlippedCars(void)
+{
+	return enabled && cfg.keepFlipped;
+}
+
+bool
+LocalDent::StartEngine(CVehicle *v)
+{
+    if(!v) return false;
+    if(enabled && cfg.extras && cfg.engineReliability && v->IsCar() && v->GetModelIndex()!=MI_RCBANDIT){
+        float crush=0,heat=0;
+        if(context) for(auto &c:context->cars) if(c->vehicle==v){crush=c->engineFrac;heat=c->overheat;break;}
+        if(reliability::severity(v->m_fHealth,crush,heat)>0 || engines.count(v)) return false;
+    }
+    v->bEngineOn=true;return true;
+}
+
+void
+LocalDent::ProcessEngine(CVehicle *v)
+{
+    if(!enabled || !cfg.extras || !cfg.engineReliability || !v || !v->IsCar() || v->GetModelIndex()==MI_RCBANDIT) return;
+    float crush=0,heat=0;
+    if(context) for(auto &c:context->cars) if(c->vehicle==v){crush=c->engineFrac;heat=c->overheat;break;}
+    float damage=reliability::severity(v->m_fHealth,crush,heat);
+    if(damage<=0 && v->bEngineOn){engines.erase(v);return;}
+    int handle=CPools::GetVehicleRef(v);
+    EngineRecord &record=engines[v];
+    if(record.handle!=handle || record.clump!=clumpOf(v)){
+        record=EngineRecord{};record.handle=handle;record.clump=clumpOf(v);record.health=v->m_fHealth;
+        record.engine.seed=(uint32_t)handle*2654435761u+1u;if(!record.engine.seed)record.engine.seed=1;
+    }
+    if(v->m_fHealth-record.health>25.f){record.engine.reset(v->bEngineOn);record.engine.retry=0;}
+    record.health=v->m_fHealth;
+    bool driver=v->pDriver && !v->pDriver->DyingOrDead();
+    bool player=driver && v->pDriver->IsPlayer();
+    bool request=driver && (!player || std::fabs(v->m_fGasPedal)>.05f);
+    bool canRun=v->m_fHealth>0 && v->GetStatus()!=STATUS_WRECKED && !v->bIsInWater;
+    auto event=record.engine.step(CTimer::GetTimeStepInSeconds(),damage,request,v->bEngineOn,canRun);
+    v->bEngineOn=record.engine.phase==reliability::Phase::Running;
+    if(!v->bEngineOn && v->GetStatus()==STATUS_SIMPLE) v->SetStatus(STATUS_PHYSICS);
+    if(cfg.sounds && event==reliability::Event::Crank) DMAudio.PlayOneShot(v->m_audioEntityId,SOUND_CAR_ENGINE_START,1.f);
+    if(cfg.sounds && (event==reliability::Event::Failed || event==reliability::Event::Stalled)) DMAudio.PlayOneShot(v->m_audioEntityId,SOUND_CAR_JERK,1.f);
+    if(cfg.logHits && event!=reliability::Event::None){
+        const char *label=event==reliability::Event::Crank?"cranking":event==reliability::Event::Started?"started":event==reliability::Event::Failed?"failed":"stalled";
+        char b[128];snprintf(b,sizeof(b),"Engine: %s handle=%d damage=%.2f health=%.0f",label,handle,damage,v->m_fHealth);logLine(b);
+    }
+}
+
+float
+LocalDent::PowerFactor(CVehicle *v)
+{
+	if(!enabled || !context || !cfg.powerLoss) return 1.0f;
+	for(auto &c : context->cars)
+		if(c->vehicle == v){
+			float drag = cfg.handlingDamage ? std::min(.35f, c->bodyBend * cfg.dragLoss) : 0.f;
+			float f = (1.0f - c->engineFrac * cfg.powerLossMax) * (1.0f - drag);
+			if(cfg.extras){
+				const uint32_t now = CTimer::GetTimeInMilliseconds();
+				float t = std::min(1.f, std::max(0.f, (c->overheat - .5f) / .5f));
+				f *= 1.0f - .7f * t * t * (3.f - 2.f * t);			// a boiling engine loses power
+				if(c->engineFrac > .2f && hash01(now / 140 + (uint32_t)c->handle * 17u) < (.08f + .5f * c->engineFrac) * .6f)
+					f *= .25f;										// misfire
+				if(now < c->slipUntil) f *= .1f;					// gearbox slipping
+				if(c->gearbox < .99f){								// stuck in a low gear: a top speed
+					float spd = std::sqrt(v->m_vecMoveSpeed.MagnitudeSqr());
+					float limit = .25f + .75f * c->gearbox;
+					f *= std::min(1.f, std::max(0.f, (limit - spd) / .08f));
+				}
+				if(!(c->torn & (1u << 6)) && c->partDisp[6] > cfg.tearBumper * cfg.hangFraction * .8f) f *= .97f;	// dragging bumpers
+				if(!(c->torn & (1u << 7)) && c->partDisp[7] > cfg.tearBumper * cfg.hangFraction * .8f) f *= .97f;
+			}
+			return std::max(0.f, f);
+		}
+	return 1.0f;
+}
+
+static Car *
+carOf(CVehicle *v)
+{
+	if(!LocalDent::enabled || !context || !cfg.handlingDamage) return nullptr;
+	for(auto &c : context->cars) if(c->vehicle == v) return c.get();
+	return nullptr;
+}
+
+static float
+hubMag(const Car &c, int i)
+{
+	return std::sqrt(c.hubD[i][0] * c.hubD[i][0] + c.hubD[i][1] * c.hubD[i][1] + c.hubD[i][2] * c.hubD[i][2]);
+}
+
+float
+LocalDent::BrakeFactor(CVehicle *v)
+{
+	Car *c = carOf(v);
+	if(!c) return 1.0f;
+	float m = std::max(std::max(hubMag(*c, 0), hubMag(*c, 1)), std::max(hubMag(*c, 2), hubMag(*c, 3)));
+	return 1.0f - std::min(.5f, m * cfg.brakeLoss);
+}
+
+float
+LocalDent::TractionFactor(CVehicle *v)
+{
+	Car *c = carOf(v);
+	if(!c) return 1.0f;
+	float avg = (hubMag(*c, 0) + hubMag(*c, 1) + hubMag(*c, 2) + hubMag(*c, 3)) * .25f;
+	float low = 1.f;
+	for(int i = 0; i < 4; i++) low = std::min(low, c->tyrePressure[i]);
+	return (1.0f - std::min(.35f, avg * cfg.gripLoss)) * (1.0f - (cfg.extras ? .3f * (1.f - low) : 0.f));
+}
+
+float
+LocalDent::SpringFactor(CVehicle *v, int wheel)
+{
+	Car *c = carOf(v);
+	if(!c || wheel < 0 || wheel > 3) return 1.0f;
+	return 1.0f - std::min(.5f, hubMag(*c, wheel) * cfg.suspensionLoss);
+}
+
+float
+LocalDent::DampFactor(CVehicle *v, int wheel)
+{
+	Car *c = carOf(v);
+	if(!c || wheel < 0 || wheel > 3) return 1.0f;
+	return 1.0f - std::min(.6f, hubMag(*c, wheel) * cfg.suspensionLoss * 1.25f);
+}
+
+void
+LocalDent::WheelTilt(CVehicle *v, int wheel, CMatrix &mat)
+{
+	Car *c = carOf(v);
+	if(!c || !cfg.wheelTilt || wheel < 0 || wheel > 3) return;
+	// wheel numbering is CARWHEEL_*; the hubs are stored in kWheels order (LF, RF, LB, RB = same numbering)
+	float side = (wheel == CARWHEEL_FRONT_RIGHT || wheel == CARWHEEL_REAR_RIGHT) ? 1.0f : -1.0f;
+	float camber = std::min(std::max(c->hubD[wheel][2] * cfg.tiltScale, -.45f), .45f) * side;
+	float toe = std::min(std::max(c->hubD[wheel][0] * cfg.tiltScale * -side, -.45f), .45f);
+	if(std::fabs(camber) < .002f && std::fabs(toe) < .002f) return;
+	float cc = std::cos(camber), sc = std::sin(camber), ct = std::cos(toe), st = std::sin(toe);
+	CVector *axes[3] = { &mat.GetRight(), &mat.GetForward(), &mat.GetUp() };
+	for(CVector *a : axes){
+		float x = a->x * cc + a->z * sc, z = -a->x * sc + a->z * cc, y = a->y;	// lean about the car's long axis
+		float x2 = x * ct - y * st, y2 = x * st + y * ct;				// turn about the vertical axis
+		a->x = x2; a->y = y2; a->z = z;
+	}
+}
+
+float
+LocalDent::WheelBrake(CVehicle *v, int wheel, float brake)
+{
+	Car *c = carOf(v);
+	if(!c || !cfg.wheelLock || wheel < 0 || wheel > 3) return brake;
+	float jam = c->wheelJam[wheel];
+	if(jam < cfg.wheelLockFrom) return brake;
+	// pushed into the wheel a little: it drags; a lot: it is locked solid
+	float lock = std::min(1.0f, (jam - cfg.wheelLockFrom) / std::max(.05f, cfg.wheelLockFull - cfg.wheelLockFrom));
+	float locked = 20000.0f * CTimer::GetTimeStepFix();
+	return brake + (locked - brake) * lock;
+}
+
+float
+LocalDent::WheelDrive(CVehicle *v, int wheel)
+{
+	Car *c = carOf(v);
+	if(!c || !cfg.extras || wheel < 0 || wheel > 3) return 1.0f;
+	// an axle bent this far no longer turns the wheel: the drive to it is cut
+	return 1.0f - std::min(1.f, std::max(0.f, (hubMag(*c, wheel) - .20f) / .30f));
+}
+
+CVector
+LocalDent::CentreOfMassShift(CVehicle *v)
+{
+	Car *c = carOf(v);
+	if(!c || !cfg.extras) return CVector(0.f, 0.f, 0.f);
+	return CVector(std::min(.4f, std::max(-.4f, c->comX)), std::min(.4f, std::max(-.4f, c->comY)), 0.f);
+}
+
+void
+LocalDent::SaveState(int slot)
+{
+	if(!enabled || !context) return;
+	FILE *f = fopen(slotFile(slot).c_str(), "wb");
+	if(!f) return;
+	std::vector<Car*> list;
+	for(auto &c : context->cars) if(c->st && alive(*c) && c->bodyBend > .01f) list.push_back(c.get());
+	uint32_t magic = 0x3153444cu, count = (uint32_t)list.size();
+	fwrite(&magic, 4, 1, f);
+	fwrite(&count, 4, 1, f);
+	for(Car *c : list){
+		int model = c->vehicle->GetModelIndex();
+		float pos[3] = { c->vehicle->GetPosition().x, c->vehicle->GetPosition().y, c->vehicle->GetPosition().z };
+		uint32_t n = (uint32_t)c->st->nodes.size();
+		float sc[24] = {};
+		sc[0] = c->coolant; sc[1] = c->coolantLeak; sc[2] = c->overheat; sc[3] = c->fuelLeak;
+		for(int w = 0; w < 4; w++){ sc[4 + w] = c->tyrePressure[w]; sc[8 + w] = c->wheelJam[w]; }
+		sc[12] = c->jamArmed ? 1.f : 0.f;
+		uint32_t glass = c->glassCracked ? 1u : 0u;
+		fwrite(&model, 4, 1, f); fwrite(pos, 4, 3, f); fwrite(&n, 4, 1, f); fwrite(sc, 4, 24, f);
+		fwrite(&c->torn, 4, 1, f); fwrite(&glass, 4, 1, f);
+		for(uint32_t i = 0; i < n; i++){
+			Vec d = c->st->pos[i] - c->st->nodes[i].rest;
+			float xyz[3] = { d.x, d.y, d.z };
+			fwrite(xyz, 4, 3, f);
+		}
+	}
+	fclose(f);
+	char b[80];
+	snprintf(b, sizeof(b), "Saved crash damage of %u cars (slot %d).", count, slot);
+	logLine(b);
+}
+
+void
+LocalDent::LoadState(int slot)
+{
+	savedCars.clear();
+	if(!enabled) return;
+	FILE *f = fopen(slotFile(slot).c_str(), "rb");
+	if(!f) return;
+	uint32_t magic = 0, count = 0;
+	if(fread(&magic, 4, 1, f) != 1 || magic != 0x3153444cu || fread(&count, 4, 1, f) != 1 || count > 4096){ fclose(f); return; }
+	for(uint32_t k = 0; k < count; k++){
+		SavedCar sc;
+		uint32_t n = 0, glass = 0;
+		if(fread(&sc.model, 4, 1, f) != 1 || fread(sc.pos, 4, 3, f) != 3 || fread(&n, 4, 1, f) != 1 || n > 4000 ||
+		   fread(sc.scalars, 4, 24, f) != 24 || fread(&sc.torn, 4, 1, f) != 1 || fread(&glass, 4, 1, f) != 1) break;
+		sc.glass = glass != 0;
+		sc.disp.resize(n * 3);
+		if(n && fread(sc.disp.data(), 4, n * 3, f) != n * 3) break;
+		savedCars.push_back(std::move(sc));
+	}
+	fclose(f);
+	savedExpire = CTimer::GetTimeInMilliseconds() + 120000;
+	char b[80];
+	snprintf(b, sizeof(b), "Loaded crash damage of %u cars (slot %d).", (unsigned)savedCars.size(), slot);
+	logLine(b);
+}
+
+float
+LocalDent::SteerLockFactor(CVehicle *v)
+{
+	Car *c = carOf(v);
+	if(!c) return 1.0f;
+	float front = std::max(hubMag(*c, 0), hubMag(*c, 1));
+	return 1.0f - std::min(.6f, front * cfg.steerLockLoss);
+}
+
+float
+LocalDent::SteerWobble(CVehicle *v)
+{
+	Car *c = carOf(v);
+	if(!c || cfg.steerWobble <= 0.f) return 0.0f;
+	float front = std::max(hubMag(*c, 0), hubMag(*c, 1));
+	if(front < .03f) return 0.0f;
+	float speed = std::min(1.0f, std::sqrt(v->m_vecMoveSpeed.MagnitudeSqr()) / .4f);	// full wobble above ~70 km/h
+	float amp = std::min(.12f, front * cfg.steerWobble) * speed;
+	float t = CTimer::GetTimeInMilliseconds() * (0.012f + 0.03f * speed);
+	return amp * std::sin(t);
+}
+
+bool
+LocalDent::KeepDeadDrivers(void)
+{
+	return enabled && cfg.deadDrivers;
+}
+
+void
+LocalDent::EjectDeadOccupants(CVehicle *v)
+{
+	if(!enabled || !cfg.deadDrivers || !v) return;
+	auto eject = [&](CPed *p, float side){
+		if(!p || !p->bInVehicle || p->m_pMyVehicle != v || !p->DyingOrDead()) return;
+		if(v->pDriver == p) v->RemoveDriver(); else v->RemovePassenger(p);
+		if(v->IsCar()) ((CAutomobile*)v)->m_nCarHornTimer = 0;
+		p->bInVehicle = false;
+		p->m_pMyVehicle = nullptr;
+		p->m_pVehicleAnim = nullptr;
+		CVector pos = v->GetPosition() + v->GetRight() * (side * 1.8f);
+		CPedPlacement::FindZCoorForPed(&pos);
+		p->SetPosition(pos);
+		p->m_vecMoveSpeed = CVector(0.0f, 0.0f, 0.0f);
+		p->SetHeading(v->GetForward().Heading());
+		// lie on the ground where they were dragged to
+		p->SetPedState(PED_NONE);
+		p->SetDie(ANIM_STD_HIT_FLOOR, 1000.0f, 0.5f);
+		if(cfg.logHits) logLine("DeadOccupant: pulled out of the car.");
+	};
+	CPed *driver = v->pDriver;
+	eject(driver, -1.0f);
+	for(int i = 0; i < 8; i++){
+		CPed *p = v->pPassengers[i];
+		if(!p) continue;
+		eject(p, (i == 1 ? -1.0f : 1.0f));	// front-right and rear-right seats open on the right, rear-left on the left
+	}
+}
+
+// A dead occupant slumps forward over the wheel (the caller leans the torso and head by this many degrees).
+bool
+LocalDent::SlumpDegrees(CPed *ped, float &degrees)
+{
+	if(!enabled || !cfg.deadDrivers || !ped || !ped->bInVehicle || !ped->DyingOrDead()) return false;
+	static std::map<CPed*, uint32_t> seen;
+	uint32_t frame = CTimer::GetFrameCounter();
+	auto it = seen.find(ped);
+	if(it != seen.end() && it->second == frame) return false;	// once per frame (PreRender can run on a paused frame)
+	seen[ped] = frame;
+	if(seen.size() > 64) seen.clear();
+	degrees = cfg.slumpDegrees;
+	return true;
+}
+
+CVector
+LocalDent::DummyOffset(CVehicle *v, int dummy, bool right)
+{
+	if(!enabled || !context) return CVector(0.0f, 0.0f, 0.0f);
+	for(auto &c : context->cars){
+		if(c->vehicle != v || !c->dInit) continue;
+		int k = dummy == DUMMY_HEAD ? (right ? 0 : 1) : dummy == DUMMY_TAIL ? (right ? 2 : 3) : 4;
+		Vec d = c->dCur[k] - c->dRest[k];
+		if(c->st && dent::length(c->dRest[k]) > 1e-4f)
+			d = structural::displacement(*c->st, structural::skinFor(*c->st, c->dRest[k]));
+		if(!dent::finite(d)) break;
+		return CVector(d.x, d.y, d.z);
+	}
+	return CVector(0.0f, 0.0f, 0.0f);
+}
+
+void
+LocalDent::OnCollisionAlt(CPhysical *a, CEntity *other, const CColPoint &point, float impulse, float normalBefore, float normalAfter)
+{
+	if(!enabled) return;
+	auto body = collisionBody(a, point);
+	auto energy = dent::collisionEnergy(body, { 1.0f, 0.0f, 0.0f }, normalBefore, normalAfter, impulse, 0.0f);
+	if(a && a->IsVehicle()) capture((CVehicle*)a, point, energy.speedA * body.mass, false,
+		impulse, 0, Max(0.0f, -normalBefore) * 50.0f, energy.available * 2500.0f, energy.absorbedA * 2500.0f, entityWidth(other));
+}
