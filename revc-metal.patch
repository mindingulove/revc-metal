+// Continuous, low-frequency grime in car coordinates: no screen-space grain or animated noise.
+float grimeHash(vec2 p)
+{
+	ivec2 i=ivec2(p);
+	uint h=uint(i.x)*0x9E3779B9u ^ uint(i.y)*0x85EBCA6Bu;
+	h^=h>>16u;h*=0x7FEB352Du;h^=h>>15u;h*=0x846CA68Bu;h^=h>>16u;
+	return float(h&65535u)/65535.0;
+}
+float grimeNoise(vec2 p)
+{
+	vec2 i=floor(p),f=fract(p);f=f*f*(3.0-2.0*f);
+	return mix(mix(grimeHash(i),grimeHash(i+vec2(1,0)),f.x),mix(grimeHash(i+vec2(0,1)),grimeHash(i+vec2(1,1)),f.x),f.y);
+}
+float dirtCoverage()
+{
+	if(u_dirtProps.x<=0.001) return 0.0;
+	float h=(v_carPosition.z-u_dirtProps.z)/max(u_dirtProps.w,0.5);
+	vec2 p=v_carPosition.xy;
+	float patches=grimeNoise(p*3.0+u_dirtProps.y);
+	float streaks=grimeNoise(vec2(p.y*11.0,v_carPosition.z*1.5)+u_dirtProps.y);
+	float wheelDistance=min(abs(p.y-u_dirtAxles.x),abs(p.y-u_dirtAxles.y));
+	float splash=(1.0-smoothstep(0.25,0.85,wheelDistance))*(1.0-smoothstep(0.2,0.65,h));
+	float lower=1.0-smoothstep(0.12,0.80,h);
+	return clamp(u_dirtProps.x*(0.10+lower*(0.50+0.35*patches)+splash*0.25+streaks*0.08),0.0,0.95);
+}
 
