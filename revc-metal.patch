--- /dev/null
+++ b/plugins/hello_plugin/hello.cpp
@@ -0,0 +1,30 @@
+// Minimal example plugin: logs each lifecycle event. Copy to <game>/scripts/hello.asi
+#include "extras/plugins/PluginAPI.h"
+
+static const RegtaPluginAPI *g_api;
+static int g_frames;
+
+static void OnEvent(void *user)
+{
+	const char *name = (const char *)user;
+	if(g_api)
+		g_api->log("event: %s", name);
+}
+
+static void OnProcess(void *)
+{
+	if(++g_frames == 1)
+		g_api->log("event: process (first frame)");
+}
+
+extern "C" REGTA_PLUGIN_EXPORT void RegtaPluginInit(const RegtaPluginAPI *api)
+{
+	g_api = api;
+	api->log("hello plugin loaded (api v%u)", api->version);
+	api->registerEvent(REGTA_EVENT_INIT_RW, OnEvent, (void*)"init_rw");
+	api->registerEvent(REGTA_EVENT_INIT_GAME, OnEvent, (void*)"init_game");
+	api->registerEvent(REGTA_EVENT_INIT_SCRIPTS, OnEvent, (void*)"init_scripts");
+	api->registerEvent(REGTA_EVENT_SHUTDOWN_GAME, OnEvent, (void*)"shutdown_game");
+	api->registerEvent(REGTA_EVENT_SHUTDOWN_RW, OnEvent, (void*)"shutdown_rw");
+	api->registerEvent(REGTA_EVENT_PROCESS, OnProcess, nullptr);
+}
