+#pragma once
+
+// Optional converted-car IDE suffix. Each instance gets its own donor copy.
+// Positive rideHeight raises the chassis relative to the authored wheel centres.
+struct ConvertedSuspension {
+    int enabled;
+    float rideHeight, stiffness, damping, travel;
+    bool Valid() const {
+        return (enabled == 0 || enabled == 1) && rideHeight >= -0.3f && rideHeight <= 0.3f &&
+            stiffness >= 0.25f && stiffness <= 4.0f && damping >= 0.25f && damping <= 4.0f &&
+            travel >= 0.25f && travel <= 2.0f;
+    }
+    template<class Handling> void Apply(Handling &h) const {
+        if(!enabled || !Valid()) return;
+        h.fSuspensionForceLevel *= stiffness;
+        h.fSuspensionDampingLevel *= damping;
+        const float span = (h.fSuspensionUpperLimit - h.fSuspensionLowerLimit) * travel;
+        // Match SetupSuspensionLines' static quarter-load spring compression.
+        h.fSuspensionLowerLimit = -span / (4.0f * h.fSuspensionForceLevel) - rideHeight;
+        h.fSuspensionUpperLimit = h.fSuspensionLowerLimit + span;
+    }
+};
