+// Captured stationary Upstate camera matrices: float cofactor inversion made shadow history jump.
+#include "../vendor/librw/src/matrixinvert.h"
+#include <cmath>
+#include <cstdio>
+#include <initializer_list>
+static const float fixtures[][16] = {
+{0.706145644f,-0.695712626f,-1.64097019e-05f,9.70818359e-09f,0.329758167f,0.334687561f,0.234550536f,-4.25537383e-09f,-824.662109f,-759.143127f,-72.5692673f,-0.555472791f,825.204407f,759.671387f,71.6947556f,0.555626571f},
+{0.706140757f,-0.695709884f,4.58304339e-06f,7.22094118e-09f,0.329781562f,0.334713697f,0.234552652f,2.04933737e-09f,-824.684875f,-759.163879f,-72.5712814f,-0.55548805f,825.226135f,759.692444f,71.6964798f,0.55564189f},
+{0.706168532f,-0.69575572f,2.75613547e-06f,1.44222656e-09f,0.329789788f,0.334703535f,0.234561339f,8.57941551e-10f,-824.694763f,-759.172913f,-72.5721283f,-0.555494606f,825.237305f,759.701294f,71.6977844f,0.555648446f}
+};
+static void multiply(float *out,const float *m,const float *v){
+ for(int row=0;row<4;row++)out[row]=m[row]*v[0]+m[4+row]*v[1]+m[8+row]*v[2]+m[12+row]*v[3];
+}
+int main(){
+ float maximum=0;
+ for(const auto &inverse:fixtures){
+  float vp[16]; if(!rw::matrixutil::invert4(vp,inverse))return 1;
+  float error=0;
+  for(int y=0;y<16;y++)for(int x=0;x<16;x++)for(float depth:{.2f,.7f,.9f,.98f}){
+   float clip[]={-.75f+x*.1f,-.75f+y*.1f,depth,1},world[4],back[4];
+   multiply(world,inverse,clip);for(int c=0;c<3;c++)world[c]/=world[3];world[3]=1;
+   multiply(back,vp,world);
+   float dx=(back[0]/back[3]-clip[0])*563/2,dy=(back[1]/back[3]-clip[1])*298/2;
+   error=fmaxf(error,sqrtf(dx*dx+dy*dy));
+  }
+  printf("stationary captured camera: maximum shadow reprojection error %.5f pixels\n",error);
+  maximum=fmaxf(maximum,error);
+ }
+ float singular[16]={},out[16];if(rw::matrixutil::invert4(out,singular))return 2;
+ return maximum<.1f?0:3;
+}
