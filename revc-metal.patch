+# Example plugins, built as ".asi" modules (shared libraries) for the reGTA plugin loader.
+# Plugins may reference engine symbols exported by the executable, so unresolved
+# symbols are allowed at link time on Apple.
+function(regta_add_plugin name)
+    add_library(${name} MODULE ${ARGN})
+    set_target_properties(${name} PROPERTIES
+        PREFIX ""
+        SUFFIX ".asi"
+        LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/plugins")
+    target_include_directories(${name} PRIVATE "${PROJECT_SOURCE_DIR}/src")
+    if(APPLE)
+        target_link_options(${name} PRIVATE -undefined dynamic_lookup)
+    endif()
+endfunction()
+
+regta_add_plugin(hello hello_plugin/hello.cpp)
