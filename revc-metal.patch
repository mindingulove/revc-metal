+ if(!mtlglInit(nullptr,8,8)){puts("SKIP: no Metal device");fflush(stdout);std::_Exit(77);}
+#define LOAD(n) auto n##_=reinterpret_cast<decltype(glad_##n)>(mtlglGetProcAddress(#n));assert(n##_)
+ LOAD(glGenTextures);LOAD(glBindTexture);LOAD(glTexImage2D);LOAD(glTexParameteri);LOAD(glTexSubImage2D);LOAD(glGetTexImage);LOAD(glDeleteTextures);
+ for(auto size:{std::pair<int,int>{128,64},{1,32},{7,3}}){
+  int levels=1;for(int n=std::max(size.first,size.second);n>1;n/=2)levels++;
+  GLuint texid;glGenTextures_(1,&texid);glBindTexture_(GL_TEXTURE_2D,texid);
+  glTexImage2D_(GL_TEXTURE_2D,0,GL_RGBA8,size.first,size.second,0,GL_RGBA,GL_UNSIGNED_BYTE,nullptr);
+  glTexParameteri_(GL_TEXTURE_2D,GL_TEXTURE_MAX_LEVEL,levels-1);
+  for(int level=0;level<levels;level++){
+   int w=std::max(1,size.first>>level),h=std::max(1,size.second>>level);std::vector<unsigned char> pixels(w*h*4,(unsigned char)(level+31));
+   glTexSubImage2D_(GL_TEXTURE_2D,level,0,0,w,h,GL_RGBA,GL_UNSIGNED_BYTE,pixels.data());
+   auto texture=(__bridge id<MTLTexture>)mtlglTexture(texid);assert(texture && texture.mipmapLevelCount==(NSUInteger)levels);
+   std::vector<unsigned char> read(pixels.size());glGetTexImage_(GL_TEXTURE_2D,level,GL_RGBA,GL_UNSIGNED_BYTE,read.data());assert(read==pixels);
+  }
+  // Reading/defining outside the legal chain must never reach the Metal driver.
+  unsigned char sentinel[4]={17,18,19,20};glGetTexImage_(GL_TEXTURE_2D,levels,GL_RGBA,GL_UNSIGNED_BYTE,sentinel);assert(sentinel[0]==17);
+  glDeleteTextures_(1,&texid);
+ }
+ // A later storage declaration must retain an already uploaded base level.
+ GLuint texid;glGenTextures_(1,&texid);glBindTexture_(GL_TEXTURE_2D,texid);std::vector<unsigned char> base(8*8*4,83);
+ glTexImage2D_(GL_TEXTURE_2D,0,GL_RGBA8,8,8,0,GL_RGBA,GL_UNSIGNED_BYTE,base.data());glTexParameteri_(GL_TEXTURE_2D,GL_TEXTURE_MAX_LEVEL,0);
+ assert(((__bridge id<MTLTexture>)mtlglTexture(texid)).mipmapLevelCount==1);
+ glTexParameteri_(GL_TEXTURE_2D,GL_TEXTURE_MAX_LEVEL,3);std::vector<unsigned char> tail(4,121);
+ glTexImage2D_(GL_TEXTURE_2D,3,GL_RGBA8,1,1,0,GL_RGBA,GL_UNSIGNED_BYTE,tail.data());
+ std::vector<unsigned char> read(base.size());glGetTexImage_(GL_TEXTURE_2D,0,GL_RGBA,GL_UNSIGNED_BYTE,read.data());assert(read==base);
+ read.resize(4);glGetTexImage_(GL_TEXTURE_2D,3,GL_RGBA,GL_UNSIGNED_BYTE,read.data());assert(read==tail);
+ puts("PASS native Metal: complete mip allocation, every-level exact pixel readback, rectangular/1D/NPOT textures, late storage growth preserves base, invalid-level read rejected. No window/game launched.");mtlglShutdown();fflush(stdout);std::_Exit(0);
+}}
