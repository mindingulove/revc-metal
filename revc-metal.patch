+// ---- script loading -----------------------------------------------------------------------------
+
+CRunningScript *
+StartScript(const std::string &pathIn)
+{
+	std::string path = pathIn;
+	path = Slashes(path.c_str());
+	FILE *f = fopen(path.c_str(), "rb");
+	if(!f){
+		Log("script \"%s\" was not found", path.c_str());
+		return nullptr;
+	}
+	fseek(f, 0, SEEK_END);
+	long size = ftell(f);
+	fseek(f, 0, SEEK_SET);
+	if(size <= 0 || size > SIZE_CLEO_SPACE){
+		fclose(f);
+		Log("script \"%s\" is empty or too large", path.c_str());
+		return nullptr;
+	}
+	uint32_t at = AllocChunk((uint32_t)size + 16);
+	if(!at){
+		fclose(f);
+		Log("no script memory left for \"%s\"", path.c_str());
+		return nullptr;
+	}
+	size_t got = fread(&Space()[at], 1, size, f);
+	fclose(f);
+	if(got != (size_t)size){
+		FreeChunk(at);
+		Log("script \"%s\" could not be read", path.c_str());
+		return nullptr;
+	}
+	if(!CTheScripts::pIdleScripts){
+		FreeChunk(at);
+		Log("no free script thread for \"%s\"", path.c_str());
+		return nullptr;
+	}
+	CRunningScript *ns = CTheScripts::StartNewScript(at);
+	ns->m_bIsCustom = true;
+	ns->m_nBaseIp = at;
+	size_t slash = path.find_last_of("/\\");
+	std::string base = slash == std::string::npos ? path : path.substr(slash + 1);
+	strncpy(ns->m_abScriptName, base.c_str(), 7);
+	ns->m_abScriptName[7] = 0;
+	Slot &sl = SlotOf(ns);
+	sl = Slot();
+	sl.used = true;
+	sl.script = ns;
+	sl.base = at;
+	sl.size = (uint32_t)size;
+	sl.path = path;
+	memset(sl.arr, 0, sizeof(sl.arr));
+	Log("started custom script \"%s\" (%ld bytes)", path.c_str(), size);
+	return ns;
+}
+
+void
+LoadFolder(const char *dir)
+{
+	DIR *d = opendir(dir);
+	if(!d) return;
+	std::vector<std::string> names;
+	while(struct dirent *e = readdir(d)){
+		size_t n = strlen(e->d_name);
+		if(n < 4 || strcasecmp(e->d_name + n - 3, ".cs") != 0 || e->d_name[0] == '.') continue;
+		names.push_back(e->d_name);
+	}
+	closedir(d);
+	std::sort(names.begin(), names.end());
+	for(auto &n : names) StartScript(std::string(dir) + "/" + n);
+}
+
+} // namespace
+
+namespace Cleo {
+
+void
+Init(void)
+{
+	if(!enabled) return;
+	if(!gUp){
+		RegisterAll();
+		gUp = true;
+	}
+	for(Slot &s : gSlots) s = Slot();
+	gChunks.clear();
+	gChunks.push_back({ (uint32_t)CLEO_SPACE_START, (uint32_t)SIZE_CLEO_SPACE, true });
+	memset(gShared, 0, sizeof(gShared));
+	gHeap.clear();
+	gHeapNext = VA_HEAP;
+	for(FILE *f : gFiles) if(f) fclose(f);
+	gFiles.clear();
+	for(DIR *d : gFinds) if(d) closedir(d);
+	gFinds.clear();
+	gFindPatterns.clear();
+	LoadFolder("CLEO");
+	LoadFolder("cleo");
+	LoadFolder("scripts");
+}
+
+void
+Update(void)
+{
+	if(!enabled) return;
+	// free what scripts that ended on their own (004E) were holding
+	for(int i = 0; i < MAX_NUM_SCRIPTS; i++){
+		if(!gSlots[i].used) continue;
+		bool active = false;
+		for(CRunningScript *a = CTheScripts::pActiveScripts; a; a = a->GetNext())
+			if(a == gSlots[i].script){ active = true; break; }
+		if(!active){
+			FreeChunk(gSlots[i].base);
+			gSlots[i].script->m_bIsCustom = false;
+			gSlots[i] = Slot();
+		}
+	}
+}
+
+bool
+ProcessOpcode(CRunningScript *script, int32_t id, int8_t &result)
+{
+	if(!enabled || !script->m_bIsCustom || id < 0 || id >= 0x8000 || !gOps[id]) return false;
+	result = gOps[id](script);
+	return true;
+}
+
+}
