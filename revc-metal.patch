+  [tex[5] replaceRegion:region mipmapLevel:0 withBytes:positions.data() bytesPerRow:width*16];
+  [tex[3] replaceRegion:region mipmapLevel:0 withBytes:hist.data() bytesPerRow:width*16];
+  auto dummy=[S.device newBufferWithLength:1024 options:MTLResourceStorageModeShared];
+  float lights[32*8]={};for(int i=0;i<32;i++){lights[i*8]=i<4?i*.1f:100+i;lights[i*8+2]=-1;lights[i*8+3]=i<4?3:5;lights[i*8+4]=.3f;lights[i*8+5]=.6f;lights[i*8+6]=.9f;lights[i*8+7]=1;}
+  TestUniforms u={};memcpy(u.invVP,identity,64);u.invVP[10]=-1;memcpy(u.prevVP,identity,64);u.width=width;u.height=height;u.toSun[2]=-1;u.sunVisibility=1;u.shadowDistance=70;u.pad1=u.pad2=1;u.pad5=32;u.histValid=1;
