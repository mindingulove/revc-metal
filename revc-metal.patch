+				vec2 nm = mix(ndc0, n1, m);
+				float zm = 1.0/mix(k0, k1, m);
+				if(zm - ssrEyeZ(textureLod(ssrDepth, ssrToTex(nm), 0.0).r) > 0.0) b = m; else a = m;
+			}
+			vec2 nb = mix(ndc0, n1, b);
+			float zb = 1.0/mix(k0, k1, b);
+			float tw = abs(R.z) > 0.02 ? (zb - P0.z)/R.z : tmax*b;
+			vec2 e = 1.0 - abs(nb);
+			float edge = clamp(min(e.x, e.y)*6.0, 0.0, 1.0);
+			float facing = smoothstep(-0.1, 0.35, R.z);
+			float dist = 1.0 - clamp(tw/80.0, 0.0, 1.0);
+			return vec4(textureLod(ssrColor, ssrToTex(nb), 0.0).rgb, edge*facing*dist);
+		}
+		tPrev = t;
+	}
+	return vec4(0.0);
+}
