+	car.parts+=regtaRTCollectVehicleAtomic(atomic,car.primary,car.secondary,(const void *const*)car.model->m_materials1,(const void *const*)car.model->m_materials2);
+	return atomic;
+}
+
+extern "C" void
+regtaRTCollectVehicles(const float *eye, float distance)
+{
+	CVehiclePool *pool = CPools::GetVehiclePool();
+	if(!pool) return;
+	CVector camera(eye[0], eye[1], eye[2]);
+	float limit = distance*distance;
+	int collected = 0, offscreen = 0, parts = 0;
+	static bool logScene = getenv("REGTA_RT_SCENE_LOG") != nil;
+	for(int i = 0; i < pool->GetSize(); i++){
+		CVehicle *vehicle = pool->GetSlot(i);
+		if(!vehicle || !vehicle->m_rwObject || !vehicle->bIsVisible || vehicle->bRemoveFromWorld) continue;
+		if(RwObjectGetType(vehicle->m_rwObject) != rpCLUMP) continue;
+		if((vehicle->GetPosition()-camera).MagnitudeSqr() > limit) continue;
+		int before = parts;
+		auto pack=[](RwRGBA c){return (unsigned)c.red|((unsigned)c.green<<8)|((unsigned)c.blue<<16)|0xFF000000u;};
+		ReflectionVehicle instance;instance.model=(CVehicleModelInfo*)CModelInfo::GetModelInfo(vehicle->GetModelIndex());
+		instance.primary=pack(CVehicleModelInfo::ms_vehicleColourTable[vehicle->m_currentColour1]);
+		instance.secondary=pack(CVehicleModelInfo::ms_vehicleColourTable[vehicle->m_currentColour2]);
+		RpClumpForAllAtomics(vehicle->GetClump(), CollectReflectionVehicleAtomic, &instance);
+		parts+=instance.parts;
+		if(before == parts) continue;
+		collected++;
+		if(logScene && !vehicle->GetIsOnScreen()) offscreen++;
+	}
+	int pedestrians=0,pedParts=0,pedOffscreen=0;
+	auto *peds=CPools::GetPedPool();
+	std::vector<std::pair<float,CPed*>> nearby;
+	if(peds) for(int i=0;i<peds->GetSize();i++){
+		CPed *ped=peds->GetSlot(i);
+		if(!ped || !ped->m_rwObject || !ped->bIsVisible || ped->bRemoveFromWorld) continue;
+		if(RwObjectGetType(ped->m_rwObject)!=rpCLUMP) continue;
+		float d=(ped->GetPosition()-camera).MagnitudeSqr();
+		if(d<Min(distance*distance,625.f)) nearby.push_back({d,ped});
+	}
+	std::sort(nearby.begin(),nearby.end(),[](const std::pair<float,CPed*> &a,const std::pair<float,CPed*> &b){return a.first<b.first;});
+	for(size_t i=0;i<nearby.size() && i<24;i++){
+		CPed *ped=nearby[i].second;bool onScreen=ped->GetIsOnScreen();
+		#ifdef PED_SKIN
+		if(!onScreen && IsClumpSkinned(ped->GetClump())) ped->UpdateRpHAnim();
+#endif
+		ReflectionPed instance;
+		if(ped->bInVehicle && ped->m_pMyVehicle && ped->m_pMyVehicle->m_rwObject && RwObjectGetType(ped->m_pMyVehicle->m_rwObject)==rpCLUMP) instance.vehicle=ped->m_pMyVehicle->m_rwObject;
+		RpClumpForAllAtomics(ped->GetClump(),CollectReflectionPedAtomic,&instance);
+		if(instance.parts){pedestrians++;pedParts+=instance.parts;if(!onScreen)pedOffscreen++;}
+	}
+	static unsigned frames;
+	if(logScene && ++frames%180 == 0)
+		printf("[MetalRT scene] nearby vehicles: %d, outside camera view: %d, mesh parts: %d; peds: %d (%d off-camera), ped parts: %d\n",collected,offscreen,parts,pedestrians,pedOffscreen,pedParts);
