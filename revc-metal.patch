+// Upstate Liberty: its text lives in CLEO text files ("KEY text" per line) next to the
+// game. Merge every *.fxt in the directory into the loaded GXT table; later entries win.
+void
+CText::LoadExtraFxt(const char *dirname)
+{
+	DIR *dir = opendir(dirname);
+	if(dir == nil)
+		return;
+
+	std::vector<CKeyEntry> entries(keyArray.entries, keyArray.entries + keyArray.numEntries);
+	std::vector<wchar> chars(data.chars, data.chars + data.numChars);
+
+	struct dirent *de;
+	while((de = readdir(dir)) != nil){
+		size_t nlen = strlen(de->d_name);
+		if(nlen < 4 || strcasecmp(de->d_name + nlen - 4, ".fxt") != 0)
+			continue;
+		char path[512];
+		snprintf(path, sizeof(path), "%s/%s", dirname, de->d_name);
+		FILE *f = fopen(path, "rb");
+		if(f == nil)
+			continue;
+
+		char line[1024];
+		while(fgets(line, sizeof(line), f)){
+			size_t len = strlen(line);
+			while(len > 0 && (line[len-1] == '\n' || line[len-1] == '\r'))
+				line[--len] = '\0';
+			if(len == 0 || line[0] == '#' || line[0] == ' ' || line[0] == '\t')
+				continue;
+
+			char *sep = line;
+			while(*sep && *sep != ' ' && *sep != '\t')
+				sep++;
+			if(*sep == '\0' || sep - line > 7)
+				continue;
+			*sep++ = '\0';
+			while(*sep == ' ' || *sep == '\t')
+				sep++;
+
+			CKeyEntry e;
+			memset(&e, 0, sizeof(e));
+			strncpy(e.key, line, 7);
+			e.valueOffset = (uint32)(chars.size() * sizeof(wchar));
+			for(const uint8 *c = (const uint8*)sep; *c; c++)
+				chars.push_back(*c);
+			chars.push_back(0);
+
+			bool replaced = false;
+			for(size_t i = 0; i < entries.size(); i++)
+				if(strcmp(entries[i].key, e.key) == 0){
+					entries[i].valueOffset = e.valueOffset;
+					replaced = true;
+					break;
+				}
+			if(!replaced)
+				entries.push_back(e);
+		}
+		fclose(f);
+	}
+	closedir(dir);
+
+	std::sort(entries.begin(), entries.end(), [](const CKeyEntry &a, const CKeyEntry &b){
+		return strcmp(a.key, b.key) < 0;
+	});
+
+	delete[] keyArray.entries;
+	keyArray.numEntries = (int)entries.size();
+	keyArray.entries = new CKeyEntry[keyArray.numEntries];
+	memcpy(keyArray.entries, entries.data(), keyArray.numEntries * sizeof(CKeyEntry));
+
+	delete[] data.chars;
+	data.numChars = (int)chars.size();
+	data.chars = new wchar[data.numChars];
+	memcpy(data.chars, chars.data(), data.numChars * sizeof(wchar));
+}
+#else
+void CText::LoadExtraFxt(const char *) {}
+#endif
