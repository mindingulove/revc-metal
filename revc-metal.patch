@@ -0,0 +1,65 @@
+#pragma once
+
+#include <string>
+#include "common.h"
+
+class CPhysical;
+class CPed;
+class CEntity;
+class CMatrix;
+class CVehicle;
+struct CColPoint;
+
+// Native reGTA port of LocalDentIII (localised, panel-aware vehicle dents).
+// The deformation maths (*.hpp in this folder) is the mod's own; this layer replaces its
+// Windows/x86 glue (MinHook patches at gta3.exe addresses) with direct calls into reGTA/librw.
+namespace LocalDent {
+	extern bool enabled;
+	// Reads LocalDentIII.ini (next to the .asi, then the game folder) and starts the mod.
+	void Enable(const std::string &asiDir);
+	// Called by CPhysical's collision functions after a successful collision. Impulses are per body.
+	void OnCollisionPair(CPhysical *a, CPhysical *b, const CColPoint &point, float impulseA, float impulseB,
+	                     float normalBefore, float normalAfter);
+	void OnCollisionAlt(CPhysical *a, CEntity *other, const CColPoint &point, float impulse, float normalBefore, float normalAfter);
+
+	// Effect anchors (light glow, exhaust, engine smoke/fire) come from fixed per-model dummy points.
+	// This returns how far a car's dents moved one of them (zero for an undamaged car).
+	enum { DUMMY_HEAD, DUMMY_TAIL, DUMMY_EXHAUST };
+	CVector DummyOffset(CVehicle *v, int dummy, bool right);
+	// Steering angle (radians) the car pulls to because its front axle was bent out of line.
+	float SteerBias(CVehicle *v);
+	// The game's own panel/door/bonnet damage (CAutomobile::VehicleDamage) takes a raw impulse; this scales it so
+	// light bumps do not pop bonnets or knock panels while hard crashes still do.
+	float ScaleStockDamage(CVehicle *v, float impulse);
+	// Engine power left (0..1) after the engine bay was crushed.
+	float PowerFactor(CVehicle *v);
+	// Damaged cars crank, fail to start and stall; healthy cars retain instant ignition.
+	bool StartEngine(CVehicle *v);
+	void ProcessEngine(CVehicle *v);
+	// True when a car lying on its roof must not burn and explode by itself (the game drains its health).
+	bool KeepFlippedCars(void);
+	// Crumpled shapes and extra damage of cars are kept in userfiles/LocalDent_slotN.dat next to the saved game.
+	void SaveState(int slot);
+	void LoadState(int slot);
+	// Steering damage: smaller steering angle with bent front hubs, and a wobble that grows with speed.
+	float SteerLockFactor(CVehicle *v);
+	// Drive to a wheel whose axle is bent (1 = full, 0 = cut) and the centre of mass shift from lost parts.
+	float WheelDrive(CVehicle *v, int wheel);
+	CVector CentreOfMassShift(CVehicle *v);
+	float SteerWobble(CVehicle *v);
+	// A dead AI driver stays in the car (stock removes them at once), slumped on the wheel.
+	bool KeepDeadDrivers(void);
+	// How far (degrees, 0 = not now) a dead occupant leans forward this frame; true once per frame per ped.
+	bool SlumpDegrees(CPed *ped, float &degrees);
+	// Someone tries to get in: dead occupants are pulled out of their seats and left lying beside the car.
+	void EjectDeadOccupants(CVehicle *v);
+	// Handling lost to a bent frame: brakes, grip, and per-wheel suspension (1.0 = untouched).
+	float BrakeFactor(CVehicle *v);
+	float TractionFactor(CVehicle *v);
+	float SpringFactor(CVehicle *v, int wheel);
+	float DampFactor(CVehicle *v, int wheel);
+	// A wheel the bodywork has been pushed into rubs and binds: its brake force rises toward a locked wheel.
+	float WheelBrake(CVehicle *v, int wheel, float brake);
+	// Bent hubs tilt the visible wheel (camber) and turn it (toe); edits the wheel's matrix in place.
+	void WheelTilt(CVehicle *v, int wheel, CMatrix &mat);
+}
diff --git a/src/extras/localdent/PanelBehavior.hpp b/src/extras/localdent/PanelBehavior.hpp
new file mode 100644
index 00000000..8de10455
--- /dev/null
+++ b/src/extras/localdent/PanelBehavior.hpp
@@ -0,0 +1,18 @@
+#pragma once
+#include "PanelMath.hpp"
+namespace dent {
+inline float variedCrease(uint32_t seed,uint32_t part,float center,float spread) {
+    uint32_t x=seed^(part*0x9e3779b9u);x^=x>>16;x*=0x7feb352du;x^=x>>15;x*=0x846ca68bu;x^=x>>16;
+    float sample=float(x&0xFFFFFFu)/16777215.f;
+    return std::clamp(center+(sample*2.f-1.f)*spread,.35f,.65f);
+}
+// The fold supplies shortening relative to its hinge. Translate that hinge with
+// the body dent field instead of applying full axial shortening twice.
+inline Vec panelBodyStep(Vec rest,const PanelShape& shape,Vec point,Vec direction,
+        float depth,float radius,float oldDepth,float oldRadius,float limit,float power) {
+    Vec anchor{rest.x,shape.sign*shape.hinge,rest.z};
+    Vec local=displaceImpact(rest,rest,point,direction,depth,radius,oldDepth,oldRadius,limit,power)-rest;
+    Vec hinge=displaceImpact(anchor,anchor,point,direction,depth,radius,oldDepth,oldRadius,limit,power)-anchor;
+    local.y=hinge.y;return local;
+}
+}
diff --git a/src/extras/localdent/PanelFaces.hpp b/src/extras/localdent/PanelFaces.hpp
new file mode 100644
index 00000000..d26e3661
--- /dev/null
+++ b/src/extras/localdent/PanelFaces.hpp
@@ -0,0 +1,12 @@
+#pragma once
+#include <array>
+#include <cstdint>
+namespace dent {
+// Two windings reference one vertex triplet: identical UVs, color and shading
+// normals on both sides. Never add a second, inverted-normal vertex buffer.
+inline std::array<uint16_t,3> panelFaceIndices(size_t triangle,bool back) {
+    auto a=static_cast<uint16_t>(triangle*3);
+    return back?std::array<uint16_t,3>{a,static_cast<uint16_t>(a+2),static_cast<uint16_t>(a+1)}:
+                std::array<uint16_t,3>{a,static_cast<uint16_t>(a+1),static_cast<uint16_t>(a+2)};
+}
+}
diff --git a/src/extras/localdent/PanelGeometry.hpp b/src/extras/localdent/PanelGeometry.hpp
new file mode 100644
index 00000000..6bbb3741
--- /dev/null
+++ b/src/extras/localdent/PanelGeometry.hpp
@@ -0,0 +1,11 @@
+#pragma once
+#include "PanelMath.hpp"
+namespace dent {
+inline bool supportedPanelBounds(float length,float height,bool damaged) {
+    // III's damaged lids include already crushed/vertical apron vertices.
+    // Kuruma: 0.6325 long, 0.5082 high; Sentinel: 0.4415 / 0.3472.
+    // Keep the original horizontal-panel guard for intact variants.
+    return std::isfinite(length)&&std::isfinite(height)&&length>=.25f&&length<=3.5f&&
+           height>=0&&height<=length*(damaged?1.1f:.75f);
+}
+}
diff --git a/src/extras/localdent/PanelLattice.hpp b/src/extras/localdent/PanelLattice.hpp
new file mode 100644
index 00000000..17ba2a79
--- /dev/null
+++ b/src/extras/localdent/PanelLattice.hpp
@@ -0,0 +1,82 @@
+#pragma once
+#include "PanelSheet.hpp"
+namespace dent {
+struct PanelLattice {
+    std::vector<float> xs,ys;
+    std::vector<SheetPoint> points;
+    std::vector<Vec> previous;
+    void init(const SpanFold& span,const PanelShape& shape) {
+        for(unsigned i=0;i<=span.segments;++i)xs.push_back(span.minX+(span.maxX-span.minX)*i/span.segments);
+        for(int i=0;i<=6;++i)ys.push_back(shape.sign*(shape.hinge+shape.length*i/6));
+        ys.push_back(shape.sign*(shape.hinge+shape.length*shape.crease));
+        std::sort(ys.begin(),ys.end());
+        ys.erase(std::unique(ys.begin(),ys.end(),[](float a,float b){return std::fabs(a-b)<1e-6f;}),ys.end());
+        for(float y:ys)for(float x:xs) {
+            SheetPoint p;p.init({x,y,span.z},span.z,shape,shape.sign*y>shape.hinge+shape.length*shape.crease?1:0);
+            points.push_back(p);previous.push_back(p.rest[0]);
+        }
+    }
+    bool ordered(const std::vector<Vec>& positions) const {
+        auto determinant=[](Vec a,Vec b,Vec c){return (b.x-a.x)*(c.y-a.y)-(b.y-a.y)*(c.x-a.x);};
+        for(size_t j=0;j+1<ys.size();++j)for(size_t i=0;i+1<xs.size();++i){
+            size_t a=j*xs.size()+i,b=a+1,c=a+xs.size(),d=c+1;
+            float floor=.1f*(xs[i+1]-xs[i])*(ys[j+1]-ys[j]);
+            if(!finite(positions[a])||!finite(positions[b])||!finite(positions[c])||!finite(positions[d])||
+               determinant(positions[a],positions[b],positions[d])<floor||determinant(positions[a],positions[d],positions[c])<floor)return false;
+        }return true;
+    }
+    void keepOrdered(std::vector<Vec>& positions) {
+        if(!ordered(positions)) {
+            auto target=positions;float lo=0,hi=1;
+            for(int k=0;k<16;++k){float t=(lo+hi)*.5f;
+                for(size_t i=0;i<positions.size();++i)positions[i]=previous[i]+(target[i]-previous[i])*t;
+                if(ordered(positions))lo=t;else hi=t;
+            }
+            for(size_t i=0;i<positions.size();++i)positions[i]=previous[i]+(target[i]-previous[i])*lo;
+            if(!ordered(positions))positions=previous;
+        }
+        previous=positions;
+    }
+    size_t cell(const std::vector<float>& axis,float value) const {
+        return std::min(size_t(std::max(ptrdiff_t(0),std::upper_bound(axis.begin(),axis.end(),value)-axis.begin()-1)),axis.size()-2);
+    }
+    struct Sample {std::array<size_t,3> index;std::array<float,3> weight;};
+    Sample sample(Vec p) const {
+        auto i=cell(xs,p.x),j=cell(ys,p.y);float u=std::clamp((p.x-xs[i])/(xs[i+1]-xs[i]),0.f,1.f);
+        float v=std::clamp((p.y-ys[j])/(ys[j+1]-ys[j]),0.f,1.f);size_t a=j*xs.size()+i,b=a+1,c=a+xs.size(),d=c+1;
+        if(u>=v)return {{a,b,d},{1-u,u-v,v}};
+        return {{a,d,c},{1-v,u,v-u}};
+    }
+    Vec displacement(Vec p,const std::vector<Vec>& moved) const {
+        auto s=sample(p);Vec delta{};
+        for(int k=0;k<3;++k)delta=delta+(moved[s.index[k]]-points[s.index[k]].rest[0])*s.weight[k];
+        return delta;
+    }
+};
+inline std::vector<PanelTriangle> splitLatticeDiagonal(const PanelTriangle& t,float x,float y,float dx,float dy) {
+    auto distance=[&](Vec p){return (p.x-x)/dx-(p.y-y)/dy;};
+    bool below=false,above=false;for(auto& v:t.v){below|=distance(v.position)<0;above|=distance(v.position)>0;}
+    if(!below||!above)return {t};
+    std::vector<PanelTriangle> out;
+    for(bool upper:{false,true}) {
+        std::vector<PanelVertex> poly;
+        for(int i=0;i<3;++i) {
+            auto a=t.v[i],b=t.v[(i+1)%3];float da=distance(a.position),db=distance(b.position);
+            bool ia=upper?da>=0:da<=0,ib=upper?db>=0:db<=0;
+            if(ia)poly.push_back(a);
+            if(ia!=ib){auto v=interpolate(a,b,da/(da-db));v.side=a.side;poly.push_back(v);}
+        }
+        for(size_t i=1;i+1<poly.size();++i){PanelTriangle p{{poly[0],poly[i],poly[i+1]},t.material};if(areaSquared(p)>1e-12f)out.push_back(p);}
+    }return out;
+}
+inline std::vector<PanelTriangle> splitPanelLattice(const PanelTriangle& t,const PanelShape& shape,const SpanFold& span,const PanelLattice& grid) {
+    auto parts=splitPanelSurface(t,shape,span.minX,span.maxX,span.segments);
+    std::vector<PanelTriangle> out;
+    for(auto& part:parts) {
+        Vec mid=(part.v[0].position+part.v[1].position+part.v[2].position)*(1.f/3);
+        auto i=grid.cell(grid.xs,mid.x),j=grid.cell(grid.ys,mid.y);
+        auto more=splitLatticeDiagonal(part,grid.xs[i],grid.ys[j],grid.xs[i+1]-grid.xs[i],grid.ys[j+1]-grid.ys[j]);
+        out.insert(out.end(),more.begin(),more.end());
+    }return out;
+}
+}
diff --git a/src/extras/localdent/PanelLighting.hpp b/src/extras/localdent/PanelLighting.hpp
new file mode 100644
index 00000000..cafad855
--- /dev/null
+++ b/src/extras/localdent/PanelLighting.hpp
@@ -0,0 +1,40 @@
+#pragma once
+#include "PanelLattice.hpp"
+namespace dent {
+// Gradients belong to the shared deformation field, never to newly cut render
+// triangles. Separate crease sides and the input normal preserve authored edges.
+struct PanelLighting {
+    struct Gradient {Vec x{},y{};float weight{};};
+    std::array<std::vector<Gradient>,2> nodes;
+    PanelLighting(const PanelLattice& grid,const std::vector<Vec>& moved,const PanelShape& shape) {
+        for(auto& n:nodes)n.resize(grid.points.size());
+        auto add=[&](size_t a,size_t b,size_t c){
+            Vec p=grid.points[a].rest[0],u=grid.points[b].rest[0]-p,v=grid.points[c].rest[0]-p;
+            float det=u.x*v.y-u.y*v.x;if(std::fabs(det)<1e-12f)return;
+            Vec du=moved[b]-moved[a],dv=moved[c]-moved[a];
+            Vec dx=(du*v.y-dv*u.y)*(1.f/det),dy=(dv*u.x-du*v.x)*(1.f/det);
+            float mid=(p.y+grid.points[b].rest[0].y+grid.points[c].rest[0].y)/3;
+            int side=shape.sign*mid>shape.hinge+shape.length*shape.crease?1:0;
+            float area=std::fabs(det);
+            for(size_t i:{a,b,c}){auto& n=nodes[side][i];n.x=n.x+dx*area;n.y=n.y+dy*area;n.weight+=area;}
+        };
+        for(size_t j=0;j+1<grid.ys.size();++j)for(size_t i=0;i+1<grid.xs.size();++i){
+            size_t a=j*grid.xs.size()+i,b=a+1,c=a+grid.xs.size(),d=c+1;add(a,b,d);add(a,d,c);
+        }
+        for(auto& side:nodes)for(auto& n:side)if(n.weight>0){n.x=n.x*(1.f/n.weight);n.y=n.y*(1.f/n.weight);}
+    }
+    Vec normal(const PanelLattice& grid,Vec rest,Vec original,int side) const {
+        auto sample=grid.sample(rest);Vec x{},y{};float weight=0;
+        for(int k=0;k<3;++k){auto& n=nodes[side?1:0][sample.index[k]];
+            if(n.weight<=0)continue;float w=sample.weight[k];x=x+n.x*w;y=y+n.y*w;weight+=w;}
+        if(weight<.999f)return original;
+        // Inverse transpose of [x y (0,0,1)], including body displacement,
+        // accumulated impacts, displacement cap and cell-order correction.
+        float det=x.x*y.y-y.x*x.y;
+        if(!std::isfinite(det)||det<1e-6f)return original;
+        Vec out{(y.y*original.x-x.y*original.y+(x.y*y.z-y.y*x.z)*original.z)/det,
+                (-y.x*original.x+x.x*original.y+(y.x*x.z-x.x*y.z)*original.z)/det,original.z};
+        return finite(out)&&length(out)>1e-8f?unit(out):original;
+    }
+};
+}
diff --git a/src/extras/localdent/PanelMath.hpp b/src/extras/localdent/PanelMath.hpp
new file mode 100644
index 00000000..3d7d34d6
--- /dev/null
+++ b/src/extras/localdent/PanelMath.hpp
@@ -0,0 +1,105 @@
+#pragma once
+#include "ImpactMath.hpp"
+#include <array>
+#include <vector>
+namespace dent {
+struct PanelShape {
+    float sign=1,hinge=0,length=1,crease=.5f;
+};
+struct Fold {
+    float length{},crease{},compression{},runA{},runB{},height{};
+};
+inline Fold foldFor(float length,float crease,float compression) {
+    if(!std::isfinite(length)||!std::isfinite(crease)||!std::isfinite(compression)||length<.05f) return {};
+    crease=std::clamp(crease,.35f,.65f);
+    compression=std::clamp(compression,0.f,length*.45f);
+    float a=length*crease,b=length-a,d=length-compression;
+    float x=(d*d+a*a-b*b)/(2*d);
+    return {length,crease,compression,x,d-x,std::sqrt(std::max(0.f,a*a-x*x))};
+}
+inline Fold limitedFold(float length,float crease,float compression,float maxHeight) {
+    auto f=foldFor(length,crease,compression);
+    if(f.height<=maxHeight) return f;
+    float lo=0,hi=f.compression;
+    for(int i=0;i<24;++i) {
+        float mid=(lo+hi)*.5f;
+        if(foldFor(length,crease,mid).height>maxHeight) hi=mid;else lo=mid;
+    }
+    return foldFor(length,crease,lo);
+}
+inline Vec foldOffset(Vec rest,const PanelShape& shape,const Fold& f) {
+    if(f.compression<=0||f.length<=0) return {};
+    float s=std::clamp(shape.sign*rest.y-shape.hinge,0.f,f.length);
+    float a=f.length*f.crease,b=f.length-a,x,z;
+    if(s<=a) {float u=s/a;x=f.runA*u;z=f.height*u;}
+    else {float u=(s-a)/b;x=f.runA+f.runB*u;z=f.height*(1-u);}
+    return {0,shape.sign*(x-s),z};
+}
+inline Vec foldNormal(Vec normal,const Fold& f,float sign,int side) {
+    if(f.compression<=0||f.length<=0) return normal;
+    float segment=f.length*(side?1-f.crease:f.crease);
+    float slopeX=(side?f.runB:f.runA)/segment;
+    float slopeZ=(side?-f.height:f.height)/segment;
+    float axial=(normal.y*sign-slopeZ*normal.z)/std::max(.005f,slopeX);
+    return unit({normal.x,axial*sign,normal.z});
+}
+struct PanelVertex {
+    Vec position{},normal{};
+    std::array<float,4> color{};
+    std::array<std::array<float,2>,8> uv{};
+    int side{};
+};
+struct PanelTriangle {std::array<PanelVertex,3> v;unsigned material{};};
+inline PanelVertex interpolate(const PanelVertex& a,const PanelVertex& b,float t) {
+    PanelVertex out;
+    out.position=a.position+(b.position-a.position)*t;
+    // Keep interpolation affine through all clipping passes. Normalize once at output.
+    out.normal=a.normal+(b.normal-a.normal)*t;
+    for(int i=0;i<4;++i) out.color[i]=a.color[i]+(b.color[i]-a.color[i])*t;
+    for(int i=0;i<8;++i) for(int j=0;j<2;++j)
+        out.uv[i][j]=a.uv[i][j]+(b.uv[i][j]-a.uv[i][j])*t;
+    return out;
+}
+inline std::vector<PanelVertex> clipCrease(const PanelTriangle& t,float sign,float plane,bool upper) {
+    std::vector<PanelVertex> out;
+    auto inside=[&](float d){return upper?d>=0:d<=0;};
+    for(int i=0;i<3;++i) {
+        auto a=t.v[i],b=t.v[(i+1)%3];
+        float da=sign*a.position.y-plane,db=sign*b.position.y-plane;
+        if(inside(da)) out.push_back(a);
+        if(inside(da)!=inside(db)) {
+            auto cut=interpolate(a,b,da/(da-db));
+            cut.position.y=plane/sign;out.push_back(cut);
+        }
+    }
+    return out;
+}
+inline float areaSquared(const PanelTriangle& t) {
+    Vec a=t.v[1].position-t.v[0].position,b=t.v[2].position-t.v[0].position;
+    Vec cross{a.y*b.z-a.z*b.y,a.z*b.x-a.x*b.z,a.x*b.y-a.y*b.x};
+    return dot(cross,cross)*.25f;
+}
+inline std::vector<PanelTriangle> splitCrease(const PanelTriangle& t,float sign,float plane) {
+    std::vector<PanelTriangle> out;
+    bool below=false,above=false;
+    for(auto& v:t.v) {float d=sign*v.position.y-plane;below|=d<0;above|=d>0;}
+    if(!below||!above) {
+        auto same=t;for(auto& v:same.v) v.side=above?1:0;
+        out.push_back(same);return out;
+    }
+    for(int side=0;side<2;++side) {
+        auto poly=clipCrease(t,sign,plane,side!=0);
+        for(size_t j=1;j+1<poly.size();++j) {
+            PanelTriangle part{{poly[0],poly[j],poly[j+1]},t.material};
+            for(auto& v:part.v) v.side=side;
+            if(areaSquared(part)>1.e-12f) out.push_back(part);
+        }
+    }
+    return out;
+}
+// Topology and side labels must use the same per-panel crease as the fold.
+inline std::vector<PanelTriangle> splitPanelCrease(const PanelTriangle& triangle,const PanelShape& shape) {
+    return splitCrease(triangle,shape.sign,shape.hinge+shape.length*shape.crease);
+}
+
+}
diff --git a/src/extras/localdent/PanelSheet.hpp b/src/extras/localdent/PanelSheet.hpp
new file mode 100644
index 00000000..8beefffd
--- /dev/null
+++ b/src/extras/localdent/PanelSheet.hpp
@@ -0,0 +1,51 @@
+#pragma once
+#include "PanelSurface.hpp"
+namespace dent {
+// A shared rest-height deformation field keeps coincident upper/lower layers
+// ordered. Normals come from local field derivatives, independent of triangles.
+struct SheetPoint {
+    std::array<Vec,5> rest{},base{};
+    float dx{},dy{};
+    void init(Vec vertex,float height,const PanelShape& shape,int side) {
+        float eps=.002f;
+        Vec p{vertex.x,vertex.y,height};
+        rest={p,p+Vec{-eps,0,0},p+Vec{eps,0,0},p,p};
+        float crease=shape.sign*(shape.hinge+shape.length*shape.crease);
+        float lo=p.y-eps,hi=p.y+eps;
+        // Never average the two slopes of the intentional sharp crease.
+        bool lower=(side==0)==(shape.sign>0);
+        if(lower) hi=std::min(hi,crease);else lo=std::max(lo,crease);
+        rest[3].y=lo;rest[4].y=hi;dx=2*eps;dy=hi-lo;
+        base=rest;
+    }
+    void observe(Vec point,Vec direction,float depth,float radius,float oldDepth,float oldRadius,
+                 float limit,float power) {
+        for(unsigned k=0;k<5;++k)
+            base[k]=displaceImpact(rest[k],base[k],point,direction,depth,radius,oldDepth,oldRadius,limit,power);
+    }
+};
+inline float smoothCompression(const SpanFold& span,float x) {
+    if(span.maxX-span.minX<.001f)return span.at(x);
+    float t=std::clamp((x-span.minX)/(span.maxX-span.minX),0.f,1.f)*span.segments;
+    int i=std::min(int(t),int(span.segments)-1);float u=t-i;
+    auto c=[&](int k){return span.compression[std::clamp(k,0,int(span.segments))];};
+    // Positive cubic B-spline weights: smooth slopes, no overshoot or negative damage.
+    return (c(i-1)*(1-u)*(1-u)*(1-u)+c(i)*(3*u*u*u-6*u*u+4)+
+            c(i+1)*(-3*u*u*u+3*u*u+3*u+1)+c(i+2)*u*u*u)/6;
+}
+inline Vec sheetPosition(const SheetPoint& p,unsigned k,const PanelShape& shape,
+                         const SpanFold& span,bool followBody,float limit) {
+    Vec result=p.base[k]+surfaceFoldOffset(p.rest[k],shape,smoothCompression(span,p.rest[k].x),followBody);
+    Vec delta=result-p.rest[k];float d=length(delta);
+    return d>limit?p.rest[k]+delta*(limit/d):result;
+}
+inline Vec sheetNormal(const SheetPoint& p,const PanelShape& shape,const SpanFold& span,
+                       bool followBody,float limit,Vec original) {
+    if(p.dx<1e-6f||p.dy<1e-6f)return original;
+    Vec a=(sheetPosition(p,2,shape,span,followBody,limit)-sheetPosition(p,1,shape,span,followBody,limit))*(1/p.dx);
+    Vec b=(sheetPosition(p,4,shape,span,followBody,limit)-sheetPosition(p,3,shape,span,followBody,limit))*(1/p.dy);
+    Vec z{0,0,1};
+    Vec normal=surfaceCross(b,z)*original.x+surfaceCross(z,a)*original.y+surfaceCross(a,b)*original.z;
+    return finite(normal)&&length(normal)>1e-6f?unit(normal):original;
+}
+}
diff --git a/src/extras/localdent/PanelSurface.hpp b/src/extras/localdent/PanelSurface.hpp
new file mode 100644
index 00000000..fb62a296
--- /dev/null
+++ b/src/extras/localdent/PanelSurface.hpp
@@ -0,0 +1,143 @@
+#pragma once
+#include "PanelBehavior.hpp"
+#include <map>
+#include <tuple>
+namespace dent {
+// Each strip measures differential movement of its virtual hinge and free edge.
+// Both anchors use the same accumulated dent field as the body and glass.
+struct SpanFold {
+    float minX{},maxX{},z{};
+    unsigned segments=6;
+    std::array<Vec,13> hinge{},tip{};
+    std::array<float,13> compression{};
+    void init(float lo,float hi,float height,unsigned slices,const PanelShape& shape) {
+        minX=lo;maxX=hi;z=height;segments=std::clamp(slices,2u,12u);
+        compression.fill(0);
+        for(unsigned i=0;i<=segments;++i) {
+            float x=minX+(maxX-minX)*float(i)/segments;
+            hinge[i]={x,shape.sign*shape.hinge,z};
+            tip[i]={x,shape.sign*(shape.hinge+shape.length),z};
+        }
+    }
+    void observe(const PanelShape& shape,Vec point,Vec direction,float depth,float radius,
+                 float oldDepth,float oldRadius,float limit,float power,
+                 bool buckle,float strength,float threshold,float fraction,float maxLift) {
+        for(unsigned i=0;i<=segments;++i) {
+            float x=minX+(maxX-minX)*float(i)/segments;
+            Vec h{x,shape.sign*shape.hinge,z},t{x,shape.sign*(shape.hinge+shape.length),z};
+            hinge[i]=displaceImpact(h,hinge[i],point,direction,depth,radius,oldDepth,oldRadius,limit,power);
+            tip[i]=displaceImpact(t,tip[i],point,direction,depth,radius,oldDepth,oldRadius,limit,power);
+            if(!buckle) continue;
+            float shortening=shape.sign*((hinge[i].y-h.y)-(tip[i].y-t.y));
+            float demand=std::max(0.f,shortening-threshold)*strength;
+            auto f=limitedFold(shape.length,shape.crease,
+                std::min(demand,shape.length*fraction),maxLift);
+            compression[i]=std::max(compression[i],f.compression);
+        }
+    }
+    float at(float x) const {
+        if(maxX-minX<.001f) return compression[segments/2];
+        float t=std::clamp((x-minX)/(maxX-minX),0.f,1.f)*segments;
+        unsigned i=std::min(unsigned(t),segments-1);
+        return compression[i]+(compression[i+1]-compression[i])*(t-i);
+    }
+};
+inline Vec surfaceFoldOffset(Vec rest,const PanelShape& shape,float compression,bool followBody) {
+    auto fold=foldFor(shape.length,shape.crease,compression);
+    Vec offset=foldOffset(rest,shape,fold);
+    if(followBody&&shape.length>.05f) {
+        float u=std::clamp((shape.sign*rest.y-shape.hinge)/shape.length,0.f,1.f);
+        // Body displacement already shortens the plate. Remove the fold's linear
+        // shortening component so both longitudinal ends remain body-anchored.
+        offset.y+=shape.sign*fold.compression*u;
+    }
+    return offset;
+}
+inline std::vector<PanelVertex> clipWidth(const PanelTriangle& t,float plane,bool upper) {
+    std::vector<PanelVertex> out;
+    auto inside=[&](float d){return upper?d>=0:d<=0;};
+    for(int i=0;i<3;++i) {
+        auto a=t.v[i],b=t.v[(i+1)%3];float da=a.position.x-plane,db=b.position.x-plane;
+        if(inside(da)) out.push_back(a);
+        if(inside(da)!=inside(db)) {
+            auto cut=interpolate(a,b,da/(da-db));cut.position.x=plane;
+            cut.side=a.side;out.push_back(cut);
+        }
+    }return out;
+}
+inline std::vector<PanelTriangle> splitWidth(const PanelTriangle& t,float plane) {
+    bool below=false,above=false;
+    for(auto& v:t.v) {below|=v.position.x<plane;above|=v.position.x>plane;}
+    if(!below||!above) return {t};
+    std::vector<PanelTriangle> out;
+    for(bool upper:{false,true}) {
+        auto p=clipWidth(t,plane,upper);
+        for(size_t j=1;j+1<p.size();++j) {
+            PanelTriangle part{{p[0],p[j],p[j+1]},t.material};
+            if(areaSquared(part)>1.e-12f) out.push_back(part);
+        }
+    }return out;
+}
+inline std::vector<PanelTriangle> splitPanelSurface(const PanelTriangle& t,const PanelShape& shape,
+                                                  float minX,float maxX,unsigned segments) {
+    auto out=splitPanelCrease(t,shape);segments=std::clamp(segments,2u,12u);
+    for(unsigned k=1;k<segments&&maxX-minX>.001f;++k) {
+        float plane=minX+(maxX-minX)*float(k)/segments;
+        std::vector<PanelTriangle> next;
+        for(auto& tri:out) {auto parts=splitWidth(tri,plane);next.insert(next.end(),parts.begin(),parts.end());}
+        out=std::move(next);
+    }
+    // Longitudinal refinement reduces visible disagreement between differently
+    // triangulated outer paint and underside layers. Crease side tags survive.
+    for(unsigned k=1;k<6;++k) {
+        float plane=shape.sign*(shape.hinge+shape.length*float(k)/6);
+        std::vector<PanelTriangle> next;
+        for(auto tri:out) {
+            for(auto& v:tri.v) std::swap(v.position.x,v.position.y);
+            auto parts=splitWidth(tri,plane);
+            for(auto& part:parts) {
+                for(auto& v:part.v) std::swap(v.position.x,v.position.y);
+                next.push_back(part);
+            }
+        }
+        out=std::move(next);
+    }
+    return out;
+}
+inline Vec surfaceCross(Vec a,Vec b) {return {a.y*b.z-a.z*b.y,a.z*b.x-a.x*b.z,a.x*b.y-a.y*b.x};}
+inline std::vector<unsigned> surfaceNormalGroups(const std::vector<Vec>& rest,const std::vector<Vec>& normals,
+                                                const std::vector<int>& sides) {
+    using Key=std::tuple<long long,long long,long long,long long,long long,long long,int>;
+    std::map<Key,unsigned> groups;std::vector<unsigned> out;out.reserve(rest.size());
+    for(size_t i=0;i<rest.size();++i) {
+        auto p=rest[i],n=normals[i];
+        Key key{std::llround(p.x*1e5),std::llround(p.y*1e5),std::llround(p.z*1e5),
+                std::llround(n.x*1e4),std::llround(n.y*1e4),std::llround(n.z*1e4),sides[i]};
+        auto item=groups.emplace(key,unsigned(groups.size()));out.push_back(item.first->second);
+    }return out;
+}
+// Transform original shading normals through each actual deformed triangle,
+// then smooth only vertices that shared position, normal and crease side.
+inline std::vector<Vec> surfaceNormals(const std::vector<Vec>& rest,const std::vector<Vec>& current,
+                                      const std::vector<Vec>& original,const std::vector<unsigned>& groups) {
+    if(rest.size()!=current.size()||rest.size()!=original.size()||rest.size()!=groups.size()||rest.size()%3) return original;
+    std::vector<Vec> sum(rest.size()),out(original);
+    for(size_t i=0;i<rest.size();i+=3) {
+        Vec a=rest[i+1]-rest[i],b=rest[i+2]-rest[i];
+        Vec x=current[i+1]-current[i],y=current[i+2]-current[i];
+        Vec oldCross=surfaceCross(a,b),newCross=surfaceCross(x,y);
+        float area=length(oldCross);
+        if(area<1.e-8f||length(newCross)<1.e-8f||!finite(newCross)) continue;
+        Vec oldN=unit(oldCross),newN=unit(newCross);
+        for(size_t k=0;k<3;++k) {
+            Vec n=original[i+k];
+            Vec transformed=surfaceCross(y,newN)*dot(n,a)+surfaceCross(newN,x)*dot(n,b)+newCross*dot(n,oldN);
+            if(groups[i+k]<sum.size()&&finite(transformed))
+                sum[groups[i+k]]=sum[groups[i+k]]+unit(transformed)*area;
+        }
+    }
+    for(size_t i=0;i<out.size();++i) if(groups[i]<sum.size()&&length(sum[groups[i]])>.001f)
+        out[i]=unit(sum[groups[i]]);
+    return out;
+}
+}
diff --git a/src/extras/localdent/StructuralBody.hpp b/src/extras/localdent/StructuralBody.hpp
new file mode 100644
index 00000000..f73d3a07
--- /dev/null
+++ b/src/extras/localdent/StructuralBody.hpp
@@ -0,0 +1,461 @@
+#pragma once
+// Node-and-beam car structure (a much reduced take on soft-body vehicle damage).
+//
+// The structure lives in the car's own coordinate frame. GTA's rigid-body physics keeps driving the
+// car; this layer only decides how the *shape* of the body changes in a crash:
+//   - nodes (about 100) are generated from the body mesh on a coarse grid;
+//   - beams join neighbouring nodes, with a spring, a damper, and a yield point: pushed past it a
+//     beam changes its rest length, so the bend is permanent; pulled far past it, it breaks;
+//   - the front and rear are soft crumple zones, the cabin is stiff, the roof and pillars thinner,
+//     and the floor in the middle is pinned to the rigid body;
+//   - a crash drives the nodes near the contact inward (by the speed-dependent crush depth), the
+//     beams spread that load through the frame, and body vertices follow their nearest nodes.
+#include "ImpactMath.hpp"
+#include <vector>
+#include <cstdint>
+#include <cmath>
+#include <algorithm>
+
+namespace structural {
+using dent::Vec;
+
+enum Region : uint8_t { FRONT, REAR, CABIN, ROOF, FLOOR, HUB };
+
+struct Node { Vec rest; float mass; bool pinned; uint8_t region; bool buckles; float contactScale = 1.f; };
+struct Beam { int a, b; float k, c, L0, L00, yieldC, yieldT, breakT, crushLimit; bool broken; };
+struct Driver { int node; Vec target; };
+constexpr int kSkin = 8;
+struct SkinSample { int idx[kSkin]; float w[kSkin]; };
+
+struct Params {
+	float baseStiffness = 2.5e5f;
+	float crushScale = 0.6f;		// crush depth multiplier applied to the contact drivers
+	float driveStiffness = 4.0e6f;
+	float crumpleTravelScale = 1.8f; // structural rail travel relative to the surface-dent budget
+	float crumpleBuckle = 1.f; // compression-driven bow of upper front/rear members
+	float frontSoft = 0.25f, rearSoft = 0.25f;	// stiffness of the front/rear crumple zones relative to the cabin
+	float roofSoft = 0.5f;
+	float yieldFront = 0.020f, yieldRear = 0.020f, yieldCabin = 0.060f, yieldRoof = 0.035f, yieldFloor = 0.080f;
+	float roofBuckle = 1.5f;		// how strongly crushed roof/pillar beams bow upward (about sqrt(length*shortening)*this/2)
+	float densify = 30.f;			// how hard a fully crushed beam stiffens ("bottoming out")
+	float crushFront = 0.30f, crushRear = 0.30f, crushCabin = 0.08f, crushRoof = 0.06f;	// shortening a beam survives before it is solid
+};
+
+struct Structure {
+	std::vector<Node> nodes;
+	std::vector<Beam> beams;
+	std::vector<Vec> pos, vel, start, force;
+	std::vector<float> lift;		// permanent upward bow of roof/pillar nodes whose beams were crushed shorter
+	std::vector<Driver> drivers;
+	uint32_t episode = 0, driverMs = 0;
+	bool dirty = false;
+	int sleepFrames = 0;
+	float length = 0, width = 0, height = 0;
+	float frontY = 0, rearY = 0, topZ = 0;
+	bool roofCrushed = false;
+	int hubNode[4] = { -1, -1, -1, -1 };
+	int engineNode = -1;
+	float kDrive = 4.0e6f;
+	float maxOmega = 0.f;			// fastest vibration of the beam lattice (rad/s), cached by step()
+	float roofBuckle = 1.5f;
+	float crumpleBuckle = 1.f;
+	float densify = 30.f;
+};
+
+// Inward cabin movement at one seat, relative to the floor. Rigid displacement of the
+// whole structure and outward panel motion do not consume passenger survival space.
+inline float seatIntrusion(const Structure &s, Vec seat)
+{
+    Vec reference{};int floors=0;
+    for(size_t i=0;i<s.nodes.size();i++) if(s.nodes[i].region==FLOOR){reference=reference+(s.pos[i]-s.nodes[i].rest);floors++;}
+    if(floors) reference=reference*(1.f/floors);
+    float intrusion=0;
+    for(size_t i=0;i<s.nodes.size();i++){
+        const Node &n=s.nodes[i];
+        if(n.region!=CABIN && n.region!=ROOF && n.region!=FLOOR) continue;
+        Vec toward=seat-n.rest;
+        float lateral=std::fabs(toward.x), longitudinal=std::fabs(toward.y);
+        if(lateral>1.25f || longitudinal>1.f || std::fabs(toward.z)>1.6f) continue;
+        float distance=dent::length(toward);if(distance<.05f) continue;
+        Vec motion=s.pos[i]-n.rest-reference;
+        if(i<s.lift.size()) motion.z+=s.lift[i];
+        float near=(1.f-std::clamp((longitudinal-.25f)/.75f,0.f,1.f))*(1.f-std::clamp((lateral-.65f)/.6f,0.f,1.f));
+        intrusion=std::max(intrusion,dent::dot(motion,toward)*(near/distance));
+    }
+    return std::max(0.f,intrusion);
+}
+
+inline Vec blend(const Vec &a, const Vec &b, float t) { return a + (b - a) * t; }
+
+inline bool
+build(Structure &s, const std::vector<Vec> &pts, float carMass, const Vec *hubs, const Params &prm)
+{
+	if(pts.size() < 200 || !std::isfinite(carMass) || carMass <= 1.f) return false;
+	Vec lo = pts[0], hi = pts[0];
+	for(const Vec &p : pts){
+		lo = { std::min(lo.x, p.x), std::min(lo.y, p.y), std::min(lo.z, p.z) };
+		hi = { std::max(hi.x, p.x), std::max(hi.y, p.y), std::max(hi.z, p.z) };
+	}
+	float sx = hi.x - lo.x, sy = hi.y - lo.y, sz = hi.z - lo.z;
+	if(sx < .5f || sy < 1.5f || sz < .4f || !std::isfinite(sx + sy + sz)) return false;
+	s.width = sx; s.length = sy; s.height = sz;
+	s.frontY = hi.y; s.rearY = lo.y; s.topZ=hi.z; s.roofCrushed=false;
+
+	float cell = .55f;
+	int nx = 0, ny = 0, nz = 0;
+	std::vector<int> cellCount;
+	std::vector<Vec> cellSum;
+	for(int attempt = 0; attempt < 5; attempt++, cell *= 1.25f){
+		nx = std::max(2, (int)std::ceil(sx / cell));
+		ny = std::max(3, (int)std::ceil(sy / cell));
+		nz = std::max(2, (int)std::ceil(sz / cell));
+		cellCount.assign((size_t)nx*ny*nz, 0);
+		cellSum.assign((size_t)nx*ny*nz, Vec{});
+		for(const Vec &p : pts){
+			int ix = std::min(nx-1, (int)((p.x - lo.x) / sx * nx));
+			int iy = std::min(ny-1, (int)((p.y - lo.y) / sy * ny));
+			int iz = std::min(nz-1, (int)((p.z - lo.z) / sz * nz));
+			size_t c = ((size_t)iz*ny + iy)*nx + ix;
+			cellCount[c]++;
+			cellSum[c] = cellSum[c] + p;
+		}
+		int occupied = 0;
+		for(int n : cellCount) if(n >= 4) occupied++;
+		if(occupied <= 260) break;
+	}
+
+	s.nodes.clear(); s.beams.clear();
+	std::vector<int> cellNode((size_t)nx*ny*nz, -1);
+	// Keep the same deformable fraction of the handling mass regardless of mesh
+	// density; dividing by a fixed 100 made dense meshes artificially heavier.
+	int bodyNodes = 0;
+	for(int count : cellCount) if(count >= 4) ++bodyNodes;
+	const float nodeMass = carMass * 0.5f / std::max(1,bodyNodes + (hubs ? 4 : 0));
+	for(int iz = 0; iz < nz; iz++)
+		for(int iy = 0; iy < ny; iy++)
+			for(int ix = 0; ix < nx; ix++){
+				size_t c = ((size_t)iz*ny + iy)*nx + ix;
+				if(cellCount[c] < 4) continue;
+				Node nd;
+				nd.rest = cellSum[c] * (1.f / cellCount[c]);
+				nd.mass = nodeMass;
+				nd.pinned = false;
+				nd.buckles = false;
+				float yN = (nd.rest.y - lo.y) / sy, zN = (nd.rest.z - lo.z) / sz;
+				if(yN > .72f) nd.region = FRONT;
+				else if(yN < .22f) nd.region = REAR;
+				else if(zN > .68f) nd.region = ROOF;
+				else if(zN < .30f) nd.region = FLOOR;
+				else nd.region = CABIN;
+				bool end = nd.region == FRONT || nd.region == REAR;
+				// A panel dent budget is too short for an entire longitudinal rail. Fade
+				// extra crush travel in toward the nose/tail, leaving the passenger cell alone.
+				float endness = nd.region == FRONT ? (yN - .72f) / .22f : (.22f - yN) / .18f;
+				float t = end ? std::clamp(endness, 0.f, 1.f) : 0.f;
+				t = t*t*(3.f-2.f*t);
+				nd.contactScale = 1.f + (prm.crumpleTravelScale - 1.f)*t;
+				nd.buckles = nd.region == ROOF || (nd.region == CABIN && zN > .45f) || (end && zN > .25f);	// roof and the pillars below it
+				cellNode[c] = (int)s.nodes.size();
+				s.nodes.push_back(nd);
+			}
+	if(s.nodes.size() < 12) return false;
+
+	// pin the floor of the passenger cell: it is where the rigid body holds the structure
+	int pinned = 0;
+	for(auto &nd : s.nodes){
+		float yN = (nd.rest.y - lo.y) / sy;
+		if(nd.region == FLOOR && yN > .28f && yN < .72f){ nd.pinned = true; pinned++; }
+	}
+	if(pinned < 3){
+		std::vector<int> order(s.nodes.size());
+		for(size_t i = 0; i < order.size(); i++) order[i] = (int)i;
+		std::sort(order.begin(), order.end(), [&](int a, int b){
+			auto score = [&](int i){ const Vec &r = s.nodes[i].rest; return std::fabs(r.y - (lo.y + hi.y)*.5f) + std::fabs(r.x - (lo.x + hi.x)*.5f) + std::fabs(r.z - lo.z); };
+			return score(a) < score(b);
+		});
+		for(size_t i = 0; i < 4 && i < order.size(); i++) s.nodes[order[i]].pinned = true;
+	}
+
+	auto regionK = [&](uint8_t r){
+		switch(r){
+		case FRONT: return prm.baseStiffness * prm.frontSoft;
+		case REAR: return prm.baseStiffness * prm.rearSoft;
+		case ROOF: return prm.baseStiffness * prm.roofSoft;
+		case FLOOR: return prm.baseStiffness * 1.5f;
+		default: return prm.baseStiffness;
+		}
+	};
+	auto regionYield = [&](uint8_t r){
+		switch(r){
+		case FRONT: return prm.yieldFront;
+		case REAR: return prm.yieldRear;
+		case ROOF: return prm.yieldRoof;
+		case FLOOR: return prm.yieldFloor;
+		default: return prm.yieldCabin;
+		}
+	};
+	auto addBeam = [&](int a, int b, float kScale){
+		float L0 = dent::length(s.nodes[a].rest - s.nodes[b].rest);
+		if(L0 < .05f) return;
+		uint8_t ra = s.nodes[a].region, rb = s.nodes[b].region;
+		float k = std::min(regionK(ra), regionK(rb)) * kScale;
+		float yc = std::min(regionYield(ra), regionYield(rb));
+		Beam bm;
+		bm.a = a; bm.b = b; bm.k = k; bm.L0 = L0; bm.L00 = L0;
+		bm.crushLimit = (ra == FRONT || rb == FRONT) ? prm.crushFront : (ra == REAR || rb == REAR) ? prm.crushRear :
+		                (ra == ROOF || rb == ROOF) ? prm.crushRoof : prm.crushCabin;
+		bm.c = 0.5f * std::sqrt(k * nodeMass);
+		bm.yieldC = yc; bm.yieldT = yc * 1.6f; bm.breakT = yc * 6.0f; bm.broken = false;
+		s.beams.push_back(bm);
+	};
+	for(int iz = 0; iz < nz; iz++)
+		for(int iy = 0; iy < ny; iy++)
+			for(int ix = 0; ix < nx; ix++){
+				int a = cellNode[((size_t)iz*ny + iy)*nx + ix];
+				if(a < 0) continue;
+				for(int dz = -1; dz <= 1; dz++)
+					for(int dy = -1; dy <= 1; dy++)
+						for(int dx = -1; dx <= 1; dx++){
+							if(dz < 0 || (dz == 0 && (dy < 0 || (dy == 0 && dx <= 0)))) continue;	// each pair once
+							int jx = ix+dx, jy = iy+dy, jz = iz+dz;
+							if(jx < 0 || jy < 0 || jz < 0 || jx >= nx || jy >= ny || jz >= nz) continue;
+							int b = cellNode[((size_t)jz*ny + jy)*nx + jx];
+							if(b >= 0) addBeam(a, b, 1.f);
+						}
+			}
+
+	// wheel hubs: extra nodes tied into the nearest body nodes (used for steering damage)
+	if(hubs){
+		for(int h = 0; h < 4; h++){
+			Node nd;
+			nd.rest = hubs[h]; nd.mass = nodeMass; nd.pinned = false; nd.region = HUB; nd.buckles = false;
+			int hi_ = (int)s.nodes.size();
+			s.nodes.push_back(nd);
+			s.hubNode[h] = hi_;
+			std::vector<std::pair<float,int>> dist;
+			for(int i = 0; i < hi_; i++) dist.push_back({ dent::length(s.nodes[i].rest - nd.rest), i });
+			std::sort(dist.begin(), dist.end());
+			for(int k = 0; k < 4 && k < (int)dist.size(); k++) addBeam(hi_, dist[k].second, 0.8f);
+		}
+	}
+	// engine mount: the body node nearest the front-centre of the engine bay
+	{
+		Vec target = { (lo.x + hi.x)*.5f, hi.y - sy*.28f, lo.z + sz*.40f };
+		float best = 1e9f;
+		for(size_t i = 0; i < s.nodes.size(); i++){
+			if(s.nodes[i].region == HUB) continue;
+			float d = dent::length(s.nodes[i].rest - target);
+			if(d < best){ best = d; s.engineNode = (int)i; }
+		}
+	}
+
+	s.pos.resize(s.nodes.size()); s.vel.assign(s.nodes.size(), Vec{});
+	s.start.resize(s.nodes.size()); s.force.assign(s.nodes.size(), Vec{}); s.lift.assign(s.nodes.size(), 0.f);
+	for(size_t i = 0; i < s.nodes.size(); i++) s.pos[i] = s.start[i] = s.nodes[i].rest;
+	s.kDrive = prm.driveStiffness;
+	s.roofBuckle = prm.roofBuckle;
+	s.crumpleBuckle = prm.crumpleBuckle;
+	s.densify = prm.densify;
+	s.drivers.clear();
+	s.episode = 0;
+	s.sleepFrames = 0;
+	s.dirty = false;
+	return !s.beams.empty();
+}
+
+// Load the nodes near a contact: each is driven `depth*weight` further along `inward` than where it
+// was when this crash episode began, so a deepening hit keeps pushing and a finished one releases.
+inline void
+drive(Structure &s, Vec contact, Vec inward, float depth, float radius, float power, uint32_t episodeId, uint32_t nowMs, float endDepth = -1.f, float endRadius = 0.f, float roofDepth = -1.f, float roofRadius = 0.f, float wrap = 0.f)
+{
+	if(episodeId != s.episode){ s.episode = episodeId; s.start = s.pos; }
+	s.drivers.clear();
+	Vec dir = dent::unit(inward);
+	// Axial impacts load the nose's support frame, not just the surface directly
+	// under one contact sample. A collision at bonnet height still loads the
+	// radiator/grille and bumper below it. Side and cabin hits keep their old field.
+	bool frontHit = contact.y > s.frontY - s.length*.28f && dir.y < -.65f;
+	bool rearHit = contact.y < s.rearY + s.length*.22f && dir.y > .65f;
+	bool roofHit = roofDepth >= 0.f && dir.z < -.65f && contact.z > s.topZ-s.height*.30f &&
+	               contact.y < s.frontY-s.length*.28f && contact.y > s.rearY+s.length*.22f;
+	if(roofHit && roofDepth>.005f) s.roofCrushed=true;
+	for(size_t i = 0; i < s.nodes.size(); i++){
+		if(s.nodes[i].pinned) continue;
+		bool end = endDepth >= 0.f && ((frontHit && s.nodes[i].region == FRONT) || (rearHit && s.nodes[i].region == REAR));
+		bool roof=roofHit && (s.nodes[i].region==ROOF || (s.nodes[i].region==CABIN && s.nodes[i].buckles));
+		Vec delta = s.start[i] - contact;
+		if(end || roof) delta.z *= .4f;
+		float w = dent::weight(dent::length(delta), roof ? std::max(radius,roofRadius) : end ? std::max(radius,endRadius) : radius, power);
+		if(w < .02f) continue;
+		float travel = (roof ? roofDepth : end ? endDepth : depth) * w * (roof ? 1.f : s.nodes[i].contactScale);
+		// Extra compliance cannot compress the whole nose through the engine/cabin.
+		// Once rail travel is spent, the beams carry the load into the rest of the frame.
+		if(end) travel = std::min(travel, s.length*.22f);
+		if(roof) travel = std::min(travel,s.height*.35f);
+		Vec pushDir = dir;
+		if(wrap > 0.f){
+			// beside the contact line the frame is also pulled in toward it: it folds around a pole or trunk
+			Vec off = s.start[i] - contact;
+			Vec lateral = off - dir * dent::dot(off, dir);
+			float lat = dent::length(lateral);
+			if(lat > 1e-4f){
+				float t = std::min(1.f, lat / std::max(radius, .1f));
+				pushDir = dent::unit(dir - lateral * (wrap * t / lat));
+			}
+		}
+		s.drivers.push_back({ (int)i, s.start[i] + pushDir * travel });
+	}
+	s.driverMs = nowMs;
+	s.sleepFrames = 0;
+}
+
+inline void
+resetToRest(Structure &s)
+{
+	for(size_t i = 0; i < s.nodes.size(); i++){ s.pos[i] = s.start[i] = s.nodes[i].rest; s.vel[i] = Vec{}; }
+	s.drivers.clear();
+	s.roofCrushed=false;
+	std::fill(s.lift.begin(),s.lift.end(),0.f);
+	s.dirty = true;
+}
+
+inline void
+step(Structure &s, float dt, uint32_t nowMs)
+{
+	if(!s.drivers.empty() && nowMs > s.driverMs + 250) s.drivers.clear();
+	if(s.drivers.empty() && s.sleepFrames > 45) return;	// settled
+	if(!(dt > 0.f) || !std::isfinite(dt)) return;
+	dt = std::min(dt, 0.05f);
+	if(s.maxOmega <= 0.f){
+		// the stiffest node (sum of its beams' stiffness over its mass) sets the fastest vibration to resolve
+		std::vector<float> sumK(s.nodes.size(), 0.f);
+		for(const Beam &bm : s.beams){ sumK[bm.a] += bm.k; sumK[bm.b] += bm.k; }
+		for(size_t i = 0; i < s.nodes.size(); i++)
+			s.maxOmega = std::max(s.maxOmega, std::sqrt(2.f * sumK[i] / std::max(1e-3f, s.nodes[i].mass)));
+		s.maxOmega = std::max(s.maxOmega, 1.f);
+	}
+	// explicit integration is stable only while the step stays well below 2/omega: size the sub-steps
+	// from that, so a slow frame cannot blow the frame up and bend it for good
+	const int sub = std::min(200, std::max(std::max(2, (int)std::ceil(dt / 0.001f)), (int)std::ceil(dt * s.maxOmega / 0.8f)));
+	const float h = dt / sub;
+	const size_t n = s.nodes.size();
+	float maxSpeed = 0.f;
+	// nodes under the contact are held exactly at their crush depth (whatever hit the car is in the way,
+	// so they cannot back off); the beams must carry the rest of the load into the structure
+	std::vector<char> held(n, 0);
+	for(const Driver &dr : s.drivers) held[dr.node] = 1;
+	for(int it = 0; it < sub; ++it){
+		for(const Driver &dr : s.drivers){ s.pos[dr.node] = dr.target; s.vel[dr.node] = Vec{}; }
+		for(size_t i = 0; i < n; i++) s.force[i] = Vec{};
+		for(Beam &bm : s.beams){
+			if(bm.broken) continue;
+			Vec d = s.pos[bm.b] - s.pos[bm.a];
+			float len = dent::length(d);
+			if(len < 1e-5f) continue;
+			Vec dir = d * (1.f / len);
+			float strain = (len - bm.L0) / bm.L0;
+			// a crushed beam runs out of travel: its compressive yield climbs steeply as it nears solid,
+			// so the load moves on into the rest of the structure (the cabin, then the roof)
+			float crushed = std::max(0.f, 1.f - bm.L0 / bm.L00) / bm.crushLimit;
+			bool roofLoaded = s.roofCrushed && (s.nodes[bm.a].region==ROOF || s.nodes[bm.b].region==ROOF);
+			// Roof loading bends thin roof/pillar members before axial cabin rails yield.
+			float yieldScale=roofLoaded ? .25f : 1.f;
+			float yc = bm.yieldC * yieldScale * (1.f + s.densify * crushed * crushed * crushed);
+			if(strain < -yc){
+				bm.L0 = len / (1.f - yc * .9f);				// compression past yield: shorter for good
+			}else if(strain > bm.yieldT * yieldScale){
+				if(strain > bm.breakT){ bm.broken = true; continue; }
+				bm.L0 = len / (1.f + bm.yieldT * yieldScale * .9f);			// tension past yield: longer for good
+			}
+			float relv = dent::dot(s.vel[bm.b] - s.vel[bm.a], dir);
+			float F = bm.k * (len - bm.L0) + bm.c * relv;
+			s.force[bm.a] = s.force[bm.a] + dir * F;
+			s.force[bm.b] = s.force[bm.b] - dir * F;
+		}
+		for(size_t i = 0; i < n; i++){
+			const Node &nd = s.nodes[i];
+			if(held[i]) continue;
+			if(nd.pinned){ s.pos[i] = nd.rest; s.vel[i] = Vec{}; continue; }
+			s.vel[i] = (s.vel[i] + s.force[i] * (h / nd.mass)) * 0.9995f;
+			float sp = dent::length(s.vel[i]);
+			if(sp > 60.f) s.vel[i] = s.vel[i] * (60.f / sp);
+			s.pos[i] = s.pos[i] + s.vel[i] * h;
+			Vec off = s.pos[i] - nd.rest;
+			float o = dent::length(off);
+			if(o > 1.4f) s.pos[i] = nd.rest + off * (1.4f / o);
+			maxSpeed = std::max(maxSpeed, sp);
+		}
+	}
+	for(size_t i = 0; i < n; i++)
+		if(!dent::finite(s.pos[i])){ resetToRest(s); return; }
+	if(s.roofBuckle > 0.f || s.crumpleBuckle > 0.f){
+		// a roof/pillar beam crushed shorter by dL bows out by about sqrt(L*dL): lift its nodes by that
+		std::fill(s.lift.begin(), s.lift.end(), 0.f);
+		for(const Beam &bm : s.beams){
+			if(bm.broken || !s.nodes[bm.a].buckles || !s.nodes[bm.b].buckles) continue;
+			float dL = bm.L00 - bm.L0;
+			if(dL <= 0.f) continue;
+			// ramp in smoothly: no bow until the beam is genuinely crushed (a few percent shorter)
+			// the roof only bows after a serious squeeze (a front crash must be severe before it reaches the cabin)
+			bool end = s.nodes[bm.a].region == FRONT || s.nodes[bm.a].region == REAR ||
+			           s.nodes[bm.b].region == FRONT || s.nodes[bm.b].region == REAR;
+			float start = (end || s.roofCrushed) ? .015f : .05f, width = (end || s.roofCrushed) ? .05f : .10f;
+			float f = std::min(1.f, std::max(0.f, (dL / bm.L00 - start) / width));
+			f = f * f * (3.f - 2.f * f);
+			float buckle = end ? s.crumpleBuckle : s.roofBuckle;
+			float l = std::min(end ? .25f : .35f, .5f * buckle * std::sqrt(bm.L00 * dL)) * f;
+			if(!end && s.roofCrushed) l=-l;
+			if(std::fabs(l)>std::fabs(s.lift[bm.a])) s.lift[bm.a]=l;
+			if(std::fabs(l)>std::fabs(s.lift[bm.b])) s.lift[bm.b]=l;
+		}
+	}
+	s.dirty = true;
+	if(s.drivers.empty() && maxSpeed < 0.03f) s.sleepFrames++; else s.sleepFrames = 0;
+}
+
+// Skinning: each body vertex follows its nearest nodes. The weight of a node fades smoothly to zero at
+// the distance of the (kSkin+1)-th nearest node, so the displacement field has no jumps where the set
+// of nearest nodes changes (jumps tear triangles apart and flip the texture).
+inline SkinSample
+skinFor(const Structure &s, Vec p)
+{
+	SkinSample out{};
+	float bestD[kSkin + 1];
+	int bestI[kSkin + 1];
+	for(int k = 0; k <= kSkin; k++){ bestD[k] = 1e9f; bestI[k] = 0; }
+	for(size_t i = 0; i < s.nodes.size(); i++){
+		if(s.nodes[i].region == HUB) continue;
+		float d = dent::length(s.nodes[i].rest - p);
+		for(int k = 0; k <= kSkin; k++)
+			if(d < bestD[k]){
+				for(int m = kSkin; m > k; m--){ bestD[m] = bestD[m-1]; bestI[m] = bestI[m-1]; }
+				bestD[k] = d; bestI[k] = (int)i;
+				break;
+			}
+	}
+	float R = std::max(bestD[kSkin], 1e-3f), sum = 0;
+	for(int k = 0; k < kSkin; k++){
+		float t = std::max(0.f, 1.f - bestD[k] / R);
+		float w = t * t;
+		out.idx[k] = bestI[k];
+		out.w[k] = w;
+		sum += w;
+	}
+	if(sum < 1e-6f){ out.w[0] = 1.f; sum = 1.f; }
+	for(int k = 0; k < kSkin; k++) out.w[k] /= sum;
+	return out;
+}
+
+inline Vec
+displacement(const Structure &s, const SkinSample &k)
+{
+	Vec d{};
+	for(int i = 0; i < kSkin; i++){
+		Vec nd = s.pos[k.idx[i]] - s.nodes[k.idx[i]].rest;
+		if(k.idx[i] < (int)s.lift.size()) nd.z += s.lift[k.idx[i]];
+		d = d + nd * k.w[i];
+	}
+	return d;
+}
+
+}
diff --git a/src/extras/localdent/TrafficPolicy.hpp b/src/extras/localdent/TrafficPolicy.hpp
new file mode 100644
index 00000000..5508af16
--- /dev/null
+++ b/src/extras/localdent/TrafficPolicy.hpp
@@ -0,0 +1,19 @@
+#pragma once
+#include "DentMath.hpp"
+#include <cstdint>
+namespace dent {
+inline int slotHandle(int index,uint8_t flag) {
+    if(index<0||index>=10000||(flag&0x80)) return -1;
+    return (index<<8)|flag;
+}
+inline bool inTrafficRange(Vec car,Vec observer,float range) {
+    if(!finite(car)||!finite(observer)||!std::isfinite(range)||range<=0) return false;
+    Vec delta=car-observer;return dot(delta,delta)<=range*range;
+}
+struct TrafficCandidate {void* vehicle{};float distanceSquared{};bool direct{};int handle{};};
+inline bool trafficPriority(const TrafficCandidate& a,const TrafficCandidate& b) {
+    if(a.direct!=b.direct) return a.direct;
+    if(a.distanceSquared!=b.distanceSquared) return a.distanceSquared<b.distanceSquared;
+    return a.handle<b.handle;
+}
+}
diff --git a/src/extras/metalfx/MetalFXBridge.cpp b/src/extras/metalfx/MetalFXBridge.cpp
new file mode 100644
index 00000000..db444f23
--- /dev/null
+++ b/src/extras/metalfx/MetalFXBridge.cpp
@@ -0,0 +1,270 @@
+// Objective-C++ (compiled with -x objective-c++, see src/CMakeLists.txt)
+#define GL_SILENCE_DEPRECATION
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#import <MetalFX/MetalFX.h>
+#import <IOSurface/IOSurface.h>
+#import <OpenGL/OpenGL.h>
+#import <OpenGL/CGLIOSurface.h>
+#import <OpenGL/gl3.h>
+#include <stdio.h>
+#include <atomic>
+#include <cstdint>
+#include "MetalFXBridge.h"
+#ifdef RW_METALGL
+#include "src/mtl/mtlgl.h"
+#endif
+
+
+namespace {
+static std::atomic<uint64_t> &lastGpuNs=*new std::atomic<uint64_t>(0);
+
+struct State {
+	id<MTLDevice> device;
+	id<MTLCommandQueue> queue;
+	id<MTLFXTemporalScaler> scaler;
+	id<MTLTexture> exposure;
+	id<MTLTexture> outputPrivate;
+	IOSurfaceRef surface[MFX_NUM_TEXTURES];
+	id<MTLTexture> metal[MFX_NUM_TEXTURES];
+	GLuint gl[MFX_NUM_TEXTURES];
+	int inW, inH, outW, outH;
+	bool ready;
+ id<MTLCommandBuffer> pending[2];
+ unsigned frameSlot;
+};
+State &S = *new State();	// never destroyed: the MetalFX objects must not be torn down during exit()
+
+void
+logLine(const char *msg)
+{
+	fprintf(stderr, "MetalFX: %s\n", msg);
+	if(FILE *f = fopen("metalfx.log", "a")){
+		fprintf(f, "%s\n", msg);
+		fclose(f);
+	}
+}
+
+IOSurfaceRef
+makeSurface(int w, int h, int bytesPerElement, uint32_t pixelFormat)
+{
+	NSDictionary *props = @{
+		(id)kIOSurfaceWidth: @(w),
+		(id)kIOSurfaceHeight: @(h),
+		(id)kIOSurfaceBytesPerElement: @(bytesPerElement),
+		(id)kIOSurfacePixelFormat: @(pixelFormat),
+	};
+	return IOSurfaceCreate((__bridge CFDictionaryRef)props);
+}
+
+// one shared texture: IOSurface -> Metal texture and GL rectangle texture
+bool
+makeShared(int idx, int w, int h, int bpe, uint32_t pixelFormat, MTLPixelFormat mtlFormat, MTLTextureUsage usage,
+           GLenum glInternal, GLenum glFormat, GLenum glType)
+{
+#ifdef RW_METALGL
+	{
+		MTLTextureDescriptor *d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:mtlFormat width:w height:h mipmapped:NO];
+		d.usage = usage | MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead;
+		d.storageMode = MTLStorageModePrivate;
+		S.metal[idx] = [S.device newTextureWithDescriptor:d];
+		if(!S.metal[idx]){ logLine("texture creation failed"); return false; }
+		S.gl[idx] = mtlglWrapTexture((__bridge void*)S.metal[idx]);
+		return true;
+	}
+#endif
+	S.surface[idx] = makeSurface(w, h, bpe, pixelFormat);
+	if(!S.surface[idx]){ logLine("IOSurfaceCreate failed"); return false; }
+	MTLTextureDescriptor *d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:mtlFormat width:w height:h mipmapped:NO];
+	d.usage = usage;
+	S.metal[idx] = [S.device newTextureWithDescriptor:d iosurface:S.surface[idx] plane:0];
+	if(!S.metal[idx]){ logLine("newTextureWithDescriptor(iosurface) failed"); return false; }
+	glGenTextures(1, &S.gl[idx]);
+	glBindTexture(GL_TEXTURE_RECTANGLE, S.gl[idx]);
+	CGLError err = CGLTexImageIOSurface2D(CGLGetCurrentContext(), GL_TEXTURE_RECTANGLE, glInternal, w, h, glFormat, glType, S.surface[idx], 0);
+	if(err != kCGLNoError){
+		char b[128];
+		snprintf(b, sizeof(b), "CGLTexImageIOSurface2D failed for texture %d: %s", idx, CGLErrorString(err));
+		logLine(b);
+		return false;
+	}
+	glTexParameteri(GL_TEXTURE_RECTANGLE, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+	glTexParameteri(GL_TEXTURE_RECTANGLE, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+	glTexParameteri(GL_TEXTURE_RECTANGLE, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+	glTexParameteri(GL_TEXTURE_RECTANGLE, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+	return true;
+}
+
+}
+
+extern "C" int
+mfxSetup(int inW, int inH, int outW, int outH, unsigned *glTex)
+{
+	mfxShutdown();
+	@autoreleasepool {
+#ifdef RW_METALGL
+		S.device = (__bridge id<MTLDevice>)mtlglDevice();
+#else
+		S.device = MTLCreateSystemDefaultDevice();
+#endif
+		if(!S.device){ logLine("no Metal device"); return 0; }
+		if(![MTLFXTemporalScalerDescriptor supportsDevice:S.device]){ logLine("temporal scaler not supported on this GPU"); return 0; }
+#ifdef RW_METALGL
+		S.queue = (__bridge id<MTLCommandQueue>)mtlglCommandQueue();
+#else
+		S.queue = [S.device newCommandQueue];
+#endif
+		S.inW = inW; S.inH = inH; S.outW = outW; S.outH = outH;
+
+		GLint prevTex = 0;
+#ifndef RW_METALGL
+		glGetIntegerv(GL_TEXTURE_BINDING_RECTANGLE, &prevTex);
+#endif
+		bool ok =
+			// BGRA8 colour, R32F depth, RGBA16F motion, BGRA8 output
+			makeShared(MFX_COLOR, inW, inH, 4, 0x42475241 /*'BGRA'*/, MTLPixelFormatBGRA8Unorm, MTLTextureUsageShaderRead,
+			           GL_RGBA, GL_BGRA, GL_UNSIGNED_INT_8_8_8_8_REV) &&
+			makeShared(MFX_DEPTH, inW, inH, 4, 0x4C303066 /*'L00f'*/, MTLPixelFormatR32Float, MTLTextureUsageShaderRead,
+			           GL_R32F, GL_RED, GL_FLOAT) &&
+			makeShared(MFX_MOTION, inW, inH, 8, 0x52476841 /*'RGhA'*/, MTLPixelFormatRGBA16Float, MTLTextureUsageShaderRead,
+			           GL_RGBA16F, GL_RGBA, GL_HALF_FLOAT) &&
+			makeShared(MFX_OUTPUT, outW, outH, 4, 0x42475241, MTLPixelFormatBGRA8Unorm, MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite,
+			           GL_RGBA, GL_BGRA, GL_UNSIGNED_INT_8_8_8_8_REV) &&
+			// Reactive coverage for characters, vehicles, and moving-shadow disocclusion.
+			makeShared(MFX_REACTIVE, inW, inH, 1, 0x4C303038 /*'L008'*/, MTLPixelFormatR8Unorm, MTLTextureUsageShaderRead,
+			           GL_R8, GL_RED, GL_UNSIGNED_BYTE);
+#ifndef RW_METALGL
+		glBindTexture(GL_TEXTURE_RECTANGLE, prevTex);
+#endif
+		if(!ok){ mfxShutdown(); return 0; }
+
+		MTLFXTemporalScalerDescriptor *d = [[MTLFXTemporalScalerDescriptor alloc] init];
+		d.colorTextureFormat = MTLPixelFormatBGRA8Unorm;
+		d.depthTextureFormat = MTLPixelFormatR32Float;
+		d.motionTextureFormat = MTLPixelFormatRGBA16Float;
+		d.outputTextureFormat = MTLPixelFormatBGRA8Unorm;
+		d.inputWidth = inW; d.inputHeight = inH;
+		d.outputWidth = outW; d.outputHeight = outH;
+		d.autoExposureEnabled = NO;
+		d.requiresSynchronousInitialization = YES;
+		if(@available(macOS 14.4, *)){
+			d.reactiveMaskTextureEnabled = YES;
+			d.reactiveMaskTextureFormat = MTLPixelFormatR8Unorm;
+		}
+		S.scaler = [d newTemporalScalerWithDevice:S.device];
+		if(!S.scaler){ logLine("could not create the temporal scaler (unsupported formats or scale)"); mfxShutdown(); return 0; }
+
+		MTLTextureDescriptor *od = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm width:outW height:outH mipmapped:NO];
+		od.storageMode = MTLStorageModePrivate;
+		od.usage = S.scaler.outputTextureUsage | MTLTextureUsageShaderRead;
+		S.outputPrivate = [S.device newTextureWithDescriptor:od];
+
+		// fixed exposure of 1.0
+		MTLTextureDescriptor *ed = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatR16Float width:1 height:1 mipmapped:NO];
+		ed.storageMode = MTLStorageModeShared;
+		S.exposure = [S.device newTextureWithDescriptor:ed];
+		uint16_t one = 0x3C00;
+		[S.exposure replaceRegion:MTLRegionMake2D(0, 0, 1, 1) mipmapLevel:0 withBytes:&one bytesPerRow:2];
+
+		for(int i = 0; i < MFX_NUM_TEXTURES; i++) glTex[i] = S.gl[i];
+		S.ready = true;
+		char b[160];
+		snprintf(b, sizeof(b), "temporal scaler ready: %dx%d -> %dx%d", inW, inH, outW, outH);
+		logLine(b);
+	}
+	return 1;
+}
+
+extern "C" int
+mfxRun(float jitterX, float jitterY, int reset)
+{
+	if(!S.ready) return 0;
+#ifdef RW_METALGL
+	mtlglFlush();	// the renderer's own work for this frame must be on the queue before ours
+#endif
+	@autoreleasepool {
+  // The scaler and its private output texture are reused. Bound the number of
+  // outstanding encodes, including ANE work scheduled through MPSGraph.
+  unsigned slot=S.frameSlot++%2;
+  if(S.pending[slot]){
+   [S.pending[slot] waitUntilCompleted];
+   if(S.pending[slot].status!=MTLCommandBufferStatusCompleted){logLine("prior temporal command buffer failed; renderer will retain GPU temporal accumulation");S.pending[slot]=nil;return 0;}
+   S.pending[slot]=nil;
+  }
+		id<MTLCommandBuffer> cb = [S.queue commandBuffer];
+		S.scaler.colorTexture = S.metal[MFX_COLOR];
+		S.scaler.depthTexture = S.metal[MFX_DEPTH];
+		S.scaler.motionTexture = S.metal[MFX_MOTION];
+		S.scaler.outputTexture = S.outputPrivate;
+		S.scaler.exposureTexture = S.exposure;
+		if(@available(macOS 14.4, *)) S.scaler.reactiveMaskTexture = S.metal[MFX_REACTIVE];
+		S.scaler.inputContentWidth = S.inW;
+		S.scaler.inputContentHeight = S.inH;
+		S.scaler.jitterOffsetX = jitterX;
+		S.scaler.jitterOffsetY = jitterY;
+		S.scaler.motionVectorScaleX = 1.0f;
+		S.scaler.motionVectorScaleY = 1.0f;
+		S.scaler.depthReversed = NO;
+		S.scaler.preExposure = 1.0f;
+		S.scaler.reset = reset != 0;
+		[S.scaler encodeToCommandBuffer:cb];
+		id<MTLBlitCommandEncoder> blit = [cb blitCommandEncoder];
+		[blit copyFromTexture:S.outputPrivate toTexture:S.metal[MFX_OUTPUT]];
+		[blit endEncoding];
+        [cb addCompletedHandler:^(id<MTLCommandBuffer> done){
+            if(done.status==MTLCommandBufferStatusCompleted && done.GPUEndTime>=done.GPUStartTime)
+                lastGpuNs.store((uint64_t)((done.GPUEndTime-done.GPUStartTime)*1.0e9),std::memory_order_relaxed);
+        }];
+		[cb commit];
+  S.pending[slot]=cb;
+#ifdef RW_METALGL
+		if(0){	// ordered on the renderer's queue: no CPU wait
+#else
+		[cb waitUntilCompleted];
+		if(cb.status != MTLCommandBufferStatusCompleted){
+#endif
+			logLine("command buffer failed");
+			return 0;
+		}
+	}
+	return 1;
+}
+
+// Apple's multithreaded OpenGL engine: the driver encodes and submits GL commands on a second thread, so the game thread
+// returns from draw calls sooner. (kCGLCEMPEngine = 313; the game thread stays the only one calling GL.)
+extern "C" int
+regtaEnableGLMultithreading(void)
+{
+	CGLContextObj ctx = CGLGetCurrentContext();
+	if(!ctx) return 0;
+	CGLError err = CGLEnable(ctx, (CGLContextEnable)313);
+	char b[96];
+	snprintf(b, sizeof(b), "multithreaded OpenGL engine: %s", err == kCGLNoError ? "on" : CGLErrorString(err));
+	logLine(b);
+	return err == kCGLNoError;
+}
+
+extern "C" void
+mfxShutdown(void)
+{
+	@autoreleasepool {
+		S.ready = false;
+  for(int i=0;i<2;i++){if(S.pending[i]) [S.pending[i] waitUntilCompleted];S.pending[i]=nil;}S.frameSlot=0;
+		S.scaler = nil;
+		S.exposure = nil;
+		S.outputPrivate = nil;
+		for(int i = 0; i < MFX_NUM_TEXTURES; i++){
+			S.metal[i] = nil;
+#ifdef RW_METALGL
+			S.gl[i] = 0;
+#else
+			if(S.gl[i]){ glDeleteTextures(1, &S.gl[i]); S.gl[i] = 0; }
+#endif
+			if(S.surface[i]){ CFRelease(S.surface[i]); S.surface[i] = nullptr; }
+		}
+		S.queue = nil;
+		S.device = nil;
+	}
+}
+
+extern "C" float mfxGpuMilliseconds(void){return (float)(lastGpuNs.load(std::memory_order_relaxed)/1.0e6);}
diff --git a/src/extras/metalfx/MetalFXBridge.h b/src/extras/metalfx/MetalFXBridge.h
new file mode 100644
index 00000000..39981a79
--- /dev/null
+++ b/src/extras/metalfx/MetalFXBridge.h
@@ -0,0 +1,21 @@
+#pragma once
+
+// Bridge between the OpenGL renderer and Apple's MetalFX temporal scaler (macOS 13+).
+// GL and Metal share IOSurface-backed textures: the renderer converts the scene into the input textures,
+// the scaler runs on a Metal command buffer, and the result is read back through the output texture.
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum { MFX_COLOR, MFX_DEPTH, MFX_MOTION, MFX_OUTPUT, MFX_REACTIVE, MFX_NUM_TEXTURES };
+
+// Creates the scaler and the shared textures (GL_TEXTURE_RECTANGLE names are returned in glTex).
+// Needs a current GL context. Returns 1 on success.
+int mfxSetup(int inW, int inH, int outW, int outH, unsigned *glTex);
+// Upscales the input textures into the output texture and waits for it. jitter is in input pixels.
+int mfxRun(float jitterX, float jitterY, int reset);
+void mfxShutdown(void);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/src/extras/metalfx/MetalRT.cpp b/src/extras/metalfx/MetalRT.cpp
new file mode 100644
index 00000000..d93fcb68
