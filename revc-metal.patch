+struct Config {
+	dent::ImpactConfig curve;
+	float crumpleCrush50 = .30f, roofCrush50 = .20f;	// frame / roof crush depth (m) of a 50 km/h crash
+	float maxTotal = 1.05f, falloffPower = .65f;
