new file mode 100644
index 00000000..32c41dcb
--- /dev/null
+++ b/tools/build_vc_freeroam_map.py
@@ -0,0 +1,27 @@
+#!/usr/bin/env python3
+"""Build Vice City's road selector from detached IPL path nodes, using its /16 coordinate scale."""
+from pathlib import Path
+import sys,math
+root=Path(sys.argv[1]);segments=[];groups=0
+for path in sorted((root/'data/maps').rglob('*.ipl')):
+ lines=[s for line in path.read_text(errors='replace').splitlines() if (s:=line.split('#')[0].strip().replace(',',' '))]
+ inside=False;i=0
+ while i<len(lines):
+  line=lines[i];i+=1
+  if line=='path':inside=True;continue
+  if line=='end':inside=False;continue
+  if not inside:continue
+  header=line.split()
+  if len(header)!=2:continue
+  kind,model=map(int,header)
+  if model!=-1 or kind not in (0,1,2):raise ValueError((path,line))
+  nodes=[list(map(float,s.split())) for s in lines[i:i+12]];i+=12;assert len(nodes)==12 and all(len(n)>=6 for n in nodes)
+  if kind==2:continue # Boat lanes aren't safe land spawn points.
+  groups+=1
+  for n in nodes:
+   target=int(n[1])
+   if n[0] and 0<=target<12 and nodes[target][0]:
+    segment=(int(kind==0),*[v/16 for v in n[3:6]],*[v/16 for v in nodes[target][3:6]])
+    assert all(math.isfinite(v) for v in segment);segments.append(segment)
+assert len(segments)>1000,len(segments)
+out=root/'data/freeroam-map.dat';out.write_text(''.join('%d %.3f %.3f %.3f %.3f %.3f %.3f\n'%s for s in segments));print(f'{groups} land path groups, {len(segments)} segments -> {out}')
