+// Hidden-window test of the actual vehicle shaders and final ray-reflection composite.
+// clang++ -std=c++17 tools-mtl/vehicle-paint-reflection-test.cpp -I/opt/homebrew/include \
+//   -L/opt/homebrew/lib -lglfw -framework OpenGL -o /tmp/vehicle-paint-reflection-test
+// Run from the repository root; optional arguments select old vertex/fragment shader snapshots.
+#define GL_SILENCE_DEPRECATION
+#define GLFW_INCLUDE_NONE
+#include <GLFW/glfw3.h>
+#include "glad/glad.h"
+#include "mtlgl.h"
+#include <cstdlib>
+#include <fstream>
+#include <iterator>
+#include <string>
+#include <vector>
+#include <cassert>
+#include <cstring>
+#include <cstdio>
+#include <cmath>
+
+static void testAttrib4(GLuint i,float x,float y,float z,float w){
+ float a[]={x,y,z,w,x,y,z,w,x,y,z,w};GLuint b;glGenBuffers(1,&b);glBindBuffer(GL_ARRAY_BUFFER,b);glBufferData(GL_ARRAY_BUFFER,sizeof(a),a,GL_STATIC_DRAW);glEnableVertexAttribArray(i);glVertexAttribPointer(i,4,GL_FLOAT,GL_FALSE,0,nullptr);
+}
+static void testAttrib3(GLuint i,float x,float y,float z){testAttrib4(i,x,y,z,1);}
+static std::string read(const char *p){std::ifstream f(p);std::string s((std::istreambuf_iterator<char>(f)),{});assert(!s.empty());return s;}
+static GLuint shader(GLenum type,const std::string &s){GLuint sh=glCreateShader(type);const char *p=s.c_str();glShaderSource(sh,1,&p,nullptr);glCompileShader(sh);GLint ok;glGetShaderiv(sh,GL_COMPILE_STATUS,&ok);if(!ok){char log[8192];glGetShaderInfoLog(sh,sizeof(log),nullptr,log);puts(log);}assert(ok);return sh;}
+static GLuint program(const std::string &v,const std::string &f){GLuint p=glCreateProgram();glAttachShader(p,shader(GL_VERTEX_SHADER,v));glAttachShader(p,shader(GL_FRAGMENT_SHADER,f));glLinkProgram(p);GLint ok;glGetProgramiv(p,GL_LINK_STATUS,&ok);assert(ok);return p;}
+static std::string extract(const std::string &s,const char *name){std::string mark=std::string("static const char *")+name+" =";size_t start=s.find(mark);assert(start!=std::string::npos);std::string r;bool q=false;for(size_t i=start+mark.size();i<s.size();i++){char c=s[i];if(!q&&c==';')break;if(c=='"'){q=!q;continue;}if(!q)continue;if(c=='\\'){c=s[++i];if(c=='n')c='\n';else if(c=='t')c='\t';}r+=c;}return r;}
