+"	vec3 N = dot(v_normal,v_normal) > 1e-8 ? normalize(v_normal) : vec3(0.0,0.0,1.0);\n"
+"	vec3 V = normalize(v_viewVec);\n"
+"	if(u_glassMaterial > 0.5 && dot(N,V) < 0.0) N = -N;\n"
+"	vec3 reflected = reflect(-V,N);\n"
+"	float f = 1.0-clamp(dot(N,V),0.0,1.0);\n"
+"	float reflectionWeight = clamp(mix(f*f*f*f*f,1.0,u_reflProps.x)*u_reflProps.z,0.0,0.9);\n"
+"	if(u_ssrTex.z < -0.5){\n"
+"		// Glossy clear coat: keep the reflected scene legible head-on as well as at grazing angles.\n"
+"		// Material specularity still gates the coat, so tires and matte trim remain matte.\n"
+"		float coat = clamp(u_reflProps.z,0.0,1.0);\n"
+"		reflectionWeight = mix(0.60,0.90,f*f*f*f*f)*coat;\n"
+"	}\n"
+"	float glassFresnel = 0.04 + 0.96*f*f*f*f*f;\n"
+"	// Display-strength remap keeps a clear pane's reflected scene legible; not a change to ray quality.\n"
+"	if(u_glassMaterial > 0.5) reflectionWeight = clamp((1.0-pow(1.0-glassFresnel,3.0))*clamp(u_reflProps.z,0.0,1.0)*u_glassReflectionStrength,0.0,0.9);\n"
+"	float dirt=dirtCoverage();\n"
+"	reflectionWeight *= 1.0-dirt*0.88;\n"
+"	vec4 sampled = texture(tex0, vec2(v_tex0.x, 1.0-v_tex0.y));\n"
+" vec4 pass1 = v_color*sampled;\n"
+" // DiffuseSampler2 decals are layered onto opaque paint. Their alpha is coverage,\n"
+" // never window transparency; lettering retains its authored colour when the car is repainted.\n"
+" if(u_liveryMode>0.5) pass1 = vec4(mix(v_color.rgb,v_lighting.rgb*sampled.rgb,sampled.a),v_color.a);\n"
+"	float light=clamp(dot(v_color.rgb,vec3(0.333333)),0.25,1.0);\n"
+"	vec3 dust=vec3(0.24,0.205,0.155)*light+pass1.rgb*0.15;\n"
+"	pass1.rgb=mix(pass1.rgb,dust,dirt*0.8);\n"
+"	vec3 envmap = vec3(0.0);\n"
+"	if(u_ssrTex.z > -0.5 || u_ssrTex.w > 0.5)\n"
