+void
+ClassicAxis::Enable(const std::string &asiDir)
+{
+	std::string ini = asiDir + "/ClassicAxisIII.ini";
+	FILE *t = fopen(ini.c_str(), "rb");
+	if(t) fclose(t); else ini = "ClassicAxisIII.ini";	// game folder
+	settings.forceAutoAim = ReadBool(ini, "ForceAutoAim", false);
+	settings.lockOnTargetType = ReadInt(ini, "LockOnTargetType", 1);
+	settings.showTriangleForMouseRecruit = ReadBool(ini, "ShowTriangleForMouseRecruit", true);
+	settings.storiesAimingCoords = ReadBool(ini, "StoriesAimingCoords", false);
+	settings.cameraCrosshairMultX = ReadFloat(ini, "CameraCrosshairMultX", 0.53f);
+	settings.cameraCrosshairMultY = ReadFloat(ini, "CameraCrosshairMultY", 0.4f);
+	settings.storiesPointingArm = ReadBool(ini, "StoriesPointingArm", false);
+	settings.rightAnalogStickSensitivityX = ReadFloat(ini, "RightAnalogStickSensitivityX", 1.0f);
+	settings.rightAnalogStickSensitivityY = ReadFloat(ini, "RightAnalogStickSensitivityY", 1.0f);
+	settings.zoomForAssaultRifles = ReadBool(ini, "ZoomForAssaultRifles", true);
+	settings.modernCamera = ReadBool(ini, "ModernCamera", true);
+	{
+		std::string v;
+		settings.walkKey = IniLookup(ini, "WalkKey", v) ? v : "LALT";
+		settings.crouchKey = IniLookup(ini, "CrouchKey", v) ? v : "C";
+	}
+	enabled = true;
+}
+
+// ---- camera (CCamNew) ----
+
+static const float minFOV = 50.0f;
+static const float maxFOV = 70.0f;
+static const float maxFOVModern = 70.0f;
+static const float wepMinRange = 70.0f;
+
+static CVector ca_targetCoords;
+static bool ca_cameraInput;
+static CEntity *ca_hiddenEntities[5];
+static float ca_previousPedZoomIndicator;
+static float ca_fovLerp = maxFOV;
+static bool ca_doFovChanges;
+static float ca_duckOffset;
+float ca_previousHorAngle;
+float ca_previousVerAngle;
+bool ca_camUseCurrentAngle;
+
+#define CA_INTERP(a, b, f) a = a + (f) * ((b) - a)
+
+static float
+CA_BaseFOV(void)
+{
+	return settings.modernCamera ? maxFOVModern : maxFOV;
+}
+
+static void
+CA_CrouchOffset(CCam *cam, float &offset)
+{
+	CPed *e = (CPed*)cam->CamTargetEntity;
+	float end = 0.0f;
+	if(e->bIsDucking){
+		float f = CA_BaseFOV();
+		end = -0.5f;
+		end += ((f - cam->FOV) / minFOV * f) / 100.0f;
+	}
+	CA_INTERP(offset, end, 0.1f * CTimer::GetTimeStep());
+}
+
+static void
+CA_VectorsReadyForRW(CCam *cam)
+{
+	CVector right;
+	cam->Up = CVector(0.0f, 0.0f, 1.0f);
+	cam->Front.Normalise();
+	if(cam->Front.x == 0.0f && cam->Front.y == 0.0f){
+		cam->Front.x = 0.0001f;
+		cam->Front.y = 0.0001f;
+	}
+	right = CrossProduct(cam->Front, cam->Up);
+	right.Normalise();
+	cam->Up = CrossProduct(right, cam->Front);
+}
+
+static void
+CA_FOVLerp(CCam *cam)
+{
+	CPed *e = (CPed*)cam->CamTargetEntity;
+	eWeaponType weaponType = e->m_weapons[e->m_currentWeapon].m_eWeaponType;
+	CWeaponInfo *info = CWeaponInfo::GetWeaponInfo(weaponType);
+	if(TheCamera.m_uiTransitionState == 0){
+		if(info && !info->IsFlagSet(WEAPONFLAG_CANAIM_WITHARM) && info->IsFlagSet(WEAPONFLAG_CANAIM) &&
+		   info->m_fRange >= wepMinRange && ca_doFovChanges)
+			CA_INTERP(ca_fovLerp, minFOV, 0.1f * CTimer::GetTimeStep());
+		else
+			CA_INTERP(ca_fovLerp, CA_BaseFOV(), 0.1f * CTimer::GetTimeStep());
+	}
+	cam->FOV = ca_fovLerp;
+	ca_doFovChanges = false;
+}
+
+static void
+CA_AvoidCollisions(CCam *cam, float length)
+{
+	CColPoint colPoint;
+	CEntity *entity = nil;
+
+	CWorld::pIgnoreEntity = cam->CamTargetEntity;
+	if(CWorld::ProcessLineOfSight(ca_targetCoords, cam->Source, colPoint, entity, true, true, false, true, false, false, false)){
+		float distFromPoint = (ca_targetCoords - colPoint.point).Magnitude();
+		cam->Source = colPoint.point;
+		if(distFromPoint < 1.3f)
+			RwCameraSetNearClipPlane(Scene.camera, Max(distFromPoint - 0.3f, 0.05f));
+	}
+
+	float viewPlaneHeight = tanf(DEGTORAD(cam->FOV) * 0.5f);
+	float viewPlaneWidth = viewPlaneHeight * CDraw::GetAspectRatio() * 1.05f;
+
+	CWorld::pIgnoreEntity = nil;
+	for(int i = 0; i < 5; i++){
+		if(ca_hiddenEntities[i]){
+			ca_hiddenEntities[i]->bIsVisible = true;
+			ca_hiddenEntities[i] = nil;
+		}
+
+		float nearClip = RwCameraGetNearClipPlane(Scene.camera);
+		float radius = viewPlaneWidth * nearClip;
+		CVector center = cam->Source + cam->Front * nearClip;
+		entity = CWorld::TestSphereAgainstWorld(center, radius, nil, true, true, true, true, false, true);
+		if(entity){
+			bool isPed = entity->IsPed();
+			if(isPed && entity->IsVisible() && (center - entity->GetPosition()).Magnitude2D() < 0.5f){
+				if(TheCamera.m_uiTransitionState == 0){
+					ca_hiddenEntities[i] = entity;
+					entity->bIsVisible = false;
+				}
+			}else if(!isPed){
+				CVector distFromPoint = gaTempSphereColPoints[0].point - ca_targetCoords;
+				float frontDist = DotProduct(distFromPoint, cam->Front);
+				float dist = (distFromPoint - cam->Front * frontDist).Magnitude() / viewPlaneWidth;
+
+				dist = Max(Min(nearClip, dist), 0.1f);
+				if(dist < nearClip)
+					RwCameraSetNearClipPlane(Scene.camera, dist);
+				if(dist == 0.1f)
+					cam->Source += (ca_targetCoords - cam->Source) * (dist / length);
+			}
+		}
+	}
+}
+
+// Shared look-around input: right stick or mouse. Returns offsets to add to beta/alpha.
+static void
+CA_LookInput(CCam *cam, bool &lockMovement, float &betaOffset, float &alphaOffset)
+{
+	CPad *pad = CPad::GetPad(0);
+	if(pad->ArePlayerControlsDisabled())
+		lockMovement = true;
+	float lookLeftRight = -(float)pad->NewState.RightStickX;
+	float lookUpDown = -(float)pad->NewState.RightStickY;
+	float mouseX = pad->NewMouseControllerState.x;
+	float mouseY = pad->NewMouseControllerState.y;
+	bool mouseInput = false;
+
+	if(mouseX != 0.0f || mouseY != 0.0f){
+		mouseInput = true;
+		lookLeftRight = -2.5f * mouseX;
+		lookUpDown = 4.0f * mouseY;
+	}
+
+	betaOffset = lookLeftRight * 0.01f * (1.0f / 20.0f) * cam->FOV / 80.0f * CTimer::GetTimeStep();
+	alphaOffset = lookUpDown * 0.01f * (0.6f / 20.0f) * cam->FOV / 80.0f * CTimer::GetTimeStep();
+	betaOffset *= settings.rightAnalogStickSensitivityX;
+	alphaOffset *= settings.rightAnalogStickSensitivityY;
+
+	if(mouseInput){
+		betaOffset = lookLeftRight * TheCamera.m_fMouseAccelHorzntl * cam->FOV / 80.0f;
+		alphaOffset = lookUpDown * TheCamera.m_fMouseAccelHorzntl * cam->FOV / 80.0f;
+	}
+
+	if(betaOffset || alphaOffset || lockMovement){
+		cam->Rotating = false;
+		ca_cameraInput = true;
+	}else
+		ca_cameraInput = false;
+}
+
+static void
+CA_WrapAngles(CCam *cam, bool alsoAlpha)
+{
+	while(cam->Beta >= PI) cam->Beta -= 2.0f*PI;
+	while(cam->Beta < -PI) cam->Beta += 2.0f*PI;
+	if(alsoAlpha){
+		while(cam->Alpha >= PI) cam->Alpha -= 2.0f*PI;
+		while(cam->Alpha < -PI) cam->Alpha += 2.0f*PI;
+	}
+}
+
+void
+CCam::Process_FollowPed_ClassicAxis(const CVector &CameraTarget, float TargetOrientation, float, float)
+{
+	if(!CamTargetEntity || !CamTargetEntity->IsPed())
+		return;
+
+	if(settings.zoomForAssaultRifles)
+		CA_FOVLerp(this);
+	else
+		FOV = CA_BaseFOV();
+
+	const float minDist = 2.0f;
+	const float maxDist = minDist + TheCamera.m_fPedZoomValueSmooth;
+	const float heightOffset = 0.4f;
+	const bool usingController = CPad::IsAffectedByController;
+
+	ca_targetCoords = CameraTarget;
+
+	if(settings.modernCamera){
+		ca_targetCoords += TheCamera.GetRight() * -0.25f;
+		ca_targetCoords += TheCamera.GetUp() * 0.075f;
+	}
+
+	CA_CrouchOffset(this, ca_duckOffset);
+
+	ca_targetCoords.z += m_fSyphonModeTargetZOffSet;
+	ca_targetCoords.z += heightOffset;
+	ca_targetCoords.z += ca_duckOffset;
+
+	CVector dist = Source - ca_targetCoords;
+
+	if(ResetStatics){
+		Beta = CGeneral::GetATanOfXY(-dist.x, -dist.y);
+		Alpha = 0.0f;
+
+		dist = maxDist * CVector(cosf(Alpha) * cosf(Beta), cosf(Alpha) * sinf(Beta), sinf(Alpha));
+		Source = ca_targetCoords + dist;
+
+		ResetStatics = false;
+	}
+
+	float length = dist.Magnitude();
+	if(ca_previousPedZoomIndicator != maxDist){
+		dist *= maxDist / length;
+		ca_previousPedZoomIndicator = maxDist;
+	}else{
+		if(length == 0.0f)
+			dist = CVector(1.0f, 1.0f, 0.0f);
+		else if(length < minDist)
+			dist *= minDist / length;
+		else if(length > maxDist)
+			dist *= maxDist / length;
+	}
+
+	length = dist.Magnitude();
+
+	bool lockMovement = false;
+	if(usingController && TheCamera.m_uiTransitionState == 0){
+		if(Alpha > -DEGTORAD(85.0f))
+			Beta = CGeneral::GetATanOfXY(-dist.x, -dist.y);
+		Alpha = -CGeneral::GetATanOfXY(dist.Magnitude2D(), dist.z);
+	}
+
+	CA_WrapAngles(this, true);
+
+	float betaOffset, alphaOffset;
+	CA_LookInput(this, lockMovement, betaOffset, alphaOffset);
+
+	if(!lockMovement){
+		Beta += betaOffset;
+		Alpha += alphaOffset;
+	}
+
+	CA_WrapAngles(this, false);
+
+	if(Alpha > DEGTORAD(60.0f))
+		Alpha = DEGTORAD(60.0f);
+	else if(Alpha < -DEGTORAD(89.5f))
+		Alpha = -DEGTORAD(89.5f);
+
+	if(CPad::GetPad(0)->ForceCameraBehindPlayer() && !lockMovement){
+		m_fTargetBeta = TargetOrientation;
+		Rotating = true;
+	}
+
+	if(Rotating){
+		WellBufferMe(m_fTargetBeta, &Beta, &BetaSpeed, 0.1f, 0.06f, true);
+		float deltaBeta = m_fTargetBeta - Beta;
+		while(deltaBeta >= PI) deltaBeta -= 2*PI;
+		while(deltaBeta < -PI) deltaBeta += 2*PI;
+		if(Abs(deltaBeta) < 0.06f)
+			Rotating = false;
+	}
+
+	if(TheCamera.m_bUseTransitionBeta)
+		Beta = CGeneral::GetATanOfXY(-cosf(m_fTransitionBeta), -sinf(m_fTransitionBeta));
+
+	if(TheCamera.m_bCamDirectlyBehind){
+		m_bCollisionChecksOn = true;
+		Beta = TargetOrientation;
+		Alpha = 0.0f;
+		TheCamera.m_bCamDirectlyBehind = false;
+	}
+
+	if(TheCamera.m_bCamDirectlyInFront){
+		Beta = TargetOrientation + PI;
+		Alpha = 0.0f;
+		TheCamera.m_bCamDirectlyInFront = false;
+	}
+
+	if(ca_camUseCurrentAngle){
+		Beta = ca_previousHorAngle;
+		Alpha = ca_previousVerAngle;
+		ca_camUseCurrentAngle = false;
+	}
+
+	m_fDistanceBeforeChanges = (Source - ca_targetCoords).Magnitude();
+
+	Front = CVector(cosf(Alpha) * cosf(Beta), cosf(Alpha) * sinf(Beta), sinf(Alpha));
+	Source = ca_targetCoords - Front * length;
+	SourceBeforeLookBehind = ca_targetCoords + Front;
+
+	// camera under water level while the ped is in water: stay above it
+	{
+		float waterLevel;
+		if(CamTargetEntity->bTouchingWater &&
+		   CWaterLevel::GetWaterLevelNoWaves(ca_targetCoords.x, ca_targetCoords.y, ca_targetCoords.z, &waterLevel) &&
+		   Source.z < waterLevel + 0.6f){
+			RwCameraSetNearClipPlane(Scene.camera, 0.2f);
+			Source = ca_targetCoords - Front * (dist * (maxDist / length)).Magnitude2D();
+			Source.z = waterLevel + 0.6f;
+		}
+	}
+
+	ca_targetCoords.z -= heightOffset;
+
+	m_cvecTargetCoorsForFudgeInter = ca_targetCoords;
+
+	Front = ca_targetCoords - Source;
+	Front.Normalise();
+
+	CA_AvoidCollisions(this, length);
+	CA_VectorsReadyForRW(this);
+}
+
+void
+CCam::Process_AimWeapon_ClassicAxis(const CVector &CameraTarget, float TargetOrientation, float, float)
+{
+	if(!CamTargetEntity || !CamTargetEntity->IsPed())
+		return;
+
+	ca_doFovChanges = true;
+	if(settings.zoomForAssaultRifles)
+		CA_FOVLerp(this);
+	else
+		FOV = CA_BaseFOV();
+
+	CPlayerPed *e = (CPlayerPed*)CamTargetEntity;
+
+	const float maxDist = 2.7f;
+	const float heightOffset = 0.25f;
+	float length = maxDist;
+
+	CVector aimOffset = settings.storiesAimingCoords ? CVector(0.55f, 0.0f, 0.0f) : CVector(0.2f, 0.0f, 0.0f);
+
+	ca_targetCoords = e->GetMatrix() * aimOffset;
+
+	CEntity *entity = nil;
+	CColPoint colPoint;
+
+	if(CWorld::ProcessLineOfSight(ca_targetCoords, Source, colPoint, entity, true, false, false, true, false, true, true)){
+		ca_targetCoords.x = CameraTarget.x;
+		ca_targetCoords.y = CameraTarget.y;
+	}
+
+	CA_CrouchOffset(this, ca_duckOffset);
+
+	ca_targetCoords.z += m_fSyphonModeTargetZOffSet + 0.05f;
+	ca_targetCoords.z += heightOffset;
+	ca_targetCoords.z += ca_duckOffset;
+
+	CVector dist = Source - ca_targetCoords;
+	(void)dist;
+
+	bool lockMovement = false;
+	CEntity *p = e->m_pPointGunAt;
+	if(e->m_bHasLockOnTarget && !LookingBehind && p){
+		CVector target = p->GetPosition();
+		CVector distfromTarget = Source - target;
+		float viewPlaneHeight = tanf(DEGTORAD(FOV) * 0.5f);
+		float viewPlaneWidth = viewPlaneHeight * CDraw::GetAspectRatio() * 1.05f;
+
+		float horShift = CGeneral::GetATanOfXY(1.0f, (TheCamera.m_f3rdPersonCHairMultX - 0.5f + TheCamera.m_f3rdPersonCHairMultX - 0.5f) * viewPlaneWidth);
+		float verShift = CGeneral::GetATanOfXY(1.0f, (viewPlaneHeight * 0.0174f) * ((0.5f - TheCamera.m_f3rdPersonCHairMultY + 0.5f - TheCamera.m_f3rdPersonCHairMultY) * (1.0f / CDraw::GetAspectRatio())));
+		Beta = e->m_fRotationCur + (PI * 0.5f) + horShift;
+		Alpha = CGeneral::GetATanOfXY(distfromTarget.Magnitude2D(), -distfromTarget.z) - verShift;
+
+		lockMovement = true;
+	}
+
+	CA_WrapAngles(this, true);
+
+	float betaOffset, alphaOffset;
+	CA_LookInput(this, lockMovement, betaOffset, alphaOffset);
+
+	if(!lockMovement){
+		Beta += betaOffset;
+		Alpha += alphaOffset;
+	}
+
+	CA_WrapAngles(this, false);
+
+	if(Alpha > DEGTORAD(50.0f))
+		Alpha = DEGTORAD(50.0f);
+	else if(Alpha < -DEGTORAD(50.0f))
+		Alpha = -DEGTORAD(50.0f);
+
+	if(TheCamera.m_bCamDirectlyBehind){
+		m_bCollisionChecksOn = true;
+		Beta = TargetOrientation;
+		Alpha = 0.0f;
+		TheCamera.m_bCamDirectlyBehind = false;
+	}
+
+	if(TheCamera.m_bCamDirectlyInFront){
+		Beta = TargetOrientation + PI;
+		Alpha = 0.0f;
+		TheCamera.m_bCamDirectlyInFront = false;
+	}
+
+	if(ca_camUseCurrentAngle){
+		Beta = ca_previousHorAngle;
+		Alpha = ca_previousVerAngle;
+		ca_camUseCurrentAngle = false;
+	}
+
+	m_fDistanceBeforeChanges = (Source - ca_targetCoords).Magnitude();
+	Front = CVector(cosf(Alpha) * cosf(Beta), cosf(Alpha) * sinf(Beta), sinf(Alpha));
+	Source = ca_targetCoords - Front * length;
+	SourceBeforeLookBehind = ca_targetCoords + Front;
+	ca_targetCoords.z -= heightOffset;
+
+	m_cvecTargetCoorsForFudgeInter = ca_targetCoords;
+
+	Front = ca_targetCoords - Source;
+	Front.Normalise();
+
+	CA_AvoidCollisions(this, length);
+	CA_VectorsReadyForRW(this);
+}
