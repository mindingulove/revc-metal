+  }
+  float vertices[]={100,100,1,101,100,1,100,101,1};uint32_t tri[]={0,1,2};const uint32_t *meshes[]={tri};int count=3,casts=1;float colours[]={1,1,1,1,1,1};
+  int geometryId=mrtAddGeometry(vertices,3,1,meshes,&count,colours,&casts);assert(geometryId>=0);
