+  char c=src[i];if(!quoted&&c==';')break;if(c=='"'){quoted=!quoted;continue;}if(!quoted)continue;
+  if(c=='\\'){c=src[++i];if(c=='n')c='\n';else if(c=='t')c='\t';}result+=c;
+ }return result;
+}
