new file mode 100644
index 00000000..25d92672
--- /dev/null
+++ b/src/extras/RTLights.cpp
@@ -0,0 +1,55 @@
+// Point lights for the ray traced lighting (street lamps, vehicle lights, fires): the lights the game registers this frame,
+// nearest to the camera first. The renderer traces a shadow ray to each one it lights a pixel with.
+#include "common.h"
+#include "PointLights.h"
+#include "Camera.h"
+#include "Coronas.h"
+#include <algorithm>
+
+extern "C" int
+regtaRTGatherLights(float *out, int maxLights)
+{
+	// point lights (fires, explosions, vehicle lights) and coronas (street lamps and other light sources: the game gives
+	// lamps a corona and a light pool on the ground, but no light of their own)
+	struct Cand { float d2; int i; bool corona; };
+	static Cand cand[NUMPOINTLIGHTS + NUMCORONAS];
+	int n = 0;
+	CVector cam = TheCamera.GetPosition();
+	for(int i = 0; i < CPointLights::NumLights; i++){
+		const CRegisteredPointLight &l = CPointLights::aLights[i];
+		if(l.type != CPointLights::LIGHT_POINT && l.type != CPointLights::LIGHT_DIRECTIONAL) continue;
+		if(l.radius <= 0.5f || l.red + l.green + l.blue <= 0.01f) continue;
+		float d2 = (l.coors - cam).MagnitudeSqr();
+		if(d2 > SQR(150.0f)) continue;
+		cand[n++] = { d2, i, false };
+	}
+	for(int i = 0; i < NUMCORONAS; i++){
+		const CRegisteredCorona &c = CCoronas::aCoronas[i];
+		if(c.id == 0 || c.fadeAlpha == 0 || c.size <= 0.0f) continue;
+		if(c.red + c.green + c.blue < 30) continue;
+		float d2 = (c.coors - cam).MagnitudeSqr();
+		if(d2 > SQR(150.0f)) continue;
+		cand[n++] = { d2, i, true };
+	}
+	std::sort(cand, cand + n, [](const Cand &a, const Cand &b){ return a.d2 < b.d2; });
+	if(n > maxLights) n = maxLights;
+	for(int k = 0; k < n; k++){
+		float *o = out + k*8;
+		if(cand[k].corona){
+			const CRegisteredCorona &c = CCoronas::aCoronas[cand[k].i];
+			float r = c.size*6.0f;
+			if(r < 6.0f) r = 6.0f;
+			if(r > 18.0f) r = 18.0f;
+			o[0] = c.coors.x; o[1] = c.coors.y; o[2] = c.coors.z; o[3] = r;
+			o[4] = c.red/255.0f; o[5] = c.green/255.0f; o[6] = c.blue/255.0f; o[7] = 0.7f*c.fadeAlpha/255.0f;
+			continue;
+		}
+		const CRegisteredPointLight &l = CPointLights::aLights[cand[k].i];
+		CVector pos = l.coors;
+		// headlights are directional in the game: put the light a little ahead of the lamp
+		if(l.type == CPointLights::LIGHT_DIRECTIONAL) pos += l.dir*2.0f;
+		o[0] = pos.x; o[1] = pos.y; o[2] = pos.z; o[3] = l.radius;
+		o[4] = l.red; o[5] = l.green; o[6] = l.blue; o[7] = 1.0f;
+	}
+	return n;
+}
