+#pragma once
+
+// Existing suspension-arm geometry pivots about the chassis; wheel spin and
+// steering stay on the native wheel frame. Rest meshes are baked by the converter.
+inline void UpdateImportedSuspensionArm(RwFrame *arm, RwFrame *wheel, const CVector &restOffset)
+{
+	if(!arm || !wheel) return;
+	CVector pivot(*RwMatrixGetPos(RwFrameGetMatrix(arm)));
+	float wheelZ = RwMatrixGetPos(RwFrameGetMatrix(wheel))->z;
+	float angle = Atan2(restOffset.z, restOffset.x) - Atan2(wheelZ - pivot.z, restOffset.x);
+	while(angle > PI) angle -= TWOPI;
+	while(angle < -PI) angle += TWOPI;
+	CMatrix mat;
+	mat.Attach(RwFrameGetMatrix(arm));
+	mat.SetRotateY(Clamp(angle, -HALFPI, HALFPI));
+	mat.Translate(pivot);
+	mat.UpdateRW();
+}
+
+#include <vector>
+
+// Cache rest vertices per vehicle, never mutate the shared model dictionary.
+struct ImportedRunningGear {
+ RwFrame *frame = nil;
+ RpAtomic *atomic = nil;
+ std::vector<rw::V3d> vertices, normals;
+ CVector pivot, left, right;
+ float lo = 0, hi = 0, previousLeft = 1.e20f, previousRight = 1.e20f;
+ int kind = 0; // 1 leaf, 2 axle/differential and attached shaft, 3 non-spinning hub
+};
+inline bool PrepareImportedGear(ImportedRunningGear &part)
+{
+ if(!part.atomic) return false;
+ auto *src = RpAtomicGetGeometry(part.atomic);
+ if(!src || src->numMorphTargets != 1 || !src->morphTargets[0].vertices) return false;
+ unsigned format = (src->flags & 0xFFu & ~(unsigned)rw::Geometry::TRISTRIP) | (src->numTexCoordSets << 16);
+ auto *copy = rw::Geometry::create(src->numVertices, src->numTriangles, format);
+ if(!copy) return false;
+ auto &a = src->morphTargets[0]; auto &b = copy->morphTargets[0];
+ part.vertices.assign(a.vertices,a.vertices+src->numVertices);
+ memcpy(b.vertices,a.vertices,src->numVertices*sizeof(rw::V3d));
+ if(a.normals){part.normals.assign(a.normals,a.normals+src->numVertices);memcpy(b.normals,a.normals,src->numVertices*sizeof(rw::V3d));}
+ memcpy(copy->triangles,src->triangles,src->numTriangles*sizeof(rw::Triangle));
+ if(src->colors) memcpy(copy->colors,src->colors,src->numVertices*sizeof(rw::RGBA));
+ for(int t=0;t<src->numTexCoordSets;t++) memcpy(copy->texCoords[t],src->texCoords[t],src->numVertices*sizeof(rw::TexCoords));
+ for(int m=0;m<src->matList.numMaterials;m++) copy->matList.appendMaterial(src->matList.materials[m]);
+ b.boundingSphere=a.boundingSphere;b.boundingSphere.radius+=.6f;copy->buildMeshes();
+ RpAtomicSetGeometry(part.atomic,copy,0);copy->destroy();
+ part.lo=1.e20f;part.hi=-1.e20f;
+ for(auto &v:part.vertices){part.lo=Min(part.lo,v.y+part.pivot.y);part.hi=Max(part.hi,v.y+part.pivot.y);}
+ return true;
+}
+// Rest-space displacement and derivatives. Leaf eyes stay on the chassis;
+// their centre follows wheel travel. Axle ends follow independent wheel travel,
+// with the longitudinal shaft tapered back to its authored chassis pivot.
+inline CVector ImportedGearDisplacement(const ImportedRunningGear &p,const rw::V3d &v,float dl,float dr)
+{
+ float x=v.x+p.pivot.x,y=v.y+p.pivot.y;
+ if(p.kind==1){
+  float center=p.left.y;float radius=Max(.05f,y<center?center-p.lo:p.hi-center);
+  float t=Clamp((y-center)/radius,-1.f,1.f);
+  return CVector(dl*(1-t*t),0,-2*dl*t/radius);
+ }
+ if(p.kind==3) return CVector(dl,0,0);
+ float track=Max(.1f,p.right.x-p.left.x),s=(x-p.left.x)/track;
+ float amount=dl+(dr-dl)*s;
+ float length=p.left.y-p.pivot.y;
+ float t=fabsf(length)>.25f?Clamp((y-p.pivot.y)/length,0.f,1.f):1.f;
+ float weight=t*t*(3-2*t),dy=fabsf(length)>.25f?6*t*(1-t)/length:0;
+ return CVector(amount*weight,(dr-dl)/track*weight,amount*dy);
+}
+inline void UpdateImportedGear(ImportedRunningGear &p,float dl,float dr)
+{
+ if(!p.frame || !p.atomic) return;
+ if(p.vertices.empty() && !PrepareImportedGear(p)) return;
+ if(fabsf(dl-p.previousLeft)<1.e-5f && fabsf(dr-p.previousRight)<1.e-5f) return;
+ p.previousLeft=dl;p.previousRight=dr;
+ auto *g=RpAtomicGetGeometry(p.atomic);
+ g->lock(rw::Geometry::LOCKVERTICES | (p.normals.empty()?0:rw::Geometry::LOCKNORMALS));
+ auto &m=g->morphTargets[0];
+ for(size_t i=0;i<p.vertices.size();i++){
+  auto v=p.vertices[i];auto delta=ImportedGearDisplacement(p,v,dl,dr);v.z+=delta.x;m.vertices[i]=v;
+  if(!p.normals.empty()){
+   auto n=p.normals[i];n.x-=delta.y*n.z;n.y-=delta.z*n.z;
+   float inv=1.f/sqrtf(n.x*n.x+n.y*n.y+n.z*n.z);n.x*=inv;n.y*=inv;n.z*=inv;m.normals[i]=n;
+  }
+ }
+ g->unlock();
+}
+
+// Optional authored lamp lens meshes; visibility belongs to each vehicle instance.
+struct ImportedLampLens {
+ RpAtomic *atomic = nil;
+ int side = 0;
+ uint32 flags = 0;
+ bool broken = false, componentVisible = true;
+};
+inline bool SetImportedLampBroken(ImportedLampLens &lens, bool broken)
+{
+ if(!lens.atomic) return false;
+ bool changed=lens.broken!=broken;
+ RpAtomicSetFlags(lens.atomic,broken || !lens.componentVisible?0:lens.flags);
+ lens.broken=broken;
+ return changed && broken && lens.componentVisible; // exactly one shatter event on the intact -> broken transition
+}
