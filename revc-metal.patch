diff --git a/src/extras/localdent/CollisionEnergy.hpp b/src/extras/localdent/CollisionEnergy.hpp
new file mode 100644
index 00000000..189e25ab
--- /dev/null
+++ b/src/extras/localdent/CollisionEnergy.hpp
@@ -0,0 +1,47 @@
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <limits>
+
+namespace dent {
+// Speeds use the engine's units; multiplying energy by 50^2 yields joules.
+// Effective normal masses include rotational leverage at the actual contact.
+// A fixed body has inverse effective mass zero and crush compliance zero.
+struct CollisionBody {
+    float mass{}, inverseEffectiveMass{}, compliance{};
+};
+struct CollisionEnergy {
+    float available{}, absorbedA{}, absorbedB{}, speedA{}, speedB{};
+};
+inline bool validBody(const CollisionBody &b) {
+    return std::isfinite(b.mass) && b.mass > 0 &&
+        std::isfinite(b.inverseEffectiveMass) && b.inverseEffectiveMass >= 0 &&
+        std::isfinite(b.compliance) && b.compliance >= 0;
+}
+// before/after are signed (velocity A - velocity B) dot the B-to-A normal.
+// An approaching pair has before < 0; tangential motion does no crush work.
+inline CollisionEnergy collisionEnergy(CollisionBody a, CollisionBody b,
+                                      float before, float after,
+                                      float impulseA, float impulseB) {
+    CollisionEnergy r;
+    if(!validBody(a) || !validBody(b) || !std::isfinite(before) ||
+       !std::isfinite(after) || before >= 0) return r;
+    const double inverse = double(a.inverseEffectiveMass) + b.inverseEffectiveMass;
+    const double compliance = double(a.compliance) + b.compliance;
+    if(inverse <= 0 || compliance <= 0) return r;
+    const double loss = .5 / inverse * std::max(0.0, double(before)*before - double(after)*after);
+    if(!std::isfinite(loss) || loss <= 0 || loss > std::numeric_limits<float>::max()/2500.0) return r;
+    r.available = float(loss);
+    auto absorb = [loss,compliance](CollisionBody body, float impulse, float &energy, float &speed) {
+        if(body.compliance <= 0 || !std::isfinite(impulse) || impulse <= 0) return;
+        const double share = loss * body.compliance / compliance;
+        // The impulse already contains both bodies' inertia. Bound the energy
+        // equivalent speed by that body's solver delta-v; do not multiply by mass again.
+        speed = float(std::min(std::sqrt(2 * share / body.mass), double(impulse) / body.mass));
+        energy = .5f * body.mass * speed * speed;
+    };
+    absorb(a, impulseA, r.absorbedA, r.speedA);
+    absorb(b, impulseB, r.absorbedB, r.speedB);
+    return r;
+}
+}
