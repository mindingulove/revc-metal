@@ -0,0 +1,29 @@
+#include "common.h"
+#include "../src/skel/skeleton.h"
+#include "../src/skel/crossplatform.h"
+#include "../vendor/librw/src/mtl/mtlgl.h"
+#define GLFW_EXPOSE_NATIVE_COCOA
+#include <GLFW/glfw3native.h>
+#import <Cocoa/Cocoa.h>
+#import <QuartzCore/CAMetalLayer.h>
+#include <cassert>
+extern void cursorEnterCB(GLFWwindow*,int);
+extern void windowFocusCB(GLFWwindow*,int);
+extern "C" int performanceParityTest(int,char**){@autoreleasepool{
+ assert(glfwInit());glfwWindowHint(GLFW_VISIBLE,GLFW_FALSE);glfwWindowHint(GLFW_CLIENT_API,GLFW_NO_API);
+ auto *window=glfwCreateWindow(48,48,"performance parity regression",nullptr,nullptr);assert(window);
+ psGlobalType state{};state.window=window;void *previous=RsGlobal.ps;RsGlobal.ps=&state;
+ cursorEnterCB(window,1);assert(state.cursorIsInWindow);cursorEnterCB(window,0);assert(!state.cursorIsInWindow);
+ windowFocusCB(window,1);assert(state.cursorIsInWindow==(glfwGetWindowAttrib(window,GLFW_HOVERED)!=0));
+ for(int i=0;i<10000;i++){cursorEnterCB(window,i&1);assert(state.cursorIsInWindow==bool(i&1));}
+ windowFocusCB(window,0);windowFocusCB(window,1);assert(state.cursorIsInWindow==(glfwGetWindowAttrib(window,GLFW_HOVERED)!=0));
+ RsGlobal.ps=previous;
+ NSWindow *native=glfwGetCocoaWindow(window);
+ // Actual Metal drawable sizes must follow requested pixels, including explicit high-density requests.
+ assert(mtlglInit((__bridge void*)native,48,48));CAMetalLayer *layer=(CAMetalLayer*)native.contentView.layer;
+ assert(layer.drawableSize.width==48 && layer.drawableSize.height==48);
+ mtlglResize(96,96);assert(layer.drawableSize.width==96 && layer.drawableSize.height==96);
+ mtlglResize(32,24);assert(layer.drawableSize.width==32 && layer.drawableSize.height==24);
+ mtlglShutdown();glfwDestroyWindow(window);glfwTerminate();
+ puts("PASS native cursor enter/leave/focus cache and Metal requested 48/96/32x24 drawable sizes. Hidden window only; no game launched.");fflush(stdout);_Exit(0);
+}}
