+void
+AddTextLine(float x, float y, const char *text)
+{
+	int n = CTheScripts::NumberOfIntroTextLinesThisFrame;
+	if(n >= MAX_NUM_INTRO_TEXT_LINES) return;
+	auto &line = CTheScripts::IntroTextLines[n];
+	line.m_fAtX = x;
+	line.m_fAtY = y;
+	int i = 0;
+	for(const unsigned char *p = (const unsigned char*)text; *p && i < SCRIPT_TEXT_MAX_LENGTH - 1; p++) line.m_Text[i++] = *p;
+	for(; i < SCRIPT_TEXT_MAX_LENGTH; i++) line.m_Text[i] = 0;
+	CTheScripts::NumberOfIntroTextLinesThisFrame++;
+}
