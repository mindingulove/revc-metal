diff --git a/src/modelinfo/ModelTraits.cpp b/src/modelinfo/ModelTraits.cpp
new file mode 100644
index 00000000..a40112cf
--- /dev/null
+++ b/src/modelinfo/ModelTraits.cpp
@@ -0,0 +1,72 @@
+#include "common.h"
+
+#include <vector>
+#include <algorithm>
+
+#include "FileMgr.h"
+#include "FileLoader.h"
+#include "ModelInfo.h"
+#include "ModelTraits.h"
+
+bool CModelTraits::ms_loaded;
+int CModelTraits::ms_present = -1;
+static std::vector<int> ms_ids[CModelTraits::NUM_TRAITS];
+
+void
+CModelTraits::Load(void)
+{
+	char *line;
+	char modelName[32];
+	int section = -1;
+	int id;
+
+	for(int i = 0; i < NUM_TRAITS; i++)
+		ms_ids[i].clear();
+	ms_loaded = false;
+
+	int fd = CFileMgr::OpenFile("data/modelTraits.dat", "r");
+	if(fd <= 0)
+		return;
+
+	for(line = CFileLoader::LoadLine(fd); line; line = CFileLoader::LoadLine(fd)){
+		if(*line == '\0' || *line == '#')
+			continue;
+
+		if(section < 0){
+			if(strncmp(line, "door", 4) == 0)
+				section = DOOR;
+			else if(strncmp(line, "tree", 4) == 0)
+				section = TREE;
+			else if(strncmp(line, "banner", 6) == 0)
+				section = BANNER;
+			else if(strncmp(line, "glass", 5) == 0)
+				section = GLASS;
+		}else if(strncmp(line, "end", 3) == 0){
+			section = -1;
+		}else if(sscanf(line, "%31s", modelName) == 1){
+			if(CModelInfo::GetModelInfo(modelName, &id))
+				ms_ids[section].push_back(id);
+		}
+	}
+
+	CFileMgr::CloseFile(fd);
+	ms_loaded = true;
+}
+
+bool
+CModelTraits::Has(eTrait trait, int id)
+{
+	return std::find(ms_ids[trait].begin(), ms_ids[trait].end(), id) != ms_ids[trait].end();
+}
+
+bool
+CModelTraits::DataPresent(void)
+{
+	if(ms_present < 0){
+		int fd = CFileMgr::OpenFile("data/modelTraits.dat", "r");
+		ms_present = fd > 0;
+		if(fd > 0)
+			CFileMgr::CloseFile(fd);
+	}
+	return ms_present != 0;
+}
diff --git a/src/modelinfo/ModelTraits.h b/src/modelinfo/ModelTraits.h
new file mode 100644
index 00000000..17b570bf
--- /dev/null
+++ b/src/modelinfo/ModelTraits.h
@@ -0,0 +1,27 @@
+#pragma once
+
+// Data-driven model traits (ported from Upstate Liberty's ModelTraits).
+// data/modelTraits.dat assigns behaviours to models by name:
+//   door   - objects usable as garage doors
+//   tree   - vegetation moving in the wind
+//   banner - hanging objects moving in the wind
+//   glass  - breakable glass
+// If the file is absent the stock hard-coded model lists are used instead.
+class CModelTraits
+{
+public:
+	enum eTrait { DOOR, TREE, BANNER, GLASS, NUM_TRAITS };
+
+	static void Load(void);
+	static bool IsLoaded(void) { return ms_loaded; }
+	static bool Has(eTrait trait, int id);
+	// true if data/modelTraits.dat exists (i.e. the Upstate Liberty data set is installed)
+	static bool DataPresent(void);
+
+private:
+	static int ms_present;
+	static bool ms_loaded;
+};
+
+// Upstate Liberty extensions are enabled only when its data set is present.
+inline bool IsUpstate(void) { return CModelTraits::DataPresent(); }
